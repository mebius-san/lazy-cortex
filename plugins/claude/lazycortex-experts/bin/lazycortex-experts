#!/usr/bin/env python3
"""
Command-line entry point of the lazycortex-experts plugin.
"""

from __future__ import annotations

import importlib
import sys
from pathlib import Path

from typing import TYPE_CHECKING
if TYPE_CHECKING:
  pass


# Put the CLI's own directory first on sys.path so its sibling bin-modules resolve by bare name.
sys.path.insert(0, str(Path(__file__).parent))

# Usage text printed with no arguments or a help flag
USAGE = ("usage: lazycortex-experts <subcommand> [args...]\n"
         "Subcommands: rename-implementer-agent, list-classes")

# Verbs and the module that serves each
_ROUTES = {
  "rename-implementer-agent": "rename_agent",
  "list-classes": "expert_classes",
}

# Exit code of an unknown subcommand
_EXIT_USAGE = 2


def main(argv: list[str]) -> int:
  """
  Route a subcommand to the module that serves it.

  Args:
    argv: Command-line arguments after the program name, starting with the subcommand.

  Returns:
    The exit code of the module that served the subcommand, 0 after printing the usage text, or 2 for an unknown
    subcommand.
  """
  if not argv or argv[0] in ("-h", "--help"):
    print(USAGE)
    return 0

  # guard: an unknown subcommand is a usage error
  if argv[0] not in _ROUTES:
    sys.stderr.write(f"lazycortex-experts: unknown subcommand {argv[0]!r}\n{USAGE}\n")
    return _EXIT_USAGE
  return importlib.import_module(_ROUTES[argv[0]]).main(argv[1:])


if __name__ == "__main__":
  sys.exit(main(sys.argv[1:]))
