#!/usr/bin/env python3

"""
lazycortex-core CLI dispatcher.
"""

# waiver: module name matches the installed CLI binary name; renaming breaks the PATH contract.
# pylint: disable=invalid-name

from __future__ import annotations

import argparse
import importlib
import json
import os
import shutil
import subprocess
import sys
import time
from pathlib import Path

from typing import TYPE_CHECKING
if TYPE_CHECKING:
  from collections.abc import Callable


# Put the CLI's own directory first on sys.path so its sibling bin-modules resolve by bare name.
sys.path.insert(0, str(Path(__file__).parent))

# Claude Code puts `<installPath>/bin` of every installed plugin on the session's PATH at
# startup and never refreshes it, so after `/plugin update` a long-lived session — and every
# headless spawn inheriting its environment — keeps resolving the bare `lazycortex-core` to the
# version that was installed when the session began.

# Decision: the stale-PATH problem is corrected here, inside the binary, not in its callers — a
# cache-resident copy forwards to the version the install registry
# (`~/.claude/plugins/installed_plugins.json`) names before dispatching. The cache is never
# walked: it keeps every version ever installed, so its newest directory is not necessarily the
# one this machine has enabled. The alternative, every skill resolving the installed version's
# path and invoking it absolutely, touches ~20 SKILL.md files across the marketplace and breaks
# the `Bash(lazycortex-core *)` allow pattern consumers carry: an absolute-path invocation does
# not match it, so headless spawns under `dontAsk` would be denied. A dev-vault copy never
# forwards — its source tree is the live one.

# Path fragment that marks a copy running from inside the Claude Code plugin cache.
_PLUGIN_CACHE_REL = ".claude/plugins/cache"
# Environment variable a forwarded process carries so it never forwards a second time.
_FORWARDED_ENV = "LAZYCORTEX_CORE_FORWARDED"
# Value the forwarding copy sets the forwarded marker to.
_FORWARDED_ON = "1"
# Plugin name the install registry records this CLI under.
_PLUGIN_NAME = "lazycortex-core"
# Directory under a plugin root that holds its executables.
_BIN_DIRNAME = "bin"
# File name of this CLI inside a plugin's bin directory.
_CLI_FILENAME = "lazycortex-core"
# Program name every subcommand's argparse `prog` starts with.
_PROG = "lazycortex-core"
# Text encoding of every subprocess pipe and runtime file this CLI reads or writes.
_ENCODING = "utf-8"

# Top-level usage text printed when no subcommand, or an unknown one, is given.
USAGE = ("usage: lazycortex-core <subcommand> [args...]\n"
         "Subcommands: expert-pump-once, doctor-tick, runtime-tick, runtime, resume, memory-reflect-all, "
         "dispatch-job, collect-job, consume-job, retire-jobs, cancel-job, lookup-expert, scaffold, file-sync, "
         "remote-mirror, safe-pull, error-record, error-list, settings-get, settings-set, resolve-language, "
         "routine-ensure-filter, permission-allow, add-protocols, detect-scope, daemon-pause, daemon-resume, "
         "daemon-list, metrics-alloc-port, metrics-scrape-file, sandbox-sync, sandbox-audit, index-guard, "
         "history-append, reconcile-routine, plugin-root, resolve-ref, external-dirs, inbox-check, "
         "protocol-audit, provider-validate, provider-token, routine-validate, routine-register, "
         "routine-unregister, routine-show, routine-migrate, install-phase, daemon-run-here, git-lock, recover, "
         "list-jobs, routines-bootstrap, memory-reflect, plugin-dirs, agent-models-seed, permission-edit, "
         "guard-public-write, guard-public-files, mcp-config-drop, context-scan, gitignore-ensure, runtime-gc, "
         "migrate-plan, migrate-stamp, migrate-release, settings-rungs")



# ----------------------------------------------------------------------------------------
class _Verb:
  """
  Subcommand names this CLI implements itself, as spelled on the command line.

  Attributes:
    EXPERT_PUMP_ONCE: Run one expert-pump pass and print its counters.
    DOCTOR_TICK: Run one doctor tick and print its result.
    RUNTIME_TICK: Run daemon iterations by hand.
    RUNTIME: Run the runtime daemon in the foreground.
    RESUME: Clear the daemon's halt block.
    MEMORY_REFLECT_ALL: Dispatch a reflect job for every persona-marked expert.
    DISPATCH_JOB: Queue an expert job.
    COLLECT_JOB: Read an expert job's status.
    CONSUME_JOB: Retire an expert job.
    RETIRE_JOBS: Retire an expert's finished jobs under one dedup key.
    CANCEL_JOB: Abort an expert job.
    LOOKUP_EXPERT: Look up an expert's settings entry.
    ERROR_RECORD: Record or resolve an error-ledger event.
    ERROR_LIST: List error-ledger incidents.
    DETECT_SCOPE: Print a plugin's install scope.
    PLUGIN_ROOT: Print a plugin's source root.
    MIGRATE_PLAN: Print a repository's migration plan, or check one migration step file.
    MIGRATE_STAMP: Record the version a plugin's migrations are complete for.
    MIGRATE_RELEASE: Set the release version on a plugin's unreleased migration steps.
    SETTINGS_RUNGS: List the settings-ladder rungs a plugin gained since a git revision.
    DAEMON_PAUSE: Create the daemon pause semaphore.
    DAEMON_RESUME: Remove the daemon pause semaphore.
    DAEMON_LIST: List the runtime daemons installed on this host.
    METRICS_ALLOC_PORT: Allocate a metrics port for a repo.
    METRICS_SCRAPE_FILE: Write the Prometheus scrape-targets file.
    SANDBOX_SYNC: Record a repo's expert-spawn sandbox scope.
    SANDBOX_AUDIT: Report what the recorded sandbox scope fails to grant.
    HISTORY_APPEND: Append one bullet to a note's history section.
    RECONCILE_ROUTINE: Register or refresh one routine registration.
    RUNTIME_GC: Sweep the runtime garbage and print the summary.
  """

  # Run one expert-pump pass and print its counters.
  EXPERT_PUMP_ONCE = "expert-pump-once"
  # Run one doctor tick and print its result.
  DOCTOR_TICK = "doctor-tick"
  # Run daemon iterations by hand.
  RUNTIME_TICK = "runtime-tick"
  # Run the runtime daemon in the foreground.
  RUNTIME = "runtime"
  # Clear the daemon's halt block.
  RESUME = "resume"
  # Dispatch a reflect job for every persona-marked expert.
  MEMORY_REFLECT_ALL = "memory-reflect-all"
  # Queue an expert job.
  DISPATCH_JOB = "dispatch-job"
  # Read an expert job's status.
  COLLECT_JOB = "collect-job"
  # Retire an expert job.
  CONSUME_JOB = "consume-job"
  # Retire an expert's finished jobs under one dedup key.
  RETIRE_JOBS = "retire-jobs"
  # Abort an expert job.
  CANCEL_JOB = "cancel-job"
  # Look up an expert's settings entry.
  LOOKUP_EXPERT = "lookup-expert"
  # Record or resolve an error-ledger event.
  ERROR_RECORD = "error-record"
  # List error-ledger incidents.
  ERROR_LIST = "error-list"
  # Print a plugin's install scope.
  DETECT_SCOPE = "detect-scope"
  # Print a plugin's source root.
  PLUGIN_ROOT = "plugin-root"
  # Print a repository's migration plan, or check one migration step file.
  MIGRATE_PLAN = "migrate-plan"
  # Record the version a plugin's migrations are complete for.
  MIGRATE_STAMP = "migrate-stamp"
  # Set the release version on a plugin's unreleased migration steps.
  MIGRATE_RELEASE = "migrate-release"
  # List the settings-ladder rungs a plugin gained since a git revision.
  SETTINGS_RUNGS = "settings-rungs"
  # Create the daemon pause semaphore.
  DAEMON_PAUSE = "daemon-pause"
  # Remove the daemon pause semaphore.
  DAEMON_RESUME = "daemon-resume"
  # List the runtime daemons installed on this host.
  DAEMON_LIST = "daemon-list"
  # Allocate a metrics port for a repo.
  METRICS_ALLOC_PORT = "metrics-alloc-port"
  # Write the Prometheus scrape-targets file.
  METRICS_SCRAPE_FILE = "metrics-scrape-file"
  # Record a repo's expert-spawn sandbox scope.
  SANDBOX_SYNC = "sandbox-sync"
  # Report what the recorded sandbox scope fails to grant.
  SANDBOX_AUDIT = "sandbox-audit"
  # Append one bullet to a note's history section.
  HISTORY_APPEND = "history-append"
  # Register or refresh one routine registration.
  RECONCILE_ROUTINE = "reconcile-routine"
  # Sweep the runtime garbage and print the summary.
  RUNTIME_GC = "runtime-gc"


