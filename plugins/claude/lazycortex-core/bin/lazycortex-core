class _RepoPath:
  """
  Repository-relative paths and file suffixes the subcommands read or write.

  Attributes:
    SETTINGS: The repo's lazycortex settings file.
    RUN_LOGS: Root of the per-artifact run logs.
    MEMORY: Root of the per-expert memory notes.
    MD_SUFFIX: Suffix of a run log or memory note.
    RUNTIME: Directory of the daemon's per-machine runtime files.
    RATE_LIMIT_DEFERRED: Marker file remembering which rate-limit window expert-pump-once last announced.
  """

  # The repo's lazycortex settings file.
  SETTINGS = ".claude/lazy.settings.json"
  # Root of the per-artifact run logs.
  RUN_LOGS = ".logs/claude"
  # Root of the per-expert memory notes.
  MEMORY = ".memory"
  # Suffix of a run log or memory note.
  MD_SUFFIX = ".md"
  # Directory of the daemon's per-machine runtime files.
  RUNTIME = ".runtime"
  # Marker file remembering which rate-limit window expert-pump-once last announced.
  RATE_LIMIT_DEFERRED = "rate-limit-deferred.json"


# ----------------------------------------------------------------------------------------
class _Probe:
  """
  Command words of the git and supervisor probes, plus the answers they are read against.

  Attributes:
    ENV_REPO_ROOT: Environment variable naming the repository root.
    ENV_GIT_OPTIONAL_LOCKS: git environment variable that turns optional locks off.
    GIT_OPTIONAL_LOCKS_OFF: Value that turns git's optional locks off.
    GIT: git executable.
    GIT_REV_PARSE: git sub-verb resolving refs and paths.
    GIT_SHOW_TOPLEVEL: rev-parse flag printing the checkout's top-level directory.
    DARWIN: `sys.platform` value of macOS.
    LAUNCHCTL: macOS supervisor executable.
    LAUNCHCTL_LIST: launchctl sub-verb describing one unit.
    LAUNCHD_LABEL: launchd unit label of this checkout's runtime daemon.
    LAUNCHD_PID: Key a launchd listing carries only while the unit runs a process.
    SYSTEMCTL: Linux supervisor executable.
    SYSTEMCTL_USER: systemctl flag addressing the user instance.
    SYSTEMCTL_IS_ACTIVE: systemctl sub-verb printing one unit's state.
    SYSTEMD_UNIT: systemd unit name of this checkout's runtime daemon.
    SYSTEMD_ACTIVE: State systemctl prints for a running unit.
    SECONDS_PER_DAY: Seconds in one day, for the reflect log window.
    POLLING_DEFAULT_SEC: Daemon polling interval runtime-tick falls back to, in seconds.
  """

  # Environment variable naming the repository root.
  ENV_REPO_ROOT = "LAZY_REPO_ROOT"
  # git environment variable that turns optional locks off.
  ENV_GIT_OPTIONAL_LOCKS = "GIT_OPTIONAL_LOCKS"
  # Value that turns git's optional locks off.
  GIT_OPTIONAL_LOCKS_OFF = "0"
  # git executable.
  GIT = "git"
  # git sub-verb resolving refs and paths.
  GIT_REV_PARSE = "rev-parse"
  # rev-parse flag printing the checkout's top-level directory.
  GIT_SHOW_TOPLEVEL = "--show-toplevel"
  # `sys.platform` value of macOS.
  DARWIN = "darwin"
  # macOS supervisor executable.
  LAUNCHCTL = "launchctl"
  # launchctl sub-verb describing one unit.
  LAUNCHCTL_LIST = "list"
  # launchd unit label of this checkout's runtime daemon.
  LAUNCHD_LABEL = "com.lazycortex.runtime.{}"
  # Key a launchd listing carries only while the unit runs a process.
  LAUNCHD_PID = '"PID"'
  # Linux supervisor executable.
  SYSTEMCTL = "systemctl"
  # systemctl flag addressing the user instance.
  SYSTEMCTL_USER = "--user"
  # systemctl sub-verb printing one unit's state.
  SYSTEMCTL_IS_ACTIVE = "is-active"
  # systemd unit name of this checkout's runtime daemon.
  SYSTEMD_UNIT = "lazy-core-runtime-{}.service"
  # State systemctl prints for a running unit.
  SYSTEMD_ACTIVE = "active"
  # Seconds in one day, for the reflect log window.
  SECONDS_PER_DAY = 86400
  # Daemon polling interval runtime-tick falls back to, in seconds.
  POLLING_DEFAULT_SEC = 5


# ----------------------------------------------------------------------------------------
class _Msg:
  """
  Diagnostic and reply texts the subcommands print.

  Attributes:
    REQUEST_PARSE: A job request that is not JSON.
    REQUEST_MISSING: A job request without an expert or a job id.
    CONSUME_FAILED: consume-job's call into the runtime raised.
    RETIRE_REQUEST_MISSING: A retire request without an expert or a dedup key.
    RETIRE_FAILED: retire-jobs' call into the runtime raised.
    CANCEL_FAILED: cancel-job's call into the runtime raised.
    COLLECT_FAILED: collect-job's call into the runtime raised.
    BUNDLE_PARSE: A dispatch bundle that is not JSON.
    BUNDLE_MISSING: A dispatch bundle without a field the runtime requires.
    DISPATCH_FAILED: dispatch-job's call into the runtime raised.
    REPO_ROOT_UNSET: lookup-expert run without the repository root in the environment.
    STDIN_NOT_JSON: lookup-expert's stdin is not JSON.
    STDIN_MISSING_NAME: lookup-expert's stdin carries no expert name.
    EMPTY_JSON: Empty JSON object lookup-expert reads an empty stdin as.
    CAUSE_REQUIRED: error-record asked to open an event without a cause.
    CFG_PARSE: reconcile-routine's --cfg-json is not JSON.
    CFG_NOT_OBJECT: reconcile-routine's --cfg-json is not an object.
    NOT_HALTED: resume found no halt block.
    TICK_BAD_ARGS: runtime-tick got a flag it does not know or a second routine name.
    TICK_DAEMON_ALIVE: runtime-tick found the daemon running on this checkout.
    TICK_UNKNOWN_ROUTINE: runtime-tick was named a routine the registry does not hold.
    TICK_NO_ROUTINES: Placeholder for an empty routine registry.
    TICK_NOT_DISPATCHED: runtime-tick's named routine never dispatched.
    UNKNOWN_SUBCOMMAND: The subcommand is not one this CLI knows.
    LIST_SEP: Separator of the registered-routine list in the unknown-routine refusal.
  """

  # A job request that is not JSON.
  REQUEST_PARSE = "request parse: {}"
  # A job request without an expert or a job id.
  REQUEST_MISSING = "request missing 'expert' or 'job_id'"
  # consume-job's call into the runtime raised.
  CONSUME_FAILED = "consume failed: {}"
  # A retire request without an expert or a dedup key.
  RETIRE_REQUEST_MISSING = "request missing 'expert' or 'dedup_key'"
  # retire-jobs' call into the runtime raised.
  RETIRE_FAILED = "retire failed: {}"
  # cancel-job's call into the runtime raised.
  CANCEL_FAILED = "cancel failed: {}"
  # collect-job's call into the runtime raised.
  COLLECT_FAILED = "collect failed: {}"
  # A dispatch bundle that is not JSON.
  BUNDLE_PARSE = "bundle parse: {}"
  # A dispatch bundle without a field the runtime requires.
  BUNDLE_MISSING = "missing required bundle field: {}"
  # dispatch-job's call into the runtime raised.
  DISPATCH_FAILED = "dispatch failed: {}"
  # lookup-expert run without the repository root in the environment.
  REPO_ROOT_UNSET = "LAZY_REPO_ROOT not set"
  # lookup-expert's stdin is not JSON.
  STDIN_NOT_JSON = "stdin not JSON: {}"
  # lookup-expert's stdin carries no expert name.
  STDIN_MISSING_NAME = 'stdin missing "name"'
  # Empty JSON object lookup-expert reads an empty stdin as.
  EMPTY_JSON = "{}"
  # error-record asked to open an event without a cause.
  CAUSE_REQUIRED = "error-record: --cause is required when opening an event"
  # reconcile-routine's --cfg-json is not JSON.
  CFG_PARSE = "cfg-json parse: {}"
  # reconcile-routine's --cfg-json is not an object.
  CFG_NOT_OBJECT = "cfg-json must be a JSON object"
  # resume found no halt block.
  NOT_HALTED = "daemon not halted"
  # runtime-tick got a flag it does not know or a second routine name.
  TICK_BAD_ARGS = ("refused: unrecognised arguments {!r}; "
                   "usage: runtime-tick [<routine-name>] [--drain]")
  # runtime-tick found the daemon running on this checkout.
  TICK_DAEMON_ALIVE = ("refused: the runtime daemon is running on this checkout — a concurrent manual "
                       "tick would race it over the tree, index, and job queue. Stop the unit first.")
  # runtime-tick was named a routine the registry does not hold.
  TICK_UNKNOWN_ROUTINE = "refused: unknown routine {!r}; registered: {}"
  # Placeholder for an empty routine registry.
  TICK_NO_ROUTINES = "(none)"
  # runtime-tick's named routine never dispatched.
  TICK_NOT_DISPATCHED = ("refused: routine {!r} did not dispatch — the runtime is stuck "
                         "(dirty tree or halt); see /lazy-runtime.recover")
  # The subcommand is not one this CLI knows.
  UNKNOWN_SUBCOMMAND = "unknown subcommand: {}\n{}"
  # Separator of the registered-routine list in the unknown-routine refusal.
  LIST_SEP = ", "


