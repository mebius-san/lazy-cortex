# ----------------------------------------------------------------------------------------
def _env_repo_root() -> Path:
  """
  Return the repository root the environment names, else the process working directory.

  Returns:
    The repository root.
  """
  return Path(os.environ.get(_Probe.ENV_REPO_ROOT, os.getcwd()))


def _query_git_toplevel() -> str:
  """
  Return the top-level directory of the checkout the process runs in.

  Returns:
    The checkout's top-level directory, or an empty string outside a checkout.
  """
  return subprocess.run([ _Probe.GIT, _Probe.GIT_REV_PARSE, _Probe.GIT_SHOW_TOPLEVEL ],
                        capture_output = True, text = True, check = False, encoding = _ENCODING).stdout.strip()


def _print_error(message: str) -> int:
  """
  Report a failure as an error JSON on stdout.

  Every job verb reports a failure this way.

  Args:
    message: Human-readable failure text.

  Returns:
    The process exit code 1.
  """
  print(json.dumps({ _Field.ERROR: message }))
  return 1


def _find_newer_cached_cli() -> Path | None:
  """
  Return the registry-installed CLI when this cache-resident copy is not the one it names.

  Returns:
    The installed version's CLI path, or `None` when this copy is the live one or nothing newer is installed.
  """
  # the directory this copy runs from
  here = Path(__file__).resolve().parent

  # guard: only a copy running from the plugin cache can be stale; a source-tree copy is the live one
  if _PLUGIN_CACHE_REL not in here.as_posix():
    return None

  # the install the registry names for this plugin
  # waiver: lazy sibling import -- the registry reader is needed only on the cache-resident path, before forwarding
  from lazy_setup import installed_plugin_root
  installed = installed_plugin_root(_PLUGIN_NAME)

  # guard: no install record, or the record names this very copy — nothing newer to forward to
  if installed is None or installed.resolve() == here.parent:
    return None

  # the installed version's CLI, when that install still carries one
  cli = installed / _BIN_DIRNAME / _CLI_FILENAME
  return cli if cli.is_file() else None


def _forward_if_stale() -> None:
  """
  Re-exec into the registry-installed version, once.
  """
  # guard: a forwarded process dispatches itself, so a registry mismatch can never loop
  if os.environ.get(_FORWARDED_ENV):
    return

  # guard: nothing newer is installed, so this copy dispatches itself
  if (newer := _find_newer_cached_cli()) is None:
    return

  # hand the whole invocation to the installed version, marked so it does not forward again
  os.environ[_FORWARDED_ENV] = _FORWARDED_ON
  os.execv(sys.executable, [ sys.executable, str(newer), *sys.argv[1:] ])


def _read_job_request() -> tuple[str, str] | None:
  """
  Read the `{expert, job_id}` address of a job from a JSON request on stdin.

  A malformed or incomplete request is reported as an error JSON on stdout before returning.

  Returns:
    The expert name and job id, or `None` when the request is not JSON or lacks either half of the address.
  """
  # guard: a request that is not JSON names no job
  try:
    req = json.load(sys.stdin)
  except json.JSONDecodeError as error:
    _print_error(_Msg.REQUEST_PARSE.format(error))
    return None

  # the job is addressed by its expert and its id
  expert = req.get(_Field.EXPERT)
  job_id = req.get(_Field.JOB_ID)

  # guard: both halves of the address are required
  if not expert or not job_id:
    _print_error(_Msg.REQUEST_MISSING)
    return None

  # the addressed job
  return expert, job_id


def _cmd_consume_job() -> int:
  """
  Retire an expert job on behalf of a sibling plugin.

  Reads `{expert, job_id}` JSON from stdin and prints `{"status": "ok"}` on success. This is the contract sibling
  plugins use to retire a job after they have applied or explicitly discarded its response.

  Guarantees:
    - Idempotent: re-consuming an already-consumed job, or one whose job directory is gone, is a no-op that still
      reports success.

  Returns:
    Process exit code: 0 on success, 1 with an error JSON on stdout on a malformed request or a runtime failure.
  """
  # waiver: lazy sibling import -- one broken subcommand module must not take the whole CLI down
  from expert_runtime import consume_job

  # Contract:
  # Consuming a job that is already consumed, or whose job directory no longer exists, is a no-op
  # that still reports success, so a sibling plugin may retry the call safely.

  # guard: a malformed request was already reported
  if (request := _read_job_request()) is None:
    return 1

  # retire the job; any runtime failure is reported, never raised at the caller
  # noinspection PyBroadException
  try:
    consume_job(_env_repo_root(), *request)
  except Exception as error:
    return _print_error(_Msg.CONSUME_FAILED.format(error))
  print(json.dumps({ _Field.STATUS: _Token.OK }))
  return 0


def _cmd_retire_jobs() -> int:
  """
  Retire every finished job of one expert that carries a given dedup key.

  Reads `{expert, dedup_key}` JSON from stdin and prints `{"retired": [<job_id>, ...]}` on success. This is the
  contract a sibling plugin that never consumes its own jobs uses before it re-dispatches under the same key, so a
  finished earlier attempt stops answering `already-queued`.

  Guarantees:
    - Only finished jobs (`DONE`, whatever their outcome) are retired; a queued or running job under the same key is
      never touched, so a live job is never duplicated.
    - Idempotent: a second call finds nothing left to retire and prints an empty list.

  Returns:
    Process exit code: 0 on success, 1 with an error JSON on stdout on a malformed request or a runtime failure.
  """
  # waiver: lazy sibling import -- one broken subcommand module must not take the whole CLI down
  from expert_runtime import retire_completed_jobs

  # Contract:
  # Only finished jobs (`DONE`, whatever their outcome) of the named expert whose dedup key matches are
  # marked consumed; a queued or running job is NEVER touched, so retiring before a re-dispatch can never
  # duplicate a live job. A repeated call retires nothing and still succeeds.

  # guard: a request that is not JSON names no key
  try:
    req = json.load(sys.stdin)
  except json.JSONDecodeError as error:
    return _print_error(_Msg.REQUEST_PARSE.format(error))

  # the jobs are addressed by their expert and their dedup key
  expert = req.get(_Field.EXPERT) if isinstance(req, dict) else None
  dedup_key = req.get(_Field.DEDUP_KEY) if isinstance(req, dict) else None

  # guard: both halves of the address are required
  if not expert or not dedup_key:
    return _print_error(_Msg.RETIRE_REQUEST_MISSING)

  # retire the finished jobs; any runtime failure is reported, never raised at the caller
  # noinspection PyBroadException
  try:
    retired = retire_completed_jobs(_env_repo_root(), expert, dedup_key)
  except Exception as error:
    return _print_error(_Msg.RETIRE_FAILED.format(error))
  print(json.dumps({ _Field.RETIRED: retired }))
  return 0


def _cmd_cancel_job() -> int:
  """
  Cancel an expert job on behalf of a sibling plugin.

  Reads `{expert, job_id}` JSON from stdin and prints `{"cancelled": true|false, "job_id": ...}` to stdout. This is
  the contract sibling plugins use to abort a running expert job headlessly, e.g. the specs apply worker
  cancelling an asset's running job before it deletes the documents an attach line's `drop=` names.

  Guarantees:
    - Sequentially idempotent: a job that is already terminal (done, failed, deferred, dead, cancelled) or whose
      bundle is absent reports `cancelled: false` with exit code 0 and its bundle is left untouched, so a later
      cancel call never clobbers a finished bundle's terminal marker. A job that finishes while a cancel is in
      flight may still end up cancelled.

  Returns:
    Process exit code: 0 with the cancellation report, 1 with an error JSON on stdout on a malformed request or a
    runtime failure.
  """
  # waiver: lazy sibling import -- one broken subcommand module must not take the whole CLI down
  from constants import JobStatus
  # waiver: lazy sibling import -- one broken subcommand module must not take the whole CLI down
  from expert_runtime import cancel_job, job_dir, read_job_status

  # guard: a malformed request was already reported
  if (request := _read_job_request()) is None:
    return 1

  # the job's repository and address
  repo = _env_repo_root()
  expert, job_id = request

  # Contract:
  # A job that is already terminal (done, failed, deferred, dead or cancelled), or whose bundle is absent,
  # reports `cancelled: false` with exit code 0 and its bundle is left untouched, so a later cancel call
  # never clobbers a finished bundle's terminal marker. The promise holds for sequential calls only; a job
  # that finishes while a cancel is in flight may still end up cancelled.

  # limit: check-then-act, a job finishing before cancel_job still gets CANCELLED; move the re-check into cancel_job
  terminal = { JobStatus.DONE, JobStatus.FAILED, JobStatus.DEFERRED, JobStatus.DEAD, JobStatus.CANCELLED }
  jdir = job_dir(repo, expert, job_id)
  # guard: a terminal or absent bundle is already done — don't re-mark it
  if not (jdir.exists() and read_job_status(jdir) not in terminal):
    print(json.dumps({ _Field.CANCELLED: False, _Field.JOB_ID: job_id }))
    return 0

  # cancel the job; any runtime failure is reported, never raised at the caller
  # noinspection PyBroadException
  try:
    cancel_job(repo, expert, job_id)
  except Exception as error:
    return _print_error(_Msg.CANCEL_FAILED.format(error))
  print(json.dumps({ _Field.CANCELLED: True, _Field.JOB_ID: job_id }))
  return 0


def _cmd_collect_job() -> int:
  """
  Report the status of a queued expert job to a sibling plugin.

  Reads `{expert, job_id}` JSON from stdin and prints the status object
  `{"status": "missing|dead|cancelled|pending|done|deferred|failed", "response": {...}}` to stdout; `response` is
  present only when `status` is `done`, `deferred` or `failed`. This is the read-side companion to `dispatch-job`
  and the contract sibling plugins use to inspect a job they queued earlier.

  Returns:
    Process exit code: 0 on success, 1 with an error JSON on stdout on a malformed request or a runtime failure.
  """
  # waiver: lazy sibling import -- one broken subcommand module must not take the whole CLI down
  from expert_runtime import collect_job

  # guard: a malformed request was already reported
  if (request := _read_job_request()) is None:
    return 1

  # read the job's status; any runtime failure is reported, never raised at the caller
  # noinspection PyBroadException
  try:
    out = collect_job(_env_repo_root(), *request)
  except Exception as error:
    return _print_error(_Msg.COLLECT_FAILED.format(error))
  print(json.dumps(out))
  return 0


def _cmd_dispatch_job() -> int:
  """
  Queue an expert job for a sibling plugin from a JSON job bundle.

  Reads the bundle from stdin as
  `{ "expert": "<name>", "payload": {...}, "protocols": [...], "source": [repo-relative path, ...],
  "context": [repo-relative path, ...], "source_inline": {filename: text}, "context_inline": {filename: text},
  "result": [filename, ...], "job_id": "...", "dedup_key": "..." }`.
  `source` and `context` name working-tree paths that the pump copies into the job's buckets when it claims the job;
  `source_inline` and `context_inline` carry text that no file holds and are written at dispatch.

  Prints `{"job_id": "...", "queue_path": "..."}` on a fresh dispatch and
  `{"job_id": "...", "status": "already-queued"}` on a dedup hit. This is the contract sibling plugins MUST use to
  queue jobs.

  Returns:
    Process exit code: 0 on success, 1 with an error JSON on stdout on a bundle parse or dispatch error.
  """
  # waiver: lazy sibling import -- one broken subcommand module must not take the whole CLI down
  from expert_runtime import dispatch_job

  # guard: a bundle that is not JSON describes no job
  try:
    bundle = json.load(sys.stdin)
  except json.JSONDecodeError as error:
    return _print_error(_Msg.BUNDLE_PARSE.format(error))

  # queue the job; a missing field or any runtime failure is reported, never raised at the caller
  # noinspection PyBroadException
  try:
    out = dispatch_job(
      _env_repo_root(),
      bundle.get(_Field.EXPERT) or "",
      bundle.get(_Field.PAYLOAD) or {},
      protocols = bundle.get(_Field.PROTOCOLS),
      source = bundle.get(_Field.SOURCE),
      context = bundle.get(_Field.CONTEXT),
      source_inline = bundle.get(_Field.SOURCE_INLINE),
      context_inline = bundle.get(_Field.CONTEXT_INLINE),
      result = bundle.get(_Field.RESULT),
      job_id = bundle.get(_Field.JOB_ID),
      dedup_key = bundle.get(_Field.DEDUP_KEY),
    )
  except KeyError as error:
    return _print_error(_Msg.BUNDLE_MISSING.format(error))
  except Exception as error:
    return _print_error(_Msg.DISPATCH_FAILED.format(error))
  print(json.dumps(out))
  return 0


def _cmd_lookup_expert() -> int:
  """
  Look up an expert's settings entry by name.

  Reads `{"name": "..."}` from stdin and prints `{"found": true, "entry": {...}}` or `{"found": false}` to stdout.

  Returns:
    Process exit code: 0 whether or not the expert was found, 2 when the repository root is not in the environment
    or the request is not JSON or names no expert.
  """
  # guard: the lookup reads the repo's own settings, so the root must be named
  if not (repo := os.environ.get(_Probe.ENV_REPO_ROOT)):
    print(_Msg.REPO_ROOT_UNSET, file = sys.stderr)
    return 2

  # guard: a request that is not JSON names no expert
  try:
    body = json.loads(sys.stdin.read() or _Msg.EMPTY_JSON)
  except json.JSONDecodeError as error:
    print(_Msg.STDIN_NOT_JSON.format(error), file = sys.stderr)
    return 2

  # guard: there is nothing to look up without a name
  if not (name := body.get(_Field.NAME)):
    print(_Msg.STDIN_MISSING_NAME, file = sys.stderr)
    return 2

  # report the resolved entry, or that there is none
  # waiver: lazy sibling import -- one broken subcommand module must not take the whole CLI down
  from expert_runtime import resolve_expert_entry
  if entry := resolve_expert_entry(Path(repo), name):
    print(json.dumps({ _Field.FOUND: True, _Field.ENTRY: entry }))
  else:
    print(json.dumps({ _Field.FOUND: False }))
  return 0


def _collect_reflect_sources(repo: Path, name: str, cutoff: float) -> list[dict[str, str]]:
  """
  Collect the source manifest of a reflect job for one expert.

  Args:
    repo: Repository root.
    name: Expert name.
    cutoff: Earliest modification time, in seconds since the epoch, a run log must have to be included.

  Returns:
    The recent run logs, then the current memory notes, of the expert, each as a path and a description.
  """
  # recent run logs: the runs the reflect job consolidates
  sources = []
  log_root = repo / _RepoPath.RUN_LOGS / name
  if log_root.is_dir():
    for path in sorted(log_root.iterdir()):
      if path.is_file() and path.suffix == _RepoPath.MD_SUFFIX and path.stat().st_mtime >= cutoff:
        sources.append({ _Field.PATH: str(path), _Field.DESCRIPTION: _Token.RECENT_RUN_LOG })

  # current memory notes: what the consolidation updates
  mem_root = repo / _RepoPath.MEMORY / name
  if mem_root.is_dir():
    for path in sorted(mem_root.iterdir()):
      if path.is_file() and path.suffix == _RepoPath.MD_SUFFIX:
        sources.append({ _Field.PATH: str(path), _Field.DESCRIPTION: _Token.CURRENT_MEMORY_NOTE })
  return sources


def _cmd_memory_reflect_all(argv: list[str]) -> int:
  """
  Dispatch a reflect job for every persona-marked expert.

  Prints the counters of dispatched, skipped, would-dispatch, and failed experts as JSON.

  Args:
    argv: Argument tail: `--dry-run` lists the targets without dispatching, `--days N` sets the run-log window.

  Returns:
    Process exit code 0.
  """
  # parse the flags
  parser = argparse.ArgumentParser(prog = f"{_PROG} {_Verb.MEMORY_REFLECT_ALL}")
  parser.add_argument(_Arg.DRY_RUN, action = _Arg.STORE_TRUE)
  parser.add_argument(_Arg.DAYS, type = int, default = _Arg.DAYS_DEFAULT)
  args = parser.parse_args(argv)

  # load the expert registry
  # waiver: lazy sibling import -- one broken subcommand module must not take the whole CLI down
  from lazy_settings import load_section
  # waiver: lazy sibling import -- one broken subcommand module must not take the whole CLI down
  from expert_runtime import dispatch_job
  repo = _env_repo_root()
  experts = load_section(repo / _RepoPath.SETTINGS, _Field.SETTINGS_EXPERTS)

  # dispatch one reflect job per persona-marked expert, counting every skip and failure
  dispatched = 0
  skipped_not_persona = 0
  would_dispatch = 0
  errors: list[dict[str, str]] = []
  for name, entry in experts.items():
    # guard: skip the settings version key and any entry that is not an expert mapping
    if name == _Field.SETTINGS_VERSION or not isinstance(entry, dict):
      continue

    # an expert without the persona aspect keeps no memory to reflect on, so it is counted and passed over
    if _Token.PERSONA_ASPECT not in (entry.get(_Field.ASPECTS) or []):
      skipped_not_persona += 1
      continue

    # a dry run only counts the experts a real run would dispatch to
    if args.dry_run:
      would_dispatch += 1
      continue

    # the reflect job carries the expert's sources from the requested look-back window
    payload = {
      _Field.KIND: _Token.REFLECT,
      _Field.ROLE: _Token.REFLECT,
      _Field.REQUEST: _Token.REFLECT_REQUEST,
      _Field.SOURCE: _collect_reflect_sources(repo, name, time.time() - args.days * _Probe.SECONDS_PER_DAY),
    }

    # one expert's failed dispatch is recorded and the loop moves on to the next expert
    # noinspection PyBroadException
    try:
      dispatch_job(repo, name, payload)
      dispatched += 1
    except Exception as error:
      errors.append({ _Field.EXPERT: name, _Field.ERROR: str(error) })

  # report the counters
  print(json.dumps({ _Field.DISPATCHED: dispatched, _Field.SKIPPED_NOT_PERSONA: skipped_not_persona,
                     _Field.WOULD_DISPATCH: would_dispatch, _Field.ERRORS: errors }))
  return 0


def _cmd_error_record(argv: list[str]) -> int:
  """
  Record one error event, or resolve an incident, from command-line flags.

  Other plugins call this over the published CLI to register an error the runtime did not capture as a job or
  routine failure. Opening an event prints `{"recorded": true, "id": "<ulid>"}` so the caller can correlate;
  `--cause` is required when opening, so a plugin cannot drop a causeless event into the ledger.

  Notes:
    - Best-effort: the underlying ledger write never raises.

  Args:
    argv: Argument tail with the incident key and the event flags.

  Returns:
    Process exit code: 0 on success, 2 when opening an event without `--cause`.
  """
  # waiver: lazy sibling import -- one broken subcommand module must not take the whole CLI down
  import error_ledger

  # parse the flags
  parser = argparse.ArgumentParser(prog = f"{_PROG} {_Verb.ERROR_RECORD}")
  parser.add_argument(_Arg.INCIDENT, required = True)
  parser.add_argument(_Arg.KIND, default = _Arg.KIND_DEFAULT)
  parser.add_argument(_Arg.CAUSE)
  parser.add_argument(_Arg.SEVERITY, default = _Arg.SEVERITY_DEFAULT, choices = _Arg.SEVERITY_CHOICES)
  parser.add_argument(_Arg.DETAIL, default = "")
  parser.add_argument(_Arg.EXPERT)
  parser.add_argument(_Arg.JOB_ID)
  parser.add_argument(_Arg.ROUTINE)
  parser.add_argument(_Arg.RESOLVE, action = _Arg.STORE_TRUE)
  parser.add_argument(_Arg.RESOLUTION, default = _Arg.RESOLUTION_DEFAULT)
  args = parser.parse_args(argv)
  repo = Path.cwd()

  # --resolve closes an incident instead of opening one; cause is meaningless for the close path
  if args.resolve:
    event_id = error_ledger.new_id()
    error_ledger.resolve(repo, args.incident, resolution = args.resolution, id = event_id)
  else:
    # guard: opening an event without a cause violates the closed-set contract — refuse the call
    if not args.cause:
      print(_Msg.CAUSE_REQUIRED, file = sys.stderr)
      return 2
    event_id = error_ledger.new_id()
    error_ledger.record(repo, {
      _Field.ID: event_id,
      _Field.INCIDENT: args.incident, _Field.PHASE: _Token.PHASE_OPENED, _Field.KIND: args.kind,
      _Field.CAUSE: args.cause, _Field.SEVERITY: args.severity, _Field.DETAIL: args.detail,
      _Field.ACTOR: _Token.ACTOR_PLUGIN_CLI,
      _Field.EXPERT: args.expert, _Field.JOB_ID: args.job_id, _Field.ROUTINE: args.routine,
    })

  # report the event id so the caller can correlate
  print(json.dumps({ _Field.RECORDED: True, _Field.ID: event_id }))
  return 0


def _cmd_history_append(argv: list[str]) -> int:
  """
  Append one bullet to a note's `# History` day-group section.

  File mode rewrites the note in place; `--stdin` transforms a JSON-carried text and touches no file.

  Args:
    argv: Argument tail of the history-append subcommand.

  Returns:
    Process exit code: 0 on success; 2 with a one-line stderr message on a missing file, an empty or multi-line
    line, a bad date, or malformed stdin JSON.
  """
  # waiver: lazy sibling import -- one broken subcommand module must not take the whole CLI down
  from history import main as history_main
  return history_main(argv)


def _cmd_reconcile_routine(argv: list[str]) -> int:
  """
  Register a routine, or bring an already registered one back to the shipped shape.

  The boundary-legal way for a sibling plugin's installer to keep its own routine registrations current in a
  consumer repo: every key named by `--managed` is set to the shipped value, every other shipped key is filled in
  only when the entry never carried it, and everything else the entry carries is left exactly as the operator wrote
  it.

  Args:
    argv: Argument tail: the routine name, `--cfg-json` with the shipped config object, `--managed` with a
      comma-separated owned-key list (empty owns nothing), an optional `--cwd` repository root, and `--dry-run` to
      report the status the call would return and write nothing.

  Returns:
    Process exit code: 0 with `{"status": "registered|refreshed|unchanged"}` on stdout, 1 with
    `{"status": "error", "reason": ...}` on malformed cfg JSON or a config the routine schema rejects, 2 on
    argument error.
  """
  # parse the flags
  parser = argparse.ArgumentParser(prog = f"{_PROG} {_Verb.RECONCILE_ROUTINE}")
  parser.add_argument(_Arg.NAME)
  parser.add_argument(_Arg.CFG_JSON, required = True, help = _Arg.CFG_JSON_HELP)
  parser.add_argument(_Arg.MANAGED, default = "", help = _Arg.MANAGED_HELP)
  parser.add_argument(_Arg.CWD, default = None, help = _Arg.REPO_ROOT_HELP)
  parser.add_argument(_Arg.DRY_RUN, action = _Arg.STORE_TRUE, help = _Arg.RECONCILE_DRY_RUN_HELP)
  args = parser.parse_args(argv)

  # guard: a shipped config that is not JSON cannot be reconciled
  try:
    cfg = json.loads(args.cfg_json)
  except json.JSONDecodeError as error:
    print(json.dumps({ _Field.STATUS: _Token.STATUS_ERROR, _Field.REASON: _Msg.CFG_PARSE.format(error) }))
    return 1

  # guard: a scalar or array is not a routine config body
  if not isinstance(cfg, dict):
    print(json.dumps({ _Field.STATUS: _Token.STATUS_ERROR, _Field.REASON: _Msg.CFG_NOT_OBJECT }))
    return 1

  # resolve the repository root: the explicit --cwd, else the root the settings path resolves under
  # waiver: lazy sibling import -- one broken subcommand module must not take the whole CLI down
  from settings_cli import resolve_settings_path
  repo = Path(args.cwd) if args.cwd is not None else resolve_settings_path(None).parent.parent

  # reconcile the registration; a config the routine schema rejects is reported, never raised
  # waiver: lazy sibling import -- one broken subcommand module must not take the whole CLI down
  from expert_runtime import reconcile_routine
  # waiver: lazy sibling import -- one broken subcommand module must not take the whole CLI down
  from routine_types import RoutineConfigError
  managed = [ key for key in args.managed.split(_Arg.MANAGED_SEP) if key ]
  try:
    status = reconcile_routine(repo, args.name, cfg, managed, dry_run = args.dry_run)
  except RoutineConfigError as error:
    print(json.dumps({ _Field.STATUS: _Token.STATUS_ERROR, _Field.REASON: str(error) }))
    return 1
  print(json.dumps({ _Field.STATUS: status }))
  return 0


def _is_daemon_alive(repo: Path) -> bool:
  """
  Report whether this checkout's supervisor unit is currently running a daemon process.

  Args:
    repo: Repository root whose runtime unit is probed.

  Returns:
    `True` when the unit is running, `False` when it is not or the host has no supervisor.
  """
  # macOS: a launchd listing carries a PID only while the unit runs a process
  if sys.platform == _Probe.DARWIN:
    # guard: a host without launchctl has no supervisor that could be running the unit
    if shutil.which(_Probe.LAUNCHCTL) is None:
      return False
    probe = subprocess.run([ _Probe.LAUNCHCTL, _Probe.LAUNCHCTL_LIST, _Probe.LAUNCHD_LABEL.format(repo.name) ],
                           capture_output = True, text = True, check = False, encoding = _ENCODING)
    return probe.returncode == 0 and _Probe.LAUNCHD_PID in probe.stdout

  # guard: same reasoning for a non-systemd host
  if shutil.which(_Probe.SYSTEMCTL) is None:
    return False

  # Linux: the systemd user unit reports `active` only while it runs
  probe = subprocess.run(
    [ _Probe.SYSTEMCTL, _Probe.SYSTEMCTL_USER, _Probe.SYSTEMCTL_IS_ACTIVE, _Probe.SYSTEMD_UNIT.format(repo.name) ],
    capture_output = True, text = True, check = False, encoding = _ENCODING,
  )
  return probe.returncode == 0 and probe.stdout.strip() == _Probe.SYSTEMD_ACTIVE


def _cmd_runtime_tick(repo: Path, argv: list[str]) -> int:
  """
  Run daemon iterations by hand and print a JSON summary of the run.

  Each pass is a full daemon iteration with the push deferred. An optional routine name forces that routine due for
  a single pass; `--drain` keeps iterating until the queue empties or a stop signal fires.

  Args:
    repo: Repository root.
    argv: Argument tail: an optional routine name and the `--drain` flag.

  Returns:
    Process exit code: 0 on success, 2 on a refusal (unrecognised arguments, a running daemon, an unknown routine,
    or a named routine that never dispatched).
  """
  # waiver: lazy sibling import -- one broken subcommand module must not take the whole CLI down
  from runtime_daemon import (
    check_working_tree, run_iteration, compute_sleep, due_routines, time_until_next_due,
  )
  # waiver: lazy sibling import -- one broken subcommand module must not take the whole CLI down
  from lazy_settings import load_section
  # waiver: lazy sibling import -- one broken subcommand module must not take the whole CLI down
  from constants import (
    DaemonKey, JobMarker, RepoDir, SettingsFile, SettingsKey, StateKey,
  )
  # waiver: lazy sibling import -- one broken subcommand module must not take the whole CLI down
  import rate_limit_flag
  # waiver: lazy sibling import -- one broken subcommand module must not take the whole CLI down
  import runtime_state

  # split the arguments into the drain flag, unknown flags, and routine names
  drain = _Arg.DRAIN in argv
  unknown_flags = [ arg for arg in argv if arg.startswith(_Arg.FLAG_PREFIX) and arg != _Arg.DRAIN ]
  names = [ arg for arg in argv if not arg.startswith(_Arg.FLAG_PREFIX) ]

  # guard: the command's contract is refuse-rather-than-surprise: a typo'd flag or a second
  # positional must not be silently dropped
  if unknown_flags or len(names) > 1:
    print(_Msg.TICK_BAD_ARGS.format(unknown_flags + names[1:]), file = sys.stderr)
    return 2

  # the one routine the operator named, if any
  routine = names[0] if names else None

  # guard: a live daemon and a manual tick would race over the tree, the index, and the job queue
  if _is_daemon_alive(repo):
    print(_Msg.TICK_DAEMON_ALIVE, file = sys.stderr)
    return 2

  # the routine registry, without its version key
  registry = load_section(repo / SettingsFile.REL, SettingsKey.ROUTINES)
  registry.pop(SettingsKey.VERSION, None)

  # guard: a named routine must be one the registry holds
  if routine is not None and routine not in registry:
    print(_Msg.TICK_UNKNOWN_ROUTINE.format(routine, _Msg.LIST_SEP.join(sorted(registry)) or _Msg.TICK_NO_ROUTINES),
          file = sys.stderr)
    return 2

  def count_ready_jobs() -> int:
    # count the job bundles still READY and not yet finished, dead, or cancelled
    jobs_root = repo / RepoDir.EXPERTS / RepoDir.JOBS
    # guard: no jobs tree yet — nothing is queued
    if not jobs_root.is_dir():
      return 0
    count = 0
    for edir in jobs_root.iterdir():
      # guard: skip stray files beside the per-expert directories
      if not edir.is_dir():
        continue
      for jdir in edir.iterdir():
        # guard: skip stray files beside the job bundles
        if not jdir.is_dir():
          continue
        if (jdir / JobMarker.READY).exists() and not any(
          (jdir / marker).exists() for marker in (JobMarker.DONE, JobMarker.DEAD, JobMarker.CANCELLED)
        ):
          count += 1
    return count

  def load_last_run() -> dict:
    # a copy of the per-routine last-run ledger, so later reads compare against a frozen value
    return dict(runtime_state.load(repo).get(StateKey.LAST_RUN, {}))

  # the polling interval the daemon would sleep at least
  polling = load_section(repo / SettingsFile.REL, SettingsKey.DAEMON).get(
    DaemonKey.POLLING_INTERVAL_SEC, _Probe.POLLING_DEFAULT_SEC)

  # Every pass is one REAL daemon iteration — dispatch, journal, ledger, commit all included;
  # the READY queue drains through the registered pump routine like it would under the daemon.
  # The loop stops on the same signals the daemon would stop dispatching on (halt, dirty tree,
  # rate-limit flag), on empty queues, or on a pass that made no progress — never on a count.
  ticks = 0
  stopped = None
  while True:
    # snapshot the ledger and the queue, then run one real iteration with the push deferred
    before = (load_last_run(), count_ready_jobs())
    run_iteration(repo, push = False, only = routine, force_due = routine is not None)
    ticks += 1

    # a halt the iteration wrote stops the run exactly as it stops the daemon
    if runtime_state.load(repo).get(StateKey.DAEMON_HALTED):
      stopped = _Token.STOP_HALTED
      break

    # a named routine and a plain tick are single-pass; only `--drain` keeps going
    if routine is not None or not drain:
      break

    # the iteration dispatched nothing on a dirty tree and wrote no halt — looping
    # would spin forever on the same state
    if check_working_tree(repo) is not None:
      stopped = _Token.STOP_DIRTY_TREE
      break

    # a raised rate-limit flag blocks every dispatch the next pass would make
    if rate_limit_flag.is_raised():
      stopped = _Token.STOP_RATE_LIMITED
      break

    # the drain is complete once no routine is due and the queue is empty
    last_run = load_last_run()
    if not due_routines(time.time(), registry, last_run, system_stuck = False) and count_ready_jobs() == 0:
      break

    # nothing advanced and nothing drained — whatever is left cannot be drained by
    # looping; stop instead of spinning
    if (last_run, count_ready_jobs()) == before:
      stopped = _Token.STOP_NO_PROGRESS
      break

    # wait for the next due routine exactly as the daemon would
    time.sleep(compute_sleep(time_until_next_due(time.time(), registry, last_run), polling))

  # named mode: whether the one routine the operator named actually dispatched; None for a plain tick
  dispatched = None
  if routine is not None:
    dispatched = load_last_run().get(routine) != before[0].get(routine)

  # the run summary is printed whatever the outcome
  print(json.dumps({ _Field.TICKS: ticks, _Field.ROUTINE: routine, _Field.DISPATCHED: dispatched,
                     _Field.READY_LEFT: count_ready_jobs(), _Field.STOPPED: stopped,
                     _Field.HALTED: bool(runtime_state.load(repo).get(StateKey.DAEMON_HALTED)) }))

  # a named routine that never dispatched (stuck-system filter, say) must not look like success
  if routine is not None and not dispatched:
    print(_Msg.TICK_NOT_DISPATCHED.format(routine), file = sys.stderr)
    return 2

  # the run did what was asked
  return 0


def _cmd_resume(argv: list[str]) -> int:
  """
  Clear the daemon's halt block so the runtime resumes work.

  Halt reasons are handled individually: `uncommitted_changes` requires a clean working tree, while every other
  reason clears unconditionally. If the underlying cause still holds, the daemon re-halts on its next iteration, so
  clearing is always safe and never destructive.

  Guarantees:
    - Idempotent: if the daemon is not halted, nothing changes and the verb exits 0 with `resumed: false`.

  Args:
    argv: Argument tail: an optional repository positional.

  Returns:
    Process exit code: 0 on a clear or a no-op, 1 when the halt cannot be cleared (still-dirty tree).
  """
  # waiver: lazy sibling import -- one broken subcommand module must not take the whole CLI down
  import recover

  # resolve the repository: the positional, else the environment, else the cwd
  parser = argparse.ArgumentParser(prog = f"{_PROG} {_Verb.RESUME}")
  parser.add_argument(_Arg.REPO, nargs = _Arg.OPTIONAL, default = None, help = _Arg.REPO_ROOT_HELP)
  args = parser.parse_args(argv)
  repo_path = Path(args.repo) if args.repo else _env_repo_root()

  # Contract:
  # Resuming a daemon that is not halted changes nothing and exits 0 with `resumed: false`,
  # so the verb may be called repeatedly without checking the halt first.

  # guard: daemon is not halted — idempotent no-op
  if (halt_before := recover.read_halt(repo_path)) is None:
    print(json.dumps({ _Field.RESUMED: False, _Field.HALT: None, _Field.NOTE: _Msg.NOT_HALTED }))
    return 0

  # clear the halt; a refusal (still-dirty tree) is reported on stderr with exit 1
  try:
    recover.resume(repo_path)
  except recover.RecoverError as error:
    print(json.dumps({ _Field.RESUMED: False, _Field.HALT: halt_before, _Field.ERROR: str(error) }),
          file = sys.stderr)
    return 1
  print(json.dumps({ _Field.RESUMED: True, _Field.HALT: halt_before }))
  return 0


def _cmd_error_list(argv: list[str]) -> int:
  """
  Print error-ledger incidents as JSON, optionally filtered by state, kind, and since-cursor.

  Args:
    argv: Argument tail with the `--state`, `--kind`, and `--since` filters.

  Returns:
    Process exit code 0.
  """
  # waiver: lazy sibling import -- one broken subcommand module must not take the whole CLI down
  import error_ledger

  # parse the filters
  parser = argparse.ArgumentParser(prog = f"{_PROG} {_Verb.ERROR_LIST}")
  parser.add_argument(_Arg.STATE, default = _Arg.STATE_DEFAULT, choices = _Arg.STATE_CHOICES)
  parser.add_argument(_Arg.KIND, default = None)
  parser.add_argument(_Arg.SINCE, default = None, help = _Arg.SINCE_HELP)
  args = parser.parse_args(argv)

  # read the incidents, narrowed to one kind when asked
  rows = error_ledger.read_incidents(Path.cwd(), state = args.state, since = args.since)
  if args.kind:
    rows = [ row for row in rows if row.get(_Field.KIND) == args.kind ]
  print(json.dumps(rows, ensure_ascii = False))
  return 0


def _cmd_detect_scope(argv: list[str]) -> int:
  """
  Print the install scope (`project`, `user`, or `not-installed`) for a plugin key.

  Resolves the scope from where the plugin is actually enabled (`enabledPlugins` in the project, then the user,
  `settings.json` and `settings.local.json`), falling back to the install record's own scope only when neither
  settings file enables it. The project root defaults to the git toplevel of the cwd, so a call from any
  subdirectory resolves the same scope. This is the boundary-legal path for sibling install skills to detect their
  own scope without importing lazycortex-core Python.

  Args:
    argv: Argument tail: the plugin key and an optional `--cwd` project root.

  Returns:
    Process exit code 0.
  """
  # waiver: lazy sibling import -- one broken subcommand module must not take the whole CLI down
  from lazy_install_phases import detect_install_scope

  # parse the plugin key and the optional root
  parser = argparse.ArgumentParser(prog = f"{_PROG} {_Verb.DETECT_SCOPE}")
  parser.add_argument(_Arg.PLUGIN_KEY, help = _Arg.PLUGIN_KEY_HELP)
  parser.add_argument(_Arg.CWD, default = None, help = _Arg.DETECT_CWD_HELP)
  args = parser.parse_args(argv)

  # an explicit root is used as given, the git probe is for the cwd-driven default only
  if args.cwd is not None:
    print(detect_install_scope(args.plugin_key, project_root = args.cwd))
    return 0

  # default root: the cwd's git toplevel, else the cwd itself
  print(detect_install_scope(args.plugin_key, project_root = _query_git_toplevel() or os.getcwd()))
  return 0


def _cmd_plugin_root(argv: list[str]) -> int:
  """
  Print the directory a plugin's sources are read from.

  The directory is the daemon's `LAZYCORTEX_PLUGIN_DIRS` entry, else the dev-vault sibling plugin tree, else the
  authoring repo's `plugins/claude/<plugin>/` when this checkout ships the plugin, else the install that
  `installed_plugins.json` records. This is the single implementation every install, audit, and seed skill
  points at instead of reading `installed_plugins.json` itself.

  Args:
    argv: Argument tail: the plugin and an optional `--cwd` checkout root.

  Returns:
    Process exit code: 0 with one path on stdout, 1 with an `error:` line on stderr when nothing resolves.
  """
  # waiver: lazy sibling import -- one broken subcommand module must not take the whole CLI down
  from lazy_setup import plugin_root, format_plugin_root_miss

  # parse the plugin and the optional checkout root
  parser = argparse.ArgumentParser(prog = f"{_PROG} {_Verb.PLUGIN_ROOT}")
  parser.add_argument(_Arg.PLUGIN, help = _Arg.PLUGIN_HELP)
  parser.add_argument(_Arg.CWD, default = None, help = _Arg.PLUGIN_ROOT_CWD_HELP)
  args = parser.parse_args(argv)

  # the checkout root: the explicit --cwd, else the cwd's git toplevel, else the cwd itself
  root = Path(args.cwd) if args.cwd is not None else Path(_query_git_toplevel() or os.getcwd())

  # guard: no stage resolves this plugin; the error line names every stage searched
  if (report := plugin_root(args.plugin, root, Path.home())) is None:
    print(format_plugin_root_miss(args.plugin, root, Path.home()), file = sys.stderr)
    return 1

  # the resolved source root
  print(report[_Field.ROOT])
  return 0


def _cmd_daemon_pause(argv: list[str]) -> int:
  """
  Create the local pause semaphore so the daemon skips work until resumed.

  Creates `.runtime/daemon.pause` under the repo root (git toplevel of the cwd, or the cwd itself outside a
  checkout) and prints `{"paused": true, "semaphore": "<path>"}`. Purely local: no settings edit, no commit; the
  daemon keeps serving metrics and reports itself paused.

  Guarantees:
    - Idempotent: pausing an already-paused daemon succeeds and leaves the existing semaphore in place.

  Args:
    argv: Argument tail; the verb takes no arguments.

  Returns:
    Process exit code 0.
  """
  # waiver: lazy sibling import -- one broken subcommand module must not take the whole CLI down
  from constants import RuntimeFile

  # the verb takes no arguments; argparse still answers --help and refuses extras
  argparse.ArgumentParser(prog = f"{_PROG} {_Verb.DAEMON_PAUSE}").parse_args(argv)

  # Contract:
  # Pausing a daemon that is already paused succeeds and leaves the existing semaphore in place.

  # touch the semaphore under the checkout root
  semaphore = Path(_query_git_toplevel() or os.getcwd()) / RuntimeFile.PAUSE
  semaphore.parent.mkdir(parents = True, exist_ok = True)
  semaphore.touch(exist_ok = True)
  print(json.dumps({ _Field.PAUSED: True, _Field.SEMAPHORE: str(semaphore) }))
  return 0


def _cmd_daemon_resume(argv: list[str]) -> int:
  """
  Remove the local pause semaphore so the daemon resumes on its next wakeup.

  Deletes `.runtime/daemon.pause` under the repo root and prints `{"paused": false, "semaphore": "<path>"}`.

  Guarantees:
    - Idempotent: resuming a daemon that is not paused is a no-op that still reports success.

  Args:
    argv: Argument tail; the verb takes no arguments.

  Returns:
    Process exit code 0.
  """
  # waiver: lazy sibling import -- one broken subcommand module must not take the whole CLI down
  from constants import RuntimeFile

  # the verb takes no arguments; argparse still answers --help and refuses extras
  argparse.ArgumentParser(prog = f"{_PROG} {_Verb.DAEMON_RESUME}").parse_args(argv)

  # Contract:
  # Resuming a daemon that is not paused is a no-op that still reports success.

  # remove the semaphore under the checkout root
  semaphore = Path(_query_git_toplevel() or os.getcwd()) / RuntimeFile.PAUSE
  semaphore.unlink(missing_ok = True)
  print(json.dumps({ _Field.PAUSED: False, _Field.SEMAPHORE: str(semaphore) }))
  return 0


def _cmd_daemon_list(argv: list[str]) -> int:
  """
  Print every lazycortex runtime daemon installed on this host as JSON.

  Each daemon carries its repo's `daemon.metrics` settings, printed as
  `{"daemons": [{"repo_id", "repo_root", "repo_label", "metrics_enabled", "bind", "port"}, ...]}`. This is the
  boundary-legal path for sibling plugins (lazycortex-observe) to learn the host's scrape-target set without
  importing lazycortex-core Python.

  Args:
    argv: Argument tail; only the call-site-clarity `--json` flag is accepted.

  Returns:
    Process exit code 0.
  """
  # waiver: lazy sibling import -- one broken subcommand module must not take the whole CLI down
  from daemon_registry import enumerate_local_daemons

  # --json is accepted for call-site clarity only; the output is JSON either way
  parser = argparse.ArgumentParser(prog = f"{_PROG} {_Verb.DAEMON_LIST}")
  parser.add_argument(_Arg.JSON, action = _Arg.STORE_TRUE, default = True, help = _Arg.JSON_HELP)
  parser.parse_args(argv)

  # list the installed daemons
  print(json.dumps({ _Field.DAEMONS: enumerate_local_daemons() }, ensure_ascii = False))
  return 0


def _cmd_metrics_alloc_port(argv: list[str]) -> int:
  """
  Allocate a metrics port for a repo and print `{"port": N, "reused": bool}`.

  Allocation is sequential from 9464: the repo's already-recorded port is reused verbatim; otherwise the first port
  that is neither recorded by another local daemon nor currently blocked is returned.

  Args:
    argv: Argument tail with the required `--repo-root`.

  Returns:
    Process exit code: 0 on success, 1 with an `error` JSON when the whole range is exhausted.
  """
  # waiver: lazy sibling import -- one broken subcommand module must not take the whole CLI down
  from port_alloc import allocate_port

  # parse the repo root
  parser = argparse.ArgumentParser(prog = f"{_PROG} {_Verb.METRICS_ALLOC_PORT}")
  parser.add_argument(_Arg.REPO_ROOT, required = True, help = _Arg.ALLOC_REPO_ROOT_HELP)
  args = parser.parse_args(argv)

  # allocate the port; an exhausted range is reported as error JSON with exit 1
  try:
    print(json.dumps(allocate_port(Path(args.repo_root))))
  except RuntimeError as error:
    return _print_error(str(error))
  return 0


def _cmd_metrics_scrape_file(argv: list[str]) -> int:
  """
  Write the Prometheus file_sd scrape-targets file and print `{"path", "count", "targets"}`.

  Covers every metrics-enabled daemon on this host, one file_sd entry per daemon
  (`{"targets": ["127.0.0.1:<port>"], "labels": {"repo": "<label>"}}`). The file is server-blind: no repo paths,
  hostnames, or credentials. The default location is `${XDG_CONFIG_HOME:-~/.config}/lazycortex/scrape-targets.json`.

  Args:
    argv: Argument tail with the optional `--out` path override.

  Returns:
    Process exit code 0.
  """
  # waiver: lazy sibling import -- one broken subcommand module must not take the whole CLI down
  from daemon_registry import write_scrape_targets_file

  # parse the optional output path
  parser = argparse.ArgumentParser(prog = f"{_PROG} {_Verb.METRICS_SCRAPE_FILE}")
  parser.add_argument(_Arg.OUT, default = None, help = _Arg.OUT_HELP)
  args = parser.parse_args(argv)

  # write the file at the override, else at its default location
  print(json.dumps(write_scrape_targets_file(Path(args.out) if args.out else None), ensure_ascii = False))
  return 0


def _cmd_sandbox_sync(argv: list[str]) -> int:
  """
  Record the expert-spawn sandbox scope for a repo and print the sync result.

  The repo root is always granted read and write. Every entry (recorded, passed, or the root itself) also
  contributes the location it resolves to through symlinks, plus the targets of the symlinks directly inside it:
  macOS checks the resolved path, so an unresolved entry grants nothing where the data lives. The `sandbox` section
  of the repo's `lazy.settings.json` (Claude Code's own `sandbox` shape, `network.allowedDomains` above all) becomes
  the file's `sandbox` block; only `enabled`, `allowUnsandboxedCommands` and the two path allowlists survive
  undeclared, and declared path entries fold into the recorded lists.

  Prints `{"path", "present", "enabled", "added_read", "added_write", "removed_read", "removed_write", "changed"}`.
  `removed_read` and `removed_write` name any recorded grant for a plugin-cache version no longer on disk, pruned
  from that allowlist.

  Args:
    argv: Argument tail: the required `--repo-root` and repeatable `--allow-read` and `--allow-write` grants.

  Returns:
    Process exit code 0.
  """
  # waiver: lazy sibling import -- one broken subcommand module must not take the whole CLI down
  from sandbox_scope import sync

  # parse the repo root and the extra grants
  parser = argparse.ArgumentParser(prog = f"{_PROG} {_Verb.SANDBOX_SYNC}")
  parser.add_argument(_Arg.REPO_ROOT, required = True, help = _Arg.SYNC_REPO_ROOT_HELP)
  parser.add_argument(_Arg.ALLOW_READ, action = _Arg.APPEND, default = [], help = _Arg.ALLOW_READ_HELP)
  parser.add_argument(_Arg.ALLOW_WRITE, action = _Arg.APPEND, default = [], help = _Arg.ALLOW_WRITE_HELP)
  args = parser.parse_args(argv)

  # record the scope and report what changed
  print(json.dumps(sync(Path(args.repo_root), read = args.allow_read, write = args.allow_write),
                   ensure_ascii = False))
  return 0


def _cmd_sandbox_audit(argv: list[str]) -> int:
  """
  Report which resolved locations the recorded sandbox scope fails to grant.

  Read-only companion to `sandbox-sync`: prints
  `{"path", "present", "enabled", "allow_unsandboxed", "missing_read", "missing_write", "drift"}`. A non-empty
  `missing_write` means confined spawns will fail every write through that symlink with `Operation not permitted`;
  `drift` lists the dotted keys on which the settings' `sandbox` section and the file disagree.

  Args:
    argv: Argument tail with the required `--repo-root`.

  Returns:
    Process exit code 0 either way; the verdict travels in the JSON.
  """
  # waiver: lazy sibling import -- one broken subcommand module must not take the whole CLI down
  from sandbox_scope import audit

  # parse the repo root
  parser = argparse.ArgumentParser(prog = f"{_PROG} {_Verb.SANDBOX_AUDIT}")
  parser.add_argument(_Arg.REPO_ROOT, required = True, help = _Arg.AUDIT_REPO_ROOT_HELP)
  args = parser.parse_args(argv)

  # audit the scope
  print(json.dumps(audit(Path(args.repo_root)), ensure_ascii = False))
  return 0


def _cmd_expert_pump_once(repo: Path) -> int:
  """
  Run one expert-pump pass and print its counter line.

  The line reports the experts visited and jobs processed. A rate-limit deferral is announced on the
  line only the first time per rate-limit window, so repeated idle ticks stay quiet.

  Args:
    repo: Repository root.

  Returns:
    Process exit code 0.
  """
  # waiver: lazy sibling import -- one broken subcommand module must not take the whole CLI down
  from expert_pump import pump

  # one pump pass and its counter line
  result = pump(repo)
  line = _Token.PUMP_LINE.format(result[_Field.PUMP_EXPERTS], result[_Field.PUMP_PROCESSED])

  # A deferral is otherwise invisible: the tick looks idle, and on a checkout with no halt
  # of its own nothing else would ever say the queue is waiting on a rate-limit window.
  # Only the FIRST deferral of a window (and a window change) carries the marker — repeats
  # are elided by the daemon's quiet-tick filter, else a 5s-polling checkout would write
  # one journal line per tick for the whole window. The gitignored marker file remembers
  # which resets_at was last announced; a non-deferred tick clears it.
  marker = repo / _RepoPath.RUNTIME / _RepoPath.RATE_LIMIT_DEFERRED
  if result.get(_Field.PUMP_DEFERRED):
    # read which window was last announced; a missing or unreadable marker counts as none announced,
    # so the worst outcome is one repeated announcement, never a lost one
    resets = result.get(_Field.RESETS_AT)
    announced = None
    try:
      announced = json.loads(marker.read_text(encoding = _ENCODING)).get(_Field.RESETS_AT)
    except (OSError, ValueError):
      pass

    # a new window is announced and remembered; a failed write only means the next tick announces it again
    if announced != resets:
      line += _Token.PUMP_DEFERRED_LINE.format(resets)
      try:
        marker.parent.mkdir(parents = True, exist_ok = True)
        marker.write_text(json.dumps({ _Field.RESETS_AT: resets }), encoding = _ENCODING)
      except OSError:
        pass
  else:
    # a non-deferred tick forgets the announced window; an absent marker is the usual case and a failed
    # delete costs at most one skipped announcement, so neither may fail the pump pass
    try:
      marker.unlink()
    except OSError:
      pass

  # the counter line, with the deferral fragment when this tick announced one
  print(line)
  return 0


def _cmd_runtime_gc(argv: list[str]) -> int:
  """
  Sweep the repository's runtime garbage and print the summary as JSON.

  Args:
    argv: Argument tail with the optional `--dry-run`.

  Returns:
    Process exit code 1 when any deletion failed or any journal record was lost, else 0.
  """
  # waiver: lazy sibling import -- one broken subcommand module must not take the whole CLI down
  from runtime_gc import sweep

  # parse the report-only flag
  parser = argparse.ArgumentParser(prog = f"{_PROG} {_Verb.RUNTIME_GC}")
  parser.add_argument(_Arg.DRY_RUN, action = _Arg.STORE_TRUE, help = _Arg.RUNTIME_GC_DRY_RUN_HELP)
  args = parser.parse_args(argv)

  # one sweep, its summary, and a failing exit when any deletion failed or any journal record was lost
  summary = sweep(_env_repo_root(), dry_run = args.dry_run)
  print(json.dumps(summary, ensure_ascii = False))
  return 1 if summary[_Field.ERRORS] else 0


