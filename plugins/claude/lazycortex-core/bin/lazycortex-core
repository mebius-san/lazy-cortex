class _Arg:
  """
  Argparse flags, positional names, actions, choices, defaults, and help strings of the subcommands.

  Attributes:
    STORE_TRUE: Boolean-flag action.
    APPEND: Repeatable-flag action.
    OPTIONAL: Optional single positional.
    DRY_RUN: Report-only flag of memory-reflect-all, reconcile-routine, and runtime-gc.
    DAYS: Log-window flag of memory-reflect-all.
    DAYS_DEFAULT: Default log window of memory-reflect-all, in days.
    INCIDENT: Incident-key flag of error-record.
    KIND: Event-kind flag of error-record and error-list.
    KIND_DEFAULT: Default event kind of error-record.
    CAUSE: Cause flag of error-record.
    SEVERITY: Severity flag of error-record.
    SEVERITY_DEFAULT: Default severity of error-record.
    SEVERITY_CHOICES: Severities error-record accepts.
    DETAIL: Detail flag of error-record.
    EXPERT: Expert flag of error-record.
    JOB_ID: Job-id flag of error-record.
    ROUTINE: Routine flag of error-record.
    RESOLVE: Close-the-incident flag of error-record.
    RESOLUTION: Resolution flag of error-record.
    RESOLUTION_DEFAULT: Default resolution of error-record.
    NAME: Routine-name positional of reconcile-routine.
    CFG_JSON: Shipped-config flag of reconcile-routine.
    CFG_JSON_HELP: Help of --cfg-json.
    MANAGED: Owned-keys flag of reconcile-routine.
    MANAGED_HELP: Help of --managed.
    CWD: Root-override flag of reconcile-routine, detect-scope, and plugin-root.
    REPO_ROOT_HELP: Help of a repository-root override that falls back to the environment, then the cwd.
    RECONCILE_DRY_RUN_HELP: Help of reconcile-routine's --dry-run.
    RUNTIME_GC_DRY_RUN_HELP: Help of runtime-gc's --dry-run.
    REPO: Repository positional of resume.
    STATE: Incident-state flag of error-list.
    STATE_DEFAULT: Default incident state of error-list.
    STATE_CHOICES: Incident states error-list accepts.
    SINCE: Cursor flag of error-list.
    SINCE_HELP: Help of --since.
    PLUGIN_KEY: Plugin-key positional of detect-scope.
    PLUGIN_KEY_HELP: Help of the plugin-key positional.
    DETECT_CWD_HELP: Help of detect-scope's --cwd.
    PLUGIN: Plugin positional of plugin-root.
    PLUGIN_HELP: Help of the plugin positional.
    PLUGIN_ROOT_CWD_HELP: Help of plugin-root's --cwd.
    JSON: Call-site-clarity flag of daemon-list.
    JSON_HELP: Help of --json.
    REPO_ROOT: Repo-root flag of the metrics and sandbox subcommands.
    ALLOC_REPO_ROOT_HELP: Help of metrics-alloc-port's --repo-root.
    OUT: Output-path flag of metrics-scrape-file.
    OUT_HELP: Help of --out.
    SYNC_REPO_ROOT_HELP: Help of sandbox-sync's --repo-root.
    ALLOW_READ: Extra-readable-path flag of sandbox-sync.
    ALLOW_READ_HELP: Help of --allow-read.
    ALLOW_WRITE: Extra-writable-path flag of sandbox-sync.
    ALLOW_WRITE_HELP: Help of --allow-write.
    AUDIT_REPO_ROOT_HELP: Help of sandbox-audit's --repo-root.
    DRAIN: Drain flag of runtime-tick.
    FLAG_PREFIX: Prefix that marks a runtime-tick argument as a flag.
    MANAGED_SEP: Separator of reconcile-routine's --managed key list.
  """

  # Boolean-flag action.
  STORE_TRUE = "store_true"
  # Repeatable-flag action.
  APPEND = "append"
  # Optional single positional.
  OPTIONAL = "?"
  # Report-only flag of memory-reflect-all and reconcile-routine.
  DRY_RUN = "--dry-run"
  # Log-window flag of memory-reflect-all.
  DAYS = "--days"
  # Default log window of memory-reflect-all, in days.
  DAYS_DEFAULT = 30
  # Incident-key flag of error-record.
  INCIDENT = "--incident"
  # Event-kind flag of error-record and error-list.
  KIND = "--kind"
  # Default event kind of error-record.
  KIND_DEFAULT = "plugin_error"
  # Cause flag of error-record.
  CAUSE = "--cause"
  # Severity flag of error-record.
  SEVERITY = "--severity"
  # Default severity of error-record.
  SEVERITY_DEFAULT = "error"
  # Severities error-record accepts.
  SEVERITY_CHOICES = [ "error", "warn" ]
  # Detail flag of error-record.
  DETAIL = "--detail"
  # Expert flag of error-record.
  EXPERT = "--expert"
  # Job-id flag of error-record.
  JOB_ID = "--job-id"
  # Routine flag of error-record.
  ROUTINE = "--routine"
  # Close-the-incident flag of error-record.
  RESOLVE = "--resolve"
  # Resolution flag of error-record.
  RESOLUTION = "--resolution"
  # Default resolution of error-record.
  RESOLUTION_DEFAULT = "manual"
  # Routine-name positional of reconcile-routine.
  NAME = "name"
  # Shipped-config flag of reconcile-routine.
  CFG_JSON = "--cfg-json"
  # Help of --cfg-json.
  CFG_JSON_HELP = "JSON object: the shipped routine config"
  # Owned-keys flag of reconcile-routine.
  MANAGED = "--managed"
  # Help of --managed.
  MANAGED_HELP = "Comma-separated keys the caller's plugin owns"
  # Root-override flag of reconcile-routine, detect-scope, and plugin-root.
  CWD = "--cwd"
  # Help of a repository-root override that falls back to the environment, then the cwd.
  REPO_ROOT_HELP = "Repository root (default: $LAZY_REPO_ROOT or cwd)"
  # Help of reconcile-routine's --dry-run.
  RECONCILE_DRY_RUN_HELP = "Report the status the call would return; write nothing"
  # Help of runtime-gc's --dry-run.
  RUNTIME_GC_DRY_RUN_HELP = "List what the sweep would remove; delete and record nothing"
  # Repository positional of resume.
  REPO = "repo"
  # Incident-state flag of error-list.
  STATE = "--state"
  # Default incident state of error-list.
  STATE_DEFAULT = "all"
  # Incident states error-list accepts.
  STATE_CHOICES = [ "all", "open", "needs_operator", "closed" ]
  # Cursor flag of error-list.
  SINCE = "--since"
  # Help of --since.
  SINCE_HELP = "ULID cursor; only incidents whose latest event id is strictly greater are returned"
  # Plugin-key positional of detect-scope.
  PLUGIN_KEY = "plugin_key"
  # Help of the plugin-key positional.
  PLUGIN_KEY_HELP = "e.g. lazycortex-diagram@lazycortex"
  # Help of detect-scope's --cwd.
  DETECT_CWD_HELP = "Project root (default: the git toplevel of the cwd, else the cwd)"
  # Plugin positional of plugin-root.
  PLUGIN = "plugin"
  # Help of the plugin positional.
  PLUGIN_HELP = "e.g. lazycortex-experts or lazycortex-experts@lazycortex"
  # Help of plugin-root's --cwd.
  PLUGIN_ROOT_CWD_HELP = "Checkout root (default: the git toplevel of the cwd, else the cwd)"
  # Call-site-clarity flag of daemon-list.
  JSON = "--json"
  # Help of --json.
  JSON_HELP = "accepted for call-site clarity; output is always JSON"
  # Repo-root flag of the metrics and sandbox subcommands.
  REPO_ROOT = "--repo-root"
  # Help of metrics-alloc-port's --repo-root.
  ALLOC_REPO_ROOT_HELP = "absolute path of the repo the port is for"
  # Output-path flag of metrics-scrape-file.
  OUT = "--out"
  # Help of --out.
  OUT_HELP = "override the output path"
  # Help of sandbox-sync's --repo-root.
  SYNC_REPO_ROOT_HELP = "absolute path of the repo whose sandbox scope is recorded"
  # Extra-readable-path flag of sandbox-sync.
  ALLOW_READ = "--allow-read"
  # Help of --allow-read.
  ALLOW_READ_HELP = "extra readable path (repeatable)"
  # Extra-writable-path flag of sandbox-sync.
  ALLOW_WRITE = "--allow-write"
  # Help of --allow-write.
  ALLOW_WRITE_HELP = "extra writable path (repeatable)"
  # Help of sandbox-audit's --repo-root.
  AUDIT_REPO_ROOT_HELP = "absolute path of the repo whose sandbox scope is audited"
  # Drain flag of runtime-tick.
  DRAIN = "--drain"
  # Prefix that marks a runtime-tick argument as a flag.
  FLAG_PREFIX = "--"
  # Separator of reconcile-routine's --managed key list.
  MANAGED_SEP = ","


# ----------------------------------------------------------------------------------------
class _Field:
  """
  JSON keys of the stdin requests the subcommands read and the stdout replies they print.

  Attributes:
    ERROR: Error message of a failed call.
    STATUS: Outcome status of a call.
    EXPERT: Expert name of a job request.
    JOB_ID: Job identifier of a job request.
    CANCELLED: Whether cancel-job cancelled the job.
    PAYLOAD: Request payload of a dispatch bundle.
    PROTOCOLS: Protocol refs of a dispatch bundle.
    SOURCE: Source path manifest of a dispatch bundle.
    CONTEXT: Context path manifest of a dispatch bundle.
    SOURCE_INLINE: Inline source texts of a dispatch bundle.
    CONTEXT_INLINE: Inline context texts of a dispatch bundle.
    RESULT: Result file names of a dispatch bundle.
    DEDUP_KEY: Dedup key of a dispatch bundle.
    NAME: Expert name of a lookup-expert request.
    FOUND: Whether lookup-expert found the expert.
    ENTRY: Settings entry lookup-expert found.
    DISPATCHED: Experts memory-reflect-all dispatched a reflect job for.
    SKIPPED_NOT_PERSONA: Experts memory-reflect-all skipped as not persona-marked.
    WOULD_DISPATCH: Experts memory-reflect-all would dispatch on a dry run.
    ERRORS: Per-expert dispatch failures of memory-reflect-all, and failed deletions or lost records of runtime-gc.
    ASPECTS: Aspect list of an expert's settings entry.
    PATH: Path of a reflect-job source entry.
    DESCRIPTION: Description of a reflect-job source entry.
    KIND: Payload kind of a reflect job.
    ROLE: Payload role of a reflect job.
    REQUEST: Payload request text of a reflect job.
    RECORDED: Whether error-record recorded the event.
    ID: Event identifier error-record recorded.
    INCIDENT: Incident-folding key of an error-ledger event.
    PHASE: Lifecycle phase of an error-ledger event.
    CAUSE: Closed-set cause of an error-ledger event.
    SEVERITY: Severity of an error-ledger event.
    DETAIL: One-line description of an error-ledger event.
    ACTOR: Component that recorded an error-ledger event.
    REASON: Rejection reason of reconcile-routine.
    RETIRED: Job ids retire-jobs retired.
    RESUMED: Whether resume cleared a halt.
    HALT: Halt block resume found.
    NOTE: Explanatory note of a no-op resume.
    PAUSED: Whether the daemon pause semaphore is present after the call.
    SEMAPHORE: Path of the daemon pause semaphore.
    DAEMONS: Daemon list of daemon-list.
    ROOT: Source root plugin-root prints.
    TICKS: Number of iterations runtime-tick ran.
    ROUTINE: Routine runtime-tick was asked to run.
    READY_LEFT: READY jobs left after runtime-tick.
    STOPPED: Signal that stopped runtime-tick's drain loop.
    HALTED: Whether the daemon is halted after runtime-tick.
    PUMP_EXPERTS: Experts expert-pump-once visited.
    PUMP_PROCESSED: Jobs expert-pump-once processed.
    PUMP_DEFERRED: Whether expert-pump-once deferred on a rate limit.
    RESETS_AT: Reset time of the rate-limit window expert-pump-once deferred on.
    SETTINGS_VERSION: Version key of a settings section, never an entry.
    SETTINGS_EXPERTS: Settings section holding the expert registry.
  """

  # Error message of a failed call.
  ERROR = "error"
  # Outcome status of a call.
  STATUS = "status"
  # Expert name of a job request.
  EXPERT = "expert"
  # Job identifier of a job request.
  JOB_ID = "job_id"
  # Whether cancel-job cancelled the job.
  CANCELLED = "cancelled"
  # Request payload of a dispatch bundle.
  PAYLOAD = "payload"
  # Protocol refs of a dispatch bundle.
  PROTOCOLS = "protocols"
  # Source path manifest of a dispatch bundle.
  SOURCE = "source"
  # Context path manifest of a dispatch bundle.
  CONTEXT = "context"
  # Inline source texts of a dispatch bundle.
  SOURCE_INLINE = "source_inline"
  # Inline context texts of a dispatch bundle.
  CONTEXT_INLINE = "context_inline"
  # Result file names of a dispatch bundle.
  RESULT = "result"
  # Dedup key of a dispatch bundle.
  DEDUP_KEY = "dedup_key"
  # Expert name of a lookup-expert request.
  NAME = "name"
  # Whether lookup-expert found the expert.
  FOUND = "found"
  # Settings entry lookup-expert found.
  ENTRY = "entry"
  # Experts memory-reflect-all dispatched a reflect job for.
  DISPATCHED = "dispatched"
  # Experts memory-reflect-all skipped as not persona-marked.
  SKIPPED_NOT_PERSONA = "skipped_not_persona"
  # Experts memory-reflect-all would dispatch on a dry run.
  WOULD_DISPATCH = "would_dispatch"
  # Per-expert dispatch failures of memory-reflect-all, and failed deletions or lost records of runtime-gc.
  ERRORS = "errors"
  # Aspect list of an expert's settings entry.
  ASPECTS = "aspects"
  # Path of a reflect-job source entry.
  PATH = "path"
  # Description of a reflect-job source entry.
  DESCRIPTION = "description"
  # Payload kind of a reflect job.
  KIND = "kind"
  # Payload role of a reflect job.
  ROLE = "role"
  # Payload request text of a reflect job.
  REQUEST = "request"
  # Whether error-record recorded the event.
  RECORDED = "recorded"
  # Event identifier error-record recorded.
  ID = "id"
  # Incident-folding key of an error-ledger event.
  INCIDENT = "incident"
  # Lifecycle phase of an error-ledger event.
  PHASE = "phase"
  # Closed-set cause of an error-ledger event.
  CAUSE = "cause"
  # Severity of an error-ledger event.
  SEVERITY = "severity"
  # One-line description of an error-ledger event.
  DETAIL = "detail"
  # Component that recorded an error-ledger event.
  ACTOR = "actor"
  # Rejection reason of reconcile-routine.
  REASON = "reason"
  # Job ids retire-jobs retired.
  RETIRED = "retired"
  # Whether resume cleared a halt.
  RESUMED = "resumed"
  # Halt block resume found.
  HALT = "halt"
  # Explanatory note of a no-op resume.
  NOTE = "note"
  # Whether the daemon pause semaphore is present after the call.
  PAUSED = "paused"
  # Path of the daemon pause semaphore.
  SEMAPHORE = "semaphore"
  # Daemon list of daemon-list.
  DAEMONS = "daemons"
  # Source root plugin-root prints.
  ROOT = "root"
  # Number of iterations runtime-tick ran.
  TICKS = "ticks"
  # Routine runtime-tick was asked to run.
  ROUTINE = "routine"
  # READY jobs left after runtime-tick.
  READY_LEFT = "ready_left"
  # Signal that stopped runtime-tick's drain loop.
  STOPPED = "stopped"
  # Whether the daemon is halted after runtime-tick.
  HALTED = "halted"
  # Experts expert-pump-once visited.
  PUMP_EXPERTS = "experts"
  # Jobs expert-pump-once processed.
  PUMP_PROCESSED = "processed"
  # Whether expert-pump-once deferred on a rate limit.
  PUMP_DEFERRED = "deferred"
  # Reset time of the rate-limit window expert-pump-once deferred on.
  RESETS_AT = "resets_at"
  # Version key of a settings section, never an entry.
  SETTINGS_VERSION = "_version"
  # Settings section holding the expert registry.
  SETTINGS_EXPERTS = "experts"


# ----------------------------------------------------------------------------------------
class _Token:
  """
  JSON values and token strings the subcommands write or compare against.

  Attributes:
    OK: Status of a successful consume-job.
    PERSONA_ASPECT: Aspect ref that marks an expert as persona-carrying.
    REFLECT: Payload kind and role of a reflect job.
    REFLECT_REQUEST: Request text of a reflect job.
    RECENT_RUN_LOG: Source description of a recent run log.
    CURRENT_MEMORY_NOTE: Source description of a current memory note.
    PHASE_OPENED: Phase of a newly opened error-ledger event.
    ACTOR_PLUGIN_CLI: Actor error-record stamps on the events it records.
    STATUS_ERROR: Reconcile-routine status of a rejected call.
    STOP_HALTED: Drain-loop stop reason: the daemon is halted.
    STOP_DIRTY_TREE: Drain-loop stop reason: the working tree is dirty.
    STOP_RATE_LIMITED: Drain-loop stop reason: the rate-limit flag is raised.
    STOP_NO_PROGRESS: Drain-loop stop reason: a pass changed nothing.
    PUMP_DEFERRED_LINE: Line fragment expert-pump-once appends on the first deferral of a rate-limit window.
    PUMP_LINE: Counter line expert-pump-once prints.
  """

  # Status of a successful consume-job.
  OK = "ok"
  # Aspect ref that marks an expert as persona-carrying.
  PERSONA_ASPECT = "lazycortex-core:lazy-memory.persona-aspect"
  # Payload kind and role of a reflect job.
  REFLECT = "reflect"
  # Request text of a reflect job.
  REFLECT_REQUEST = (
    "Consolidate recent runs into memory per lazy-memory.persona-aspect "
    "§Obligations. Use /lazy-memory.write for any new or updated notes. "
    "Return outcome=empty if nothing is worth consolidating."
  )
  # Source description of a recent run log.
  RECENT_RUN_LOG = "recent run log"
  # Source description of a current memory note.
  CURRENT_MEMORY_NOTE = "current memory note"
  # Phase of a newly opened error-ledger event.
  PHASE_OPENED = "opened"
  # Actor error-record stamps on the events it records.
  ACTOR_PLUGIN_CLI = "plugin-cli"
  # Reconcile-routine status of a rejected call.
  STATUS_ERROR = "error"
  # Drain-loop stop reason: the daemon is halted.
  STOP_HALTED = "halted"
  # Drain-loop stop reason: the working tree is dirty.
  STOP_DIRTY_TREE = "dirty_tree"
  # Drain-loop stop reason: the rate-limit flag is raised.
  STOP_RATE_LIMITED = "rate_limited"
  # Drain-loop stop reason: a pass changed nothing.
  STOP_NO_PROGRESS = "no_progress"
  # Line fragment expert-pump-once appends on the first deferral of a rate-limit window.
  PUMP_DEFERRED_LINE = " deferred=rate_limit resets_at={}"
  # Counter line expert-pump-once prints.
  PUMP_LINE = "experts={} processed={}"


