def _cmd_runtime(repo: Path) -> int:
  """
  Run the runtime daemon in the foreground for the repository.

  Args:
    repo: Repository root.

  Returns:
    Process exit code 0 once the daemon exits.
  """
  # waiver: lazy sibling import -- one broken subcommand module must not take the whole CLI down
  from runtime_daemon import run
  run(repo)
  return 0


# Subcommands this CLI implements itself, each taking the argument tail after the verb.
_LOCAL = {
  _Verb.RESUME:              _cmd_resume,
  _Verb.MEMORY_REFLECT_ALL:  _cmd_memory_reflect_all,
  _Verb.ERROR_RECORD:        _cmd_error_record,
  _Verb.ERROR_LIST:          _cmd_error_list,
  _Verb.DETECT_SCOPE:        _cmd_detect_scope,
  _Verb.PLUGIN_ROOT:         _cmd_plugin_root,
  _Verb.DAEMON_PAUSE:        _cmd_daemon_pause,
  _Verb.DAEMON_RESUME:       _cmd_daemon_resume,
  _Verb.DAEMON_LIST:         _cmd_daemon_list,
  _Verb.METRICS_ALLOC_PORT:  _cmd_metrics_alloc_port,
  _Verb.METRICS_SCRAPE_FILE: _cmd_metrics_scrape_file,
  _Verb.SANDBOX_SYNC:        _cmd_sandbox_sync,
  _Verb.SANDBOX_AUDIT:       _cmd_sandbox_audit,
  _Verb.HISTORY_APPEND:      _cmd_history_append,
  _Verb.RECONCILE_ROUTINE:   _cmd_reconcile_routine,
  _Verb.RUNTIME_GC:          _cmd_runtime_gc,
}

# Subcommands that take no arguments and read their whole request as JSON from stdin.
_STDIN_VERBS = {
  _Verb.DISPATCH_JOB:  _cmd_dispatch_job,
  _Verb.COLLECT_JOB:   _cmd_collect_job,
  _Verb.CONSUME_JOB:   _cmd_consume_job,
  _Verb.RETIRE_JOBS:   _cmd_retire_jobs,
  _Verb.CANCEL_JOB:    _cmd_cancel_job,
  _Verb.LOOKUP_EXPERT: _cmd_lookup_expert,
}

# Subcommands that act on the repository root rather than on an argument tail.
_REPO_VERBS = {
  _Verb.EXPERT_PUMP_ONCE: _cmd_expert_pump_once,
  _Verb.DOCTOR_TICK:      _cmd_doctor_tick,
  _Verb.RUNTIME:          _cmd_runtime,
}


def main() -> int:
  """
  Dispatch the subcommand named on the command line.

  A cache-resident copy that is not the registry-installed version hands the invocation to the installed version
  first. An unknown subcommand, or none, is refused with the usage text on stderr.

  Guarantees:
    - An invocation handed over to the installed version is dispatched by that version and never handed over
      again.

  Returns:
    Process exit code of the subcommand, or 2 when the subcommand is missing or unknown.
  """

  # Contract:
  # An invocation that was handed over to the installed version is dispatched by that version itself
  # and never handed over again, so a registry mismatch can never loop the hand-over forever.

  # a stale cache-resident copy hands the whole invocation to the installed version first
  _forward_if_stale()

  # guard: without a subcommand there is nothing to dispatch
  if len(sys.argv) < 2:
    print(USAGE, file = sys.stderr)
    return 2

  # the subcommand, its argument tail, and the repository it acts on
  sub = sys.argv[1]
  rest = sys.argv[2:]
  repo = _env_repo_root()

  # verbs acting on the repository root
  if (repo_verb := _REPO_VERBS.get(sub)) is not None:
    return repo_verb(repo)
  if sub == _Verb.RUNTIME_TICK:
    # optional git locks off for the tick and everything it spawns — a background
    # `git status` must not rewrite the shared index (see runtime_daemon.run)
    os.environ.setdefault(_Probe.ENV_GIT_OPTIONAL_LOCKS, _Probe.GIT_OPTIONAL_LOCKS_OFF)
    return _cmd_runtime_tick(repo, rest)

  # verbs this CLI implements itself
  if (stdin_verb := _STDIN_VERBS.get(sub)) is not None:
    return stdin_verb()
  if (local := _LOCAL.get(sub)) is not None:
    return local(rest)

  # verbs a sibling module implements, loaded on demand so one broken module never takes the
  # others down and a call never pays for modules it does not use
  if (target := _DELEGATED.get(sub)) is not None:
    module, func = target
    handler: Callable[[list[str]], int] = getattr(importlib.import_module(module), func)
    return handler(rest)

  # anything else is refused with the usage text
  print(_Msg.UNKNOWN_SUBCOMMAND.format(sub, USAGE), file = sys.stderr)
  return 2


if __name__ == "__main__":
  sys.exit(main())
