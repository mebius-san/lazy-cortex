#!/usr/bin/env python3
"""
Command-line entry point of the lazycortex-obsidian plugin.
"""

from __future__ import annotations

import importlib
import sys
from pathlib import Path

from typing import TYPE_CHECKING
if TYPE_CHECKING:
  pass


# Put the CLI's own directory first on sys.path so its sibling bin-modules resolve by bare name.
sys.path.insert(0, str(Path(__file__).parent))

# Usage text printed with no arguments or a help flag
USAGE = ("usage: lazycortex-obsidian <subcommand> [args...]\n"
         "Subcommands: tag-pages (plan | apply), plugin-install, snippet-enable, and every iconize_sync "
         "subcommand — sync, sync-paths, reconcile, reconcile-plugin, reconcile-dirty, reconcile-commit, "
         "check-versions")

# Verbs served by their own module; every other subcommand belongs to the iconize worker
_ROUTES = {
  "tag-pages": "tag_pages",
  "plugin-install": "plugin_install",
  "snippet-enable": "snippet_enable",
}


def main(argv: list[str]) -> int:
  """
  Route a subcommand to the module that serves it.

  Verbs with a module of their own go to it; every other subcommand goes to the iconize worker. A routine's
  `command` naming this plugin reaches any of them without knowing the plugin's layout. With no arguments or a
  help flag, the usage text is printed.

  Args:
    argv: Command-line arguments after the program name, starting with the subcommand.

  Returns:
    The exit code of the module that served the subcommand, or 0 after printing the usage text.
  """
  if not argv or argv[0] in ("-h", "--help"):
    print(USAGE)
    return 0

  # a routed verb gets its own arguments; the iconize worker parses the whole line itself
  if argv[0] in _ROUTES:
    return importlib.import_module(_ROUTES[argv[0]]).main(argv[1:])
  # waiver: lazy sibling import -- one broken subcommand module must not take the whole CLI down
  from iconize_sync import main as _worker
  return _worker(argv)


if __name__ == "__main__":
  sys.exit(main(sys.argv[1:]))
