  _UNEXPECTED_FAILURES = ( OSError, RuntimeError, subprocess.SubprocessError, ValueError )

  # The signals that end a run, and the base of the exit status a run ended by one reports: the shell's 128 plus the
  # signal's number.
  _TERMINATION_SIGNALS = ( signal.SIGTERM, signal.SIGINT )
  _SIGNAL_EXIT_BASE    = 128
  # The stderr line of a run a signal stopped, naming the paths a rollback could not put back (`-` for none).
