# waiver: a named tuple, not a dataclass — test loaders exec this extension-less file without registering it in
# sys.modules, which a dataclass needs at class creation
class _TermsWrite(NamedTuple):
  """
  What one `terms-write` run changed and committed.

  Attributes:
    commit: Outcome of the commit carrying the term files and the documents.
    documents: Repo-relative documents whose text changed.
    unmatched: Accepted link and retarget operations that found no occurrence in any document, and link operations
      that a `skip` kept off a document they name, the latter carrying `skip_unmatched`, those documents sorted.
    merged: Stems of the terms the batch joined with another term.
    applied: Number of operations the batch applied.
    refused: Refused operations, each with its zero-based batch position, the operation as sent and the reason.
    skip_fragments: The `skip` fragments that matched no place, in the order sent, by document and by the word of
      the link they keep off it.
  """

  # The outcome of the commit carrying the term files and the documents
  commit: _wiki_commit.CommitResult
  # The repo-relative documents whose text changed
  documents: list[str]
  # The link and retarget operations that found no occurrence in any document
  unmatched: list[dict]
  # The stems of the terms the batch joined with another term
  merged: list[str]
  # The number of operations the batch applied
  applied: int
  # The operations the batch refused, each with its position in the batch and the reason
  refused: list[dict]
  # The `skip` fragments that matched no place, by document and by the word of the link they keep off it
  skip_fragments: dict[tuple[str, str], list[str]]


# ----------------------------------------------------------------------------------------
class _SignalStop:
  """
  Termination-signal handling of one guarded run.

  A signal received while `holding` is set is only recorded; otherwise it stops the run at once.

  Attributes:
    holding: Whether a signal is only recorded instead of stopping the run.
    received: The first signal recorded while `holding` was set, or `None`.
  """

  def __init__(self, *, signals: tuple[int, ...]) -> None:
    """
    Prepare the handling of the given signals; no handler is installed yet.

    Args:
      signals: The signals that end a run.
    """
    # the signals handled, and whether their handlers could be set from this thread
    self._signals = signals
    self._installed = False

    # whether a signal is only recorded, and the first one recorded
    self.holding = False
    self.received: int | None = None

  def install(self) -> dict[int, _SignalHandler]:
    """
    Make each termination signal reach this handling.

    Returns:
      The handler each signal had before, by signal; empty when handlers cannot be set from this thread.
    """
    # the handlers in place now, then this one; only the main thread may set them
    try:
      previous: dict[int, _SignalHandler] = { signum: signal.getsignal(signum) for signum in self._signals }
      for signum in self._signals:
        signal.signal(signum, self.on_signal)
    except ValueError:
      return {}
    self._installed = True
    return previous

  def ignore(self) -> None:
    """
    Make every termination signal ignored, when this handling was installed.
    """
    # guard: handlers that could not be set are left alone
    if not self._installed:
      return

    # every signal is ignored from here on
    for signum in self._signals:
      signal.signal(signum, signal.SIG_IGN)

  @staticmethod
  def restore(previous: dict[int, _SignalHandler]) -> None:
    """
    Put back the handlers the termination signals had before.

    Args:
      previous: The handler each signal had before, by signal.
    """
    # each signal gets its earlier handler back
    for signum, handler in previous.items():
      signal.signal(signum, handler)

  def on_signal(self, signum: int, _frame: FrameType | None) -> None:
    """
    Record a termination signal, or stop the run on it.

    Args:
      signum: The signal received.
      _frame: The interrupted frame, unused.

    Raises:
      KeyboardInterrupt: Carrying the signal, when the signal is not only recorded.
    """
    # while a signal is only recorded, git finishes its commit and releases its lock, and the run decides afterwards
    if self.holding:
      if self.received is None:
        self.received = signum
      return

    # otherwise the write in progress stops, and every further signal is ignored so the rollback can finish
    self.ignore()
    raise KeyboardInterrupt(signum)


# ----------------------------------------------------------------------------------------
class _PathState(NamedTuple):
  """
  What one path held before a run touched it: its file bytes and its entry in the git index.

  Attributes:
    data: The file's bytes, or `None` when the path was not a file.
    entries: The path's index entries as `<mode> <object> <stage>` strings, empty when the index held none, or
      `None` when the index could not be read and is therefore left alone.
    intent: Whether the index held the path only as an intent to add, with no content staged.
  """

  # The file's bytes; None when the path was not a file
  data: bytes | None
  # The index entries of the path; empty when it had none, None when the index could not be read
  entries: tuple[str, ...] | None
  # Whether the path was registered as an intent to add, which an index entry alone does not tell
  intent: bool = False


# ----------------------------------------------------------------------------------------
class _RunLanding:
  """
  The commit door of one guarded run: the single place its writes are recorded in git.

  Attributes:
    landed: Whether the run's commit step has completed without failing, even when the named paths carried
      nothing to commit; from then on nothing of the run is undone.
    staged: Repo-relative paths the run handed to git to stage, noted before the git call; empty until a commit is
      attempted.
  """

  def __init__(self, *, repo: Path, stop: _SignalStop) -> None:
    """
    Prepare the commit door of a run.

    Args:
      repo: Repository root the commit is made in.
      stop: Termination-signal handling of the run, told to only record signals while git commits.
    """
    # where the commit is made, and the signal handling that must not cut git short
    self._repo = repo
    self._stop = stop

    # nothing is committed yet, and nothing was handed to git to stage
    self.landed = False
    self.staged: list[str] = []

  @property
  def received(self) -> int | None:
    """
    First termination signal recorded while git committed.

    Tells the caller whether a signal arrived during the commit, so it can stop once the commit has landed. Holds
    `None` when no signal was recorded.
    """
    return self._stop.received

  @staticmethod
  def validate_no_links(repo: Path, rels: Iterable[str]) -> None:
    """
    Refuse a committing run that would write or remove a path reached through a symbolic link or a `..` step.

    Symbolic links are not supported in the trees a committing run writes or removes, and a path with a `..` step
    cannot be judged by its spelling, so it is not accepted either; the check is made before the run writes
    anything.

    Args:
      repo: Repository root.
      rels: Repo-relative paths the run is about to write or remove.

    Raises:
      OSError: When one of the paths, or a folder between it and the repository root, is a symbolic link, or when
        one of the paths contains a `..` component; the message names the path and, for a link, the link.
    """
    for rel in rels:
      # guard: a step back up the tree is taken from wherever a link before it leads, so such a path cannot be
      # judged by its spelling and is not accepted at all
      if _PARENT_STEP in Path(rel).parts:
        raise OSError(f"{rel}: a path with a '{_PARENT_STEP}' step is not accepted by a committing run")

      # each step from the root down to the path itself: the first link met stops the run
      step = repo
      for part in Path(rel).parts:
        step = step / part

        # guard: a link here means the write or the removal would land in a place the run did not name
        if step.is_symlink():
          link = step.relative_to(repo).as_posix() if step.is_relative_to(repo) else str(step)
          raise OSError(
            f"{rel}: {link} is a symbolic link, and a committing run does not write or remove through one"
          )

  @staticmethod
  def to_named_rel(repo: Path, path: Path) -> str | None:
    """
    Spell a caller's path relative to the repository root, exactly as the caller named it below that root.

    A caller may reach the repository through a symbolic link above its root; only what lies above the root is
    followed, and every name below the root, links included, is kept as the caller gave it. A path with a `..` step
    is not accepted, because such a step is taken from wherever a link before it leads.

    Args:
      repo: Resolved repository root.
      path: Path a caller supplied, absolute or relative to the working directory.

    Returns:
      The repo-relative POSIX path, or `None` when the path does not lie in the repository.

    Raises:
      OSError: When the path contains a `..` component; the message names the path.
    """
    # the path made absolute with nothing folded away: a step back up the tree must stay visible
    named = Path(path).absolute()

    # guard: a step back up the tree is taken from wherever a link before it leads, so such a path cannot be
    # judged by its spelling and is not accepted at all
    if _PARENT_STEP in named.parts:
      raise OSError(f"{path}: a path with a '{_PARENT_STEP}' step is not accepted by a committing run")

    # the caller may have reached the repository through a link above its root; only that part is followed, from
    # the top down, until an ancestor turns out to be the root — what lies below it stays as it was named
    for ancestor in reversed(( named, *named.parents )):
      if ancestor.resolve() == repo:
        return named.relative_to(ancestor).as_posix()
    return None

  def commit(self, paths: list[str], message: str) -> _wiki_commit.CommitResult:
    """
    Commit exactly the given paths as the run's one commit.

    Notes:
      - A termination signal delivered to the wiki process while git runs is only recorded and never reaches git; a
        signal sent to the whole process group reaches git too.
      - A path reached through a symbolic link, or containing a `..` component, is refused before any git call, so
        nothing is staged and the run's undo applies.

    Args:
      paths: Repo-relative paths to commit.
      message: Commit message.

    Returns:
      The commit outcome.

    Raises:
      WikiCommitError: If a path is reached through a symbolic link or contains a `..` component, if a git step
        fails, or if git cannot be run.
    """
    # limit: a signal recorded now waits on git unbounded, a hung hook holds the run; add a commit timeout if needed
    self._stop.holding = True

    # no caller gets past this door with a path reached through a link or a step back up the tree: what is
    # committed is the repository root joined with a plain path, or nothing is
    try:
      self.validate_no_links(self._repo, paths)
    except OSError as error:
      raise _wiki_commit.WikiCommitError(str(error)) from error

    # the paths git is about to stage are noted first: a refusal raises out of the call, and the undo must know
    # which index entries are the run's own
    self.staged = list(paths)
    result = _wiki_commit.commit_paths(self._repo, paths, message)

    # the commit is made: whatever fails after this point, the run's files stay as committed
    self.landed = True
    return result


# ----------------------------------------------------------------------------------------
class _DomainTreeError(Exception):
  """
  Refusal of a domain landing by the working tree itself, raised once the landing has been undone.
  """


# ----------------------------------------------------------------------------------------
class _RelinkIncompleteError(Exception):
  """
  End of a scope's relink pass that had to leave nodes out, raised once every other node is handled.

  Attributes:
    dispatched: Number of classify jobs the pass queued.
    skipped: Number of files the node factory does not recognise.
    unchanged: Number of nodes left alone because their source is unchanged.
    unreadable: Repo-relative paths of the nodes that could not be read, sorted.
    failed: Repo-relative paths of the nodes whose classify job could not be queued, sorted.
  """

  def __init__(self, *,
               dispatched: int,
               skipped: int,
               unchanged: int,
               unreadable: list[str],
               failed: list[str]) -> None:
    """
    Record what the pass did and which nodes it had to leave out.

    Args:
      dispatched: Number of classify jobs the pass queued.
      skipped: Number of files the node factory does not recognise.
      unchanged: Number of nodes left alone because their source is unchanged.
      unreadable: Repo-relative paths of the nodes that could not be read.
      failed: Repo-relative paths of the nodes whose classify job could not be queued.
    """
    # the base exception carries the one-line reading of the pass
    super().__init__(
      f"{len(unreadable)} node(s) could not be read, {len(failed)} could not be dispatched: "
      f"{', '.join(sorted([ *unreadable, *failed ]))}"
    )

    # the counts the scope's report line is built from, and the nodes it names
    self.dispatched = dispatched
    self.skipped = skipped
    self.unchanged = unchanged
    self.unreadable = sorted(unreadable)
    self.failed = sorted(failed)


