  _KEY_WIKI_SYNCED_SHA = "wiki_synced_sha"


  def run(self, argv: list[str] | None = None) -> int:
    """
    Parse arguments and dispatch to the selected subcommand.

    Guarantees:
      - Exit code 0 means the subcommand ran to completion, including its documented
        skips; 1 means the subcommand itself failed; 2 never reports failed work and is
        reserved for an invocation that could not be run at all.

    Args:
      argv: Argument vector to parse; defaults to the process arguments when not supplied.

    Returns:
      Integer exit code.
    """

    # Contract:
    # Exit code 0 means the subcommand ran to completion, including its documented skips,
    # and 1 means the subcommand itself failed; 2 NEVER reports failed work — it is
    # reserved for an invocation that could not be run at all.

    # parse the command line and pick out the invoked subcommand
    parser = self._build_parser()
    args = parser.parse_args(argv)
    cmd = getattr(args, self._DEST)

    # guard: no subcommand given — print help and exit non-zero
    if cmd is None:
      parser.print_help(sys.stderr)
      return 2

    # guard: a parsed subcommand the handler table does not carry is reported, never run
    handler = self._build_handlers().get(cmd)
    if handler is None:
      return self._unknown_subcommand(cmd)

    # hand the parsed namespace to the subcommand's handler
    return handler(args)


  def _build_handlers(self) -> dict[str, Callable[[argparse.Namespace], int]]:
    """
    Build the table that maps each subcommand name to the handler that runs it.

    Returns:
      The subcommand name to handler table; each handler takes the parsed namespace and returns an exit code.
    """
    return {
      self._CMD_RESOLVE_SCOPE: self._cmd_resolve_scope,
      self._CMD_NEIGHBOURS: self._cmd_neighbours,
      self._CMD_RESOLVE_LANGUAGE: self._cmd_resolve_language,
      self._CMD_TEXT: self._cmd_text,
      self._CMD_ENSURE_AXES: self._cmd_ensure_axes,
      self._CMD_ENSURE_SCOPE_CONFIG: self._cmd_ensure_scope_config,
      self._CMD_APPLY_NODE: self._cmd_apply_node,
      self._CMD_PROCESS_FILE: self._cmd_process_file,
      self._CMD_PRUNE_NODE: self._cmd_prune_node,
      self._CMD_DISPATCH_LINK: self._cmd_dispatch_link,
      self._CMD_BUILD_INDEX: self._cmd_build_index,
      self._CMD_RELINK_PLAN: self._cmd_relink_plan,
      self._CMD_RELINK_ALL: self._cmd_relink_all,
      self._CMD_FIND_CANDIDATES: self._cmd_find_candidates,
      self._CMD_FIND_BACK_CANDIDATES: self._cmd_find_back_candidates,
      self._CMD_SET_SYNCED_SHA: self._cmd_set_synced_sha,
      self._CMD_RELINK_COMMIT: self._cmd_relink_commit,
      self._CMD_DOCTOR: self._cmd_doctor,
      self._CMD_COLLECT_TAGS: self._cmd_collect_tags,
      self._CMD_RETAG: self._cmd_retag,
      self._CMD_TAG_TICK: self._cmd_tag_tick,
      self._CMD_TAG_APPLY: self._cmd_tag_apply,
      self._CMD_DOMAIN_PLAN: self._cmd_domain_plan,
      self._CMD_DOMAIN_APPLY_INDEX: self._cmd_domain_apply_index,
      self._CMD_DOMAIN_TICK: self._cmd_domain_tick,
      self._CMD_DOMAIN_LAND: self._cmd_domain_land,
      self._CMD_DOMAIN_COLLECT: self._cmd_domain_collect,
      self._CMD_DOMAIN_REPAIR: self._cmd_domain_repair,
      self._CMD_DOMAIN_PAYLOAD: self._cmd_domain_payload,
      self._CMD_TERMS_APPLY: self._cmd_terms_apply,
      self._CMD_TERMS_RESOLVE: self._cmd_terms_resolve,
      self._CMD_TERMS_WRITE: self._cmd_terms_write,
      self._CMD_MIRROR_PLAN: self._cmd_mirror_plan,
      self._CMD_MIRROR_SYNC: self._cmd_mirror_sync,
      self._CMD_STRUCTURE_WATCH_CONFIG: self._cmd_structure_watch_config,
      self._CMD_STRUCTURE_APPLY: self._cmd_structure_apply,
      self._CMD_STRUCTURE_RESOLVE: self._cmd_structure_resolve,
      self._CMD_CORE_CLI: lambda _args: self._cmd_core_cli(),
      self._CMD_RENDER_NAVIGATION_RULE: self._cmd_render_navigation_rule,
    }


  def _build_parser(self) -> argparse.ArgumentParser:
    """
    Build the top-level argument parser with one subparser per registered subcommand.

    Returns:
      The configured argument parser.
    """
    parser = argparse.ArgumentParser(prog = self._PROG, description = self._DESCRIPTION)
    sub = parser.add_subparsers(dest = self._DEST, metavar = self._METAVAR)
    for name, summary in _SUBCOMMANDS.items():
      sub_parser = sub.add_parser(name, help = summary)
      if name == self._CMD_RESOLVE_SCOPE:
        # resolve-scope takes the path, the repo, and the globs-only switch
        sub_parser.add_argument(self._ARG_PATH, help = self._ARG_PATH_HELP)
        sub_parser.add_argument(self._ARG_REPO, default = None, help = self._ARG_REPO_HELP)
        sub_parser.add_argument(
          self._ARG_GLOBS_ONLY,
          dest = self._ARG_GLOBS_ONLY_DEST,
          action = self._ACTION_STORE_TRUE,
          help = self._ARG_GLOBS_ONLY_HELP,
        )
      elif name == self._CMD_NEIGHBOURS:
        # neighbours takes the node path and the repo
        sub_parser.add_argument(self._ARG_PATH, help = self._ARG_NEIGHBOURS_PATH_HELP)
        sub_parser.add_argument(self._ARG_REPO, default = None, help = self._ARG_REPO_HELP)
      elif name == self._CMD_RESOLVE_LANGUAGE:
        # resolve-language reads only the repo
        sub_parser.add_argument(self._ARG_REPO, default = None, help = self._ARG_REPO_HELP)
      elif name == self._CMD_TEXT:
        # text takes the explainer key, chosen from the published set
        sub_parser.add_argument(
          self._ARG_TEXT_KEY,
          choices = _explainers.text_keys(),
          help = self._ARG_TEXT_KEY_HELP,
        )
        # the language to render in defaults to the repo's wiki language
        sub_parser.add_argument(
          self._ARG_LANG,
          dest = self._ARG_LANG_DEST,
          default = None,
          help = self._ARG_LANG_HELP,
        )
        sub_parser.add_argument(self._ARG_REPO, default = None, help = self._ARG_REPO_HELP)
      elif name == self._CMD_ENSURE_AXES:
        # ensure-axes takes one or more axis names and the repo
        sub_parser.add_argument(self._ARG_AXES, nargs = "+", help = self._ARG_AXES_HELP)
        sub_parser.add_argument(self._ARG_REPO, default = None, help = self._ARG_REPO_HELP)
      elif name == self._CMD_ENSURE_SCOPE_CONFIG:
        # ensure-scope-config takes the scope id and the frontmatter filter to seed
        sub_parser.add_argument(self._ARG_SCOPE_ID, help = self._ARG_SEED_SCOPE_ID_HELP)
        sub_parser.add_argument(
          self._ARG_FILTER_JSON,
          dest = self._ARG_FILTER_JSON_DEST,
          default = None,
          help = self._ARG_FILTER_JSON_HELP,
        )
        # exclude globs to append to the scope
        sub_parser.add_argument(
          self._ARG_EXCLUDE,
          dest = self._ARG_EXCLUDE_DEST,
          nargs = "*",
          default = None,
          help = self._ARG_EXCLUDE_HELP,
        )
        # index badges to seed, then the repo
        sub_parser.add_argument(
          self._ARG_INDEX_BADGES,
          dest = self._ARG_INDEX_BADGES_DEST,
          nargs = "*",
          default = None,
          help = self._ARG_INDEX_BADGES_HELP,
        )
        sub_parser.add_argument(self._ARG_REPO, default = None, help = self._ARG_REPO_HELP)
      elif name == self._CMD_APPLY_NODE:
        # apply-node takes the node path and the result file, which a job dir defaults
        sub_parser.add_argument(self._ARG_PATH, help = self._ARG_APPLY_PATH_HELP)
        sub_parser.add_argument(
          self._ARG_FROM,
          dest = self._ARG_FROM_DEST,
          default = None,
          help = self._ARG_FROM_HELP,
        )
        # the job dir switches the daemon tail on; the ledger records the written paths
        sub_parser.add_argument(self._ARG_JOB_DIR, dest = self._ARG_JOB_DIR_DEST, default = None,
                                help = self._ARG_JOB_DIR_HELP)
        sub_parser.add_argument(self._ARG_LEDGER, dest = self._ARG_LEDGER_DEST, default = None,
                                help = self._ARG_LEDGER_HELP)
        sub_parser.add_argument(self._ARG_REPO, default = None, help = self._ARG_REPO_HELP)
      elif name == self._CMD_PROCESS_FILE:
        # process-file takes the changed path and the repo
        sub_parser.add_argument(
          self._ARG_PATH,
          help = self._ARG_PROCESS_PATH_HELP,
        )
        sub_parser.add_argument(self._ARG_REPO, default = None, help = self._ARG_REPO_HELP)
      elif name == self._CMD_PRUNE_NODE:
        # prune-node takes the node path, the repo, and the no-commit switch
        sub_parser.add_argument(self._ARG_PATH, help = self._ARG_PRUNE_PATH_HELP)
        sub_parser.add_argument(self._ARG_REPO, default = None, help = self._ARG_REPO_HELP)
        sub_parser.add_argument(
          self._ARG_NO_COMMIT,
          dest = self._ARG_NO_COMMIT_DEST,
          action = self._ACTION_STORE_TRUE,
          help = self._ARG_NO_COMMIT_HELP,
        )
        sub_parser.add_argument(self._ARG_LEDGER, dest = self._ARG_LEDGER_DEST, default = None,
                                help = self._ARG_LEDGER_HELP)
      elif name == self._CMD_DISPATCH_LINK:
        # dispatch-link takes the node path and the repo
        sub_parser.add_argument(self._ARG_PATH, help = self._ARG_DISPATCH_LINK_PATH_HELP)
        sub_parser.add_argument(self._ARG_REPO, default = None, help = self._ARG_REPO_HELP)
      elif name == self._CMD_BUILD_INDEX:
        # build-index takes the scope id, the repo, and the ledger the rebuilt index is recorded in
        sub_parser.add_argument(self._ARG_SCOPE_ID, help = self._ARG_SCOPE_ID_HELP)
        sub_parser.add_argument(self._ARG_REPO, default = None, help = self._ARG_REPO_HELP)
        sub_parser.add_argument(self._ARG_LEDGER, dest = self._ARG_LEDGER_DEST, default = None,
                                help = self._ARG_LEDGER_HELP)
      elif name == self._CMD_RELINK_COMMIT:
        # relink-commit takes the scope id, the required ledger, the pass mode and its three counters
        sub_parser.add_argument(self._ARG_SCOPE_ID, help = self._ARG_SCOPE_ID_HELP)
        sub_parser.add_argument(self._ARG_LEDGER, dest = self._ARG_LEDGER_DEST, required = True,
                                help = self._ARG_LEDGER_HELP)
        sub_parser.add_argument(self._ARG_MODE, dest = self._ARG_MODE_DEST, required = True,
                                choices = self._RELINK_MODES, help = self._ARG_MODE_HELP)
        for flag, dest in self._RELINK_COUNTERS:
          sub_parser.add_argument(flag, dest = dest, type = int, required = True, help = self._ARG_COUNTER_HELP)
        sub_parser.add_argument(self._ARG_REPO, default = None, help = self._ARG_REPO_HELP)
      elif name == self._CMD_RELINK_PLAN:
        # relink-plan takes the scope id and the repo
        sub_parser.add_argument(self._ARG_SCOPE_ID, help = self._ARG_RELINK_SCOPE_ID_HELP)
        sub_parser.add_argument(self._ARG_REPO, default = None, help = self._ARG_REPO_HELP)
      elif name == self._CMD_STRUCTURE_WATCH_CONFIG:
        # structure-watch-config takes the compare-only switch and the repo
        sub_parser.add_argument(
          self._ARG_CHECK,
          dest = self._ARG_CHECK_DEST,
          action = self._ACTION_STORE_TRUE,
          help = self._ARG_CHECK_HELP,
        )
        sub_parser.add_argument(self._ARG_REPO, default = None, help = self._ARG_REPO_HELP)
      elif name == self._CMD_RELINK_ALL:
        # relink-all takes an optional scope id and the repo
        sub_parser.add_argument(
          self._ARG_SCOPE_ID,
          nargs = "?",
          default = None,
          help = self._ARG_RELINK_ALL_SCOPE_ID_HELP,
        )
        sub_parser.add_argument(self._ARG_REPO, default = None, help = self._ARG_REPO_HELP)
      elif name == self._CMD_FIND_CANDIDATES:
        # find-candidates takes the node path and its required scope
        sub_parser.add_argument(self._ARG_NODE_PATH, help = self._ARG_NODE_PATH_HELP)
        sub_parser.add_argument(
          self._ARG_SCOPE,
          dest = self._ARG_SCOPE_DEST,
          required = True,
          help = self._ARG_SCOPE_HELP,
        )
        # the repo, then the cap on suggestions returned
        sub_parser.add_argument(self._ARG_REPO, default = None, help = self._ARG_REPO_HELP)
        sub_parser.add_argument(
          self._ARG_TOP_N,
          dest = self._ARG_TOP_N_DEST,
          type = self._ARG_TOP_N_TYPE,
          default = self._ARG_TOP_N_DEFAULT,
          help = self._ARG_TOP_N_HELP,
        )
      elif name == self._CMD_FIND_BACK_CANDIDATES:
        # find-back-candidates takes the node path and its required scope
        sub_parser.add_argument(self._ARG_NODE_PATH, help = self._ARG_NODE_PATH_HELP)
        sub_parser.add_argument(
          self._ARG_SCOPE,
          dest = self._ARG_SCOPE_DEST,
          required = True,
          help = self._ARG_SCOPE_HELP,
        )
        # the repo, then the cap on suggestions returned
        sub_parser.add_argument(self._ARG_REPO, default = None, help = self._ARG_REPO_HELP)
        sub_parser.add_argument(
          self._ARG_TOP_N,
          dest = self._ARG_TOP_N_DEST,
          type = self._ARG_TOP_N_TYPE,
          default = self._ARG_TOP_N_DEFAULT,
          help = self._ARG_TOP_N_HELP,
        )
      elif name == self._CMD_SET_SYNCED_SHA:
        # set-synced-sha takes the scope id, the anchor commit, and the repo
        sub_parser.add_argument(self._ARG_SCOPE_ID, help = self._ARG_SCOPE_ID_HELP)
        sub_parser.add_argument(self._ARG_SHA, help = self._ARG_SHA_HELP)
        sub_parser.add_argument(self._ARG_REPO, default = None, help = self._ARG_REPO_HELP)
      elif name == self._CMD_DOCTOR:
        # doctor takes an optional scope id and the apply switch
        sub_parser.add_argument(
          self._ARG_SCOPE_ID,
          nargs = "?",
          default = None,
          help = self._ARG_DOCTOR_SCOPE_ID_HELP,
        )
        sub_parser.add_argument(
          self._ARG_APPLY,
          dest = self._ARG_APPLY_DEST,
          action = self._ACTION_STORE_TRUE,
          help = self._ARG_APPLY_HELP,
        )
        # the commit switch, then the repo
        sub_parser.add_argument(
          self._ARG_DOCTOR_COMMIT,
          dest = self._ARG_DOCTOR_COMMIT_DEST,
          action = self._ACTION_STORE_TRUE,
          help = self._ARG_DOCTOR_COMMIT_HELP,
        )
        sub_parser.add_argument(self._ARG_REPO, default = None, help = self._ARG_REPO_HELP)
      elif name == self._CMD_COLLECT_TAGS:
        # collect-tags takes the tag surface and the repo
        sub_parser.add_argument(self._ARG_SCOPE_ID, help = self._ARG_TAG_SURFACE_HELP)
        sub_parser.add_argument(self._ARG_REPO, default = None, help = self._ARG_REPO_HELP)
      elif name == self._CMD_RETAG:
        # retag takes the tag surface and the required alias map
        sub_parser.add_argument(self._ARG_SCOPE_ID, help = self._ARG_TAG_SURFACE_HELP)
        sub_parser.add_argument(
          self._ARG_FROM,
          dest = self._ARG_FROM_DEST,
          required = True,
          help = self._ARG_ALIAS_HELP,
        )
        sub_parser.add_argument(self._ARG_REPO, default = None, help = self._ARG_REPO_HELP)
      elif name == self._CMD_TAG_APPLY:
        # tag-apply takes the tag surface, the alias map and the glosses
        sub_parser.add_argument(self._ARG_SCOPE_ID, help = self._ARG_TAG_SURFACE_HELP)
        sub_parser.add_argument(self._ARG_FROM, dest = self._ARG_FROM_DEST, required = True,
                                help = self._ARG_ALIAS_HELP)
        sub_parser.add_argument(self._ARG_GLOSSES, dest = self._ARG_GLOSSES_DEST, required = True,
                                help = self._ARG_GLOSSES_HELP)
        # the job dir switches the daemon tail on; the ledger records the written paths
        sub_parser.add_argument(self._ARG_JOB_DIR, dest = self._ARG_JOB_DIR_DEST, default = None,
                                help = self._ARG_JOB_DIR_HELP)
        sub_parser.add_argument(self._ARG_LEDGER, dest = self._ARG_LEDGER_DEST, default = None,
                                help = self._ARG_LEDGER_HELP)
        sub_parser.add_argument(self._ARG_REPO, default = None, help = self._ARG_REPO_HELP)
      elif name in ( self._CMD_TAG_TICK, self._CMD_DOMAIN_APPLY_INDEX, self._CMD_DOMAIN_COLLECT ):
        # the tag tick and the domain index and collect verbs read only the repo
        sub_parser.add_argument(self._ARG_REPO, default = None, help = self._ARG_REPO_HELP)
      elif name in ( self._CMD_DOMAIN_PLAN, self._CMD_DOMAIN_REPAIR ):
        # domain plan and repair take an optional group and the repo
        sub_parser.add_argument(
          self._ARG_GROUP, dest = self._ARG_GROUP_DEST, default = None, help = self._ARG_GROUP_HELP,
        )
        sub_parser.add_argument(self._ARG_REPO, default = None, help = self._ARG_REPO_HELP)
      elif name == self._CMD_DOMAIN_PAYLOAD:
        # domain-payload takes the required group, the required output path, and the repo
        sub_parser.add_argument(
          self._ARG_GROUP, dest = self._ARG_GROUP_DEST, required = True, help = self._ARG_GROUP_HELP,
        )
        sub_parser.add_argument(self._ARG_OUT, dest = self._ARG_OUT_DEST, required = True, help = self._ARG_OUT_HELP)
        sub_parser.add_argument(self._ARG_REPO, default = None, help = self._ARG_REPO_HELP)
      elif name == self._CMD_DOMAIN_LAND:
        # domain-land takes the doc path and the required file holding the writer's document
        sub_parser.add_argument(self._ARG_PATH, help = self._ARG_DOMAIN_LAND_PATH_HELP)
        sub_parser.add_argument(
          self._ARG_FROM,
          dest = self._ARG_FROM_DEST,
          required = True,
          help = self._ARG_DOMAIN_LAND_FROM_HELP,
        )
        sub_parser.add_argument(self._ARG_PAYLOAD, required = True, help = self._ARG_DOMAIN_LAND_PAYLOAD_HELP)
        sub_parser.add_argument(self._ARG_REPO, default = None, help = self._ARG_REPO_HELP)
      elif name == self._CMD_DOMAIN_TICK:
        # a restamp has no trigger — the path and the flag exclude each other
        trigger = sub_parser.add_mutually_exclusive_group()
        trigger.add_argument(
          self._ARG_PATH,
          nargs = "?",
          default = None,
          help = self._ARG_DOMAIN_TICK_PATH_HELP,
        )
        trigger.add_argument(
          self._ARG_RESTAMP,
          dest = self._ARG_RESTAMP_DEST,
          action = self._ACTION_STORE_TRUE,
          help = self._ARG_RESTAMP_HELP,
        )
        sub_parser.add_argument(self._ARG_REPO, default = None, help = self._ARG_REPO_HELP)
        # the full-pass switch skips the trigger-path filter
        sub_parser.add_argument(
          self._ARG_FULL,
          dest = self._ARG_FULL_DEST,
          action = self._ACTION_STORE_TRUE,
          help = self._ARG_FULL_HELP,
        )
      elif name == self._CMD_TERMS_APPLY:
        # terms-apply takes the document path and the required term pair
        sub_parser.add_argument(self._ARG_PATH, help = self._ARG_TERMS_PATH_HELP)
        sub_parser.add_argument(
          self._ARG_TERM_FROM,
          dest = self._ARG_TERM_FROM_DEST,
          required = True,
          help = self._ARG_TERM_FROM_HELP,
        )
        # the replacement term, then the repo
        sub_parser.add_argument(
          self._ARG_TERM_TO,
          dest = self._ARG_TERM_TO_DEST,
          required = True,
          help = self._ARG_TERM_TO_HELP,
        )
        sub_parser.add_argument(self._ARG_REPO, default = None, help = self._ARG_REPO_HELP)
      elif name in ( self._CMD_TERMS_RESOLVE, self._CMD_TERMS_WRITE, self._CMD_STRUCTURE_APPLY ):
        # the terms- and structure-curator job verbs read the job dir and the repo
        sub_parser.add_argument(self._ARG_JOB_DIR, dest = self._ARG_JOB_DIR_DEST, required = True,
                                help = self._ARG_JOB_DIR_HELP)
        sub_parser.add_argument(self._ARG_REPO, default = None, help = self._ARG_REPO_HELP)
      elif name == self._CMD_STRUCTURE_RESOLVE:
        # structure-resolve reads one job dir or the whole tree, never both, and the repo
        source = sub_parser.add_mutually_exclusive_group(required = True)
        source.add_argument(self._ARG_JOB_DIR, dest = self._ARG_JOB_DIR_DEST, help = self._ARG_RESOLVE_JOB_DIR_HELP)
        source.add_argument(self._ARG_ALL, dest = self._ARG_ALL_DEST, action = self._ACTION_STORE_TRUE,
                            help = self._ARG_RESOLVE_ALL_HELP)
        sub_parser.add_argument(self._ARG_REPO, default = None, help = self._ARG_REPO_HELP)
      elif name == self._CMD_RENDER_NAVIGATION_RULE:
        # render-navigation-rule takes the target dir, the mode switches, the commit switches and the repo
        sub_parser.add_argument(self._ARG_RULES_DIR, dest = self._ARG_RULES_DIR_DEST, default = None,
                                help = self._ARG_RULES_DIR_HELP)
        sub_parser.add_argument(self._ARG_CREATE, dest = self._ARG_CREATE_DEST, action = self._ACTION_STORE_TRUE,
                                help = self._ARG_CREATE_HELP)
        sub_parser.add_argument(self._ARG_IN_PLACE, dest = self._ARG_IN_PLACE_DEST,
                                action = self._ACTION_STORE_TRUE, help = self._ARG_IN_PLACE_HELP)
        sub_parser.add_argument(self._ARG_SECTION, dest = self._ARG_SECTION_DEST, default = None,
                                choices = self._NAV_SECTIONS, help = self._ARG_SECTION_HELP)
        # the commit switch and its subject, then the repo
        sub_parser.add_argument(self._ARG_DOCTOR_COMMIT, dest = self._ARG_DOCTOR_COMMIT_DEST,
                                action = self._ACTION_STORE_TRUE, help = self._ARG_NAV_COMMIT_HELP)
        sub_parser.add_argument(self._ARG_SUBJECT, dest = self._ARG_SUBJECT_DEST, default = None,
                                help = self._ARG_SUBJECT_HELP)
        sub_parser.add_argument(self._ARG_REPO, default = None, help = self._ARG_REPO_HELP)
      elif name in (self._CMD_MIRROR_PLAN, self._CMD_MIRROR_SYNC):
        # mirror plan and sync take the scope id and the repo
        sub_parser.add_argument(self._ARG_SCOPE_ID, help = self._ARG_SCOPE_ID_HELP)
        sub_parser.add_argument(self._ARG_REPO, default = None, help = self._ARG_REPO_HELP)
    return parser


  def _cmd_resolve_scope(self, args: argparse.Namespace) -> int:
    """
    Resolve a file path to its scope and print JSON to stdout.

    Output is `{"scope_id": "<id>", "cfg": {...}}` on a match, or
    `{"scope_id": null}` when no scope matches.  Always exits 0.

    Guarantees:
      - A path that matches no configured scope is reported as data, never as a failure;
        the command always exits 0.
      - Under `--globs-only` the answer depends only on the configured path globs and the
        built-in topics-index exclusion, never on the file's existence or the scope's own
        frontmatter filter.

    Args:
      args: Parsed argument namespace; must carry `.path`, `.repo` and `.globs_only`.

    Returns:
      Integer exit code (always 0).
    """

    # Contract:
    # A path matching no configured scope is reported as data and NEVER as a failure;
    # the command always exits 0.

    # Contract:
    # Under `--globs-only`, the printed scope MUST depend only on the configured path globs
    # and the built-in topics-index exclusion; it MUST NOT depend on the file's existence or
    # on the scope's own frontmatter filter.

    # resolve the path and print the owning scope, or a null id when none claims it
    repo = Path(args.repo or os.environ.get(_ENV_REPO_ROOT) or os.getcwd()).resolve()
    result = _scope.ScopeResolver(repo = repo).resolve_scope_by_path(args.path, apply_filter = not args.globs_only)
    if result is None:
      print(json.dumps({ "scope_id": None }))
    else:
      scope_id, cfg = result
      print(json.dumps({ "scope_id": scope_id, "cfg": cfg }))
    return 0


  def _cmd_neighbours(self, args: argparse.Namespace) -> int:
    """
    Print the scope and one-hop neighbours of a wiki node as JSON to stdout.

    Output is the `NeighbourFinder.find` payload `{"path": ..., "scope": ..., "neighbours": [...]}` and the
    command exits 0.  A path that names no file in the repository is answered with `{"error": ...}` on stdout
    and exit code 2.

    Guarantees:
      - The command is read-only; it writes nothing.

    Args:
      args: Parsed argument namespace; must carry `.path` and `.repo`.

    Returns:
      Integer exit code: 0 when the payload was printed, 2 when the path names no file.
    """

    repo = Path(args.repo or os.environ.get(_ENV_REPO_ROOT) or os.getcwd()).resolve()

    # guard: the path names no file in the repository — nothing to look up
    if not (repo / args.path).is_file():
      print(json.dumps({ "error": f"{self._CMD_NEIGHBOURS}: {self._MSG_NO_SUCH_FILE}: {args.path}" }))
      return 2

    # look up the node's one-hop neighbourhood and print it
    print(json.dumps(_neighbours.NeighbourFinder(repo).find(args.path)))
    return 0


  def _cmd_resolve_language(self, args: argparse.Namespace) -> int:
    """
    Print the language wiki writers must write in.

    Guarantees:
      - A repository with no language key configured is answered with the `en`
        floor as data, never as a failure; the command always exits 0.

    Args:
      args: Parsed argument namespace; must carry `.repo`.

    Returns:
      Integer exit code (always 0).
    """

    # Contract:
    # A repository with no language key configured MUST be answered with the `en`
    # floor rather than an error; the command always exits 0.

    # the resolved language code is the whole output
    repo = Path(args.repo or os.environ.get(_ENV_REPO_ROOT) or os.getcwd()).resolve()
    print(_explainers.resolve_language(repo))
    return 0


  def _cmd_text(self, args: argparse.Namespace) -> int:
    """
    Print one canonical wiki passage by key, in the language the repo resolves to.

    Gives every writer that must emit fixed wording — a generated file's explainer line or
    preamble, a message a skill reports — one shared source for it.

    `--lang` serves the writer that was handed a language rather than reading one: a
    domain doc follows the language its own tree is authored in, not the wiki's.

    Guarantees:
      - A repository with no language key configured, and a language carrying no text of
        its own, are both answered with the English wording rather than an error; the
        command always exits 0.

    Args:
      args: Parsed argument namespace; must carry `.key`, `.lang` and `.repo`.

    Returns:
      Integer exit code (always 0).
    """

    # Contract:
    # A repository with no language key configured, and a language carrying no text of
    # its own, MUST both be answered with the English wording rather than an error;
    # the command always exits 0.

    # an explicit --lang wins over the repo's resolved wiki language
    repo = Path(args.repo or os.environ.get(_ENV_REPO_ROOT) or os.getcwd()).resolve()
    lang = args.lang or _explainers.resolve_language(repo)
    print(_explainers.text_for(args.key, _explainers.language_code(lang)))
    return 0


  def _cmd_ensure_axes(self, args: argparse.Namespace) -> int:
    """
    Idempotently union axis names into the repository-wide `tag_axes` vocabulary.

    Adds only the axis names that are missing and leaves the rest of the vocabulary as it was,
    so repeating a call changes nothing. Prints the outcome to stdout as one JSON object.

    Args:
      args: Parsed argument namespace; must carry `.axes` and `.repo`.

    Returns:
      Integer exit code: `1` when the stored `wiki.tag_axes` is malformed (the printed JSON then
      carries a top-level `error` key); `0` otherwise.
    """
    # union the axes and print the outcome dict
    repo = Path(args.repo or os.environ.get(_ENV_REPO_ROOT) or os.getcwd()).resolve()
    result = _axes.ensure_axes(repo, args.axes)
    print(json.dumps(result))

    # the malformed-vocabulary shape counts as a CLI failure
    if self._AXES_ERROR in result:
      return 1
    return 0


  def _cmd_ensure_scope_config(self, args: argparse.Namespace) -> int:
    """
    Idempotently seed filter predicates, exclude globs, and index badges on one configured scope.

    Adds only what the scope is missing and leaves existing values as they were, so repeating
    a call changes nothing. Prints the outcome to stdout as one JSON object; an unusable
    `--filter-json` is reported there as an `error` key and seeds nothing.

    Args:
      args: Parsed argument namespace; must carry `.scope_id`, `.filter_json`, `.exclude`,
        `.index_badges`, and `.repo`.

    Returns:
      Integer exit code: `1` when the filter JSON does not parse to an object, when the named
      scope does not exist, or when the stored scopes are malformed; `0` otherwise.
    """
    repo = Path(args.repo or os.environ.get(_ENV_REPO_ROOT) or os.getcwd()).resolve()

    # parse the optional frontmatter predicates; without --filter-json none are seeded
    frontmatter = None
    if args.filter_json is not None:
      # guard: unparseable --filter-json — report it and seed nothing
      try:
        frontmatter = json.loads(args.filter_json)
      except json.JSONDecodeError as error:
        print(json.dumps({ "error": f"--filter-json is not valid JSON: {error}" }))
        return 1

      # guard: the predicates must arrive as an object keyed by frontmatter key
      if not isinstance(frontmatter, dict):
        print(json.dumps({ "error": "--filter-json must be a JSON object" }))
        return 1

    # seed the scope and print the outcome dict
    result = _axes.ensure_scope_config(
      repo, args.scope_id, filter_frontmatter = frontmatter, exclude = args.exclude,
      index_badges = args.index_badges,
    )
    print(json.dumps(result))

    # the malformed-scopes shape and the unknown-scope outcome both count as failure
    if self._AXES_ERROR in result or result.get(self._AXES_STATUS) == self._AXES_STATUS_ERROR:
      return 1
    return 0


  def _cmd_apply_node(self, args: argparse.Namespace) -> int:
    """
    Apply a curation.json result file to a node.

    Writes only the node regions the result carries: `wiki_summary`, `topics` and `connectors`
    update the classification, `see_also` updates the links, and a result with both updates
    both. A field the result leaves out keeps its current value in the node. Without `--job-dir`
    the apply is the whole run: it prints `apply-node: ok (classify)`, `(link)` or `(classify+link)`
    followed by the node file name on success, and a failure prints its reason on stderr.

    With `--job-dir` the result file defaults to the job's own curation and the verb also performs
    the daemon tail: on success it prints a one-line JSON outcome on stdout and every outcome,
    success or refusal, leaves `response.json` at the root of the job directory. A refusal is
    reported under the category logical, technical or transient; a failed file write or an unreachable
    core CLI is reported as a transient refusal. With `--ledger` the touched
    paths are recorded in the named ledger file.

    Notes:
      - Without `--job-dir` the caller owns the index rebuild and the commit.

    Args:
      args: Parsed argument namespace; must carry `.path`, `.from_file`, `.job_dir`, `.repo` and `.ledger`.

    Returns:
      Integer exit code: 0 on success; 1 when the node file or the result file is missing, the result
      carries no applicable field, the node's file type is not recognised, or the tail fails; 2 when
      neither `--from` nor `--job-dir` is given.
    """
    node_path = Path(args.path)
    job_dir = Path(args.job_dir) if args.job_dir else None
    repo = Path(args.repo or os.environ.get(_ENV_REPO_ROOT) or os.getcwd()).resolve()
    ledger = _touch_ledger.TouchLedger(path = Path(args.ledger)) if args.ledger else None

    # guard: neither --from nor --job-dir names a result file to read
    if not args.from_file and job_dir is None:
      print(f"{self._CMD_APPLY_NODE}: --from is required without --job-dir", file = sys.stderr)
      return 2

    # the result file: named on the command line, or the job's own curation by default
    if job_dir is not None and not args.from_file:
      curation_path = job_dir / self._JOB_CURATION
    else:
      curation_path = Path(args.from_file)

    # apply the curation; a refusal leaves the node untouched
    try:
      phase = self._read_job_phase(job_dir) if job_dir is not None else None
      applied = self._apply_curation(node_path, curation_path)
    except ( _job_response.JobRefusedError, *self._UNEXPECTED_FAILURES ) as caught:
      refusal = self._as_refusal(caught)
      print(f"{self._CMD_APPLY_NODE}: {refusal.reason}", file = sys.stderr)
      # without a job dir the exit code is the whole report
      if job_dir is None:
        return 1
      return self._refuse_job(job_dir, refusal, phase = None)

    # without a job dir the apply is the whole run; the caller owns index and commit
    if job_dir is None:
      if ledger is not None:
        ledger.record(repo, [ node_path ])
      print(f"apply-node: ok ({applied}) {node_path.name}")
      return 0

    # with a job dir the daemon tail follows and records its paths; a failure of either still answers the job
    try:
      outcome = self._apply_node_tail(repo, node_path, phase or applied)
      if ledger is not None:
        ledger.record(repo, outcome[self._OUT_TOUCHED])
    except ( _job_response.JobRefusedError, *self._UNEXPECTED_FAILURES ) as caught:
      refusal = self._as_refusal(caught)
      print(f"{self._CMD_APPLY_NODE}: {refusal.reason}", file = sys.stderr)
      return self._refuse_job(job_dir, refusal, phase = phase)

    # leave the job's answer where the runtime collects it
    _job_response.write_response(
      job_dir, outcome = self._OUTCOME_CURATED, result = [ self._RESULT_CURATION ],
    )
    print(json.dumps(outcome))
    return 0


  def _apply_curation(self, node_path: Path, curation_path: Path) -> str:
    """
    Write the fields of a curation result into a node.

    Notes:
      - A field the result leaves out keeps its current value in the node.

    Args:
      node_path: Node file to update.
      curation_path: Curator's result file.

    Returns:
      The phase applied: `classify`, `link` or `classify+link`.

    Raises:
      JobRefusedError: If the node or result file is missing, the result is unreadable or carries no applicable
        field, or the node's file type is not recognised.
    """
    # guard: node file does not exist
    if not node_path.is_file():
      raise _job_response.JobRefusedError(
        category = _job_response.CATEGORY_LOGICAL, reason = f"node not found: {node_path}",
      )
    # guard: curation.json does not exist
    if not curation_path.is_file():
      raise _job_response.JobRefusedError(
        category = _job_response.CATEGORY_TECHNICAL, reason = f"curation file not found: {curation_path}",
      )

    # load the curator's result; a file that is not a JSON object cannot carry fields
    try:
      with curation_path.open(encoding = self._ENCODING) as handle:
        curation = json.load(handle)
    except (OSError, ValueError) as error:
      raise _job_response.JobRefusedError(
        category = _job_response.CATEGORY_TECHNICAL, reason = f"curation file unreadable: {curation_path}: {error}",
      ) from error
    # guard: a non-object result carries no applicable field
    if not isinstance(curation, dict):
      curation = {}

    # sort the result's fields into the classify phase and the link phase
    has_classify = (
      self._FIELD_WIKI_SUMMARY in curation
      or self._FIELD_TOPICS in curation
      or self._FIELD_CONNECTORS in curation
    )
    has_link = self._FIELD_SEE_ALSO in curation

    # guard: neither classify nor link fields present — nothing to apply
    if not has_classify and not has_link:
      raise _job_response.JobRefusedError(
        category = _job_response.CATEGORY_TECHNICAL,
        reason = f"curation.json has no applicable fields: {curation_path}",
      )

    # resolve the node type that owns the file's managed regions
    node = _nodes.node_for(node_path)

    # guard: unrecognised file type
    if node is None:
      raise _job_response.JobRefusedError(
        category = _job_response.CATEGORY_LOGICAL, reason = f"unrecognised file type: {node_path}",
      )

    # a field the curation leaves out is passed as None, so the node keeps its current value
    if has_classify and has_link:
      node.apply(
        wiki_summary = curation.get(self._FIELD_WIKI_SUMMARY),
        topics = curation.get(self._FIELD_TOPICS),
        see_also_lines = curation.get(self._FIELD_SEE_ALSO, []),
        connectors = curation.get(self._FIELD_CONNECTORS),
      )
      return self._PHASE_CLASSIFY_LINK
    if has_classify:
      node.apply_classify(
        wiki_summary = curation.get(self._FIELD_WIKI_SUMMARY),
        topics = curation.get(self._FIELD_TOPICS),
        connectors = curation.get(self._FIELD_CONNECTORS),
      )
      return self._PHASE_CLASSIFY

    # only the link fields remain
    node.apply_link(see_also_lines = curation.get(self._FIELD_SEE_ALSO, []))
    return self._PHASE_LINK


  def _read_job_phase(self, job_dir: Path) -> str:
    """
    Read which curation phase a job was dispatched for.

    Args:
      job_dir: Job directory carrying the job's request.

    Returns:
      The phase named by the request: `classify` or `link`.

    Raises:
      JobRefusedError: If the request is unreadable or names any other phase.
    """
    request_path = job_dir / self._JOB_REQUEST

    # the job's own request names the phase; a request that cannot be read is a broken job
    try:
      request = json.loads(request_path.read_text(encoding = self._ENCODING))
    except (OSError, ValueError) as error:
      raise _job_response.JobRefusedError(
        category = _job_response.CATEGORY_TECHNICAL, reason = f"request unreadable: {request_path}: {error}",
      ) from error
    kind = request.get(self._PAYLOAD_KIND) if isinstance(request, dict) else None

    # guard: the curator produces only the classify and link phases
    if kind not in ( self._PHASE_CLASSIFY, self._PHASE_LINK ):
      raise _job_response.JobRefusedError(
        category = _job_response.CATEGORY_TECHNICAL, reason = f"request kind is not classify or link: {kind!r}",
      )
    return kind


  def _apply_node_tail(self, repo: Path, node_path: Path, phase: str) -> dict:
    """
    Finish an applied node: refresh the scope index, commit the written paths and chain the link phase.

    Notes:
      - Commits exactly the paths this call wrote and nothing else in the index.
      - After a classify phase the link phase of the same node is dispatched.

    Args:
      repo: Repository root.
      node_path: Node file that was just updated.
      phase: Phase that was applied: `classify` or `link`.

    Returns:
      The outcome record: status, phase, touched repo-relative paths, commit status and refusal reason.

    Raises:
      JobRefusedError: If a classified node belongs to no scope (logical), or the commit or the link dispatch
        fails (transient).
    """
    node_rel = _touch_ledger.TouchLedger.to_repo_rel(repo, node_path)
    touched = [ node_rel ]

    # classify rebuilds the node's scope index so the new tags reach the catalog the link phase reads
    if phase == self._PHASE_CLASSIFY:
      result = _scope.ScopeResolver(repo = repo).resolve_scope_by_path(node_path)
      # guard: a classified node outside every scope has no index to rebuild
      if result is None:
        raise _job_response.JobRefusedError(
          category = _job_response.CATEGORY_LOGICAL, reason = f"node belongs to no configured scope: {node_rel}",
        )
      scope_id, cfg = result
      index_path = _index.TopicIndex(repo = repo, cfg = cfg, scope_id = scope_id).build()
      touched.append(index_path.resolve().relative_to(repo).as_posix())

    # one commit of exactly the paths this tail wrote
    try:
      commit = _wiki_commit.commit_paths(repo, touched, f"wiki({phase}): {node_path.name}")
    except _wiki_commit.WikiCommitError as error:
      raise _job_response.JobRefusedError(
        category = _job_response.CATEGORY_TRANSIENT, reason = str(error),
      ) from error

    # a classified node chains its own link phase; its report goes to stderr so stdout stays one JSON line
    if phase == self._PHASE_CLASSIFY:
      try:
        with contextlib.redirect_stdout(sys.stderr):
          exit_code = self._cmd_dispatch_link(argparse.Namespace(path = str(node_path), repo = str(repo)))
      except (OSError, RuntimeError, ValueError, subprocess.SubprocessError) as error:
        raise _job_response.JobRefusedError(
          category = _job_response.CATEGORY_TRANSIENT, reason = f"dispatch-link failed: {error}",
        ) from error
      # guard: the chained dispatch reported a failure of its own
      if exit_code != 0:
        raise _job_response.JobRefusedError(
          category = _job_response.CATEGORY_TRANSIENT, reason = f"dispatch-link exited {exit_code}",
        )

    # the outcome line the agent reads its success from
    return {
      self._OUT_STATUS:  self._OUTCOME_CURATED,
      self._OUT_PHASE:   phase,
      self._OUT_TOUCHED: touched,
      self._OUT_COMMIT:  commit.status,
      self._OUT_REASON:  None,
    }


  @staticmethod
  def _as_refusal(caught: Exception) -> _job_response.JobRefusedError:
    """
    Turn a failure of a job-dir verb into the refusal reported for the job.

    A refusal passes through unchanged; any other failure becomes a transient refusal carrying the failure's text.

    Args:
      caught: The failure raised while the verb ran.

    Returns:
      The refusal to report for the job.
    """
    # a refusal stays as it is; any other failure is reported as a transient one the runner retries
    if isinstance(caught, _job_response.JobRefusedError):
      return caught
    return _job_response.JobRefusedError(
      category = _job_response.CATEGORY_TRANSIENT, reason = str(caught) or repr(caught),
    )


  def _refuse_job(self, job_dir: Path, refusal: _job_response.JobRefusedError, *, phase: str | None) -> int:
    """
    Report a refused job to the runtime and to stdout.

    The job's response carries the refusal category and reason, and stdout gets one JSON outcome line with status
    `refused`, no touched paths and no commit.

    Args:
      job_dir: Job directory the response is written into.
      refusal: The refusal to report.
      phase: Phase the job was dispatched for, or None when it could not be read.

    Returns:
      Exit code 1.
    """
    # the job's answer carries the refusal, so the runtime sees a failure instead of silence
    _job_response.write_response(
      job_dir, outcome = _job_response.OUTCOME_ERROR, category = refusal.category, message = refusal.reason,
    )
    print(json.dumps({
      self._OUT_STATUS:  self._STATUS_REFUSED,
      self._OUT_PHASE:   phase,
      self._OUT_TOUCHED: [],
      self._OUT_COMMIT:  None,
      self._OUT_REASON:  refusal.reason,
    }))
    return 1


  def _cmd_build_index(self, args: argparse.Namespace) -> int:
    """
    Rebuild the topics.md index for the given scope.

    Regenerates the index from the scope's current node tags; the same nodes always yield the
    same file. Prints `build-index: ok <scope> → <index path>` on stdout; an unknown scope
    prints the known scope ids on stderr. With `--ledger` the rebuilt index path is recorded in the
    named ledger file.

    Args:
      args: Parsed argument namespace; must carry `.scope_id`, `.repo` and `.ledger`.

    Returns:
      Integer exit code (0 on success, 1 when the scope is unknown).
    """
    repo = Path(args.repo or os.environ.get(_ENV_REPO_ROOT) or os.getcwd()).resolve()
    scopes = _scope.ScopeResolver(repo = repo).load_scopes()

    # guard: requested scope id not present in settings
    if args.scope_id not in scopes:
      print(
        f"{self._CMD_BUILD_INDEX}: {self._MSG_UNKNOWN_SCOPE} '{args.scope_id}' "
        f"(known: {', '.join(sorted(scopes)) or 'none'})",
        file = sys.stderr,
      )
      return 1

    # rebuild the scope's index and report where it landed
    out_path = _index.TopicIndex(repo = repo, cfg = scopes[args.scope_id], scope_id = args.scope_id).build()
    if args.ledger:
      _touch_ledger.TouchLedger(path = Path(args.ledger)).record(repo, [ out_path ])
    print(f"build-index: ok {args.scope_id} → {out_path.relative_to(repo).as_posix()}")
    return 0


  def _cmd_structure_watch_config(self, args: argparse.Namespace) -> int:
    """
    Print the derived watch configuration, or check the registered routines against it.

    Without `--check` the derived `path_filter` is printed as one JSON object for a caller
    to splice into a routine registration. With `--check` every registered structure-scan
    routine is compared against that derivation and the differences are reported — a
    lingering `group_globs` or `group` key among them — which is what makes a stale
    registration a failure rather than a judgement.

    Args:
      args: Parsed argument namespace; must carry `.repo` and `.check`.

    Returns:
      Integer exit code — 0 when nothing drifted, 1 when `--check` found a difference.
    """
    repo = Path(args.repo or os.environ.get(_ENV_REPO_ROOT) or os.getcwd()).resolve()
    watch = _structure.StructureWatch(repo = repo)

    # without --check the derivation itself is the whole output
    if not args.check:
      print(json.dumps(watch.expected(), indent = 2, sort_keys = True))
      return 0

    # compare each registered structure routine against what the section derives
    registered = self._load_structure_routines(repo)
    drifted = { name: watch.drift(cfg) for name, cfg in registered.items() }
    drifted = { name: found for name, found in drifted.items() if found }
    print(json.dumps({
      "expected": watch.expected(),
      "routines": sorted(registered),
      "drift": drifted,
    }, indent = 2, sort_keys = True))
    return 1 if drifted else 0


  def _cmd_core_cli(self) -> int:
    """
    Print the absolute path of the `lazycortex-core` CLI this plugin dispatches to.

    An agent prompt shipped by this plugin has no fixed address for the core plugin; this verb
    hands it one. The path is the only stdout output.

    Returns:
      Integer exit code — 0 with the path on stdout, 1 with an `error:` line on stderr when no
      stage resolves core.
    """
    # resolve through the plugin's one core-CLI resolver — the verb exists to expose it, not to add a copy
    try:
      cli = _axes.resolve_core_cli()
    except RuntimeError as error:
      print(f"error: {error}", file = sys.stderr)
      return 1
    print(cli)
    return 0


  def _cmd_render_navigation_rule(self, args: argparse.Namespace) -> int:
    """
    Install or refresh the wiki navigation rule and print the outcome as one JSON line.

    Install mode renders the shipped rule from the repository's configured wiki scopes and domains; with no
    scopes configured the shipped Coverage text is kept. In-place mode refreshes only the named sections of the
    already installed copy; with no scopes configured its Coverage section is left empty. The target is
    `lazy-wiki.navigation.md` in the given rules directory, otherwise in the repository's `.claude/rules/`, with
    the home `~/.claude/rules/` copy used only when it alone exists.

    Notes:
      - Writes the rule file only when its content changes; an identical rule keeps its bytes and timestamp.
      - Writes nothing when no rule is installed and `--create` is not given.
      - Commits the rule only when it is git-tracked, and only when `--commit` is given.
      - Prints a JSON object with `status` (`installed`, `refreshed`, `unchanged` or `absent`), `path`, `coverage`
        (`rendered` or `no-scopes`), `domain_coverage` (`rendered` or `no-domains`) and `commit` (`committed`,
        `unchanged`, `untracked` or `null`).

    Args:
      args: Parsed argument namespace; carries `.repo`, `.rules_dir`, `.create`, `.in_place`, `.section`, `.commit`
        and `.subject`.

    Returns:
      Integer exit code — 0 on success, 1 when the git commit fails (the JSON line is still printed), 2 when
      `--create` and `--in-place` are combined.
    """
    repo = Path(args.repo or os.environ.get(_ENV_REPO_ROOT) or os.getcwd()).resolve()

    # guard: the install-only switch has no meaning against an installed copy
    if args.create and args.in_place:
      print(f"{self._CMD_RENDER_NAVIGATION_RULE}: --create and --in-place exclude each other", file = sys.stderr)
      return 2

    # the renderings both modes compose from
    coverage = _navigation.render_coverage(_scope.ScopeResolver(repo = repo).load_scopes())
    domain_cfg = _domains.DomainConfig.load(repo)
    domain_coverage = _navigation.render_domain_coverage(domain_cfg)
    target = self._resolve_nav_target(repo, args.rules_dir)
    outcome = {
      self._OUT_STATUS:          self._NAV_ABSENT,
      self._OUT_PATH:            str(target),
      self._OUT_COVERAGE:        self._NAV_RENDERED if coverage is not None else self._NAV_NO_SCOPES,
      self._OUT_DOMAIN_COVERAGE: self._NAV_RENDERED if domain_cfg is not None else self._NAV_NO_DOMAINS,
      self._OUT_COMMIT:          None,
    }

    # guard: no installed rule and no install request — nothing to write
    if not target.is_file() and not args.create:
      print(json.dumps(outcome))
      return 0

    # in place, the installed copy is the source and only the named sections change
    target_file = _textfile.TextFile(path = target)
    current = target_file.read() if target.is_file() else None
    if args.in_place and current is not None:
      wants_coverage = args.section in ( None, self._NAV_SECTION_COVERAGE )
      wants_domains = args.section in ( None, self._NAV_SECTION_DOMAIN_COVERAGE )
      text = _navigation.compose(
        current,
        coverage = (coverage or "") if wants_coverage else None,
        domain_coverage = domain_coverage if wants_domains else None,
      )
    else:
      text = _navigation.compose(
        _textfile.TextFile(path = self._NAV_SHIPPED).read(), coverage = coverage, domain_coverage = domain_coverage,
      )

    # write only a changed rule, so an unchanged one keeps its bytes and its timestamp
    if text == current:
      outcome[self._OUT_STATUS] = self._NAV_UNCHANGED
    else:
      target.parent.mkdir(parents = True, exist_ok = True)
      target_file.write(text)
      outcome[self._OUT_STATUS] = self._NAV_INSTALLED if current is None else self._NAV_REFRESHED

    # without a commit request the outcome is complete
    if not args.commit:
      print(json.dumps(outcome))
      return 0

    # commit the rule when the repository tracks it; a failed commit still reports the outcome
    try:
      outcome[self._OUT_COMMIT] = self._commit_tracked(repo, target, args.subject or self._NAV_DEFAULT_SUBJECT)
    except _wiki_commit.WikiCommitError as error:
      print(f"{self._CMD_RENDER_NAVIGATION_RULE}: {error}", file = sys.stderr)
      print(json.dumps(outcome))
      return 1
    print(json.dumps(outcome))
    return 0


  def _resolve_nav_target(self, repo: Path, rules_dir: str | None) -> Path:
    """
    Return the path of the navigation rule file to install or refresh.

    An explicit rules directory always decides the target. Otherwise the repository's own rule is used, except
    when only the home rule exists.

    Args:
      repo: Repository root whose `.claude/rules/` directory is the default location.
      rules_dir: Explicit rules directory, or `None` to use the default lookup.

    Returns:
      The target path; the file itself may not exist yet.
    """
    # an explicit directory is the target, whatever exists there
    if rules_dir:
      return Path(rules_dir) / self._NAV_RULE_NAME

    # the repo's own rule wins; the home copy is used only when the repo has none and home does
    repo_target = repo / self._NAV_REPO_RULES / self._NAV_RULE_NAME
    home_target = self._NAV_HOME_RULES / self._NAV_RULE_NAME
    return home_target if not repo_target.is_file() and home_target.is_file() else repo_target


  def _commit_tracked(self, repo: Path, target: Path, subject: str) -> str:
    """
    Commit the navigation rule when the repository tracks it.

    A rule outside the repository, or one git does not track, is left uncommitted in the worktree.

    Args:
      repo: Repository root the commit is made in.
      target: Path of the navigation rule file.
      subject: Commit subject line.

    Returns:
      The commit status — `untracked` when the rule is outside the repository or not tracked, otherwise the status
      the commit reports (`committed` or `unchanged`).

    Raises:
      WikiCommitError: If the git commit fails.
    """
    # guard: a rule outside the repository is never tracked by it
    try:
      rel = target.resolve().relative_to(repo).as_posix()
    except ValueError:
      return self._NAV_UNTRACKED

    # ask git whether it tracks the rule
    tracked = subprocess.run(
      [ "git", "ls-files", "--error-unmatch", "--", rel ],
      cwd = str(repo), capture_output = True, text = True, check = False, encoding = self._ENCODING,
    )

    # guard: an untracked rule stays in the worktree, uncommitted
    if tracked.returncode != 0:
      return self._NAV_UNTRACKED

    # a tracked rule is committed on its own path
    return _wiki_commit.commit_paths(repo, [ rel ], subject).status


  @staticmethod
  def _load_structure_routines(repo: Path) -> dict:
    """
    Return every registered routine whose name marks it as a structure scan.

    Args:
      repo: Repository root whose settings hold the routine registry.

    Returns:
      A mapping of routine name to its config dict; empty when none are registered.
    """
    settings_file = repo / Cli._SETTINGS_REL

    # guard: no settings file — nothing is registered
    if not settings_file.is_file():
      return {}

    # an unreadable registry is reported as an empty one; the caller's check then finds every
    # derived key missing, which is the honest verdict for settings nobody can read
    try:
      with settings_file.open(encoding = Cli._ENCODING) as handle:
        data = json.load(handle)
    except (OSError, json.JSONDecodeError):
      return {}
    routines = data.get(Cli._SETTINGS_ROUTINES, {})

    # guard: registry absent or malformed
    if not isinstance(routines, dict):
      return {}
    return {
      name: cfg for name, cfg in routines.items()
      if isinstance(cfg, dict) and name.startswith(Cli._STRUCTURE_SCAN_PREFIX)
    }


  def _cmd_relink_plan(self, args: argparse.Namespace) -> int:
    """
    Compute the daemon-free relink plan for a scope and print it as JSON.

    The plan names a mode (`initial`, `incremental` or `anchor-lost`, depending on the scope's
    `wiki_synced_sha` anchor) and the classify, link and drop path sets for it. Nothing is
    dispatched or written; the plan is printed to stdout as a single JSON object. An unknown
    scope prints the known scope ids on stderr.

    Args:
      args: Parsed argument namespace; must carry `.scope_id` and `.repo`.

    Returns:
      Integer exit code (0 on success, 1 when the scope is unknown).
    """
    repo = Path(args.repo or os.environ.get(_ENV_REPO_ROOT) or os.getcwd()).resolve()
    scopes = _scope.ScopeResolver(repo = repo).load_scopes()

    # guard: requested scope id not present in settings
    if args.scope_id not in scopes:
      print(
        f"{self._CMD_RELINK_PLAN}: {self._MSG_UNKNOWN_SCOPE} '{args.scope_id}' "
        f"(known: {', '.join(sorted(scopes)) or 'none'})",
        file = sys.stderr,
      )
      return 1

    # compute the plan against the scope's synced-sha anchor and emit it
    planner = _relink.RelinkPlanner(
      repo     = repo,
      scope_id = args.scope_id,
      cfg      = scopes[args.scope_id],
    )
    print(json.dumps(planner.plan()))
    return 0


  def _cmd_relink_all(self, args: argparse.Namespace) -> int:
    """
    Dispatch a classify curation job for every changed node in the requested scope or in every configured scope.

    A node whose stored source hash equals its current source hash is left alone, the same check `process-file`
    applies; a node with no stored hash or a differing one is dispatched. Without a scope id it passes over the
    whole configuration; with one it passes over that scope only.

    Notes:
      - Exits 1 with a `relink-all: unknown scope '<id>'` message on stderr when a
        scope id is given and is not configured.
      - Dispatches one classify job per changed node without waiting for any job to complete.
      - Prints `{"scope": "<id>", "dispatched": N, "skipped": K, "unchanged": U}` as one JSON line per
        scope passed over, so a run with no scope configured prints nothing and exits 0.
      - `skipped` counts files the node factory does not recognise; `unchanged` counts nodes left alone
        because their source is unchanged.

    Args:
      args: Parsed argument namespace; must carry `.scope_id` (None for every scope) and `.repo`.

    Returns:
      Integer exit code (0 on success, 1 when a named scope is unknown).
    """
    repo = Path(args.repo or os.environ.get(_ENV_REPO_ROOT) or os.getcwd()).resolve()
    resolver = _scope.ScopeResolver(repo = repo)
    scopes = resolver.load_scopes()

    # guard: a named scope that is not present in settings is an operator error
    if args.scope_id is not None and args.scope_id not in scopes:
      print(
        f"{self._CMD_RELINK_ALL}: {self._MSG_UNKNOWN_SCOPE} '{args.scope_id}' "
        f"(known: {', '.join(sorted(scopes)) or 'none'})",
        file = sys.stderr,
      )
      return 1

    # pass over the named scope, or every configured one, reporting one JSON line per scope
    targets = sorted(scopes) if args.scope_id is None else [ args.scope_id ]
    for scope_id in targets:
      dispatched, skipped, unchanged = self._relink_scope(repo, resolver, scope_id, scopes[scope_id])
      print(json.dumps({
        "scope":      scope_id,
        "dispatched": dispatched,
        "skipped":    skipped,
        "unchanged":  unchanged,
      }))
    return 0


  def _relink_scope(self,
                    repo: Path,
                    resolver: _scope.ScopeResolver,
                    scope_id: str,
                    scope_cfg: dict) -> tuple[int, int, int]:
    """
    Dispatch a classify curation job for every node in one scope whose operator source changed.

    The scope's existing per-axis tag values are collected once and shared across every
    dispatched payload as the classify anchor, so curators on a cold catalog still pull
    the consolidated vocabulary.

    Args:
      repo: Absolute path to the repository root.
      resolver: Scope resolver used to enumerate the scope's nodes.
      scope_id: Scope identifier as defined in `lazy.settings.json[wiki.scopes]`.
      scope_cfg: Configuration block for that scope.

    Returns:
      A `(dispatched, skipped, unchanged)` triple; `skipped` counts files the node factory does not recognise
      and `unchanged` counts nodes left alone because their source is unchanged.
    """
    # the scope's declared axes travel with every payload
    tag_axes: list[str] = scope_cfg.get(self._CFG_TAG_AXES) or []

    # the scope's per-axis vocabulary, collected once as the classify anchor of every payload
    existing_tags = _tags.TagOps(
      repo = repo, scope_id = scope_id, cfg = scope_cfg,
    ).collect()

    # queue one classify job per recognised node whose source changed, counting the files the
    # node factory rejects and the nodes left alone apart
    dispatcher = _dispatch.CoreDispatch()
    dispatched = 0
    skipped = 0
    unchanged = 0
    for abs_path in resolver.find_all_nodes(scope_cfg):
      node_obj = _nodes.node_for(abs_path)

      # guard: unrecognised file type — scope glob caught it but node-factory rejected
      if node_obj is None:
        skipped += 1
        continue

      # a node whose operator source is unchanged since its last curation is counted, not re-curated;
      # a node never curated (no stored hash) or edited since (a differing one) falls through to dispatch
      if node_obj.stored_src_hash == node_obj.source_hash:
        unchanged += 1
        continue

      # the node's pins and the scope's vocabulary make up its classify job
      pins = {
        "pinned_topics":    node_obj.pinned_topics,
        "unrelated_topics": node_obj.unrelated_topics,
        "pinned_links":     node_obj.pinned_links,
        "unrelated_links":  node_obj.unrelated_links,
      }
      payload = {
        self._PAYLOAD_KIND:          _dispatch.CoreDispatch.KIND_CLASSIFY,
        self._PAYLOAD_NODE_PATH:     str(abs_path),
        self._CFG_TAG_AXES:          tag_axes,
        self._PAYLOAD_SCOPE_ID:      scope_id,
        self._PAYLOAD_PINS:          pins,
        self._PAYLOAD_EXISTING_TAGS: existing_tags,
      }
      dispatcher.dispatch_curator(
        repo = repo,
        node_path = abs_path,
        payload = payload,
      )
      dispatched += 1

    # all three counts feed the caller's per-scope report line
    return dispatched, skipped, unchanged


  def _cmd_find_candidates(self, args: argparse.Namespace) -> int:
    """
    Recall a ranked link-candidate shortlist for a node and print it as JSON.

    The shortlist respects the node's pins and holds at most `--top-n` entries. It is printed
    to stdout as a JSON array of repo-relative POSIX candidate paths. An empty array (`[]`) is
    valid and tells the link curator to fall back to topics.md judgment. An unknown scope
    prints the known scope ids on stderr.

    Args:
      args: Parsed argument namespace; must carry `.node_path`, `.scope_id`,
        `.repo`, and `.top_n`.

    Returns:
      Integer exit code (0 on success, 1 when the scope is unknown).
    """
    repo = Path(args.repo or os.environ.get(_ENV_REPO_ROOT) or os.getcwd()).resolve()
    scopes = _scope.ScopeResolver(repo = repo).load_scopes()

    # guard: requested scope id not present in settings
    if args.scope_id not in scopes:
      print(
        f"{self._CMD_FIND_CANDIDATES}: {self._MSG_UNKNOWN_SCOPE} '{args.scope_id}' "
        f"(known: {', '.join(sorted(scopes)) or 'none'})",
        file = sys.stderr,
      )
      return 1

    # a relative node path resolves against the repository root
    node_path = Path(args.node_path)
    abs_path = node_path if node_path.is_absolute() else repo / node_path

    # rank the node's link candidates and print the shortlist
    finder = _candidates.CandidateFinder.with_default_sources(
      repo,
      scopes[args.scope_id],
      args.scope_id,
      top_n = args.top_n,
    )
    print(json.dumps(finder.find(abs_path)))
    return 0


  def _cmd_find_back_candidates(self, args: argparse.Namespace) -> int:
    """
    Recall scope nodes that attract a node and print them as a JSON array.

    A node attracts the target when the target is among that node's own top `--top-n` link
    candidates, so the result is the set of nodes that should consider linking to the target.
    It is printed to stdout as a JSON array of repo-relative POSIX paths; an empty array is
    valid. An unknown scope prints the known scope ids on stderr.

    Args:
      args: Parsed argument namespace; must carry `.node_path`, `.scope_id`,
        `.repo`, and `.top_n`.

    Returns:
      Integer exit code (0 on success, 1 when the scope is unknown).
    """
    repo = Path(args.repo or os.environ.get(_ENV_REPO_ROOT) or os.getcwd()).resolve()
    scopes = _scope.ScopeResolver(repo = repo).load_scopes()

    # guard: requested scope id not present in settings
    if args.scope_id not in scopes:
      print(
        f"{self._CMD_FIND_BACK_CANDIDATES}: {self._MSG_UNKNOWN_SCOPE} '{args.scope_id}' "
        f"(known: {', '.join(sorted(scopes)) or 'none'})",
        file = sys.stderr,
      )
      return 1

    # a relative node path resolves against the repository root
    node_path = Path(args.node_path)
    abs_path = node_path if node_path.is_absolute() else repo / node_path

    # find the scope nodes the target attracts and print them
    finder = _candidates.BackCandidateFinder(
      repo,
      scopes[args.scope_id],
      args.scope_id,
      top_n = args.top_n,
    )
    print(json.dumps(finder.find(abs_path)))
    return 0


  def _cmd_collect_tags(self, args: argparse.Namespace) -> int:
    """
    Survey the distinct tag values per axis for a scope and print them as JSON.

    Reports, per axis, each tag value in use with its count and example summaries, as a
    single JSON object on stdout. The reserved scope id `domains` surveys the generated
    domain-doc tree instead of a configured scope. Nothing is written.

    Args:
      args: Parsed argument namespace; must carry `.scope_id` and `.repo`.

    Returns:
      Integer exit code (0 on success, 1 when the scope is unknown or a configured scope is
      itself named `domains`).
    """
    repo = Path(args.repo or os.environ.get(_ENV_REPO_ROOT) or os.getcwd()).resolve()
    scopes = _scope.ScopeResolver(repo = repo).load_scopes()

    # guard: a configured scope literally named 'domains' would collide with the reserved surface
    if args.scope_id == self._SURFACE_DOMAINS and self._SURFACE_DOMAINS in scopes:
      print(self._MSG_DOMAINS_COLLISION.format(cmd = self._CMD_COLLECT_TAGS), file = sys.stderr)
      return 1

    # the domains surface is not a configured wiki scope — its own factory enumerates it
    if args.scope_id == self._SURFACE_DOMAINS:
      print(json.dumps(_tags.TagOps.for_domains(repo = repo).collect()))
      return 0

    # guard: requested scope id not present in settings
    if args.scope_id not in scopes:
      print(
        f"{self._CMD_COLLECT_TAGS}: {self._MSG_UNKNOWN_SCOPE} '{args.scope_id}' "
        f"(known: {', '.join(sorted(scopes)) or 'none'})",
        file = sys.stderr,
      )
      return 1

    # survey the configured scope's tag values
    ops = _tags.TagOps(repo = repo, scope_id = args.scope_id, cfg = scopes[args.scope_id])
    print(json.dumps(ops.collect()))
    return 0


  def _cmd_retag(self, args: argparse.Namespace) -> int:
    """
    Apply an axis-value alias map to a scope's node tags and print the outcome.

    Rewrites each aliased tag value in the node's managed region and nothing else. The
    reserved scope id `domains` retags the generated domain-doc tree instead of a configured
    scope. The outcome (`nodes_changed` and `tags_remapped`) is printed to stdout as JSON.

    Args:
      args: Parsed argument namespace; must carry `.scope_id`, `.from_file`,
        and `.repo`.

    Returns:
      Integer exit code (0 on success, 1 when the scope is unknown, a configured scope is itself
      named `domains`, or the alias-map file is missing or not a JSON object).
    """
    repo = Path(args.repo or os.environ.get(_ENV_REPO_ROOT) or os.getcwd()).resolve()

    # locate the alias-map file named on the command line
    alias_path = Path(args.from_file)

    # guard: alias-map file does not exist
    if not alias_path.is_file():
      print(f"retag: alias-map not found: {alias_path}", file = sys.stderr)
      return 1

    # load the alias map; only an object can map old axis values to new ones
    with alias_path.open(encoding = self._ENCODING) as handle:
      alias_map = json.load(handle)

    # guard: alias-map must be a JSON object
    if not isinstance(alias_map, dict):
      print(f"retag: alias-map must be a JSON object: {alias_path}", file = sys.stderr)
      return 1

    # scopes are loaded once and shared by both the collision guard and the ordinary lookup below
    scopes = _scope.ScopeResolver(repo = repo).load_scopes()

    # guard: a configured scope literally named 'domains' would collide with the reserved surface
    if args.scope_id == self._SURFACE_DOMAINS and self._SURFACE_DOMAINS in scopes:
      print(self._MSG_DOMAINS_COLLISION.format(cmd = self._CMD_RETAG), file = sys.stderr)
      return 1

    # the domains surface is not a configured wiki scope — its own factory enumerates it
    if args.scope_id == self._SURFACE_DOMAINS:
      print(json.dumps(_tags.TagOps.for_domains(repo = repo).retag(alias_map)))
      return 0

    # guard: requested scope id not present in settings
    if args.scope_id not in scopes:
      print(
        f"{self._CMD_RETAG}: {self._MSG_UNKNOWN_SCOPE} '{args.scope_id}' "
        f"(known: {', '.join(sorted(scopes)) or 'none'})",
        file = sys.stderr,
      )
      return 1

    # rewrite the configured scope's aliased tags
    ops = _tags.TagOps(repo = repo, scope_id = args.scope_id, cfg = scopes[args.scope_id])
    print(json.dumps(ops.retag(alias_map)))
    return 0


  def _cmd_tag_tick(self, args: argparse.Namespace) -> int:
    """
    Survey every tag surface and dispatch a tag-curator job per non-empty one.

    The surfaces are every configured wiki scope, plus the generated domain-doc tree when
    `wiki.domains` is configured. A surface carrying no tags is passed over. Prints one JSON
    line per surface, `{"surface": <id>, "dispatched": true}` for a queued job and
    `{"surface": <id>, "dispatched": false, "reason": "empty"}` for a surface passed over.
    Does not wait for any job to complete.

    Args:
      args: Parsed argument namespace; must carry `.repo`.

    Returns:
      Integer exit code (0 on success, 1 when a configured scope collides with
      the reserved `domains` surface).
    """

    # Domain(wiki.taxonomy):
    # # One canon judgement per surface
    # Tag values drift within the body of documents that share a vocabulary, so a canon is judged per such
    # body and never across them: two surfaces may legitimately spell the same idea differently, and one
    # judgement spanning both would erase a distinction nobody asked to lose. A surface carrying no tags at
    # all is passed over rather than sent for judgement — there is nothing to consolidate, and a request for
    # work with no material only occupies the queue.

    repo = Path(args.repo or os.environ.get(_ENV_REPO_ROOT) or os.getcwd()).resolve()
    scopes = _scope.ScopeResolver(repo = repo).load_scopes()

    # guard: a configured scope literally named 'domains' would collide with the reserved surface
    if self._SURFACE_DOMAINS in scopes:
      print(self._MSG_DOMAINS_COLLISION.format(cmd = self._CMD_TAG_TICK), file = sys.stderr)
      return 1

    # every configured scope is a tag surface, taken in a stable order
    surfaces: list[tuple[str, _tags.TagOps]] = [
      (scope_id, _tags.TagOps(repo = repo, scope_id = scope_id, cfg = scopes[scope_id]))
      for scope_id in sorted(scopes)
    ]

    # the generated domain-doc tree is a tag surface of its own, not a configured scope
    if _domains.DomainConfig.load(repo) is not None:
      surfaces.append((self._SURFACE_DOMAINS, _tags.TagOps.for_domains(repo = repo)))

    # survey each surface and queue a tag-curator job only for one that carries tags
    dictionary = _tags.dictionary_rel(repo)
    dispatcher: _dispatch.CoreDispatch | None = None
    for surface, ops in surfaces:
      collected = ops.collect()

      # guard: nothing tagged on this surface — no canon to judge, so no job to queue
      if not collected[_tags.COLLECT_AXES]:
        print(json.dumps({
          self._TICK_SURFACE:    surface,
          self._TICK_DISPATCHED: False,
          self._TICK_REASON:     self._TICK_EMPTY,
        }))
        continue

      # resolve the core CLI only once a job is actually going out
      if dispatcher is None:
        dispatcher = _dispatch.CoreDispatch()
      dispatcher.dispatch_tag_curator(
        repo = repo,
        surface = surface,
        payload = {
          self._PAYLOAD_KIND:           _dispatch.CoreDispatch.KIND_NORMALIZE_TAGS,
          self._PAYLOAD_SURFACE:        surface,
          self._PAYLOAD_TAG_DICTIONARY: dictionary,
        },
        collected_tags = collected,
      )
      print(json.dumps({ self._TICK_SURFACE: surface, self._TICK_DISPATCHED: True }))
    return 0


  def _cmd_tag_apply(self, args: argparse.Namespace) -> int:
    """
    Apply a curated tag canon to one tag surface and print the outcome.

    Retags the surface's nodes through the alias map and rewrites the advisory tag-values dictionary
    to match, using the glosses for values the dictionary does not yet record. The reserved scope id
    `domains` names the generated domain-doc tree instead of a configured scope. Prints one JSON line
    `{status, nodes_changed, touched_paths, commit, reason}` on stdout, where `status` is `applied`,
    `empty` or `refused`. With `--ledger` the touched paths are recorded in the named ledger file.

    With `--job-dir` the verb also performs the daemon tail: a scope surface gets its index rebuilt,
    the touched paths are committed as `wiki(normalize-tags): <surface>`, and
    `response.json` is left at the root of the job directory. The outcome is `curated`, listing
    `result/alias_map.json`, or `empty` with no result when the alias map is empty and the dictionary
    needed no change.

    Notes:
      - A refusal from a check, raised before the first write, leaves the nodes and the dictionary untouched.
      - Without `--job-dir` the caller owns the index rebuild and the commit.
      - With `--job-dir` a relative alias-map or glosses path is read inside the job directory.
      - A refusal from a check is reported under the category technical, and a failed commit under the category
        transient; any other failure, such as a failed file or ledger write, an undecodable file or an
        unreachable core CLI, is reported as a transient refusal.

    Args:
      args: Parsed argument namespace; must carry `.scope_id`, `.from_file`, `.glosses_file`, `.job_dir`,
        `.ledger` and `.repo`.

    Returns:
      Integer exit code (0 when the canon is applied or there was nothing to apply, 1 on a refusal).
    """
    repo = Path(args.repo or os.environ.get(_ENV_REPO_ROOT) or os.getcwd()).resolve()
    job_dir = Path(args.job_dir) if args.job_dir else None

    # a refusal from a check, raised before the first write, leaves nodes and dictionary untouched
    try:
      alias_map = self._read_json_object(
        self._resolve_job_input(Path(args.from_file), job_dir), what = self._WHAT_ALIAS_MAP,
      )
      glosses = self._read_json_object(
        self._resolve_job_input(Path(args.glosses_file), job_dir), what = self._WHAT_GLOSSES,
      )
      ops = self._tag_surface_ops(repo, args.scope_id)
      dictionary = _tags.TagDictionary(repo = repo)
      missing = dictionary.find_all_missing_glosses(
        post_values = self._compute_post_values(ops, alias_map), alias_map = alias_map, glosses = glosses,
      )
      # guard: a value the dictionary does not record must arrive with a gloss
      if missing:
        named = ", ".join(f"{axis}/{value}" for axis, value in missing)
        raise _job_response.JobRefusedError(
          category = _job_response.CATEGORY_TECHNICAL, reason = f"no gloss for new value(s): {named}",
        )
      outcome = self._apply_tag_canon(
        repo, args.scope_id, ops,
        dictionary = dictionary, alias_map = alias_map, glosses = glosses, job_dir = job_dir,
      )
      if args.ledger:
        _touch_ledger.TouchLedger(path = Path(args.ledger)).record(repo, outcome[self._OUT_TOUCHED])
    except ( _job_response.JobRefusedError, *self._UNEXPECTED_FAILURES ) as caught:
      refusal = self._as_refusal(caught)
      print(f"{self._CMD_TAG_APPLY}: {refusal.reason}", file = sys.stderr)
      return self._refuse_tag_apply(job_dir, refusal)

    # the job answer follows a completed apply
    if job_dir is not None:
      # an empty outcome lists no result; a curated one lists the alias map
      if outcome[self._OUT_STATUS] == self._OUTCOME_EMPTY:
        _job_response.write_response(job_dir, outcome = self._OUTCOME_EMPTY)
      else:
        _job_response.write_response(
          job_dir, outcome = self._OUTCOME_CURATED, result = [ self._RESULT_ALIAS_MAP ],
        )
    print(json.dumps(outcome))
    return 0


  @staticmethod
  def _resolve_job_input(path: Path, job_dir: Path | None) -> Path:
    """
    Resolve an input file a job-dir verb was handed.

    Args:
      path: The input file as given on the command line.
      job_dir: The job directory, or None outside a job.

    Returns:
      The path itself when it is absolute or no job directory is given, otherwise the path taken inside the
      job directory.
    """

    # Contract:
    # Inside a job a relative input path names a file of the job directory (`result/alias_map.json`), never
    # one under the working directory, because the expert writes its result files into its job directory.

    # guard: an absolute path, or a run outside a job, is read as given
    if path.is_absolute() or job_dir is None:
      return path
    return job_dir / path


  def _apply_tag_canon(self,
                       repo: Path,
                       surface: str,
                       ops: _tags.TagOps,
                       *,
                       dictionary: _tags.TagDictionary,
                       alias_map: dict,
                       glosses: dict,
                       job_dir: Path | None) -> dict:
    """
    Retag a surface, rewrite its tag-values dictionary and, for a job, commit the result.

    Writes the node tags and the dictionary only where their content changes. With a job directory a
    scope surface also has its index rebuilt, and the touched paths are committed as
    `wiki(normalize-tags): <surface>`.

    Args:
      repo: Repository root.
      surface: Scope id of the tag surface, or the reserved `domains` surface.
      ops: Tag operations bound to the surface.
      dictionary: Tag-values dictionary to merge the surface's values into.
      alias_map: Mapping from axis to old value to canonical value; may be empty.
      glosses: Glosses for values the dictionary does not yet record.
      job_dir: Job directory when the daemon tail is wanted, otherwise `None`.

    Returns:
      The outcome mapping with `status` (`applied` or `empty`), `nodes_changed`, `touched_paths`, `commit`
      (`None` without a job directory) and `reason` (always `None`).

    Raises:
      JobRefusedError: With category transient when the commit fails.
    """
    # an empty map has nothing to retag; the dictionary may still need the surface's values
    retagged = ops.retag_detailed(alias_map) if alias_map else _tags.RetagResult()
    touched = [ _touch_ledger.TouchLedger.to_repo_rel(repo, path) for path in retagged.changed_paths ]

    # the dictionary is rewritten from the surface as it now stands
    text = dictionary.merge(
      post_values = self._compute_post_values(ops, {}), alias_map = alias_map, glosses = glosses,
    )
    dictionary_file = _textfile.TextFile(path = dictionary.path)
    current = dictionary_file.read() if dictionary.path.is_file() else None
    if text != current:
      dictionary.path.parent.mkdir(parents = True, exist_ok = True)
      dictionary_file.write(text)
      touched.append(_touch_ledger.TouchLedger.to_repo_rel(repo, dictionary.path))
    status = self._OUTCOME_EMPTY if not alias_map and text == current else self._STATUS_APPLIED

    # the daemon tail: a scope surface always rebuilds its index, then one commit of exactly these paths
    commit: str | None = None
    if job_dir is not None:
      if surface != self._SURFACE_DOMAINS:
        scopes = _scope.ScopeResolver(repo = repo).load_scopes()
        index_path = _index.TopicIndex(repo = repo, cfg = scopes[surface], scope_id = surface).build()
        touched.append(_touch_ledger.TouchLedger.to_repo_rel(repo, index_path))
      try:
        commit = _wiki_commit.commit_paths(repo, touched, f"wiki(normalize-tags): {surface}").status
      except _wiki_commit.WikiCommitError as error:
        raise _job_response.JobRefusedError(
          category = _job_response.CATEGORY_TRANSIENT, reason = str(error),
        ) from error

    # the outcome line the agent reads its success from
    return {
      self._OUT_STATUS:        status,
      self._OUT_NODES_CHANGED: retagged.nodes_changed,
      self._OUT_TOUCHED:       touched,
      self._OUT_COMMIT:        commit,
      self._OUT_REASON:        None,
    }


  def _tag_surface_ops(self, repo: Path, surface: str) -> _tags.TagOps:
    """
    Resolve a tag surface id to its tag operations.

    The reserved surface `domains` resolves to the generated domain-doc tree; any other id must name a
    configured wiki scope.

    Args:
      repo: Repository root.
      surface: Scope id, or the reserved `domains` surface.

    Returns:
      Tag operations bound to the surface.

    Raises:
      JobRefusedError: With category technical when a configured scope is itself named `domains` or the scope
        id is unknown.
    """
    scopes = _scope.ScopeResolver(repo = repo).load_scopes()

    # guard: a configured scope literally named 'domains' would collide with the reserved surface
    if surface == self._SURFACE_DOMAINS and self._SURFACE_DOMAINS in scopes:
      raise _job_response.JobRefusedError(
        category = _job_response.CATEGORY_TECHNICAL,
        reason = self._MSG_DOMAINS_COLLISION.format(cmd = self._CMD_TAG_APPLY),
      )

    # the domains surface is not a configured wiki scope — its own factory enumerates it
    if surface == self._SURFACE_DOMAINS:
      return _tags.TagOps.for_domains(repo = repo)

    # guard: requested scope id not present in settings
    if surface not in scopes:
      raise _job_response.JobRefusedError(
        category = _job_response.CATEGORY_TECHNICAL,
        reason = f"{self._MSG_UNKNOWN_SCOPE} '{surface}' (known: {', '.join(sorted(scopes)) or 'none'})",
      )
    return _tags.TagOps(repo = repo, scope_id = surface, cfg = scopes[surface])


  @staticmethod
  def _compute_post_values(ops: _tags.TagOps, alias_map: dict) -> dict[str, list[str]]:
    """
    Compute the axis values a surface would carry after the alias map is applied.

    Args:
      ops: Tag operations bound to the surface.
      alias_map: Mapping from axis to old value to canonical value; may be empty.

    Returns:
      Mapping from axis to its sorted, distinct values in use after renaming.
    """
    # each value in use, renamed through the map the way a retag would rename it
    return {
      axis: sorted({
        alias_map.get(axis, {}).get(entry[_tags.COLLECT_VALUE], entry[_tags.COLLECT_VALUE]) for entry in entries
      })
      for axis, entries in ops.collect()[_tags.COLLECT_AXES].items()
    }


  def _read_json_object(self, path: Path, *, what: str) -> dict:
    """
    Read a file that must hold a JSON object.

    Args:
      path: File to read.
      what: Name of the input, used in the refusal reason.

    Returns:
      The decoded JSON object.

    Raises:
      JobRefusedError: With category technical when the file is missing, unreadable, or not a JSON object.
    """
    # guard: the file does not exist
    if not path.is_file():
      raise _job_response.JobRefusedError(
        category = _job_response.CATEGORY_TECHNICAL, reason = f"{what} not found: {path}",
      )

    # a file that is not a JSON object cannot map axes to anything
    try:
      value = json.loads(path.read_text(encoding = self._ENCODING))
    except (OSError, ValueError) as error:
      raise _job_response.JobRefusedError(
        category = _job_response.CATEGORY_TECHNICAL, reason = f"{what} unreadable: {path}: {error}",
      ) from error
    # guard: only an object maps axes to values
    if not isinstance(value, dict):
      raise _job_response.JobRefusedError(
        category = _job_response.CATEGORY_TECHNICAL, reason = f"{what} must be a JSON object: {path}",
      )
    return value


  def _refuse_tag_apply(self, job_dir: Path | None, refusal: _job_response.JobRefusedError) -> int:
    """
    Report a refused tag apply to the job and to stdout.

    Prints the outcome line with status `refused`, no nodes changed, no touched paths and the refusal
    reason. With a job directory the refusal is also left in `response.json` at the root of the job
    directory under its category.

    Args:
      job_dir: Job directory, or `None` outside a job.
      refusal: The refusal to report.

    Returns:
      Integer exit code, always 1.
    """
    # the job's answer carries the refusal, so the runtime sees a failure instead of silence
    if job_dir is not None:
      _job_response.write_response(
        job_dir, outcome = _job_response.OUTCOME_ERROR, category = refusal.category, message = refusal.reason,
      )
    print(json.dumps({
      self._OUT_STATUS:        self._STATUS_REFUSED,
      self._OUT_NODES_CHANGED: 0,
      self._OUT_TOUCHED:       [],
      self._OUT_COMMIT:        None,
      self._OUT_REASON:        refusal.reason,
    }))
    return 1


  def _cmd_set_synced_sha(self, args: argparse.Namespace) -> int:
    """
    Write the `wiki_synced_sha` anchor into a scope's topics.md frontmatter.

    Creates the topics index with a minimal frontmatter block when it does not yet exist.
    Re-running with the same SHA leaves the file unchanged. Prints
    `set-synced-sha: ok <scope> wiki_synced_sha=<sha> → <index path>` on stdout.

    Args:
      args: Parsed argument namespace; must carry `.scope_id`, `.sha`, `.repo`.

    Returns:
      Integer exit code (0 on success, 1 when the scope is unknown or has no
      topics_index configured).
    """
    repo = Path(args.repo or os.environ.get(_ENV_REPO_ROOT) or os.getcwd()).resolve()

    # write the anchor; a scope that cannot carry one is reported on stderr
    try:
      index_path = self._write_synced_sha(repo, args.scope_id, args.sha)
    except LookupError as error:
      print(f"{self._CMD_SET_SYNCED_SHA}: {error.args[0]}", file = sys.stderr)
      return 1
    print(
      f"set-synced-sha: ok {args.scope_id} {self._KEY_WIKI_SYNCED_SHA}={args.sha} → "
      f"{index_path.relative_to(repo).as_posix()}"
    )
    return 0


  def _write_synced_sha(self, repo: Path, scope_id: str, sha: str) -> Path:
    """
    Write the `wiki_synced_sha` anchor into a scope's topics index frontmatter.

    Creates the topics index when it does not yet exist.

    Args:
      repo: Repository root.
      scope_id: Identifier of the scope whose index carries the anchor.
      sha: Commit SHA to record as the anchor.

    Returns:
      Absolute path of the topics index the anchor was written to.

    Raises:
      LookupError: If the scope is unknown or has no `topics_index` configured.
    """
    scopes = _scope.ScopeResolver(repo = repo).load_scopes()

    # guard: requested scope id not present in settings
    if scope_id not in scopes:
      raise LookupError(
        f"{self._MSG_UNKNOWN_SCOPE} '{scope_id}' (known: {', '.join(sorted(scopes)) or 'none'})"
      )

    # the anchor lives in the scope's topics index, so the scope must name one
    index_rel = scopes[scope_id].get(self._CFG_TOPICS_INDEX, "")

    # guard: scope has no topics_index path configured
    if not index_rel:
      raise LookupError(f"scope '{scope_id}' has no topics_index configured")

    # write the anchor into the index frontmatter, creating the file when it is absent
    index_path = (repo / index_rel).resolve()
    index_file = _textfile.TextFile(path = index_path)
    existing = index_file.read() if index_path.is_file() else ""
    index_path.parent.mkdir(parents = True, exist_ok = True)
    index_file.write(_nodes.set_scalar_field(existing, self._KEY_WIKI_SYNCED_SHA, sha))
    return index_path


  def _cmd_relink_commit(self, args: argparse.Namespace) -> int:
    """
    Anchor a relink pass at the current HEAD and commit its touched paths with the scope index.

    Records the HEAD the pass ran against as the scope's `wiki_synced_sha` anchor, then lands the
    touch ledger together with the scope index in one commit whose subject is
    `wiki(relink): <scope> (<mode>, classify N / link M / drop K)`.

    Prints one JSON line on stdout with `status` (`committed` or `unchanged`), `anchor`, `paths` and
    `unledgered`.

    Notes:
      - Wiki files changed outside the ledger are listed under `unledgered` and never committed.

    Args:
      args: Parsed argument namespace; must carry `.scope_id`, `.repo`, `.ledger`, `.mode`,
        `.classify`, `.link` and `.drop`.

    Returns:
      Integer exit code (0 on success, 1 when the scope is unknown or git fails, 2 on bad arguments).
    """
    repo = Path(args.repo or os.environ.get(_ENV_REPO_ROOT) or os.getcwd()).resolve()

    # the anchor is the HEAD the pass ran against, taken before anything is written
    try:
      head = subprocess.check_output(
        [ "git", "rev-parse", "HEAD" ], cwd = str(repo), text = True, encoding = self._ENCODING,
      ).strip()
    except (subprocess.CalledProcessError, OSError) as error:
      print(f"{self._CMD_RELINK_COMMIT}: git rev-parse HEAD failed: {error}", file = sys.stderr)
      return 1

    # record the anchor in the scope's topics index
    try:
      index_path = self._write_synced_sha(repo, args.scope_id, head)
    except LookupError as error:
      print(f"{self._CMD_RELINK_COMMIT}: {error.args[0]}", file = sys.stderr)
      return 1
    except OSError as error:
      print(f"{self._CMD_RELINK_COMMIT}: writing the topics index failed: {error}", file = sys.stderr)
      return 1

    # one commit of exactly the ledgered paths plus the anchored index
    index_rel = _touch_ledger.TouchLedger.to_repo_rel(repo, index_path)
    paths = list(dict.fromkeys([ *_touch_ledger.TouchLedger(path = Path(args.ledger)).read(), index_rel ]))
    subject = (
      f"wiki(relink): {args.scope_id} ({args.mode}, classify {args.classify} / link {args.link} / drop {args.drop})"
    )
    try:
      commit = _wiki_commit.commit_paths(repo, paths, subject)
    except _wiki_commit.WikiCommitError as error:
      print(f"{self._CMD_RELINK_COMMIT}: {error}", file = sys.stderr)
      return 1

    # wiki files changed outside the ledger are reported, never committed
    print(json.dumps({
      self._OUT_STATUS:     commit.status,
      self._OUT_ANCHOR:     head,
      self._OUT_PATHS:      paths,
      self._OUT_UNLEDGERED: self._find_unledgered(repo, set(paths)),
    }))
    return 0


  def _find_unledgered(self, repo: Path, ledgered: set[str]) -> list[str]:
    """
    List changed wiki files that the committed path set does not name.

    Covers changed scope nodes, scope indexes and the tag dictionary; the files are only listed, never
    committed.

    Args:
      repo: Repository root.
      ledgered: Repo-relative paths the commit carries.

    Returns:
      Sorted repo-relative paths of changed wiki files outside the given set; empty when git status
      cannot be read.
    """
    # every changed path git reports, untracked ones included; NUL-separated so no path is quoted
    try:
      raw = subprocess.check_output(
        [ "git", "status", "--porcelain", "-z", "--untracked-files=all" ],
        cwd = str(repo), text = True, encoding = self._ENCODING,
      )
    except (subprocess.CalledProcessError, OSError) as error:
      print(f"{self._CMD_RELINK_COMMIT}: git status failed: {error}", file = sys.stderr)
      return []

    # each entry is the two status letters, a space, the path; a rename or copy carries its source next
    changed: list[str] = []
    fields = raw.split(self._PORCELAIN_SEP)
    index = 0
    while index < len(fields):
      entry = fields[index]
      index += 1
      # guard: the trailing separator leaves an empty field
      if len(entry) <= self._PORCELAIN_PATH_AT:
        continue
      changed.append(entry[self._PORCELAIN_PATH_AT:])
      if entry[0] in self._PORCELAIN_WITH_SOURCE:
        index += 1

    # a wiki file is a scope node, a scope index, or the tag dictionary
    resolver = _scope.ScopeResolver(repo = repo)
    indexes = { cfg.get(self._CFG_TOPICS_INDEX) for cfg in resolver.load_scopes().values() }
    dictionary = _tags.dictionary_rel(repo)
    return sorted(
      rel for rel in dict.fromkeys(changed)
      if rel not in ledgered and (
        rel in indexes or rel == dictionary or resolver.resolve_scope_by_path(rel, apply_filter = False) is not None
      )
    )


  def _cmd_doctor(self, args: argparse.Namespace) -> int:
    """
    Audit one or all scopes for wiki integrity and print grouped findings.

    Audits the named scope, or every configured scope when none is named, and prints findings
    to stdout grouped by scope and severity (FAIL, WARN, INFO) with a per-scope count and a
    grand total. Repo-level domain findings are reported as a further section when there are
    any. When `--apply` is given, fixable findings are repaired in place and the printed lines
    note which fixes were applied; `--commit` additionally commits the repaired files in one
    commit, while a run without it leaves the repairs uncommitted for the operator to inspect.
    Unknown-scope and no-scope errors go to stderr.

    Guarantees:
      - Without `--apply` the audit is read-only: no audited file is rewritten.
      - Without `--commit` nothing is committed; applied repairs are left in the working
        tree for the operator to inspect.

    Args:
      args: Parsed argument namespace; carries `.scope_id` (or `None`),
        `.apply`, `.commit`, and `.repo`.

    Returns:
      Integer exit code: 0 when the audit ran (read-only or `--apply`),
      1 when a named scope id is unknown, no scopes are configured, or the
      requested commit step failed.
    """

    # Contract:
    # Without `--apply` the audit is read-only: no audited file is rewritten.

    # Contract:
    # Without `--commit` the command NEVER commits; applied repairs are left in the
    # working tree for the operator to inspect.

    repo = Path(args.repo or os.environ.get(_ENV_REPO_ROOT) or os.getcwd()).resolve()
    scopes = _scope.ScopeResolver(repo = repo).load_scopes()

    # guard: no scopes configured at all
    if not scopes:
      print(self._MSG_NO_SCOPES, file = sys.stderr)
      return 1

    # audit the named scope, or every configured one when none is named
    if args.scope_id is None:
      target_ids = sorted(scopes)
    else:
      # guard: named scope id is not configured
      if args.scope_id not in scopes:
        print(
          f"{self._MSG_DOCTOR_UNKNOWN_SCOPE} '{args.scope_id}' "
          f"(known: {', '.join(sorted(scopes)) or 'none'})",
          file = sys.stderr,
        )
        return 1
      target_ids = [ args.scope_id ]

    # audit each target scope, counting findings and gathering the files applied fixes rewrote
    grand_total = 0
    touched: set[str] = set()
    for scope_id in target_ids:
      findings = _doctor.Doctor(
        repo     = repo,
        scope_id = scope_id,
        cfg      = scopes[scope_id],
        apply    = bool(args.apply),
      ).run_all()
      grand_total += len(findings)
      self._print_scope_findings(scope_id, findings, apply = bool(args.apply))
      touched |= self._compute_applied_paths(findings, scopes[scope_id])

    # repo-level domain checks ride the same report; report-only, so never printed on a clean tree
    domain_findings = _doctor.DomainDoctor(repo = repo).run_all()
    if domain_findings:
      grand_total += len(domain_findings)
      self._print_scope_findings(self._DOMAIN_SECTION, domain_findings, apply = False)

    # the run's grand total, labelled with the mode it ran in
    print(
      f"\ndoctor: {grand_total} finding(s) across {len(target_ids)} scope(s) "
      f"[{'apply' if args.apply else 'read-only'}]"
    )

    # no commit requested (or nothing applied to commit) — the audit itself is done
    if not (args.apply and args.commit and touched):
      return 0

    # one commit for the whole run, under the invoking routine's exported git identity
    return self._commit_paths(
      repo = repo,
      paths = sorted(touched),
      message = f"lazy-wiki: doctor apply ({len(touched)} file(s))",
    )


  def _compute_applied_paths(self, findings: list[dict], cfg: dict) -> set[str]:
    """
    Collect the repo-relative paths one scope's applied doctor fixes touched.

    Node-level repairs touch the finding's own node file; an applied
    orphan-topic / index-desync / index-stale finding means the scope's topics
    index was rebuilt, so the index path joins the set once for any of them and
    the node an index-stale finding names stays out — that file was not rewritten.

    Args:
      findings: The scope's finding dicts from `Doctor.run_all`.
      cfg: The scope-config dict, read for its `topics_index` path.

    Returns:
      Repo-relative POSIX paths of the files the applied fixes rewrote;
      empty when nothing was applied.
    """
    applied = [ finding for finding in findings if finding.get(self._F_APPLIED) ]
    index_checks = (
      _doctor.Doctor.CHECK_ORPHAN_TOPIC, _doctor.Doctor.CHECK_INDEX_DESYNC, _doctor.Doctor.CHECK_INDEX_STALE,
    )
    # an index-stale finding names the node it found unlinked, yet only the index was rewritten for it
    touched = {
      finding[self._F_NODE] for finding in applied
      if finding.get(self._F_NODE) and finding[self._F_NODE] != "-"
      and finding[self._F_CHECK] != _doctor.Doctor.CHECK_INDEX_STALE
    }
    if any(finding[self._F_CHECK] in index_checks for finding in applied):
      # the doctor's default topics-index path is the fallback it repaired against, so the commit set names it too
      touched.add(cfg.get(self._CFG_TOPICS_INDEX) or _doctor.DEFAULT_TOPICS_INDEX)
    return touched


  def _print_scope_findings(self,
                            scope_id: str,
                            findings: list[dict],
                            *,
                            apply: bool) -> None:
    """
    Print one scope's findings grouped by severity, with a per-scope count.

    Args:
      scope_id: The scope identifier being reported.
      findings: List of finding dicts from `Doctor.run_all`.
      apply: True when `--apply` was requested (annotates applied fixes).
    """
    # the scope's header line carries its finding count
    print(f"\n=== scope '{scope_id}' — {len(findings)} finding(s) ===")

    # guard: a clean scope — nothing to enumerate
    if not findings:
      print(self._MSG_CLEAN)
      return

    # bucket the findings by severity
    by_sev: dict[str, list[dict]] = {}
    for finding in findings:
      by_sev.setdefault(finding[self._F_SEVERITY], []).append(finding)

    # print each non-empty bucket in severity order, marking fixed and fixable findings
    for sev in self._SEVERITY_ORDER:
      bucket = by_sev.get(sev, [])

      # a severity with no findings prints no bucket
      if not bucket:
        continue

      # the bucket header, then one line per finding with its fix state
      print(f"  [{sev}] {len(bucket)}")
      for finding in bucket:
        suffix = ""
        if apply and finding.get(self._F_APPLIED):
          suffix = "  (fixed)"
        elif finding.get(self._F_FIXABLE):
          suffix = "  (fixable)"
        print(f"    {finding[self._F_CHECK]}: {finding[self._F_NODE]} — {finding[self._F_MESSAGE]}{suffix}")


  def _cmd_process_file(self, args: argparse.Namespace) -> int:
    """
    Resolve each named node to its scope and dispatch a classify curation job for it.

    Accepts `path` as a bare file path, a git-item JSON string (`{"path": "...", ...}`), or a
    multi-path item (`{"paths": [...], ...}`) as the whole-tick unit of a git watch carries.
    Every path is handled on its own: a node outside every configured scope, or one whose classify
    job already waits unclaimed in the queue, is skipped with a note, and a node whose dispatch raises is
    recorded rather than aborting the rest. Once the invocation's time budget is spent no further
    path is started and the unstarted paths are recorded as failed. Exits promptly without waiting
    for any curator.

    Args:
      args: Parsed argument namespace; must carry `.path` and `.repo`.

    Returns:
      Integer exit code — 0 when every path was dispatched or skipped, 1 when at least one failed or
      was left unstarted, in which case the last stdout line is `{"failed_paths": [...]}` naming them.
    """
    repo = Path(args.repo or os.environ.get(_ENV_REPO_ROOT) or os.getcwd()).resolve()

    # what the invocation learns once: its time budget, the tag surveys, the jobs already queued
    run = _ProcessFileRun(repo = repo)

    # each path is its own unit of success; the failures, and the paths the budget left unstarted,
    # narrow what the daemon retries
    failed = self._each_path(
      self._parse_paths_arg(args.path), lambda raw: self._process_one(repo, raw, run),
      is_spent = run.is_spent,
    )
    return self._report_failed(failed)


  def _process_one(self, repo: Path, raw_path: str, run: _ProcessFileRun) -> int:
    """
    Dispatch a classify curation job for one node, or skip it with a printed note.

    Args:
      repo: Absolute repository root the node resolves against.
      raw_path: The node path as the argument named it.
      run: The invocation's shared state, supplying the tag survey and the already-queued check.

    Returns:
      Integer exit code (0 on dispatch or skip).
    """
    node_path = Path(raw_path)

    # find the configured scope the node belongs to
    result = _scope.ScopeResolver(repo = repo).resolve_scope_by_path(node_path)

    # guard: node does not belong to any configured scope
    if result is None:
      print(f"{self._CMD_PROCESS_FILE}: {self._MSG_SKIP_NO_SCOPE} {raw_path}")
      return 0

    # the owning scope's id and config drive every step below
    scope_id, cfg = result

    # a relative node path resolves against the repository root before the existence check
    abs_path = node_path if node_path.is_absolute() else repo / node_path

    # guard: node file does not exist on disk
    if not abs_path.is_file():
      print(f"{self._CMD_PROCESS_FILE}: {self._MSG_SKIP_FILE_NOT_FOUND} {raw_path}")
      return 0

    # the scope's declared axes travel with the payload
    tag_axes: list[str] = cfg.get(self._CFG_TAG_AXES) or []

    # load the node; unrecognised types and unchanged sources are skipped
    node_obj = _nodes.node_for(abs_path)

    # guard: unrecognised file type — skip (scope resolver let it through via glob)
    if node_obj is None:
      print(f"{self._CMD_PROCESS_FILE}: {self._MSG_SKIP_UNRECOGNISED} {raw_path}")
      return 0

    # operator source unchanged since last curation — skip dispatch to
    # break the daemon re-dispatch loop. The curator's own commits touch only
    # managed regions, so wiki_src_hash stays equal to the node's current
    # source_hash; a virgin node (no stored hash) or an operator content edit
    # (differing hash) falls through and is dispatched.
    stored_hash = node_obj.stored_src_hash
    if stored_hash is not None and stored_hash == node_obj.source_hash:
      print(f"{self._CMD_PROCESS_FILE}: {self._MSG_SKIP_SOURCE_UNCHANGED} {raw_path}")
      return 0

    # a classify job for the node already waits unclaimed — a repeat would only collapse into it,
    # so the payload is not even assembled
    if run.is_queued(node_path):
      print(f"{self._CMD_PROCESS_FILE}: {self._MSG_SKIP_ALREADY_QUEUED} {raw_path}")
      return 0

    # the node's operator pins travel with the payload
    pins = {
      "pinned_topics":    node_obj.pinned_topics,
      "unrelated_topics": node_obj.unrelated_topics,
      "pinned_links":     node_obj.pinned_links,
      "unrelated_links":  node_obj.unrelated_links,
    }

    # the existing per-axis tag values across the scope — the classify anchor, so
    # the curator reuses a value already in use instead of coining a synonym
    # (empty axes on cold-start)
    existing_tags = run.read_tags(scope_id, cfg)

    # assemble the classify job bundle from the node, its scope, and the scope's vocabulary
    payload = {
      self._PAYLOAD_KIND:          _dispatch.CoreDispatch.KIND_CLASSIFY,
      self._PAYLOAD_NODE_PATH:     raw_path,
      self._CFG_TAG_AXES:          tag_axes,
      self._PAYLOAD_SCOPE_ID:      scope_id,
      self._PAYLOAD_PINS:          pins,
      self._PAYLOAD_EXISTING_TAGS: existing_tags,
    }

    # queue the classify job and report it
    _dispatch.CoreDispatch().dispatch_curator(
      repo = repo,
      node_path = node_path,
      payload = payload,
    )
    print(f"process-file: dispatched (classify) {raw_path}")
    return 0


  def _cmd_prune_node(self, args: argparse.Namespace) -> int:
    """
    Prune See-also links to a deleted node and persist the result.

    Reconciles the See-also links and topic index of every scope a deleted wiki node
    belonged to, so a daemon-invoked run leaves a clean working tree.

    Notes:
      - A path that still exists or falls outside any tracked scope is skipped with a note.
      - Commits the touched nodes and rebuilt topic indexes to git once for the whole batch
        unless the caller opts out; a path whose prune raised is left out of that commit.
      - With `--ledger` the pruned nodes and rebuilt topic indexes are recorded in the named ledger file.

    Args:
      args: Parsed argument namespace. `.path` accepts a bare file path, a git-item JSON
        string, or a multi-path item (as produced by the `deleted_files` git watch); must
        also carry `.repo`, `.no_commit` and `.ledger`.

    Returns:
      Integer exit code; 0 on success or skip, 1 when the commit step fails or when at least
      one path failed, in which case the last stdout line is `{"failed_paths": [...]}`.
    """
    repo = Path(args.repo or os.environ.get(_ENV_REPO_ROOT) or os.getcwd()).resolve()

    # every prune runs before the one commit, so a failed path never blocks the others
    outcomes: list[dict] = []
    failed = self._each_path(
      self._parse_paths_arg(args.path), lambda raw: self._prune_one(repo, raw, outcomes),
    )

    # the ledger records every node the prunes touched and each rebuilt index
    if args.ledger:
      _touch_ledger.TouchLedger(path = Path(args.ledger)).record(repo, [
        path for outcome in outcomes
        for path in ( *outcome[self._FIELD_PRUNED_NODES], outcome[self._FIELD_INDEX] )
      ])

    # one commit for the batch: every node the prunes touched plus each rebuilt index
    if outcomes and not args.no_commit:
      touched = sorted({
        path for outcome in outcomes
        for path in ( *outcome[self._FIELD_PRUNED_NODES], outcome[self._FIELD_INDEX] )
      })
      deleted = ", ".join(outcome[self._FIELD_DELETED] for outcome in outcomes)
      scopes = ", ".join(sorted({ outcome[self._FIELD_SCOPE] for outcome in outcomes }))
      exit_code = self._commit_paths(
        repo    = repo,
        paths   = touched,
        message = f"wiki(prune): drop links to {deleted} ({scopes})",
      )
      # guard: commit failed — surface the error so the daemon records it
      if exit_code != 0:
        return exit_code
    return self._report_failed(failed)


  def _prune_one(self, repo: Path, raw_path: str, outcomes: list[dict]) -> int:
    """
    Prune See-also links to one deleted node, or skip it with a printed note.

    Args:
      repo: Absolute repository root the path resolves against.
      raw_path: The deleted node's path as the argument named it.
      outcomes: Collector the prune result is appended to for the batch commit.

    Returns:
      Integer exit code (0 on prune or skip).
    """
    node_path = Path(raw_path)
    abs_path = node_path if node_path.is_absolute() else repo / node_path

    # guard: the file still exists — not a deletion, nothing to prune
    if abs_path.is_file():
      print(f"{self._CMD_PRUNE_NODE}: {self._MSG_SKIP_FILE_EXISTS} {raw_path}")
      return 0

    # a deleted file has no frontmatter left to filter on, so only the path globs decide its scope
    result = _scope.ScopeResolver(repo = repo).resolve_scope_by_path(node_path, apply_filter = False)

    # guard: deleted path does not belong to any configured scope
    if result is None:
      print(f"{self._CMD_PRUNE_NODE}: {self._MSG_SKIP_NO_SCOPE} {raw_path}")
      return 0

    # the outcome is printed per path and kept for the batch commit
    scope_id, cfg = result
    outcome = _prune.NodePruner(repo = repo, scope_id = scope_id, cfg = cfg).prune(abs_path)
    outcomes.append(outcome)
    print(json.dumps(outcome))
    return 0


  @staticmethod
  def _each_path(paths: list[str], handler: Callable[[str], int], *,
                 is_spent: Callable[[], bool] | None = None) -> list[str]:
    """
    Run a per-path handler over a unit's paths and collect the ones it could not handle.

    Args:
      paths: The paths of one unit, in the item's own order.
      handler: Callable handling one path; a non-zero return or an exception marks it failed.
      is_spent: Callable asked before each path whether the invocation is out of time; once it
        answers True no further path is started. None runs every path.

    Returns:
      The paths whose handler raised or returned non-zero and the paths never started, in
      input order.
    """
    failed: list[str] = []

    # one path's failure is recorded and the rest still run — the unit is retried narrowed
    for position, raw in enumerate(paths):
      # guard: out of time — the paths not started are owed to the next run; the first path is
      # never held back, so every run handles at least one
      if position > 0 and is_spent is not None and is_spent():
        print(f"time budget spent: {len(paths) - position} path(s) left for the next run", file = sys.stderr)
        failed.extend(paths[position : ])
        break
      try:
        exit_code = handler(raw)
      except Exception as error:  # noqa: BLE001
        # waiver: any failure of one path must be recorded, not propagated past its siblings
        print(f"{raw}: {error}", file = sys.stderr)
        exit_code = 1
      if exit_code != 0:
        failed.append(raw)
    return failed


  @staticmethod
  def _report_failed(failed: list[str]) -> int:
    """
    Print the failed-paths line the daemon narrows its retry by, when any path failed.

    Args:
      failed: The paths a unit could not handle; empty when every path succeeded.

    Returns:
      0 when nothing failed, 1 otherwise.
    """
    # guard: nothing failed — nothing to report
    if not failed:
      return 0

    # the LAST stdout line is the daemon's retry contract
    print(json.dumps({ _FAILED_PATHS_KEY: failed }))
    return 1


  def _commit_paths(self, *, repo: Path, paths: list[str], message: str) -> int:
    """
    Commit exactly the given repo-relative paths when any of them carries changes.

    Content the operator parked in the index is left out of the commit.

    Notes:
      - Returns success without committing when there is nothing to commit — no paths given,
        or none of the given paths changed.

    Args:
      repo: Absolute repository root the git commands run in.
      paths: Repo-relative paths to stage and commit.
      message: Commit message.

    Returns:
      0 on success or clean no-op, 1 when a git command fails.
    """

    # the shared helper stages and commits exactly the named paths; a git failure is reported here
    try:
      _wiki_commit.commit_paths(repo, paths, message)
    except _wiki_commit.WikiCommitError as error:
      print(error, file = sys.stderr)
      return 1
    return 0


  def _attach_candidates(self,
                         payload: dict,
                         repo: Path,
                         cfg: dict,
                         scope_id: str,
                         node: Path) -> None:
    """
    Add the node's ranked link shortlist to a `link` payload, when one can be computed.

    Runs the same deterministic recall the `find-candidates` subcommand exposes, so a
    daemon-dispatched link job judges against the same narrowed set the in-session path
    hands the curator. An empty shortlist is written as an empty list; a failed recall leaves the field
    absent and the dispatch carries on.

    Args:
      payload: The `link` payload to extend; mutated in place.
      repo: Absolute path to the repository root.
      cfg: Scope-config dict (the value side of a `wiki.scopes` entry).
      scope_id: Scope identifier the node belongs to.
      node: Absolute path of the node the shortlist is computed for.
    """

    # Domain(wiki.graph):
    # # A pre-selection is advice, not a boundary
    # The cheap pre-selection is handed to the judge as a ranking to weigh first, never as the only
    # material it may draw on: the catalog stays open, and a target the catalog justifies is allowed even
    # when the pre-selection missed it. Two answers must therefore not be confused — that the
    # pre-selection ran and found nothing, and that it could not run at all. The first is a genuine
    # verdict on a scope where nothing is close enough yet; the second says only that the cheap stage
    # was unavailable, and the judge falls back to the whole catalog as though the stage did not exist.
    # Failure of the cheap stage never cancels the judging: advice that could not be produced costs the
    # judging its shortcut, never its result.

    try:
      finder = _candidates.CandidateFinder.with_default_sources(repo, cfg, scope_id)
      payload[self._PAYLOAD_CANDIDATES] = finder.find(node)
    except (OSError, ValueError) as error:
      # leave the field unwritten so the curator reads "not computed" rather than "empty",
      # and say so on stderr — the dispatch itself carries on without the shortlist
      print(
        f"dispatch-link: warning — candidate recall failed for {node}: {error}; "
        "dispatching without a shortlist",
        file = sys.stderr,
      )


  def _cmd_dispatch_link(self, args: argparse.Namespace) -> int:
    """
    Resolve a node to its scope and dispatch a link curation job.

    The link job names the scope's `topics.md` by absolute path as the candidate catalog and
    carries the node's own ranked link shortlist. Besides the node's own job, one link job is queued
    for every other scope node the node attracts that does not already link to it; each of
    those jobs carries the shortlist of the node it names. Does not wait for any job to
    complete.

    A node outside every configured scope, a missing file, and an unrecognised file type are
    skipped with a `dispatch-link: skip (...)` line on stdout and exit 0. A missing
    `topics.md` prints a warning on stderr and dispatches with the path all the same. On success it
    prints `dispatch-link: dispatched (link) <path> + back-links=<n> (skipped-already-linked=<k>)`.

    Guarantees:
      - A computed shortlist that is empty is queued as an empty list; the field is absent
        only when the recall could not run, so the curator can tell "found nothing" from
        "could not compute".
      - A failed shortlist recall never aborts the dispatch: the job is queued without the
        field and the curator judges the whole catalog.

    Args:
      args: Parsed argument namespace; must carry `.path` and `.repo`.

    Returns:
      Integer exit code (0 on dispatch or skip).
    """

    # Contract:
    # Every link job the command queues carries the node's ranked shortlist as a list,
    # an empty list when the recall ran and found nothing. The field is absent ONLY when
    # the recall could not run, so the curator can tell "found nothing" from "could not
    # compute".

    # Contract:
    # A failed shortlist recall NEVER aborts the dispatch: the job is queued without the
    # shortlist and the curator falls back to judging the whole catalog.

    repo = Path(args.repo or os.environ.get(_ENV_REPO_ROOT) or os.getcwd()).resolve()

    # the node as the command line named it
    node_path = Path(args.path)

    # find the configured scope the node belongs to
    result = _scope.ScopeResolver(repo = repo).resolve_scope_by_path(node_path)

    # guard: node does not belong to any configured scope
    if result is None:
      print(f"{self._CMD_DISPATCH_LINK}: {self._MSG_SKIP_NO_SCOPE} {args.path}")
      return 0

    # the owning scope's id and config drive every step below
    scope_id, cfg = result

    # a relative node path resolves against the repository root before the existence check
    abs_path = node_path if node_path.is_absolute() else repo / node_path

    # guard: node file does not exist on disk
    if not abs_path.is_file():
      print(f"{self._CMD_DISPATCH_LINK}: {self._MSG_SKIP_FILE_NOT_FOUND} {args.path}")
      return 0

    # load the node; an unrecognised type is skipped
    node_obj = _nodes.node_for(abs_path)

    # guard: unrecognised file type — skip
    if node_obj is None:
      print(f"{self._CMD_DISPATCH_LINK}: {self._MSG_SKIP_UNRECOGNISED} {args.path}")
      return 0

    # the node's operator pins travel with the payload
    pins = {
      "pinned_topics":    node_obj.pinned_topics,
      "unrelated_topics": node_obj.unrelated_topics,
      "pinned_links":     node_obj.pinned_links,
      "unrelated_links":  node_obj.unrelated_links,
    }

    # Decision: the link job carries the path of the scope's topics.md, not its text — the curator
    # reads the catalog as it stands when the job runs, and a multi-megabyte copy per job no longer
    # fills the job store until the completed bundles age out

    # the scope's topics.md is the link-phase candidate catalog the job points at
    topics_path = repo / (cfg.get(self._CFG_TOPICS_INDEX) or _doctor.DEFAULT_TOPICS_INDEX)

    # a catalog not on disk yet is only worth a warning: the job still dispatches with the path
    if not topics_path.is_file():
      print(
        f"dispatch-link: warning — topics.md not found at {topics_path}; dispatching with the path all the same",
        file = sys.stderr,
      )

    # assemble the node's own link job, its shortlist attached when the recall ran
    payload = {
      self._PAYLOAD_KIND:         _dispatch.CoreDispatch.KIND_LINK,
      self._PAYLOAD_NODE_PATH:    str(abs_path),
      self._PAYLOAD_TOPICS_PATH:  str(topics_path),
      self._PAYLOAD_PINS:         pins,
      self._PAYLOAD_SCOPE_ID:     scope_id,
    }
    self._attach_candidates(payload, repo, cfg, scope_id, abs_path)

    # queue the node's own link job
    dispatcher = _dispatch.CoreDispatch()
    dispatcher.dispatch_curator(
      repo = repo,
      node_path = abs_path,
      payload = payload,
    )

    # Domain(wiki.graph):
    # # Order of the two curation phases
    # A node is curated in two phases that cannot be swapped: it is first classified — given its short
    # description and its topics — and only then linked to its neighbours. Neighbours are chosen from the
    # scope's catalog of classified nodes, so linking a node whose own classification has not yet reached
    # that catalog could only draw on stale material.
    # Reaching the catalog also changes what the surrounding nodes ought to link to, so the linking phase is
    # where the ripple starts: every node the newcomer attracts is sent back to be linked again against the
    # same freshly rebuilt catalog. A node that already names the newcomer among its neighbours is left
    # alone, because the link the ripple would draw is there already.
    # The ripple reaches exactly one step: linking a node never reclassifies it, and so never starts a ripple
    # of its own, which is what keeps a single appearance from cascading through the whole scope.

    # back-link fan-out — dispatch link jobs for every scope node that lists this
    # node among its top-N candidates. Runs here (not in process-file) because
    # the classify tail has already executed apply-node + build-index, so the
    # topics.md the jobs point at already lists this node — every attracted
    # node's link curator can pick it from the catalog it reads at run time. Link jobs do not
    # themselves call dispatch-link, so the fan-out cannot recurse.
    attracted_rel = _candidates.BackCandidateFinder(repo, cfg, scope_id).find(abs_path)

    # the target's repo-relative POSIX path — matched against each attracted
    # node's existing forward see-also to skip re-link dispatches where the
    # link is already in place (no LLM work needed). None when the target
    # path is outside the repo root (a cross-repo dispatch — never skip).
    try:
      target_rel = abs_path.resolve().relative_to(repo.resolve()).as_posix()
    except ValueError:
      target_rel = None

    # queue a link job for every attractor not yet linked to the target, counting both outcomes
    back_dispatched = 0
    back_skipped_existing = 0
    for rel in attracted_rel:
      attractor_path = repo / rel

      # guard: attracted path does not resolve to an existing file — skip
      if not attractor_path.is_file():
        continue
      attractor_node = _nodes.node_for(attractor_path)

      # guard: unrecognised file type — skip
      if attractor_node is None:
        continue

      # an attractor that already forward-links to the target needs no LLM work
      if target_rel is not None and target_rel in attractor_node.see_also_targets:
        back_skipped_existing += 1
        continue

      # the attractor's own link job, against the same catalog path
      attractor_pins = {
        "pinned_topics":    attractor_node.pinned_topics,
        "unrelated_topics": attractor_node.unrelated_topics,
        "pinned_links":     attractor_node.pinned_links,
        "unrelated_links":  attractor_node.unrelated_links,
      }
      attractor_payload = {
        self._PAYLOAD_KIND:         _dispatch.CoreDispatch.KIND_LINK,
        self._PAYLOAD_NODE_PATH:    str(attractor_path),
        self._PAYLOAD_TOPICS_PATH:  str(topics_path),
        self._PAYLOAD_PINS:         attractor_pins,
        self._PAYLOAD_SCOPE_ID:     scope_id,
      }
      # limit: a second O(N) scoring of the attractor's shortlist; have BackCandidateFinder return each ranking
      self._attach_candidates(attractor_payload, repo, cfg, scope_id, attractor_path)
      dispatcher.dispatch_curator(
        repo = repo,
        node_path = attractor_path,
        payload = attractor_payload,
      )
      back_dispatched += 1

    # report the node's own job together with the fan-out counts
    print(
      f"dispatch-link: dispatched (link) {args.path}"
      f" + back-links={back_dispatched} (skipped-already-linked={back_skipped_existing})"
    )
    return 0


  def _cmd_domain_plan(self, args: argparse.Namespace) -> int:
    """
    Print the domain-spec plan to stdout as one JSON object.

    The plan always reflects the current code, dictionary and generated docs in full; `--group`
    narrows only the work lists. It reports changed groups with stale docs, orphans, link and
    anchor fixes, unknown groups, untitled blocks, the catalog and the index state. Dispatching
    writers and committing are left to the caller.

    Guarantees:
      - Planning is read-only: no domain doc, no index, and no commit is ever produced.

    Args:
      args: Parsed argument namespace; must carry `.repo` and `.group`.

    Returns:
      Integer exit code (0 on success, 1 when `wiki.domains` is not configured).
    """

    # Contract:
    # Planning is read-only: the command NEVER writes a domain doc, rebuilds the index,
    # or produces a commit.

    repo = Path(args.repo or os.environ.get(_ENV_REPO_ROOT) or os.getcwd()).resolve()
    planner = _domains.DomainPlanner(repo = repo)

    # guard: wiki.domains not configured — nothing to plan
    if not planner.is_configured:
      print(self._MSG_DOMAINS_UNCONFIGURED_PLAN, file = sys.stderr)
      return 1

    # the plan is the whole output — one JSON object on stdout
    print(json.dumps(planner.plan(group = args.group)))
    return 0


  def _cmd_domain_apply_index(self, args: argparse.Namespace) -> int:
    """
    Report as JSON whether the `domains.md` index was rebuilt.

    Writes the index file only when its rendered content differs from what is
    already on disk.

    Args:
      args: Parsed argument namespace; must carry `.repo`.

    Returns:
      Integer exit code (0 on success, 1 when `wiki.domains` is not configured).
    """
    repo = Path(args.repo or os.environ.get(_ENV_REPO_ROOT) or os.getcwd()).resolve()
    planner = _domains.DomainPlanner(repo = repo)

    # guard: wiki.domains not configured — no index to build
    if not planner.is_configured:
      print(self._MSG_DOMAINS_UNCONFIGURED_INDEX, file = sys.stderr)
      return 1

    # rebuild only when the render differs; report which way it went
    index = _domains.DomainIndex(cfg = planner.cfg)
    updated = index.apply()
    sections = index.apply_sections()
    print(json.dumps({ "index": index.index_rel(), "updated": updated, "sections": sections }))
    return 0


  def _cmd_domain_tick(self, args: argparse.Namespace) -> int:
    """
    Reconcile the repo's domain-spec state for one triggered git change.

    Detection is always full; the trigger path only gates whether running a tick is
    worth it — a grouped git item is worth one when any of its paths is a domain source.

    Notes:
      - Deletes orphaned docs — a group with no blocks left in code, or a doc whose
        group the dictionary no longer lists — repairs contract anchors whose file moved
        without the guarantee changing, drops dead `## Related` links and `## Contracts`
        bullets citing a guarantee no attributed contract accounts for, and rebuilds the
        index deterministically, committing that part itself.
      - Dispatches one `wiki.domain-writer` job per changed group; the writer owns the
        doc write, the index refresh, and its own commit.
      - Idempotent: matching hashes mean zero work, so repeated ticks from the same
        commit are safe.
      - `--restamp` is the one-off after a digest-rule change: every existing doc gets
        its anchors repaired and its `domain_hash` rewritten to the current digest, the
        result is committed, and nothing is dispatched.

    Args:
      args: Parsed argument namespace; carries `.path` (git-item JSON or bare
        path, `None` with `--full` / `--restamp`), `.repo`, `.full`, and `.restamp`.

    Returns:
      Integer exit code (0 on success or skip, 1 when a git commit fails).
    """
    repo = Path(args.repo or os.environ.get(_ENV_REPO_ROOT) or os.getcwd()).resolve()
    planner = _domains.DomainPlanner(repo = repo)

    # guard: wiki.domains not configured — the routine fired in an unconfigured repo
    if not planner.is_configured:
      print(self._MSG_DOMAIN_TICK_SKIP)
      return 0

    # the one-off restamp: no detect, no dispatch — stamp what exists and commit it
    if args.restamp:
      result = planner.restamp()
      exit_code = self._commit_paths(
        repo    = repo,
        paths   = result[_domains.RESTAMP_DOCS],
        message = (
          f"{self._SUBJECT_DOMAINS_PREFIX}restamp domain_hash after digest change, "
          f"repair {result[_domains.RESTAMP_ANCHORS]} anchor(s)"
        ),
      )
      # guard: commit failed — surface the error so the daemon records it
      if exit_code != 0:
        return exit_code
      print(json.dumps({
        "restamped":        len(result[_domains.RESTAMP_DOCS]),
        "anchors_repaired": result[_domains.RESTAMP_ANCHORS],
      }))
      return 0

    # Domain(wiki.domains):
    # # What a change signal is worth
    # The published state of the domain tree is read in full from what lies on disk — the knowledge written
    # in the code, the groups the dictionary admits, and the generation mark each published document carries.
    # A single reported change therefore never says what has to be rebuilt, only whether reconciling is worth
    # running at all.
    # Two kinds of change can move the published set: an edit to code that may carry knowledge blocks, and an
    # edit to the dictionary, which admits or withdraws a group without any block moving. A change anywhere
    # else cannot alter the outcome and is dismissed without reading further.
    # Reconciling twice over the same state is free: the second pass finds every generation mark still
    # matching and every listed group still backed, so it writes nothing.

    # a trigger is only worth a tick when at least one of its paths lands in the domain sources
    if not args.full and args.path is not None:
      rels = self._parse_paths_arg(args.path)
      # every path outside the code globs and the dictionary — the tick is a no-op
      if not any(self._is_domain_trigger(planner.cfg, rel) for rel in rels):
        print(f"{self._CMD_DOMAIN_TICK}: {self._MSG_SKIP_OUTSIDE_DOMAIN} {', '.join(rels)}")
        return 0

    # full detect on every tick — the docs' domain_hash anchors are the whole state
    plan = planner.plan()
    changed = plan[_domains.PLAN_CHANGED]
    orphans = plan[_domains.PLAN_ORPHANED]
    fixes = plan[_domains.PLAN_ANCHOR_FIXES]
    links = plan[_domains.PLAN_LINK_FIXES]
    drops = plan[_domains.PLAN_CONTRACT_DROPS]
    index_stale = plan[_domains.PLAN_INDEX_STALE]

    # deterministic half: drop orphaned docs, repair moved anchors and dead links, drop unattributed
    # contracts, refresh the index — committed here
    if orphans or index_stale or fixes or links or drops:
      # only git-tracked orphans join the commit pathspec — an untracked one has no deletion to record
      tracked = self._query_tracked_paths(repo, orphans)
      self._remove_docs(repo, planner.cfg.output, orphans)
      repaired = sorted({
        *planner.apply_anchor_fixes(fixes),
        *planner.apply_link_fixes(links),
        *planner.apply_contract_drops(drops),
      })
      index = _domains.DomainIndex(cfg = planner.cfg)
      index.apply()
      sections = index.apply_sections()

      # name each kind of work in the subject; the dictionary-driven removals get their own count,
      # since a bare orphan count hides why the doc went
      unlisted = plan[_domains.PLAN_UNLISTED]
      reason = f" ({len(unlisted)} for a group no longer in the dictionary)" if unlisted else ""
      parts: list[str] = []
      if orphans:
        parts.append(f"drop {len(orphans)} orphaned doc(s){reason}")
      if orphans or index_stale:
        parts.append(self._SUBJECT_REFRESH_INDEX)
      if fixes:
        parts.append(f"repair {len(fixes)} anchor(s)")
      if links:
        parts.append(f"drop {len(links)} dead link(s)")
      if drops:
        parts.append(f"drop {len(drops)} unattributed contract(s)")

      # record the deletions, the repaired docs, and the refreshed index as one commit
      exit_code = self._commit_paths(
        repo    = repo,
        paths   = [ *tracked, *repaired, index.index_rel(), *sections ],
        message = self._SUBJECT_DOMAINS_PREFIX + ", ".join(parts),
      )
      # guard: commit failed — surface the error so the daemon records it
      if exit_code != 0:
        return exit_code

    # LLM half: one writer job per changed group, returning its folder note and every stale doc;
    # `domain-collect` lands and commits them
    if changed:
      dispatcher = _dispatch.CoreDispatch()
      for entry in changed:
        payload = planner.build_payload(entry, plan[_domains.PLAN_CATALOG])
        payload[self._PAYLOAD_KIND] = _dispatch.CoreDispatch.KIND_DOMAIN_SPEC
        dispatcher.dispatch_domain_writer(
          repo         = repo,
          group        = entry[_domains.GROUP_KEY],
          payload      = payload,
          result_names = self._compute_result_names(entry),
        )

    # one-line JSON tick summary for the daemon log
    print(json.dumps({
      "dispatched":       len(changed),
      "orphans_removed":  len(orphans),
      "anchors_repaired": len(fixes),
      "links_repaired":   len(links),
      "index":            "updated" if (orphans or index_stale) else "unchanged",
    }))
    return 0


  @staticmethod
  def _compute_result_names(entry: dict) -> list[str]:
    """
    Name the files a writer job for one changed group returns.

    Args:
      entry: One `changed_groups` entry of the plan.

    Returns:
      The folder note's file name followed by the file name of every stale doc, in doc order.
    """
    stale = set(entry[_domains.GROUP_STALE])
    docs = [ doc[_domains.GROUP_DOC] for doc in entry[_domains.GROUP_DOCS] if doc[_domains.DOC_SLUG] in stale ]
    return [ Path(rel).name for rel in ( entry[_domains.GROUP_FOLDER_NOTE], *docs ) ]


  @staticmethod
  def _remove_docs(repo: Path, output: str, rels: list[str]) -> None:
    """
    Delete generated docs and every group folder they leave empty.

    Args:
      repo: Absolute repository root.
      output: Repo-relative output directory; it is never removed itself.
      rels: Repo-relative paths of the docs to delete.
    """
    root = (repo / output).resolve()
    for rel in rels:
      (repo / rel).unlink(missing_ok = True)

      # walk up from the deleted file, dropping folders it left empty, never the output root itself
      folder = (repo / rel).parent.resolve()
      while folder != root and folder.is_relative_to(root) and folder.is_dir() and not any(folder.iterdir()):
        folder.rmdir()
        folder = folder.parent


  def _cmd_domain_payload(self, args: argparse.Namespace) -> int:
    """
    Write one changed group's domain-spec writer payload to a file.

    The file holds the group's blocks and the tree-wide catalog, so a caller can hand a writer
    the file rather than the content. Creates the output directory when missing. Prints
    `{"payload": <path>, "files": [<names>]}` on stdout, the names being the files the writer
    must return; a group with nothing to write prints its reason on stderr.

    Args:
      args: Parsed argument namespace; must carry `.group`, `.out`, and `.repo`.

    Returns:
      Integer exit code (0 when written, 1 when unconfigured or the group has nothing to write).
    """
    repo = Path(args.repo or os.environ.get(_ENV_REPO_ROOT) or os.getcwd()).resolve()
    planner = _domains.DomainPlanner(repo = repo)

    # guard: wiki.domains not configured — there is no group to write
    if not planner.is_configured:
      print(self._MSG_DOMAINS_UNCONFIGURED_PAYLOAD, file = sys.stderr)
      return 1

    # the group's entry in a plan narrowed to it, merged with the tree-wide catalog
    plan = planner.plan(group = args.group)
    entries = plan[_domains.PLAN_CHANGED]

    # guard: the group is current, unknown, or carries no blocks — nothing for a writer to do
    if not entries:
      print(f"{self._CMD_DOMAIN_PAYLOAD}: group {args.group!r} has nothing to write", file = sys.stderr)
      return 1

    # write the writer's payload and name the files it must return
    payload = planner.build_payload(entries[0], plan[_domains.PLAN_CATALOG])
    payload[self._PAYLOAD_KIND] = _dispatch.CoreDispatch.KIND_DOMAIN_SPEC
    out = Path(args.out)
    out.parent.mkdir(parents = True, exist_ok = True)
    out.write_text(json.dumps(payload, ensure_ascii = False, indent = 1), encoding = self._ENCODING)
    print(json.dumps({ "payload": str(out), "files": self._compute_result_names(entries[0]) }))
    return 0


  def _cmd_domain_repair(self, args: argparse.Namespace) -> int:
    """
    Repair moved contract anchors, drop dead `## Related` links and drop unaccounted `## Contracts` bullets in place.

    The mechanical half of keeping the domain tree consistent, for a caller that rebuilds the
    index and commits itself. Prints `{"docs": [<paths>]}` on stdout, naming each repaired doc
    once.

    Guarantees:
      - Never refreshes the index and never commits; only anchor text, dead Related lines and
        unaccounted Contracts bullets change.

    Args:
      args: Parsed argument namespace; must carry `.repo` and `.group`.

    Returns:
      Integer exit code (0 on success, 1 when `wiki.domains` is not configured).
    """
    repo = Path(args.repo or os.environ.get(_ENV_REPO_ROOT) or os.getcwd()).resolve()
    planner = _domains.DomainPlanner(repo = repo)

    # guard: wiki.domains not configured — there is no tree to repair
    if not planner.is_configured:
      print(self._MSG_DOMAINS_UNCONFIGURED_REPAIR, file = sys.stderr)
      return 1

    # every repair runs off one fresh plan, narrowed to one group when asked; a doc touched by any is
    # reported once
    plan = planner.plan(group = args.group)
    touched = {
      *planner.apply_anchor_fixes(plan[_domains.PLAN_ANCHOR_FIXES]),
      *planner.apply_link_fixes(plan[_domains.PLAN_LINK_FIXES]),
      *planner.apply_contract_drops(plan[_domains.PLAN_CONTRACT_DROPS]),
    }
    print(json.dumps({ "docs": sorted(touched) }))
    return 0


  def _cmd_domain_land(self, args: argparse.Namespace) -> int:
    """
    Land one document a domain-spec writer returned at its doc path, stamped with its digest.

    Places a block doc or a folder note in the generated tree for a caller that rebuilds the
    index and commits itself. The landed document carries the digest the required payload file
    names for the path and the configured explainer line under its title. Prints `{"doc": <path>}`
    on stdout.

    Guarantees:
      - Never refreshes the index and never commits; a refused landing writes nothing and
        exits 1 with the reason on stderr.
      - A payload that is unreadable, is not a JSON object, or names no digest for the path
        is refused like any other unlandable return.

    Args:
      args: Parsed argument namespace; must carry `.path`, `.from_file`, `.payload`, and `.repo`.

    Returns:
      Integer exit code (0 when landed, 1 when unconfigured, unreadable, or refused).
    """
    repo = Path(args.repo or os.environ.get(_ENV_REPO_ROOT) or os.getcwd()).resolve()
    planner = _domains.DomainPlanner(repo = repo)

    # guard: wiki.domains not configured — there is no tree to land into
    if not planner.is_configured:
      print(self._MSG_DOMAINS_UNCONFIGURED_LAND, file = sys.stderr)
      return 1

    # the returned file and the payload are read whole and landed through the shared primitive
    try:
      body = Path(args.from_file).read_text(encoding = self._ENCODING)
      payload = json.loads(Path(args.payload).read_text(encoding = self._ENCODING))

      # guard: a payload that is not an object names no digest
      if not isinstance(payload, dict):
        raise _domains.DomainLandingError(f"payload {args.payload!r} is not a JSON object")
      doc = _domains.DomainLanding(cfg = planner.cfg).save_doc(args.path, body, payload = payload)
    except (OSError, json.JSONDecodeError, _domains.DomainLandingError) as error:
      print(f"{self._CMD_DOMAIN_LAND}: {error}", file = sys.stderr)
      return 1
    print(json.dumps({ "doc": doc }))
    return 0


  def _cmd_domain_collect(self, args: argparse.Namespace) -> int:
    """
    Land every finished domain-spec writer job and retire it.

    For each finished, unconsumed `wiki.domain-writer` job: every returned file — the group's
    folder note and its stale block docs — is landed at the path its request named, the index
    is refreshed, exactly those paths are committed under the running identity (the routine's
    bot author), and the job is consumed. Each landed document is stamped with its digest and
    the explainer line. A contract citation in a returned document that the request attributed
    no contract to is removed from the document before it lands.
    Prints one JSON summary line, `{"landed": <n>, "failed": [<job ids>]}`.

    Guarantees:
      - A job that cannot be landed — a writer error, a missing, empty, incomplete, unnamed or
        unstampable result, a path outside the generated tree — writes nothing, is named on stderr, and is
        consumed so its group is dispatched afresh; the pass exits 1.
      - A landing whose commit fails is rolled back and left unconsumed, so the next pass
        retries it; the pass exits 1.
      - A job already consumed is never landed again.

    Args:
      args: Parsed argument namespace; must carry `.repo`.

    Returns:
      Integer exit code (0 when every finished job landed or there were none, 1 otherwise).
    """

    # Contract:
    # A finished job that cannot be landed MUST fail the pass — exit 1, the job named on stderr —
    # and MUST leave the working tree exactly as it was; nothing is ever swallowed into exit 0.

    # Domain(wiki.domains):
    # # Who places a generated domain document
    # A writer only ever returns its files; placing them, refreshing the index, and recording them
    # belong to deterministic code that cannot skip a step. A finished job is placed whole or not at
    # all. One that cannot be placed — the writer reported an error, returned nothing or too little, or
    # named a place outside the generated tree — is retired so its group is written afresh on the next
    # pass, and the pass reports the failure. A placement whose record cannot be made is undone and kept
    # for the next pass to try again.

    repo = Path(args.repo or os.environ.get(_ENV_REPO_ROOT) or os.getcwd()).resolve()
    planner = _domains.DomainPlanner(repo = repo)

    # guard: wiki.domains not configured — the routine fired in an unconfigured repo
    if not planner.is_configured:
      print(self._MSG_DOMAIN_COLLECT_SKIP)
      return 0

    # one pass over the writer's finished, unconsumed jobs
    dispatcher = _dispatch.CoreDispatch()
    expert = _dispatch.CoreDispatch.EXPERT_DOMAIN_WRITER
    landed = 0
    failed: list[str] = []
    for job in dispatcher.query_jobs(repo = repo, expert = expert):
      job_dir = Path(str(job.get(self._JOB_PATH, "")))
      job_id = str(job.get(self._JOB_ID, ""))

      # a job in flight, deferred, dead, cancelled, or already consumed is not this pass's
      if job.get(self._JOB_STATUS) not in self._COLLECTABLE or (job_dir / self._JOB_CONSUMED).exists():
        continue

      # land the job's files; a refused landing raises before anything is written
      try:
        committed = self._land_domain_job(repo, planner.cfg, dispatcher, expert, job_dir, job_id)
      except _domains.DomainLandingError as error:
        # a refused job is retired all the same: its group is still stale, so it is dispatched afresh
        print(f"{self._CMD_DOMAIN_COLLECT}: {expert}/{job_id}: {error}", file = sys.stderr)
        failed.append(job_id)
        dispatcher.consume_job(repo = repo, expert = expert, job_id = job_id)
        continue

      # the commit failed and was rolled back — keep the job for the next pass
      if not committed:
        print(f"{self._CMD_DOMAIN_COLLECT}: {expert}/{job_id}: commit failed, retried next pass", file = sys.stderr)
        failed.append(job_id)
        continue

      # landed and recorded — retire the job, releasing its dedup key
      dispatcher.consume_job(repo = repo, expert = expert, job_id = job_id)
      landed += 1

    # the summary is the routine's last stdout line; any failure fails the pass
    print(json.dumps({ "landed": landed, "failed": failed }))
    return 1 if failed else 0


  def _land_domain_job(self,
                       repo: Path,
                       cfg: _domains.DomainConfig,
                       dispatcher: _dispatch.CoreDispatch,
                       expert: str,
                       job_dir: Path,
                       job_id: str) -> bool:
    """
    Land every file one finished job returned, with the index, and commit them all.

    Every returned document lands stamped with the digest the request carries for its path and
    the configured explainer line, and without its contract citations that the request
    attributed no contract to.

    Args:
      repo: Absolute repository root.
      cfg: The repo's domain configuration.
      dispatcher: The core bridge the job's response is read through.
      expert: Expert name the job was dispatched to.
      job_dir: The job's bundle directory.
      job_id: The job's identifier.

    Returns:
      True when the landing is committed (or changed nothing), False when the commit failed
      and every touched path was restored.

    Raises:
      DomainLandingError: When the job reported an error, returned an empty file, a file its
        request does not name, or not every file its request requires, names a path the
        landing refuses, or returned a document that cannot be stamped; nothing is written.
    """
    # read the job's state; a response that is not an object reads as empty
    collected = dispatcher.query_job(repo = repo, expert = expert, job_id = job_id)
    response = collected.get(self._JOB_RESPONSE)
    response = response if isinstance(response, dict) else {}

    # guard: the writer finished with an error, or a response that violates the envelope
    if collected.get(self._JOB_STATUS) != self._STATUS_DONE:
      raise _domains.DomainLandingError(
        f"writer outcome {response.get(self._JOB_OUTCOME)!r}: {response.get(self._JOB_ERROR)!r}"
      )

    # every file the job returned, read whole
    returned = self._read_returned_docs(job_dir, response)

    # the request names the group, its folder note, and every doc the job may return
    try:
      request = json.loads((job_dir / self._JOB_REQUEST).read_text(encoding = self._ENCODING))
    except (OSError, json.JSONDecodeError) as error:
      raise _domains.DomainLandingError(f"unreadable {self._JOB_REQUEST}: {error}") from error
    group = str(request.get(_domains.GROUP_KEY, ""))
    targets = self._build_job_targets(request)

    # Domain(wiki.domains):
    # # A writer's return lands whole or not at all
    # A writer for one group returns the group's folder note and the documents of every block whose
    # knowledge changed. The return is placed only when it is complete and names nothing the request did
    # not ask for: a missing file would leave the folder half regenerated, and a file the request never
    # named has no place in the tree.

    # every returned file must be one the request named, and every required file must be returned
    unknown = sorted(set(returned) - set(targets))
    missing = sorted(set(targets) - set(returned))

    # guard: the return is incomplete or carries a file the request never named
    if unknown or missing:
      raise _domains.DomainLandingError(
        f"returned files do not match the request: unknown {unknown}, missing {missing}"
      )

    # what every path holds now, so a failed commit can put them back
    index = _domains.DomainIndex(cfg = cfg)
    rels = [ targets[name] for name in sorted(returned) ]
    before = {
      rel: (repo / rel).read_bytes() if (repo / rel).is_file() else None
      for rel in ( *rels, index.index_rel(), *index.render_sections() )
    }

    # land every file, refresh the index, and record exactly those paths — under the normalised
    # spellings the landing returns — in one commit
    landing = _domains.DomainLanding(cfg = cfg)
    contracts = self._build_job_contracts(request)
    for name in sorted(returned):
      returned[name] = landing.strip_contracts(returned[name], contracts.get(name, []))
      landing.validate_doc(targets[name], returned[name], payload = request)
    paths = [ landing.save_doc(targets[name], returned[name], payload = request) for name in sorted(returned) ]
    paths.append(index.index_rel())
    index.apply()
    paths.extend(index.apply_sections())
    exit_code = self._commit_paths(repo = repo, paths = paths, message = self._SUBJECT_DOMAINS_PREFIX + group)

    # the commit landed — nothing to undo
    if exit_code == 0:
      return True

    # undo the landing: unstage what the commit attempt staged, then restore the bytes
    subprocess.run([ "git", "reset", "-q", "--", *paths ], cwd = str(repo), check = False, capture_output = True)
    for rel, data in before.items():
      if data is None:
        (repo / rel).unlink(missing_ok = True)
      else:
        (repo / rel).write_bytes(data)
    return False


  @staticmethod
  def _build_job_targets(request: dict) -> dict[str, str]:
    """
    Map every file name a job may return to the repo-relative path it lands at.

    Args:
      request: The job's parsed `request.json`.

    Returns:
      File name to path, for the folder note and every doc the request names as stale — a doc
      that was current is not the job's to rewrite.
    """
    docs = request.get(_domains.GROUP_DOCS)
    stale = set(request.get(_domains.GROUP_STALE) or [])

    # the folder note, then every stale doc the request lists
    rels = [ str(request.get(_domains.GROUP_FOLDER_NOTE, "")) ]
    if isinstance(docs, list):
      rels += [
        str(doc.get(_domains.GROUP_DOC, ""))
        for doc in docs
        if isinstance(doc, dict) and doc.get(_domains.DOC_SLUG) in stale
      ]
    return { Path(rel).name: rel for rel in rels if rel }


  @staticmethod
  def _build_job_contracts(request: dict) -> dict[str, list[dict]]:
    """
    Map every doc file name a job's request names to the contracts attributed to that doc.

    Args:
      request: The job's parsed `request.json`.

    Returns:
      File name to contract block dicts, an empty list for a doc with none; the folder note is absent.
    """
    docs = request.get(_domains.GROUP_DOCS)

    # guard: a request without a doc list attributes no contract anywhere
    if not isinstance(docs, list):
      return {}
    return {
      Path(str(doc.get(_domains.GROUP_DOC, ""))).name: [
        contract for contract in doc.get(_domains.GROUP_CONTRACTS) or [] if isinstance(contract, dict)
      ]
      for doc in docs
      if isinstance(doc, dict) and doc.get(_domains.GROUP_DOC)
    }


  def _read_returned_docs(self, job_dir: Path, response: dict) -> dict[str, str]:
    """
    Read every file a finished job returned in its `result/` directory.

    Args:
      job_dir: The job's bundle directory.
      response: The job's parsed `response.json`.

    Returns:
      File name to text, one entry per declared result.

    Raises:
      DomainLandingError: When the response declares no result, an entry is not a plain file
        under `result/`, or a declared file is missing or empty.
    """
    entries = response.get(self._JOB_RESULT)

    # guard: the response must declare at least one returned file
    if not isinstance(entries, list) or not entries:
      raise _domains.DomainLandingError(f"response declares no result document: {entries!r}")

    # read every declared entry, refusing anything but a non-empty plain file under result/
    returned: dict[str, str] = {}
    for entry in entries:
      path = entry.get(self._JOB_PATH) if isinstance(entry, dict) else entry

      # guard: each entry must name a file under result/
      if not isinstance(path, str) or not path.startswith(self._RESULT_PREFIX):
        raise _domains.DomainLandingError(f"response declares no result document: {entries!r}")
      name = path[len(self._RESULT_PREFIX):]

      # guard: a plain filename only — no separator, no parent hop
      if not name or "/" in name or "\\" in name or name in { ".", ".." }:
        raise _domains.DomainLandingError(f"result entry is not a plain filename: {path!r}")

      # guard: a declared file that cannot be read is a missing result
      try:
        body = (job_dir / self._JOB_RESULT / name).read_text(encoding = self._ENCODING)
      except OSError as error:
        raise _domains.DomainLandingError(f"result document missing: {path!r}") from error

      # guard: the placeholder core created is empty until the writer fills it
      if not body.strip():
        raise _domains.DomainLandingError(f"result document is empty: {path!r}")
      returned[name] = body
    return returned


  def _cmd_terms_resolve(self, args: argparse.Namespace) -> int:
    """
    Print the terms dictionary scope that a job's documents belong to.

    Prints one JSON object `{scope, dictionary, sources}` on stdout, or `{"status": "noop"}` when the
    documents belong to no dictionary. An unreadable request is reported on stderr.

    Notes:
      - Nothing is written; neither the dictionary nor the job directory changes.

    Args:
      args: Parsed argument namespace; must carry `.job_dir` and `.repo`.

    Returns:
      Integer exit code (0 when a scope or a noop was printed, 1 on a refused request).
    """
    repo = Path(args.repo or os.environ.get(_ENV_REPO_ROOT) or os.getcwd()).resolve()

    # resolve the job's documents; an unreadable request is reported, never guessed at
    try:
      scope = _term_dictionary.resolve_terms_scope(repo, self._request_files(Path(args.job_dir)))
    except ( _job_response.JobRefusedError, *self._UNEXPECTED_FAILURES ) as caught:
      refusal = self._as_refusal(caught)
      print(f"{self._CMD_TERMS_RESOLVE}: {refusal.reason}", file = sys.stderr)
      return 1

    # guard: the documents belong to no dictionary
    if scope is None:
      print(json.dumps({ self._OUT_STATUS: self._OUTCOME_NOOP }))
      return 0
    print(json.dumps({
      self._OUT_SCOPE:      scope.scope_id,
      self._OUT_DICTIONARY: scope.dictionary,
      self._OUT_SOURCES:    scope.sources,
    }))
    return 0


  def _cmd_terms_write(self, args: argparse.Namespace) -> int:
    """
    Apply a curated batch of term operations to the scope's dictionary and commit it.

    Reads the job's documents from `request.json` (`files`, or the legacy single `file` as a batch of
    one) and the operations from `result/terms.json`. Only the dictionary is written and committed,
    with the subject `wiki(terms): <term>` for one operation or `wiki(terms): <dir> (<n> terms)` for
    several. Prints one JSON line `{status, dictionary, operations, commit, category, reason}` on
    stdout, and the refusal reason on stderr.

    Notes:
      - A refusal of the batch, whatever check raises it, comes before the dictionary is written and leaves it
        untouched.
      - `response.json` is left at the root of the job directory on every outcome: `curated`, listing
        `result/terms.json`; a bare `noop`; or an error carrying the category logical, technical or
        transient.
      - A failed commit, a failed file write or an unreachable core CLI is reported as a transient refusal.

    Args:
      args: Parsed argument namespace; must carry `.job_dir` and `.repo`.

    Returns:
      Integer exit code (0 when the batch is applied or there was nothing to apply, 1 on a refusal).
    """
    repo = Path(args.repo or os.environ.get(_ENV_REPO_ROOT) or os.getcwd()).resolve()
    job_dir = Path(args.job_dir)
    dictionary: str | None = None

    # a refusal from a check, raised before the dictionary is written, leaves it byte-identical
    try:
      files = self._request_files(job_dir)
      scope = _term_dictionary.resolve_terms_scope(repo, files)

      # guard: the documents belong to no dictionary, or none of them is a term source
      if scope is None:
        _job_response.write_response(job_dir, outcome = self._OUTCOME_NOOP)
        print(json.dumps(self._terms_outcome(self._OUTCOME_NOOP, None, 0, commit = None)))
        return 0

      # the curator's operations for the scope's dictionary
      dictionary = scope.dictionary
      operations = self._read_json_object(job_dir / self._RESULT_TERMS, what = self._RESULT_TERMS).get(
        self._RESULT_OPS,
      )
      # guard: the operations must be a list of objects
      if not isinstance(operations, list) or not all(isinstance(op, dict) for op in operations):
        raise _job_response.JobRefusedError(
          category = _job_response.CATEGORY_TECHNICAL, reason = f"{self._RESULT_TERMS}: operations must be a list",
        )

      # guard: nothing to apply is a noop for the whole batch
      if not operations:
        _job_response.write_response(job_dir, outcome = self._OUTCOME_NOOP)
        print(json.dumps(self._terms_outcome(self._OUTCOME_NOOP, dictionary, 0, commit = None)))
        return 0

      # write the dictionary the accepted batch yields, then commit exactly that file
      path = repo / dictionary
      text = _term_dictionary.TermDictionary(path = path).apply(operations)
      _textfile.TextFile(path = path).write(text)
      try:
        commit = _wiki_commit.commit_paths(repo, [ dictionary ], self._terms_subject(files, operations))
      except _wiki_commit.WikiCommitError as error:
        raise _job_response.JobRefusedError(
          category = _job_response.CATEGORY_TRANSIENT, reason = str(error),
        ) from error
    except ( _job_response.JobRefusedError, *self._UNEXPECTED_FAILURES ) as caught:
      refusal = self._as_refusal(caught)
      print(f"{self._CMD_TERMS_WRITE}: {refusal.reason}", file = sys.stderr)
      _job_response.write_response(
        job_dir, outcome = _job_response.OUTCOME_ERROR, category = refusal.category, message = refusal.reason,
      )
      outcome = self._terms_outcome(self._STATUS_REFUSED, dictionary, 0, commit = None)
      outcome[self._OUT_CATEGORY] = refusal.category
      outcome[self._OUT_REASON] = refusal.reason
      print(json.dumps(outcome))
      return 1

    # the dictionary is written and committed; the job's answer names its result file
    _job_response.write_response(job_dir, outcome = self._OUTCOME_CURATED, result = [ self._RESULT_TERMS ])
    print(json.dumps(
      self._terms_outcome(self._OUTCOME_CURATED, dictionary, len(operations), commit = commit.status),
    ))
    return 0


  def _cmd_structure_apply(self, args: argparse.Namespace) -> int:
    """
    Apply the structure curator's operations to the project-structure map and commit the result.

    Handles a curate request (`paths` or `path`) and a rename request (`old_paths` and `new_paths`, or the singular
    pair). Paths excluded from the map are dropped from the batch and from the operations. Every outcome is also
    written to `response.json` at the job's root: `curated` listing `result/structure.json`, a bare `noop`, or an
    error with its category.

    Notes:
      - Rewrites and commits the map only when the whole batch is accepted; a refusal from the batch checks
        leaves it untouched.
      - Prints one JSON line on stdout with `status`, `operations`, `commit`, `category` and `reason`.
      - A commit conflict, a failed file write or an unreachable core CLI is reported as a transient refusal.

    Args:
      args: Parsed command line; carries the job directory and optionally the repository root.

    Returns:
      Zero for `curated` and `noop`, one for a refused batch.
    """
    repo = Path(args.repo or os.environ.get(_ENV_REPO_ROOT) or os.getcwd()).resolve()
    job_dir = Path(args.job_dir)
    watch = _structure.StructureWatch(repo = repo)
    operations: list[dict] = []

    # a refusal from the batch checks, raised before the map is written, leaves it byte-identical
    try:
      request = self._read_json_object(job_dir / self._JOB_REQUEST, what = self._JOB_REQUEST)
      rename = request.get(self._REQ_KIND) == self._REQ_KIND_RENAME
      members = self._structure_members(request, rename = rename, watch = watch)

      # guard: every path of the batch is excluded from the map
      if not members:
        _job_response.write_response(job_dir, outcome = self._OUTCOME_NOOP)
        print(json.dumps(self._structure_outcome(self._OUTCOME_NOOP, 0, None)))
        return 0

      # the curator's operations for the map
      raw = self._read_json_object(job_dir / self._RESULT_STRUCTURE, what = self._RESULT_STRUCTURE).get(
        self._RESULT_OPS,
      )
      # guard: the operations must be a list of objects
      if not isinstance(raw, list) or not all(isinstance(op, dict) for op in raw):
        raise _job_response.JobRefusedError(
          category = _job_response.CATEGORY_TECHNICAL,
          reason = f"{self._RESULT_STRUCTURE}: operations must be a list",
        )
      # an operation on an excluded path is never written, whatever the curator judged
      operations = [ op for op in raw if not watch.is_excluded(str(op.get(self._MAP_OP_PATH, ""))) ]
      moves = self._vanished_dir_moves(repo, members) if rename else []

      # guard: nothing to apply is a noop for the whole batch
      if not operations and not moves:
        _job_response.write_response(job_dir, outcome = self._OUTCOME_NOOP)
        print(json.dumps(self._structure_outcome(self._OUTCOME_NOOP, 0, None)))
        return 0

      # write the map the accepted batch yields, then commit exactly that file
      map_path = repo / _structure.MAP_PATH
      text = _structure_map.StructureMap(path = map_path).apply(operations, moves = moves)
      _textfile.TextFile(path = map_path).write(text)
      try:
        commit = _wiki_commit.commit_paths(
          repo, [ _structure.MAP_PATH ], self._structure_subject(members, rename = rename),
        )
      except _wiki_commit.WikiCommitError as error:
        raise _job_response.JobRefusedError(
          category = _job_response.CATEGORY_TRANSIENT, reason = str(error),
        ) from error
    except ( _job_response.JobRefusedError, *self._UNEXPECTED_FAILURES ) as caught:
      refusal = self._as_refusal(caught)
      print(f"{self._CMD_STRUCTURE_APPLY}: {refusal.reason}", file = sys.stderr)
      _job_response.write_response(
        job_dir, outcome = _job_response.OUTCOME_ERROR, category = refusal.category, message = refusal.reason,
      )
      outcome = self._structure_outcome(self._STATUS_REFUSED, 0, None)
      outcome[self._OUT_CATEGORY] = refusal.category
      outcome[self._OUT_REASON] = refusal.reason
      print(json.dumps(outcome))
      return 1

    # the map is written and committed; the job's answer names its result file
    _job_response.write_response(job_dir, outcome = self._OUTCOME_CURATED, result = [ self._RESULT_STRUCTURE ])
    print(json.dumps(self._structure_outcome(self._OUTCOME_CURATED, len(operations), commit.status)))
    return 0


  def _cmd_structure_resolve(self, args: argparse.Namespace) -> int:
    """
    Print the paths the structure map describes, each with the depth it is described at.

    The output is one JSON object carrying the resolved `{path, depth}` entries and whether the map exists.
    The reason for a failure goes to standard error.

    Args:
      args: Parsed command line; carries the job directory or the whole-tree switch, and optionally the
        repository root.

    Returns:
      Zero when the resolution is printed, one when the request or the tracked tree cannot be read.
    """
    repo = Path(args.repo or os.environ.get(_ENV_REPO_ROOT) or os.getcwd()).resolve()
    profiles = _structure.StructureProfiles(watch = _structure.StructureWatch(repo = repo))

    # one job's paths (a rename's new side), or every directory of the tree; a failure is reported, never guessed at
    try:
      if args.all_dirs:
        resolved = profiles.resolve_all()
      else:
        request = self._read_json_object(Path(args.job_dir) / self._JOB_REQUEST, what = self._JOB_REQUEST)
        rename = request.get(self._REQ_KIND) == self._REQ_KIND_RENAME
        paths = (
          self._list_or_single(request, self._REQ_NEW_PATHS, self._REQ_NEW_PATH) if rename
          else self._list_or_single(request, self._REQ_PATHS, self._REQ_PATH)
        )
        resolved = profiles.resolve(paths)
    except ( _job_response.JobRefusedError, _structure.StructureResolveError, *self._UNEXPECTED_FAILURES ) as caught:
      print(f"{self._CMD_STRUCTURE_RESOLVE}: {caught}", file = sys.stderr)
      return 1
    print(json.dumps({
      _structure.RESOLVE_PATHS:       resolved,
      _structure.RESOLVE_MAP_PRESENT: (repo / _structure.MAP_PATH).is_file(),
    }))
    return 0


  def _structure_members(self,
                         request: dict,
                         *,
                         rename: bool,
                         watch: _structure.StructureWatch) -> list[tuple[str, str]]:
    """
    Read the (old, new) path pairs a structure request covers, without the excluded ones.

    Args:
      request: Parsed job request.
      rename: Whether the request is a rename batch rather than a curate batch.
      watch: Source of the exclusions.

    Returns:
      Pairs of old and new path; a curate path is paired with itself. A pair is dropped when both of its sides are
      excluded.

    Raises:
      JobRefusedError: With the logical category when the request names no path or the two sides of a rename
        differ in length.
    """
    # a rename batch is aligned old/new pairs; a curate batch pairs each path with itself
    if rename:
      olds = self._list_or_single(request, self._REQ_OLD_PATHS, self._REQ_OLD_PATH)
      news = self._list_or_single(request, self._REQ_NEW_PATHS, self._REQ_NEW_PATH)
      # guard: the two sides of a rename batch must align
      if len(olds) != len(news):
        raise _job_response.JobRefusedError(
          category = _job_response.CATEGORY_LOGICAL, reason = "old_paths and new_paths differ in length",
        )
      pairs = list(zip(olds, news, strict = True))
    else:
      pairs = [ (path, path) for path in self._list_or_single(request, self._REQ_PATHS, self._REQ_PATH) ]

    # guard: a request naming no path is malformed input
    if not pairs:
      raise _job_response.JobRefusedError(
        category = _job_response.CATEGORY_LOGICAL, reason = f"{self._JOB_REQUEST} names no path",
      )

    # a pair drops out only when both of its sides are excluded
    return [ (old, new) for old, new in pairs if not (watch.is_excluded(old) and watch.is_excluded(new)) ]


  @staticmethod
  def _list_or_single(request: dict, list_key: str, single_key: str) -> list[str]:
    """
    Read a request field given either as a list or as a single value.

    Args:
      request: Parsed job request.
      list_key: Key of the list form.
      single_key: Key of the singular form.

    Returns:
      The list form when present, else the singular value as a one-item list, else an empty list.
    """
    values = request.get(list_key)

    # the list form wins; the singular form is a batch of one
    if isinstance(values, list):
      return [ str(value) for value in values ]
    single = request.get(single_key)
    return [ single ] if isinstance(single, str) and single else []


  @staticmethod
  def _vanished_dir_moves(repo: Path, members: list[tuple[str, str]]) -> list[tuple[str, str]]:
    """
    Derive the directory renames implied by moved files.

    Args:
      repo: Repository root; a directory that still exists under it is not a rename.
      members: Pairs of old and new file path.

    Returns:
      Pairs of old and new directory prefix, with trailing slash and without duplicates, for each directory that
      no longer exists.
    """
    moves: list[tuple[str, str]] = []

    # each pair's differing directory prefixes, after the shared tail of the path is stripped
    for old, new in members:
      old_parts, new_parts = Path(old).parts, Path(new).parts
      while len(old_parts) > 1 and len(new_parts) > 1 and old_parts[-1] == new_parts[-1]:
        old_parts, new_parts = old_parts[:-1], new_parts[:-1]

      # guard: only a file-level move under a renamed directory leaves a directory prefix behind
      if len(old_parts) == len(Path(old).parts):
        continue
      old_dir = Path(*old_parts).as_posix() + "/"
      new_dir = Path(*new_parts).as_posix() + "/"

      # guard: a directory still on disk keeps its own entry, and a pair already collected is not added twice
      if (repo / old_dir).exists() or (old_dir, new_dir) in moves:
        continue
      moves.append((old_dir, new_dir))
    return moves


  @staticmethod
  def _structure_subject(members: list[tuple[str, str]], *, rename: bool) -> str:
    """
    Compose the commit subject of a structure map update.

    Args:
      members: Pairs of old and new path covered by the batch.
      rename: Whether the batch is a rename.

    Returns:
      A subject naming the basename for one path, `<old> -> <new>` for one rename, `<dir> (<n> paths)` for a
      curate batch, or `<new-dir> (<n> renames)` for a rename batch.
    """
    # one member is named by its basename, or by both basenames for a rename
    if len(members) == 1:
      old, new = members[0]
      if rename:
        return f"wiki(structure): {Path(old).name} -> {Path(new).name}"
      return f"wiki(structure): {Path(new).name}"

    # several are named by the directory they share, with the count
    parents = [ Path(new).parent.as_posix() for _, new in members ]
    common = Path(os.path.commonpath(parents)).as_posix()
    noun = "renames" if rename else "paths"
    return f"wiki(structure): {common} ({len(members)} {noun})"


  def _structure_outcome(self, status: str, operations: int, commit: str | None) -> dict:
    """
    Build the outcome record the structure apply verb prints on stdout.

    Args:
      status: Outcome word of the run.
      operations: Number of map operations applied.
      commit: Commit status of the map write, or None when nothing was committed.

    Returns:
      Mapping with `status`, `operations`, `commit`, `category` and `reason`, the last two unset.
    """
    return {
      self._OUT_STATUS:     status,
      self._OUT_OPERATIONS: operations,
      self._OUT_COMMIT:     commit,
      self._OUT_CATEGORY:   None,
      self._OUT_REASON:     None,
    }


  def _terms_outcome(self, status: str, dictionary: str | None, operations: int, *, commit: str | None) -> dict:
    """
    Build the outcome record the terms write verb prints on stdout.

    Args:
      status: Outcome word of the run.
      dictionary: Repo-relative path of the scope's dictionary, or None when no dictionary applies.
      operations: Number of term operations applied.
      commit: Commit status of the dictionary write, or None when nothing was committed.

    Returns:
      Mapping with `status`, `dictionary`, `operations`, `commit`, `category` and `reason`, the last two unset.
    """
    return {
      self._OUT_STATUS:     status,
      self._OUT_DICTIONARY: dictionary,
      self._OUT_OPERATIONS: operations,
      self._OUT_COMMIT:     commit,
      self._OUT_CATEGORY:   None,
      self._OUT_REASON:     None,
    }


  def _request_files(self, job_dir: Path) -> list[str]:
    """
    Return the documents a job's request names.

    The `files` list is preferred; the legacy single `file` form counts as a batch of one.

    Args:
      job_dir: Job directory holding `request.json`.

    Returns:
      Repo-relative document paths in request order.

    Raises:
      JobRefusedError: If the request is unreadable or names no document.
    """
    request = self._read_json_object(job_dir / self._JOB_REQUEST, what = self._JOB_REQUEST)
    files = request.get(self._REQ_FILES)

    # the list form wins; the legacy singular form is a batch of one
    if isinstance(files, list):
      return [ str(rel) for rel in files ]
    single = request.get(self._REQ_FILE)
    # guard: a request naming no document is malformed input
    if not isinstance(single, str) or not single:
      raise _job_response.JobRefusedError(
        category = _job_response.CATEGORY_LOGICAL, reason = f"{self._JOB_REQUEST} names no document",
      )
    return [ single ]


  def _terms_subject(self, files: list[str], operations: list[dict]) -> str:
    """
    Compose the commit subject for a batch of term operations.

    A single operation is named by its term; several are named by the directory the documents share,
    followed by the number of terms.

    Args:
      files: Repo-relative paths of the documents the batch came from.
      operations: Term operations being committed.

    Returns:
      Subject line of the form `wiki(terms): <term>` or `wiki(terms): <dir> (<n> terms)`.
    """
    # one operation is named by its term
    if len(operations) == 1:
      return f"wiki(terms): {operations[0].get(self._TERMS_OP_TERM, '')}"

    # several are named by the directory the documents share, with the count
    parents = [ Path(rel).parent.as_posix() for rel in files ] or [ "." ]
    common = os.path.commonpath(parents) if len(parents) > 1 else parents[0]
    return f"wiki(terms): {Path(common).as_posix()} ({len(operations)} terms)"


  def _cmd_terms_apply(self, args: argparse.Namespace) -> int:
    """
    Apply one settled terms decision to a single document.

    Which side of a reported terminology divergence wins is the operator's decision; this verb
    performs that substitution in prose and decides nothing itself. Prints a one-line outcome to
    stdout, or the refusal reason to stderr.

    Guarantees:
      - A refused document is reported on stderr with exit 1 and is never written.

    Args:
      args: Parsed argument namespace; must carry `.path`, `.old_term`, `.new_term`, and `.repo`.

    Returns:
      Integer exit code (0 when the replacement ran or found nothing to do, 1 on a refusal).
    """

    # Contract:
    # A refused document is reported on stderr with exit 1 and is NEVER written.

    repo = Path(args.repo or os.environ.get(_ENV_REPO_ROOT) or os.getcwd()).resolve()
    result = _terms.apply_term(repo, args.path, args.old_term, args.new_term)

    # the verb declined to touch the document — the reason is the whole output
    if result[self._FIELD_TERMS_STATUS] == _terms.STATUS_REFUSED:
      print(
        f"{self._CMD_TERMS_APPLY}: refused {result[self._FIELD_TERMS_FILE]} — "
        f"{result[self._FIELD_TERMS_REASON]}",
        file = sys.stderr,
      )
      return 1

    # a performed pass and an already-applied one differ only in the count they report
    print(
      f"{self._CMD_TERMS_APPLY}: {result[self._FIELD_TERMS_STATUS]} "
      f"{result[self._FIELD_TERMS_FILE]} ({result[self._FIELD_TERMS_REPLACEMENTS]} replacements)"
    )
    return 0


  def _cmd_mirror_plan(self, args: argparse.Namespace) -> int:
    """
    Print the dry-run sync plan for one mirror scope.

    Prints the plan as one JSON object on stdout. An unknown scope, a scope without a mirror
    block, and a failed fetch of the source are reported on stderr.

    Guarantees:
      - The dry run leaves the mirror tree untouched and never commits; only the runtime
        clone cache is refreshed.

    Args:
      args: Parsed argument namespace; must carry `.scope_id` and `.repo`.

    Returns:
      Integer exit code (0 on success, 1 on unknown scope, missing mirror
      block, or fetch failure).
    """

    # Contract:
    # The dry run leaves the mirror tree untouched and NEVER commits; the only thing it
    # writes is the runtime clone cache the plan is computed against.

    engine = self._fetch_mirror_engine(args, verb = self._CMD_MIRROR_PLAN)

    # guard: unknown scope, missing mirror block, or fetch failure — already reported
    if engine is None:
      return 1

    # the dry run stops at the plan — nothing is written or committed
    print(json.dumps(engine.plan()))
    return 0


  def _cmd_mirror_sync(self, args: argparse.Namespace) -> int:
    """
    Apply the sync plan for one mirror scope and commit the fallout.

    Commits the new and updated mirror files together with the tracked removals, and prints the
    applied report as one JSON object on stdout. A second run against an unchanged source
    commits nothing. An unknown scope, a scope without a mirror block, and a failed fetch of
    the source are reported on stderr.

    Args:
      args: Parsed argument namespace; must carry `.scope_id` and `.repo`.

    Returns:
      Integer exit code (0 on success, 1 on unknown scope, missing mirror
      block, fetch failure, or commit failure).
    """
    engine = self._fetch_mirror_engine(args, verb = self._CMD_MIRROR_SYNC)

    # guard: unknown scope, missing mirror block, or fetch failure — already reported
    if engine is None:
      return 1

    # apply the plan; the report doubles as the tick summary printed below
    repo = Path(args.repo or os.environ.get(_ENV_REPO_ROOT) or os.getcwd()).resolve()
    report = engine.sync()

    # commit new + updated files and tracked removals under one deterministic message
    touched = [
      *report[_mirror.K_SYNCED],
      *report[_mirror.K_UPDATED],
      *self._query_tracked_paths(repo, report[_mirror.K_REMOVED]),
    ]
    exit_code = self._commit_paths(
      repo    = repo,
      paths   = touched,
      message = (
        f"wiki(mirror): sync {args.scope_id} "
        f"(+{len(report[_mirror.K_SYNCED])} ~{len(report[_mirror.K_UPDATED])} "
        f"-{len(report[_mirror.K_REMOVED])})"
      ),
    )
    # guard: commit failed — surface the error so the daemon records it
    if exit_code != 0:
      return exit_code

    # the applied report is the caller's one-line summary
    print(json.dumps(report))
    return 0


  def _fetch_mirror_engine(self, args: argparse.Namespace, *, verb: str) -> _mirror.MirrorSync | None:
    """
    Resolve, validate, and fetch the mirror engine for one scope.

    Args:
      args: Parsed argument namespace; must carry `.scope_id` and `.repo`.
      verb: CLI verb name prefixing every error message.

    Returns:
      The fetched engine, or `None` when the scope is unknown, carries no
      mirror block, or the fetch failed (the error is already printed).
    """
    repo = Path(args.repo or os.environ.get(_ENV_REPO_ROOT) or os.getcwd()).resolve()
    scopes = _scope.ScopeResolver(repo = repo).load_scopes()

    # guard: requested scope id not present in settings
    if args.scope_id not in scopes:
      print(
        f"{verb}: {self._MSG_UNKNOWN_SCOPE} '{args.scope_id}' "
        f"(known: {', '.join(sorted(scopes)) or 'none'})",
        file = sys.stderr,
      )
      return None

    # build the scope's mirror engine; the scope must carry a usable mirror block
    engine = _mirror.MirrorSync(repo = repo, scope_id = args.scope_id, cfg = scopes[args.scope_id])

    # guard: scope carries no usable mirror block
    if not engine.is_configured:
      print(
        f"{verb}: scope '{args.scope_id}' {self._MSG_NO_MIRROR_BLOCK}",
        file = sys.stderr,
      )
      return None

    # a fetch failure leaves the mirror untouched and must surface to the daemon
    error = engine.fetch()

    # guard: fetch failed — report it and hand the caller nothing to act on
    if error is not None:
      print(f"{verb}: {error}", file = sys.stderr)
      return None

    # the engine is validated and freshly fetched — ready for plan or sync
    return engine


  def _query_tracked_paths(self, repo: Path, paths: list[str]) -> list[str]:
    """
    Filter a path list down to those git currently tracks.

    Args:
      repo: Absolute repository root the git command runs in.
      paths: Repo-relative candidate paths.

    Returns:
      The subset of `paths` present in the git index, in git's output order;
      empty when `paths` is empty or the lookup fails.
    """
    # guard: nothing to filter
    if not paths:
      return []

    # ask git which of the paths it tracks
    proc = subprocess.run(
      [ "git", "ls-files", "--", *paths ],
      cwd = str(repo),
      capture_output = True,
      text = True,
      check = False, encoding = self._ENCODING,
    )

    # guard: lookup failed — treat every path as untracked
    if proc.returncode != 0:
      return []
    return [ line for line in proc.stdout.splitlines() if line ]


  def _is_domain_trigger(self, cfg: _domains.DomainConfig, rel: str) -> bool:
    """
    Decide whether a trigger path warrants a domain tick.

    Args:
      cfg: The repo's domain configuration.
      rel: Repo-relative (or absolute) path of the changed file.

    Returns:
      True when the path matches a configured code glob or is the dictionary file.
    """
    path = Path(rel)

    # guard: an absolute trigger is normalised to the repo-relative POSIX form the globs expect
    if path.is_absolute():
      try:
        rel = path.resolve().relative_to(cfg.repo).as_posix()
      except ValueError:
        # guard: outside the repo — cannot match any source
        return False

    # the dictionary itself is a domain source
    if rel == cfg.dictionary:
      return True

    # otherwise the path must match one of the configured code globs
    matcher = _scope.GlobMatcher()
    return any(matcher.match(rel, pat) for pat in cfg.code)


  def _parse_paths_arg(self, raw: str) -> list[str]:
    """
    Parse the `path` argument into the list of paths it names.

    A bare path names itself. A git-item JSON names its `paths` members when it carries the
    list (a whole-tick or directory-grouped item), else its single `path`; a JSON with neither
    key, or one that does not parse, is taken as a bare path.

    Args:
      raw: The raw argument string.

    Returns:
      The path strings the argument names, in the item's own order; never empty.
    """
    stripped = raw.strip()

    # an argument that does not look like a JSON object is a bare path
    if not stripped.startswith("{"):
      return [ raw ]

    # parse the git item; an unparseable one is taken as a bare path
    try:
      parsed: dict = json.loads(stripped)
    except json.JSONDecodeError:
      # guard: JSON parse error — fall back to the raw string
      return [ raw ]
    members = parsed.get(self._GIT_ITEM_PATHS_KEY)

    # a member list, when present, is the item's whole subject; a lone `path` is the file form
    if isinstance(members, list) and members:
      return [ str(member) for member in members ]

    # guard: neither shape — fall back to the raw string
    if self._GIT_ITEM_PATH_KEY not in parsed:
      return [ raw ]
    return [ str(parsed[self._GIT_ITEM_PATH_KEY]) ]


  def _unknown_subcommand(self, name: str) -> int:
    """
    Report a parsed subcommand that has no handler on stderr.

    Args:
      name: The subcommand name that was invoked.

    Returns:
      A non-zero exit code.
    """
    print(f"{self._PROG} {name}: unknown subcommand", file = sys.stderr)
    return 2


if __name__ == "__main__":
  sys.exit(Cli().run())
