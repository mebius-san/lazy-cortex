# Environment variable name that carries the repository root.
_ENV_REPO_ROOT = "LAZY_REPO_ROOT"
# The last-stdout-line key a multi-path worker narrows the daemon's retry unit with
_FAILED_PATHS_KEY = "failed_paths"
# Environment variable the daemon exports with the routine's subprocess timeout, in seconds.
_ENV_ROUTINE_TIMEOUT = "LAZY_ROUTINE_TIMEOUT_SEC"


# ----------------------------------------------------------------------------------------
class _ProcessFileRun:
  """
  Shared state of one `process-file` invocation.

  Lets every path of the invocation draw on one time budget and on lookups that do not change between
  paths. The budget comes from the `LAZY_ROUTINE_TIMEOUT_SEC` environment variable the daemon exports; an
  invocation without it has no budget.
  """

  # Domain(runtime.routines):
  # # Time budget of a batch worker
  # The daemon gives a routine's worker a fixed time and kills it when it outlives that time. A kill loses the
  # record of what the worker had already finished, so the same oversized batch is handed over again and times
  # out again. A worker over a batch of independent items therefore spends only a share of its time. Once the
  # share is used up it starts no further item, reports the items it did not start as still owed, and ends as a
  # partial failure. The daemon then retries only the owed items, so one oversized batch becomes several runs
  # that each make progress. The first item of a batch always runs, so every run moves forward. With no declared
  # time limit, as in a run by hand, there is no budget and every item is handled.

  # Share of the routine's timeout an invocation may spend before it stops starting new paths;
  # the rest is left for the path in flight and for the daemon's own bookkeeping.
  _BUDGET_FRACTION = 0.8

  def __init__(self, *, repo: Path) -> None:
    """
    Begin tracking one `process-file` invocation and start its time budget.

    Args:
      repo: Absolute repository root the invocation works in.
    """
    self._repo = repo
    self._deadline = self._compute_deadline()
    self._tags: dict[str, dict] = {}
    self._queued_keys: set[str] | None = None

  # ------------------------------------------------------------------
  def is_spent(self) -> bool:
    """
    Tell whether the invocation has used up its time budget.

    Returns:
      True once the budget the daemon's timeout allows has elapsed; always False when the
      invocation runs without a declared timeout.
    """
    return self._deadline is not None and time.monotonic() >= self._deadline

  # ------------------------------------------------------------------
  def read_tags(self, scope_id: str, cfg: dict) -> dict:
    """
    Return the tag survey of one scope, taken at most once per invocation.

    Args:
      scope_id: The scope's identifier.
      cfg: The scope-config dict.

    Returns:
      The scope's per-axis tag survey; the same survey for every call with the same scope.
    """
    # opt: one survey per scope per invocation — assumes the survey may lag by the length of one invocation:
    # it is an advisory anchor for the curator, so a value another writer adds meanwhile is only missing from it
    if scope_id not in self._tags:
      self._tags[scope_id] = _tags.TagOps(repo = self._repo, scope_id = scope_id, cfg = cfg).collect()
    return self._tags[scope_id]

  # ------------------------------------------------------------------
  def is_queued(self, node_path: Path) -> bool:
    """
    Tell whether a classify job for the node already waits unclaimed in the queue.

    Notes:
      - When the queue cannot be read, no job counts as queued and every node is dispatched.
      - A job already running does not count: it may have read the node before its latest change.

    Args:
      node_path: Absolute or repo-relative path to the node.

    Returns:
      True when a repeated dispatch for the node would only collapse into a job that has not started.
    """
    # opt: the queue is read once per invocation — assumes every path of the invocation was committed before
    # it started, so a job still unclaimed at the read sees the node as it stands now whenever it is claimed
    if self._queued_keys is None:
      try:
        self._queued_keys = _dispatch.CoreDispatch().query_queued_dedup_keys(
          repo = self._repo, expert = _dispatch.CoreDispatch.EXPERT_NAME,
        )
      except (RuntimeError, json.JSONDecodeError):
        # the check only spares work: without the listing every dispatch still goes to core, which
        # collapses a repeat itself
        self._queued_keys = set()
    return _dispatch.CoreDispatch.curator_dedup_key(
      repo = self._repo, node_path = node_path, kind = _dispatch.CoreDispatch.KIND_CLASSIFY,
    ) in self._queued_keys

  # ------------------------------------------------------------------
  @classmethod
  def _compute_deadline(cls) -> float | None:
    """
    Compute the moment after which no new path is started.

    Derives the deadline from a share of the timeout in the `LAZY_ROUTINE_TIMEOUT_SEC` environment variable.

    Returns:
      The monotonic-clock deadline, or None when the variable is absent or not a positive number.
    """
    try:
      timeout_sec = float(os.environ.get(_ENV_ROUTINE_TIMEOUT, ""))
    except ValueError:
      return None

    # guard: a timeout that is not a positive number bounds nothing
    if math.isnan(timeout_sec) or timeout_sec <= 0:
      return None
    return time.monotonic() + timeout_sec * cls._BUDGET_FRACTION


