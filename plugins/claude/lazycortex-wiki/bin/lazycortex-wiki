  # Domain(wiki.graph):
  # # Curation runs only when the operator's source changed
  # A node is curated again only when what the operator wrote in it has changed since its last curation.
  # At curation time the node records the fingerprint of its operator-authored source; a node whose
  # recorded fingerprint equals the current one is left alone, while a node with no recorded fingerprint
  # (never curated) or a differing one is curated.
  # The curator writes only into managed regions, which the fingerprint does not cover, so its own commits
  # never change the fingerprint and never summon another curation of the same node.
  # The rule is identical for a single changed node and for the periodic full pass over a scope.

  # Section label the repo-level domain findings are printed under.
  _DOMAIN_SECTION = "domains"

