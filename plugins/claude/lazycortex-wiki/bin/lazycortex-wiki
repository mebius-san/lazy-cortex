  _MSG_STOPPED         ="{cmd}: stopped by signal {signum}; paths the rollback could not put back: {failed}"

  # Curation phases a curator job runs; the commit subject and the outcome line name them.
  _PHASE_CLASSIFY      = "classify"
  _PHASE_LINK          = "link"
  _PHASE_CLASSIFY_LINK = "classify+link"

  # The curator job's result file, as the job dir holds it and as the response lists it.
  _RESULT_CURATION = "result/curation.json"
  _JOB_CURATION    = Path(_RESULT_CURATION)

  # Outcome values a job-dir verb reports in its response and its outcome line.
  _OUTCOME_CURATED = "curated"
  _OUTCOME_EMPTY   = "empty"
  _STATUS_REFUSED  = "refused"
  _STATUS_APPLIED  = "applied"

  # The tag-curator job's result file, as its curated response lists it.
  _RESULT_ALIAS_MAP = "result/alias_map.json"

  # Reading and writing git index entries for a run's undo: how many paths one git call names, the separator
  # between an entry and its path, and the object name that drops an entry.
  _INDEX_BATCH = 500
  _TAB         = "\t"
  _ZERO_OBJECT = "0" * 40

  # Names the tag-apply input files are reported under when one cannot be read.
  _WHAT_ALIAS_MAP = "alias-map"
  _WHAT_GLOSSES   = "glosses"

  # The terms-curator job's result file, and the request keys naming its documents.
  _RESULT_TERMS   = "result/terms.json"
  _REQ_FILES      = "files"
  _REQ_FILE       = "file"
  _RESULT_OPS     = "operations"
  _TERMS_OP_TERM  = "term"
