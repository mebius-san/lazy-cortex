  _MSG_DOMAIN_TICK_SKIP           = "domain-tick: skip (wiki.domains not configured)"
  _MSG_DOMAIN_COLLECT_SKIP        = "domain-collect: skip (wiki.domains not configured)"
  _MSG_DOMAINS_UNCONFIGURED_LAND  = "domain-land: wiki.domains not configured (run /wiki.configure domains)"
  _MSG_DOMAINS_UNCONFIGURED_REPAIR = "domain-repair: wiki.domains not configured (run /wiki.configure domains)"
