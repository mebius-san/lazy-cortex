  _TERMS_OP_RELINK   = "relink"
  _TERMS_OP_RETARGET = "retarget"
  # Operation kinds that change the dictionary itself rather than only the documents
  _TERMS_DICTIONARY_OPS = frozenset({ "add", "extend", "rename", "split" })
  # The most characters of one unmatched `skip` fragment an error-ledger detail shows, and the mark of a cut one
  _SKIP_FRAGMENT_MAX_CHARS = 60
  _ELLIPSIS                = "…"
  # The noun counting the linked documents in a links-only commit subject, for one document and for several.
  _SUBJECT_DOCUMENT  = "document"
  _SUBJECT_DOCUMENTS = "documents"

  # The structure-curator job's result file, and the request keys and kinds naming its paths.
  _RESULT_STRUCTURE = "result/structure.json"
  _REQ_KIND         = "kind"
  _REQ_KIND_RENAME  = "rename"
  _REQ_PATHS        = "paths"
  _REQ_PATH         = "path"
  _REQ_OLD_PATHS    = "old_paths"
  _REQ_OLD_PATH     = "old_path"
  _REQ_NEW_PATHS    = "new_paths"
  _REQ_NEW_PATH     = "new_path"
  _MAP_OP_PATH      = "path"

  # The navigation rule's file name, the shipped copy's location, and the home fallback dir.
  _NAV_RULE_NAME   = "lazy-wiki.navigation.md"
  _NAV_SHIPPED     = Path(__file__).resolve().parents[1] / "rules" / "lazy-wiki.navigation.md"
  _NAV_REPO_RULES  = Path(".claude") / "rules"
  _NAV_HOME_RULES  = Path.home() / ".claude" / "rules"
  _NAV_DEFAULT_SUBJECT = "chore(wiki): refresh navigation rule"

  # Keys and values of the render-navigation-rule outcome line.
  _OUT_PATH            = "path"
  _OUT_COVERAGE        = "coverage"
  _OUT_DOMAIN_COVERAGE = "domain_coverage"
  _NAV_INSTALLED       = "installed"
