  # Separator of every NUL-separated git listing (`-z`), which prints each path as written, never quoted.
  _NUL                   = "\0"
  # The pathspec magic that makes git read a path as written, never as a glob pattern.
  _LITERAL               = ":(literal)"
  # A commit record of a `git show` listing: its fields are split by a NUL, records end with a record separator,
