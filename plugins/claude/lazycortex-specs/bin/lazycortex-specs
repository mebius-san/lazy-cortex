# The entry function name most sibling modules route their subcommand to.
_MAIN = "main"
# The sibling module that resolves the spec content-root and owns its refusal.
_SPEC_PATHS = "spec_paths"
_EXIT_REFUSED = 2

# The sibling module and entry function each subcommand routes to; a module loads only when its own subcommand runs,
# so one broken module never takes the whole entry down.
_ROUTES: dict[str, tuple[str, str]] = {
    _SUB_OPEN_REQUEST: ( "open_request", _MAIN ),
    _SUB_APPLY_REQUEST: ( "apply_request", _MAIN ),
    _SUB_RESOLVE_PRODUCT: ( "resolve_product", _MAIN ),
    _SUB_RESOLVE_LANGUAGE: ( "resolve_language", _MAIN ),
    _SUB_FLIP_GATE: ( "asset_uncancel", _MAIN ),
    _SUB_GATE_TICK: ( "gate_tick", _MAIN ),
    _SUB_LAND_RESULT: ( "land_result", _MAIN ),
    _SUB_COLLECT_TICK: ( "collect_tick", _MAIN ),
    _SUB_SCAFFOLD_ASSET: ( "scaffold_asset", _MAIN ),
    _SUB_SEED_DOC: ( "seed_doc", _MAIN ),
    _SUB_RENDER_CONTAINER_STATS: ( "summary_render", _MAIN ),
    _SUB_COORDINATOR_DISPATCH: ( "coordinator_dispatch", _MAIN ),
    _SUB_NOTE_SET_KEY: ( "note_ops", "main_set_key" ),
    _SUB_NOTE_DROP_KEY: ( "note_ops", "main_drop_key" ),
    _SUB_NOTE_CHECK: ( "note_ops", "main_check" ),
    _SUB_NOTE_HISTORY: ( "note_ops", "main_history" ),
    _SUB_CATALOG_NOTE: ( "catalog_note", _MAIN ),
    _SUB_MARK_JOB: ( "spec_job_markers", _MAIN ),
    _SUB_UPSTREAM_TICK: ( "upstream_tick", _MAIN ),
    _SUB_UPSTREAM_DOCTOR: ( "upstream_tick", "main_doctor" ),
    _SUB_DECIDE: ( "spec_decisions", _MAIN ),
    _SUB_PINS: ( "spec_pins", _MAIN ),
    _SUB_DOC_TYPE: ( "spec_doc_types", _MAIN ),
    _SUB_ASSET_TYPE: ( "asset_types", _MAIN ),
    _SUB_TEMPLATE: ( "template_resolve", _MAIN ),
    _SUB_CORE_CLI: ( "gate_dispatch", "main_core_cli" ),
    _SUB_REVIEW_ROWS: ( "review_rows", _MAIN ),
    _SUB_RELEASE_VERSION: ( "release_version", _MAIN ),
    _SUB_RELEASE_DELTA: ( "release_delta", _MAIN ),
    _SUB_RELEASE_SCAFFOLD: ( "release_scaffold", _MAIN ),
    _SUB_RELEASE_DEPLOY: ( "release_deploy", _MAIN ),
    _SUB_RELEASE_PUBLISH: ( "release_publish", _MAIN ),
    _SUB_COHERENCE_APPLY: ( "coherence", "main_apply" ),
    _SUB_COHERENCE_DISMISS: ( "coherence", "main_dismiss" ),
    _SUB_COHERENCE_RESOLVE: ( "coherence", "main_resolve" ),
    _SUB_COHERENCE_DISPATCH: ( "coherence_dispatch", _MAIN ),
    _SUB_SET_STAGE: ( "set_stage", _MAIN ),
    _SUB_COMMIT_NOTE: ( "note_commit", _MAIN ),
    _SUB_PROMOTE_APPROVED: ( "promote_approved", _MAIN ),
    _SUB_SYNC_STATE: ( "sync_state", _MAIN ),
    _SUB_REFRESH_SOURCES: ( "sources_refresh", _MAIN ),
    _SUB_DRIVE_GESTURE: ( "drive_gestures", _MAIN ),
    _SUB_SPEC_CHECK: ( "spec_check", _MAIN ),
    _SUB_RUNTIME_GC: ( "spec_runtime_gc", _MAIN ),
    _SUB_MIGRATE_READINESS: ( "readiness_migrate", _MAIN ),
    _SUB_MIGRATE_NOTES: ( "note_migrate", _MAIN ),
    _SUB_MIGRATE_REVIEW_CLASS: ( "review_class_migrate", _MAIN ),
    _SUB_MIGRATE_REQUESTS: ( "request_migrate", _MAIN ),
    _SUB_MIGRATE_SOURCE_LINKS: ( "source_link_migrate", _MAIN ),
    _SUB_MIGRATE_UPSTREAM_HISTORY: ( "upstream_history_migrate", _MAIN ),
    _SUB_MIGRATE_GATE_ROWS: ( "gate_rows_migrate", _MAIN ),
    _SUB_LOCKIT_TEXT: ( "note_explainers", "main_lockit_text" ),
    _SUB_LOCKIT_KEYS: ( "note_explainers", "main_lockit_keys" ),
}


def resolve_entry(sub: str) -> Callable[[list[str]], int] | None:
  """
  Find the entry function a subcommand routes to, loading its sibling module.

  Guarantees:
    - Only the sibling module of the subcommand asked for is loaded, so a module that cannot load leaves the entry
      itself and every other subcommand working.

  Args:
    sub: The subcommand name.

  Returns:
    The entry function, which takes the subcommand's own arguments and returns its exit code; None when no
    subcommand carries the name.

  Raises:
    ImportError: When the routed sibling module cannot be loaded.
    AttributeError: When the routed sibling module has no entry function of the routed name.
  """

  # Contract:
  # A sibling module MUST load only when its own subcommand is resolved, never when the entry loads or another
  # subcommand runs, so one module that cannot load never takes the whole entry down.

  route = _ROUTES.get(sub)

  # guard: a name no subcommand carries routes nowhere
  if route is None:
    return None

  # the sibling module loads only now, when its own subcommand runs
  module_name, entry = route
  # waiver: the annotated local is what types the entry function; `getattr` alone would hand the caller `Any`
  handler: Callable[[list[str]], int] = getattr(importlib.import_module(module_name), entry)
  return handler


def main(argv: list[str]) -> int:
  """
  Dispatch a lazycortex-specs subcommand from the CLI argument list.

  Args:
    argv: Argument list (typically `sys.argv[1:]`).

  Returns:
    `0` for `-h` / `--help`; `2` for no arguments, an unknown subcommand, or a `spec.vault_root` the
    subcommand refused; otherwise the routed subcommand's own exit code, unchanged.
  """

  # Contract:
  # A subcommand that resolves the spec content-root under a refused `spec.vault_root` ends with exit 2 and
  # the refusal's message on stderr, never with a traceback and never with a result computed from a default.

  if not argv or argv[0] in ("-h", "--help"):
    sys.stderr.write(_USAGE)
    return 0 if argv else 2
  sub, *rest = argv
  handler = resolve_entry(sub)

  # guard: a name no subcommand carries is refused on stderr with exit 2
  if handler is None:
    sys.stderr.write(f"unknown subcommand: {sub}\n")
    return 2

  # the routed subcommand's own exit code passes back unchanged, unless it refused the vault root; the
  # refusal's class is looked up only once an exception is in flight, so the entry still loads no sibling early
  try:
    return handler(rest)
  except importlib.import_module(_SPEC_PATHS).VaultRootError as exc:
    sys.stderr.write(f"{exc}\n")
    return _EXIT_REFUSED


if __name__ == "__main__":
  sys.exit(main(sys.argv[1:]))
