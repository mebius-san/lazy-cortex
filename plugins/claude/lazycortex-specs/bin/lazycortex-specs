#!/usr/bin/env python3

"""
Command-line entry point of the lazycortex-specs plugin.

Routes each subcommand named on the command line to its sibling module and passes that module's exit code back.
Run without arguments or with `-h` / `--help` to print the subcommand list.
"""

from __future__ import annotations

import importlib
import sys
from pathlib import Path

from typing import TYPE_CHECKING
if TYPE_CHECKING:
  from collections.abc import Callable


_BIN = Path(__file__).resolve().parent
if str(_BIN) not in sys.path:
  sys.path.insert(0, str(_BIN))

