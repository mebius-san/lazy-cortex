{
  "name": "lazycortex-python",
  "version": "5.0.0",
  "description": "Python coding discipline as a plugin: shared rules + reference guidelines + chk/tst checkers + PostToolUse hook + docstring-writer/test-writer agents + canonical file template. Installs once per repo via /lazy-python.install.",
  "dependencies": ["lazycortex-core"],
  "author": {
    "name": "Mebius-san"
  },
  "provides_experts": [
    "python.code-reviewer"
  ],
  "provides_guidelines": {
    "architect": [
      "lazycortex-python:lazy-python.coding-guidelines",
      "docs/guidelines/python/coding_guidelines.md"
    ],
    "planner": [
      "lazycortex-python:lazy-python.coding-guidelines",
      "docs/guidelines/python/coding_guidelines.md",
      "lazycortex-python:lazy-python.testing-guidelines",
      "docs/guidelines/python/testing_guidelines.md"
    ],
    "developer": [
      "lazycortex-python:lazy-python.coding-guidelines",
      "docs/guidelines/python/coding_guidelines.md",
      "lazycortex-python:lazy-python.documenting-guidelines",
      "docs/guidelines/python/documenting_guidelines.md",
      "lazycortex-python:lazy-python.comment-guidelines",
      "lazycortex-python:lazy-python.testing-guidelines",
      "docs/guidelines/python/testing_guidelines.md",
      "lazycortex-python:lazy-python.checking-guidelines",
      "docs/guidelines/python/checking_guidelines.md"
    ],
    "reviewer": [
      "lazycortex-python:lazy-python.coding-guidelines",
      "docs/guidelines/python/coding_guidelines.md",
      "lazycortex-python:lazy-python.documenting-guidelines",
      "docs/guidelines/python/documenting_guidelines.md",
      "lazycortex-python:lazy-python.comment-guidelines"
    ],
    "tester": [
      "lazycortex-python:lazy-python.testing-guidelines",
      "docs/guidelines/python/testing_guidelines.md",
      "lazycortex-python:lazy-python.checking-guidelines",
      "docs/guidelines/python/checking_guidelines.md"
    ],
    "debugger": [
      "lazycortex-python:lazy-python.coding-guidelines",
      "docs/guidelines/python/coding_guidelines.md",
      "lazycortex-python:lazy-python.testing-guidelines",
      "docs/guidelines/python/testing_guidelines.md"
    ]
  }
}
