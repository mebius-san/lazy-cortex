#!/usr/bin/env bash
# tst — Python test runner for the lazycortex-python plugin.
#
# Sources the venv resolver (verifies the project venv, configuring it from pyproject.toml
# when missing or stale and allowed), then the optional project-env
# bootstrap (python.env_source in .claude/lazy.settings.json), then runs pytest
# scoped to the requested module under tests/<module>/, or all tests if no arg given.
# `all` is the module name for the whole suite, so `tst all` and a bare `tst` are the
# same run; a module with no tests/<module>/ directory is refused up front, naming the
# modules that do exist, instead of handing pytest a path it cannot find.
#
# Usage:
#   tst                  # run pytest across all tests/ subdirs
#   tst all              # the same whole-suite run, by name
#   tst <module>         # run pytest on tests/<module>/ only
#   tst -q [<module>]    # -q is accepted as a no-op (per lazy-python.style.md mandate)
#   tst --help           # print this usage
#
# Two environment variables change the run; with neither set it is as described above.
#
#   LAZYCORTEX_TST_PASSTHROUGH_PY   set to anything but empty or `0`: passthrough mode, for a
#       project's own test runner that calls this one. Every argument goes to pytest as given —
#       no module check, no `-q`, no help shortcut; the caller owns what is run and what is
#       refused. The only addition is the CPU-yield plugin; the re-export dedup plugin is not
#       loaded, so the set of tests the caller selects is exactly what runs.
#   LAZYCORTEX_TOOL_PYTEST          path to the pytest executable to run. The venv resolver is
#       skipped — the caller has chosen its environment — and the directory of that executable
#       goes first on PATH, the way an activated venv would put it. A path that names no file
#       is refused.
#
# Runs standalone from a bare terminal — CLAUDE_PLUGIN_ROOT / CLAUDE_PLUGIN_DATA
# are not read: the venv resolver (_ensure_venv.sh) derives the project root itself, and
# configures a missing or stale project venv from pyproject.toml the way `cfg` (cfg-py)
# does — never in protected mode (LAZYCORTEX_PROTECTED), where it only verifies.
set -e
set -u
set -o pipefail

# directory containing the script
script_dir="$(cd "$(dirname "$0")" && pwd)"

function print_help() {
  echo "run Python tests via pytest"
  echo "usage: tst [<module>]"
  echo
  echo "  <module>   one of the names under tests/ (e.g., 'core', 'api'), or 'all'"
  echo "             omit (or pass 'all') to run the whole suite"
  echo
  echo "  -q         accepted as no-op (lazy-python.style.md compat)"
  echo "  --help     this help"
  echo
  echo "environment:"
  echo "  LAZYCORTEX_TST_PASSTHROUGH_PY   anything but empty or 0: every argument goes to pytest as given"
  echo "  LAZYCORTEX_TOOL_PYTEST          path to the pytest executable to run instead of the project venv's"
  echo
}

# passthrough mode: LAZYCORTEX_TST_PASSTHROUGH_PY set to anything but empty or `0`
passthrough=0
if [ -n "${LAZYCORTEX_TST_PASSTHROUGH_PY:-}" ] && [ "${LAZYCORTEX_TST_PASSTHROUGH_PY}" != "0" ]; then
  passthrough=1
fi

# the module argument is parsed only when this runner is the endpoint; in passthrough mode the
# arguments stay untouched in "$@" for pytest
mod=""
if [ "$passthrough" -eq 0 ]; then
  # help shortcut
  if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
    print_help
    exit 0
  fi

  # parse args: collect non-flag positional, swallow -q
  while [ -n "${1-}" ]; do
    if [ "$1" = "-q" ]; then
      shift
      continue
    fi
    if [ -z "$mod" ]; then
      mod="$1"
    else
      echo "tst: unexpected extra arg: $1" >&2
      print_help
      exit 1
    fi
    shift
  done
fi

# the pytest to run: the one the caller names, else the one the venv resolver puts on PATH
pytest_bin="pytest"
if [ -n "${LAZYCORTEX_TOOL_PYTEST:-}" ]; then
  # refuse a path that names no file before anything runs, naming the variable and the path
  if [ ! -f "$LAZYCORTEX_TOOL_PYTEST" ]; then
    echo "tst: LAZYCORTEX_TOOL_PYTEST names no file: $LAZYCORTEX_TOOL_PYTEST" >&2
    exit 1
  fi
  pytest_bin="$LAZYCORTEX_TOOL_PYTEST"
  # the caller's environment stands in for the resolved venv: its executables go first on PATH,
  # so `python` in the env bootstrap below and in the tests is the one beside that pytest
  export PATH="$(cd "$(dirname "$pytest_bin")" && pwd):${PATH}"
else
  source "$script_dir/_ensure_venv.sh"
fi

# Optional project-env bootstrap (python.env_source) — must run after the venv is
# active and before pytest is exec'd, in this same shell so exports are inherited.
source "$script_dir/_ensure_env.sh"

# Make the re-export dedup plugin importable (it lives beside this script in bin/),
# appended so the consumer's own PYTHONPATH entries keep precedence, then load it with
# `-p _pytest_dedup`. It collapses tests collected twice via re-export shims (a test_all.py
# aggregator + per-package shims) so each test runs once; a no-op in repos without shims.
export PYTHONPATH="${PYTHONPATH:+$PYTHONPATH:}$script_dir"

# The CPU-yield plugin sits in the same bin/ and loads the same way, with `-p _pytest_cpu_yield`.
# It lowers the priority of the pytest process tree (niceness on POSIX, the below-normal priority
# class on Windows) and caps xdist's automatic worker count at all CPUs but two, so several
# concurrent test runs leave the machine responsive.

# passthrough mode: the caller's arguments reach pytest as given, with only the CPU-yield plugin added
if [ "$passthrough" -eq 1 ]; then
  exec "$pytest_bin" -p _pytest_cpu_yield "$@"
fi

# `all` and no argument are the same whole-suite run; anything else scopes to tests/<mod>/
if [ -z "$mod" ] || [ "$mod" = "all" ]; then
  target="tests/"
else
  target="tests/${mod}/"
fi

# refuse an unknown module before pytest runs, naming what tests/ actually holds
if [ ! -d "$target" ]; then
  echo "tst: no such module '${mod}' — tests/${mod}/ does not exist" >&2
  echo "tst: modules under tests/: $(ls -d tests/*/ 2>/dev/null | xargs -n1 basename | tr '\n' ' ')" >&2
  exit 1
fi

exec "$pytest_bin" -q -p _pytest_dedup -p _pytest_cpu_yield "$target"
