# subcommand name -> one-line help; drives argparse registration and dispatch.
_SUBCOMMANDS = {
  "resolve-scope":  "Resolve a file path to its scope id and config entry.",
  "ensure-axes":    "Idempotently union axis names into the repository-wide tag_axes.",
  "ensure-scope-config": "Idempotently seed filter predicates and exclude globs on one scope.",
  "apply-node":     "Apply a curation.json result to a node file (classify or link fields).",
  "process-file":   "Process a single node: dispatch a classify curation job.",
  "prune-node":     "Drop See-also links to a deleted node and rebuild the scope index.",
  "dispatch-link":  "Dispatch a link curation job for a node (chains from classify).",
  "relink-all":     "Full pass over all nodes in a scope; rebuild topics index.",
  "relink-plan":    "Compute the daemon-free relink plan (initial/incremental/anchor-lost) as JSON.",
  "find-candidates": "Recall a ranked shortlist of link candidates for a node as a JSON array.",
  "find-back-candidates": "Recall scope nodes that attract a node (target appears in their top-N candidates).",
  "set-synced-sha": "Write the wiki_synced_sha anchor into a scope's topics.md frontmatter.",
  "build-index":    "Rebuild the topics.md index from current node tags.",
  "collect-tags":   "Survey distinct tag values per axis across a scope, as JSON.",
  "retag":          "Apply an axis-value alias map to a scope's node tags.",
  "doctor":         "Audit scope integrity: broken links, missing summaries, stale glosses.",
  "domain-plan":    "Compute the domain-spec plan (changed/orphaned/unknown groups, index state) as JSON.",
  "domain-apply-index": "Rebuild the domains.md index from the dictionary and the docs on disk.",
  "domain-tick":    "Consume one git item: drop orphaned domain docs, dispatch writer jobs for changed groups.",
  "mirror-plan":    "Fetch a mirror scope's source and print the sync plan as JSON (dry-run, mirror untouched).",
  "mirror-sync":    "Fetch a mirror scope's source, sync the mirror tree, and commit the touched files.",
}

# Environment variable name that carries the repository root.
_ENV_REPO_ROOT = "LAZY_REPO_ROOT"


# ----------------------------------------------------------------------------------------
class Cli:
  """
  Command-line entry point for the lazycortex-wiki dispatcher.

  Guarantees:
    - Diagnostics and usage help go to stderr; stdout carries only the invoked
      subcommand's own result.
  """

  # Contract:
  # Every diagnostic — warning, error, and usage help — MUST be written to stderr;
  # stdout carries the invoked subcommand's own result and nothing else.

  _PROG = "lazycortex-wiki"
  _DESCRIPTION = "lazycortex-wiki — LLM-navigable semantic wiki over a markdown+code base."
  _DEST = "command"
  _METAVAR = "subcommand"
  _CMD_RESOLVE_SCOPE  = "resolve-scope"
  _CMD_ENSURE_AXES    = "ensure-axes"
  _CMD_ENSURE_SCOPE_CONFIG = "ensure-scope-config"
  _CMD_APPLY_NODE     = "apply-node"
  _CMD_PROCESS_FILE   = "process-file"
  _CMD_PRUNE_NODE     = "prune-node"
  _CMD_DISPATCH_LINK  = "dispatch-link"
  _CMD_BUILD_INDEX    = "build-index"
  _CMD_RELINK_PLAN    = "relink-plan"
  _CMD_RELINK_ALL     = "relink-all"
  _CMD_FIND_CANDIDATES = "find-candidates"
  _CMD_FIND_BACK_CANDIDATES = "find-back-candidates"
  _CMD_SET_SYNCED_SHA = "set-synced-sha"
  _CMD_DOCTOR         = "doctor"
  _CMD_COLLECT_TAGS   = "collect-tags"
  _CMD_RETAG          = "retag"
  _CMD_DOMAIN_PLAN    = "domain-plan"
  _CMD_DOMAIN_APPLY_INDEX = "domain-apply-index"
  _CMD_DOMAIN_TICK    = "domain-tick"
  _CMD_MIRROR_PLAN    = "mirror-plan"
  _CMD_MIRROR_SYNC    = "mirror-sync"

  # argparse dest names and help strings — shared or per-subcommand.
  _ARG_PATH           = "path"
  _ARG_PATH_HELP      = "File path to resolve (absolute or repo-relative)."
  _ARG_REPO           = "--repo"
  _ARG_REPO_HELP      = "Repository root (defaults to $LAZY_REPO_ROOT or cwd)."
  _ARG_FROM              = "--from"
  _ARG_FROM_DEST         = "from_file"
  _ARG_FROM_HELP         = "Path to curation.json produced by the curator."
  _ARG_ALIAS_HELP        = "Path to the alias-map JSON ({axis: {old-value: new-value}})."
  _ARG_AXES              = "axes"
  _ARG_AXES_HELP         = "Axis names to ensure are present."
  _ARG_APPLY_PATH_HELP     = "Absolute path to the markdown node file."
  _ARG_PROCESS_PATH_HELP   = "Git-item JSON string or bare file path to process."
  _ARG_SCOPE_ID            = "scope_id"
  _ARG_SCOPE_ID_HELP       = "Scope identifier as defined in lazy.settings.json[wiki.scopes]."
  _ARG_DOCTOR_SCOPE_ID_HELP = "Scope id to audit; omit to audit every configured scope."
  _ARG_RELINK_SCOPE_ID_HELP = "Scope id to plan a relink pass for."
  _ARG_RELINK_ALL_SCOPE_ID_HELP = (
    "Scope id to re-classify and re-link every node for (full pass, no src-hash skip); "
    "omit to pass over every configured scope."
  )
  _ARG_SHA                  = "sha"
  _ARG_SHA_HELP             = "Commit SHA to record as the wiki_synced_sha anchor."
  _ARG_NODE_PATH            = "node_path"
  _ARG_NODE_PATH_HELP       = "Absolute or repo-relative path to the node to find candidates for."
  _ARG_SCOPE               = "--scope"
  _ARG_SCOPE_DEST          = "scope_id"
  _ARG_SCOPE_HELP          = "Scope id the node belongs to (as in lazy.settings.json[wiki.scopes])."
  _ARG_TOP_N               = "--top-n"
  _ARG_TOP_N_DEST          = "top_n"
  _ARG_TOP_N_DEFAULT       = 20
  _ARG_TOP_N_TYPE          = int
  _ARG_TOP_N_HELP          = "Maximum number of candidate paths to return (default 20)."
  _ARG_APPLY               = "--apply"
  _ARG_APPLY_DEST          = "apply"
  _ARG_APPLY_HELP          = "Perform fixable repairs (index rebuild, drop broken see-also, refresh stale glosses)."
  _ARG_DOCTOR_COMMIT       = "--commit"
  _ARG_DOCTOR_COMMIT_DEST  = "commit"
  _ARG_DOCTOR_COMMIT_HELP  = "With --apply: commit the repaired files (the lazy-wiki.doctor-apply routine's mode)."
  _ARG_NO_COMMIT           = "--no-commit"
  _ARG_NO_COMMIT_DEST      = "no_commit"
  _ARG_NO_COMMIT_HELP      = "Mutate files only; skip the git commit (caller owns the commit)."
  _ARG_PRUNE_PATH_HELP     = "Git-item JSON string or bare path of the deleted node."

  # Curation result JSON field names.
  _FIELD_WIKI_SUMMARY = "wiki_summary"
  _FIELD_TOPICS       = "topics"
  _FIELD_CONNECTORS   = "connectors"
  _FIELD_SEE_ALSO     = "see_also"

  # Prune result JSON field names (mirrors prune.NodePruner result keys).
  _FIELD_PRUNED_NODES = "pruned_nodes"
  _FIELD_DELETED      = "deleted"
  _FIELD_INDEX        = "index"

  # Scope config key carrying the tag axis list.
  _CFG_TAG_AXES        = "tag_axes"
  # Scope config key carrying the topics-index path.
  _CFG_TOPICS_INDEX    = "topics_index"

  # Payload field names for the dispatch bundle.
  _PAYLOAD_KIND              = "kind"
  _PAYLOAD_NODE_PATH         = "node_path"
  _PAYLOAD_SCOPE_ID          = "scope_id"
  _PAYLOAD_PINS              = "pins"
  _PAYLOAD_EXISTING_TAGS     = "existing_tags"
  _PAYLOAD_TOPICS_INDEX_CONT = "topics_index_content"

  # argparse help string for dispatch-link path argument.
  _ARG_DISPATCH_LINK_PATH_HELP = "Absolute path to the node file to dispatch a link job for."

  # argparse strings for the domain subcommands.
  _ARG_DOMAIN_TICK_PATH_HELP = "Git-item JSON string or bare file path that triggered the tick (omit with --full)."
  _ARG_FULL                  = "--full"
  _ARG_FULL_DEST             = "full"
  _ARG_FULL_HELP             = "Full pass: skip the trigger-path filter (the schedule-routine mode)."

  # Domain payload field names for the writer-job request.
  _PAYLOAD_GROUP     = "group"
  _PAYLOAD_GLOSS     = "gloss"
  _PAYLOAD_LANGUAGE  = "language"
  _PAYLOAD_DOC_PATH  = "doc_path"
  _PAYLOAD_HASH      = "hash"
  _PAYLOAD_BLOCKS    = "blocks"
  _PAYLOAD_CONTRACTS = "contracts"

  # File encoding used throughout this module.
  _ENCODING = "utf-8"

  # Git-item JSON path key.
  _GIT_ITEM_PATH_KEY = "path"

  # Finding-dict keys emitted by Doctor (read-only consumption here).
  _F_CHECK    = "check"
  _F_SEVERITY = "severity"
  _F_NODE     = "node"
  _F_MESSAGE  = "message"
  _F_FIXABLE  = "fixable"
  _F_APPLIED  = "applied"

  # Severity display order: FAIL first, then WARN, then INFO.
  _SEVERITY_ORDER = ("FAIL", "WARN", "INFO")

  # argparse action for the boolean --apply flag.
  _ACTION_STORE_TRUE = "store_true"

  # Doctor output / error message strings.
  _MSG_NO_SCOPES = "doctor: no wiki scopes configured (run /wiki.install and /wiki.configure)"
  _MSG_CLEAN     = "  (clean)"

  # Section label the repo-level domain findings are printed under.
  _DOMAIN_SECTION = "domains"

  # Domain-subcommand message strings.
  _MSG_DOMAINS_UNCONFIGURED_PLAN  = "domain-plan: wiki.domains not configured (run /wiki.configure domains)"
  _MSG_DOMAINS_UNCONFIGURED_INDEX = "domain-apply-index: wiki.domains not configured (run /wiki.configure domains)"
  _MSG_DOMAIN_TICK_SKIP           = "domain-tick: skip (wiki.domains not configured)"

  # Frontmatter anchor key written into topics.md by set-synced-sha.
  _KEY_WIKI_SYNCED_SHA = "wiki_synced_sha"

  def run(self, argv: list[str] | None = None) -> int:
    """
    Parse arguments and dispatch to the selected subcommand.

    Guarantees:
      - Exit code 0 means the subcommand ran to completion, including its documented
        skips; 1 means the subcommand itself failed; 2 never reports failed work and is
        reserved for an invocation that could not be run at all.

    Args:
      argv: Argument vector to parse; defaults to the process arguments when not supplied.

    Returns:
      Integer exit code.
    """

    # Contract:
    # Exit code 0 means the subcommand ran to completion, including its documented skips,
    # and 1 means the subcommand itself failed; 2 NEVER reports failed work — it is
    # reserved for an invocation that could not be run at all.

    parser = self._build_parser()
    args = parser.parse_args(argv)
    # guard: no subcommand given — print help and exit non-zero
    if getattr(args, self._DEST) is None:
      parser.print_help(sys.stderr)
      return 2
    cmd = getattr(args, self._DEST)
    if cmd == self._CMD_RESOLVE_SCOPE:
      return self._cmd_resolve_scope(args)
    if cmd == self._CMD_ENSURE_AXES:
      return self._cmd_ensure_axes(args)
    if cmd == self._CMD_ENSURE_SCOPE_CONFIG:
      return self._cmd_ensure_scope_config(args)
    if cmd == self._CMD_APPLY_NODE:
      return self._cmd_apply_node(args)
    if cmd == self._CMD_PROCESS_FILE:
      return self._cmd_process_file(args)
    if cmd == self._CMD_PRUNE_NODE:
      return self._cmd_prune_node(args)
    if cmd == self._CMD_DISPATCH_LINK:
      return self._cmd_dispatch_link(args)
    if cmd == self._CMD_BUILD_INDEX:
      return self._cmd_build_index(args)
    if cmd == self._CMD_RELINK_PLAN:
      return self._cmd_relink_plan(args)
    if cmd == self._CMD_RELINK_ALL:
      return self._cmd_relink_all(args)
    if cmd == self._CMD_FIND_CANDIDATES:
      return self._cmd_find_candidates(args)
    if cmd == self._CMD_FIND_BACK_CANDIDATES:
      return self._cmd_find_back_candidates(args)
    if cmd == self._CMD_SET_SYNCED_SHA:
      return self._cmd_set_synced_sha(args)
    if cmd == self._CMD_DOCTOR:
      return self._cmd_doctor(args)
    if cmd == self._CMD_COLLECT_TAGS:
      return self._cmd_collect_tags(args)
    if cmd == self._CMD_RETAG:
      return self._cmd_retag(args)
    if cmd == self._CMD_DOMAIN_PLAN:
      return self._cmd_domain_plan(args)
    if cmd == self._CMD_DOMAIN_APPLY_INDEX:
      return self._cmd_domain_apply_index(args)
    if cmd == self._CMD_DOMAIN_TICK:
      return self._cmd_domain_tick(args)
    if cmd == self._CMD_MIRROR_PLAN:
      return self._cmd_mirror_plan(args)
    if cmd == self._CMD_MIRROR_SYNC:
      return self._cmd_mirror_sync(args)
    return self._not_implemented(cmd)

  def _build_parser(self) -> argparse.ArgumentParser:
    """
    Build the top-level argument parser with one subparser per registered subcommand.

    Returns:
      The configured argument parser.
    """
    parser = argparse.ArgumentParser(prog = self._PROG, description = self._DESCRIPTION)
    sub = parser.add_subparsers(dest = self._DEST, metavar = self._METAVAR)
    for name, summary in _SUBCOMMANDS.items():
      p = sub.add_parser(name, help = summary)
      if name == self._CMD_RESOLVE_SCOPE:
        p.add_argument(self._ARG_PATH, help = self._ARG_PATH_HELP)
        p.add_argument(self._ARG_REPO, default = None, help = self._ARG_REPO_HELP)
      elif name == self._CMD_ENSURE_AXES:
        p.add_argument(self._ARG_AXES, nargs = "+", help = self._ARG_AXES_HELP)
        p.add_argument(self._ARG_REPO, default = None, help = self._ARG_REPO_HELP)
      elif name == self._CMD_ENSURE_SCOPE_CONFIG:
        p.add_argument("scope_id", help = "Id of the configured scope to seed.")
        p.add_argument(
          "--filter-json",
          dest = "filter_json",
          default = None,
          help = "JSON object of frontmatter predicates to seed, keyed by frontmatter key.",
        )
        p.add_argument(
          "--exclude",
          dest = "exclude",
          nargs = "*",
          default = None,
          help = "Exclude globs to append to the scope when missing.",
        )
        p.add_argument(self._ARG_REPO, default = None, help = self._ARG_REPO_HELP)
      elif name == self._CMD_APPLY_NODE:
        p.add_argument(self._ARG_PATH, help = self._ARG_APPLY_PATH_HELP)
        p.add_argument(
          self._ARG_FROM,
          dest = self._ARG_FROM_DEST,
          required = True,
          help = self._ARG_FROM_HELP,
        )
      elif name == self._CMD_PROCESS_FILE:
        p.add_argument(
          self._ARG_PATH,
          help = self._ARG_PROCESS_PATH_HELP,
        )
        p.add_argument(self._ARG_REPO, default = None, help = self._ARG_REPO_HELP)
      elif name == self._CMD_PRUNE_NODE:
        p.add_argument(self._ARG_PATH, help = self._ARG_PRUNE_PATH_HELP)
        p.add_argument(self._ARG_REPO, default = None, help = self._ARG_REPO_HELP)
        p.add_argument(
          self._ARG_NO_COMMIT,
          dest = self._ARG_NO_COMMIT_DEST,
          action = self._ACTION_STORE_TRUE,
          help = self._ARG_NO_COMMIT_HELP,
        )
      elif name == self._CMD_DISPATCH_LINK:
        p.add_argument(self._ARG_PATH, help = self._ARG_DISPATCH_LINK_PATH_HELP)
        p.add_argument(self._ARG_REPO, default = None, help = self._ARG_REPO_HELP)
      elif name == self._CMD_BUILD_INDEX:
        p.add_argument(self._ARG_SCOPE_ID, help = self._ARG_SCOPE_ID_HELP)
        p.add_argument(self._ARG_REPO, default = None, help = self._ARG_REPO_HELP)
      elif name == self._CMD_RELINK_PLAN:
        p.add_argument(self._ARG_SCOPE_ID, help = self._ARG_RELINK_SCOPE_ID_HELP)
        p.add_argument(self._ARG_REPO, default = None, help = self._ARG_REPO_HELP)
      elif name == self._CMD_RELINK_ALL:
        p.add_argument(
          self._ARG_SCOPE_ID,
          nargs = "?",
          default = None,
          help = self._ARG_RELINK_ALL_SCOPE_ID_HELP,
        )
        p.add_argument(self._ARG_REPO, default = None, help = self._ARG_REPO_HELP)
      elif name == self._CMD_FIND_CANDIDATES:
        p.add_argument(self._ARG_NODE_PATH, help = self._ARG_NODE_PATH_HELP)
        p.add_argument(
          self._ARG_SCOPE,
          dest = self._ARG_SCOPE_DEST,
          required = True,
          help = self._ARG_SCOPE_HELP,
        )
        p.add_argument(self._ARG_REPO, default = None, help = self._ARG_REPO_HELP)
        p.add_argument(
          self._ARG_TOP_N,
          dest = self._ARG_TOP_N_DEST,
          type = self._ARG_TOP_N_TYPE,
          default = self._ARG_TOP_N_DEFAULT,
          help = self._ARG_TOP_N_HELP,
        )
      elif name == self._CMD_FIND_BACK_CANDIDATES:
        p.add_argument(self._ARG_NODE_PATH, help = self._ARG_NODE_PATH_HELP)
        p.add_argument(
          self._ARG_SCOPE,
          dest = self._ARG_SCOPE_DEST,
          required = True,
          help = self._ARG_SCOPE_HELP,
        )
        p.add_argument(self._ARG_REPO, default = None, help = self._ARG_REPO_HELP)
        p.add_argument(
          self._ARG_TOP_N,
          dest = self._ARG_TOP_N_DEST,
          type = self._ARG_TOP_N_TYPE,
          default = self._ARG_TOP_N_DEFAULT,
          help = self._ARG_TOP_N_HELP,
        )
      elif name == self._CMD_SET_SYNCED_SHA:
        p.add_argument(self._ARG_SCOPE_ID, help = self._ARG_SCOPE_ID_HELP)
        p.add_argument(self._ARG_SHA, help = self._ARG_SHA_HELP)
        p.add_argument(self._ARG_REPO, default = None, help = self._ARG_REPO_HELP)
      elif name == self._CMD_DOCTOR:
        p.add_argument(
          self._ARG_SCOPE_ID,
          nargs = "?",
          default = None,
          help = self._ARG_DOCTOR_SCOPE_ID_HELP,
        )
        p.add_argument(
          self._ARG_APPLY,
          dest = self._ARG_APPLY_DEST,
          action = self._ACTION_STORE_TRUE,
          help = self._ARG_APPLY_HELP,
        )
        p.add_argument(
          self._ARG_DOCTOR_COMMIT,
          dest = self._ARG_DOCTOR_COMMIT_DEST,
          action = self._ACTION_STORE_TRUE,
          help = self._ARG_DOCTOR_COMMIT_HELP,
        )
        p.add_argument(self._ARG_REPO, default = None, help = self._ARG_REPO_HELP)
      elif name == self._CMD_COLLECT_TAGS:
        p.add_argument(self._ARG_SCOPE_ID, help = self._ARG_SCOPE_ID_HELP)
        p.add_argument(self._ARG_REPO, default = None, help = self._ARG_REPO_HELP)
      elif name == self._CMD_RETAG:
        p.add_argument(self._ARG_SCOPE_ID, help = self._ARG_SCOPE_ID_HELP)
        p.add_argument(
          self._ARG_FROM,
          dest = self._ARG_FROM_DEST,
          required = True,
          help = self._ARG_ALIAS_HELP,
        )
        p.add_argument(self._ARG_REPO, default = None, help = self._ARG_REPO_HELP)
      elif name in (self._CMD_DOMAIN_PLAN, self._CMD_DOMAIN_APPLY_INDEX):
        p.add_argument(self._ARG_REPO, default = None, help = self._ARG_REPO_HELP)
      elif name == self._CMD_DOMAIN_TICK:
        p.add_argument(
          self._ARG_PATH,
          nargs = "?",
          default = None,
          help = self._ARG_DOMAIN_TICK_PATH_HELP,
        )
        p.add_argument(self._ARG_REPO, default = None, help = self._ARG_REPO_HELP)
        p.add_argument(
          self._ARG_FULL,
          dest = self._ARG_FULL_DEST,
          action = self._ACTION_STORE_TRUE,
          help = self._ARG_FULL_HELP,
        )
      elif name in (self._CMD_MIRROR_PLAN, self._CMD_MIRROR_SYNC):
        p.add_argument(self._ARG_SCOPE_ID, help = self._ARG_SCOPE_ID_HELP)
        p.add_argument(self._ARG_REPO, default = None, help = self._ARG_REPO_HELP)
    return parser

  def _cmd_resolve_scope(self, args: argparse.Namespace) -> int:
    """
    Resolve a file path to its scope and print JSON to stdout.

    Output is `{"scope_id": "<id>", "cfg": {...}}` on a match, or
    `{"scope_id": null}` when no scope matches.  Always exits 0.

    Guarantees:
      - A path that matches no configured scope is reported as data, never as a failure;
        the command always exits 0.

    Args:
      args: Parsed argument namespace; must carry `.path` and `.repo`.

    Returns:
      Integer exit code (always 0).
    """

    # Contract:
    # A path matching no configured scope is reported as data and NEVER as a failure;
    # the command always exits 0.

    repo_raw = args.repo or os.environ.get(_ENV_REPO_ROOT) or os.getcwd()
    repo = Path(repo_raw).resolve()
    resolver = _scope.ScopeResolver(repo = repo)
    result = resolver.resolve_scope_by_path(args.path)
    if result is None:
      print(json.dumps({ "scope_id": None }))
    else:
      scope_id, cfg = result
      print(json.dumps({ "scope_id": scope_id, "cfg": cfg }))
    return 0

  def _cmd_ensure_axes(self, args: argparse.Namespace) -> int:
    """
    Idempotently union axis names into the repository-wide `tag_axes` vocabulary.

    Delegates to `axes.ensure_axes`, which reads and writes the `wiki` section through
    `lazycortex-core`'s `settings-get` / `settings-set` CLI rather than touching
    `lazy.settings.json` directly. Prints the outcome dict to stdout as JSON.

    Args:
      args: Parsed argument namespace; must carry `.axes` and `.repo`.

    Returns:
      Integer exit code: `1` when `axes.ensure_axes` reports its malformed-`wiki.tag_axes` guard
      (a top-level `error` key); `0` otherwise. The JSON printed to stdout is unaffected.
    """
    repo_raw = args.repo or os.environ.get(_ENV_REPO_ROOT) or os.getcwd()
    repo = Path(repo_raw).resolve()
    result = _axes.ensure_axes(repo, args.axes)
    print(json.dumps(result))
    # guard: the malformed-vocabulary shape counts as a CLI failure
    if "error" in result:
      return 1
    return 0

  def _cmd_ensure_scope_config(self, args: argparse.Namespace) -> int:
    """
    Idempotently seed filter predicates and exclude globs on one configured scope.

    Delegates to `axes.ensure_scope_config`, which reads and writes the `wiki` section through
    `lazycortex-core`'s `settings-get` / `settings-set` CLI. Prints the outcome dict to stdout
    as JSON.

    Args:
      args: Parsed argument namespace; must carry `.scope_id`, `.filter_json`, `.exclude`, and
        `.repo`.

    Returns:
      Integer exit code: `1` when the filter JSON does not parse to an object, when the named
      scope does not exist, or when `axes.ensure_scope_config` reports its malformed-scopes
      guard; `0` otherwise.
    """
    repo_raw = args.repo or os.environ.get(_ENV_REPO_ROOT) or os.getcwd()
    repo = Path(repo_raw).resolve()
    frontmatter = None
    if args.filter_json is not None:
      try:
        frontmatter = json.loads(args.filter_json)
      except json.JSONDecodeError as exc:
        print(json.dumps({ "error": f"--filter-json is not valid JSON: {exc}" }))
        return 1
      # guard: the predicates must arrive as an object keyed by frontmatter key
      if not isinstance(frontmatter, dict):
        print(json.dumps({ "error": "--filter-json must be a JSON object" }))
        return 1
    result = _axes.ensure_scope_config(
      repo, args.scope_id, filter_frontmatter = frontmatter, exclude = args.exclude,
    )
    print(json.dumps(result))
    # guard: the malformed-scopes shape and the unknown-scope outcome both count as failure
    if "error" in result or result.get("status") == "error":
      return 1
    return 0

  def _cmd_apply_node(self, args: argparse.Namespace) -> int:
    """
    Apply a curation.json result file to a node.

    Reads the JSON at `--from`, determines which fields are present
    (`wiki_summary`/`topics`/`connectors` → classify-apply; `see_also` →
    link-apply; both → full apply), and writes only those managed regions.
    The optional `connectors` array flows into the classify-apply path; when
    absent the node's connectors block is left untouched.  Prints a one-line
    outcome to stdout.  Always exits 0 on success.

    Args:
      args: Parsed argument namespace; must carry `.path` and `.from_file`.

    Returns:
      Integer exit code (0 on success, 1 on failure).
    """
    node_path = Path(args.path)
    curation_path = Path(args.from_file)

    # guard: node file does not exist
    if not node_path.is_file():
      print(f"apply-node: node not found: {node_path}", file = sys.stderr)
      return 1
    # guard: curation.json does not exist
    if not curation_path.is_file():
      print(f"apply-node: curation file not found: {curation_path}", file = sys.stderr)
      return 1

    with curation_path.open(encoding = self._ENCODING) as fh:
      curation: dict = json.load(fh)

    has_classify = (
      self._FIELD_WIKI_SUMMARY in curation
      or self._FIELD_TOPICS in curation
      or self._FIELD_CONNECTORS in curation
    )
    has_link = self._FIELD_SEE_ALSO in curation

    # guard: neither classify nor link fields present — nothing to apply
    if not has_classify and not has_link:
      print(
        f"apply-node: curation.json has no applicable fields: {curation_path}",
        file = sys.stderr,
      )
      return 1

    node = _nodes.node_for(node_path)
    # guard: unrecognised file type
    if node is None:
      print(
        f"apply-node: unrecognised file type: {node_path}",
        file = sys.stderr,
      )
      return 1

    if has_classify and has_link:
      node.apply(
        wiki_summary = curation.get(self._FIELD_WIKI_SUMMARY, ""),
        topics = curation.get(self._FIELD_TOPICS, []),
        see_also_lines = curation.get(self._FIELD_SEE_ALSO, []),
        connectors = curation.get(self._FIELD_CONNECTORS),
      )
      print(f"apply-node: ok (classify+link) {node_path.name}")
    elif has_classify:
      node.apply_classify(
        wiki_summary = curation.get(self._FIELD_WIKI_SUMMARY, ""),
        topics = curation.get(self._FIELD_TOPICS, []),
        connectors = curation.get(self._FIELD_CONNECTORS),
      )
      print(f"apply-node: ok (classify) {node_path.name}")
    else:
      node.apply_link(see_also_lines = curation.get(self._FIELD_SEE_ALSO, []))
      print(f"apply-node: ok (link) {node_path.name}")
    return 0

  def _cmd_build_index(self, args: argparse.Namespace) -> int:
    """
    Rebuild the topics.md index for the given scope.

    Resolves the scope config from `lazy.settings.json`, then delegates
    to `TopicIndex.build` to enumerate nodes, aggregate the topic tree,
    and write the deterministic `topics.md`.  Prints a one-line outcome
    to stdout.

    Args:
      args: Parsed argument namespace; must carry `.scope_id` and `.repo`.

    Returns:
      Integer exit code (0 on success, 1 when the scope is unknown).
    """
    repo_raw = args.repo or os.environ.get(_ENV_REPO_ROOT) or os.getcwd()
    repo = Path(repo_raw).resolve()
    resolver = _scope.ScopeResolver(repo = repo)
    scopes = resolver.load_scopes()

    # guard: requested scope id not present in settings
    if args.scope_id not in scopes:
      print(
        f"build-index: unknown scope '{args.scope_id}' "
        f"(known: {', '.join(sorted(scopes)) or 'none'})",
        file = sys.stderr,
      )
      return 1

    cfg = scopes[args.scope_id]
    builder = _index.TopicIndex(repo = repo, cfg = cfg, scope_id = args.scope_id)
    out_path = builder.build()
    rel = out_path.relative_to(repo).as_posix()
    print(f"build-index: ok {args.scope_id} → {rel}")
    return 0

  def _cmd_relink_plan(self, args: argparse.Namespace) -> int:
    """
    Compute the daemon-free relink plan for a scope and print it as JSON.

    Resolves the scope config, then delegates to `RelinkPlanner.plan`, which
    selects the mode (`initial` / `incremental` / `anchor-lost`) by comparing
    the working tree against the `wiki_synced_sha` anchor and emits the
    classify / link / drop path sets.  The plan dict is printed to stdout as a
    single JSON object.

    Args:
      args: Parsed argument namespace; must carry `.scope_id` and `.repo`.

    Returns:
      Integer exit code (0 on success, 1 when the scope is unknown).
    """
    repo_raw = args.repo or os.environ.get(_ENV_REPO_ROOT) or os.getcwd()
    repo = Path(repo_raw).resolve()
    resolver = _scope.ScopeResolver(repo = repo)
    scopes = resolver.load_scopes()

    # guard: requested scope id not present in settings
    if args.scope_id not in scopes:
      print(
        f"relink-plan: unknown scope '{args.scope_id}' "
        f"(known: {', '.join(sorted(scopes)) or 'none'})",
        file = sys.stderr,
      )
      return 1

    planner = _relink.RelinkPlanner(
      repo     = repo,
      scope_id = args.scope_id,
      cfg      = scopes[args.scope_id],
    )
    plan = planner.plan()
    print(json.dumps(plan))
    return 0

  def _cmd_relink_all(self, args: argparse.Namespace) -> int:
    """
    Dispatch a classify curation job for every node in the requested scope, or in every configured scope.

    Re-processes all nodes regardless of whether the operator source has changed,
    making it suitable for a full-scope vocabulary consolidation pass.  Primarily
    fired by the `lazy-wiki.relink-weekly` daemon schedule routine, which names no scope
    and so passes over the whole configuration; direct invocation may name one scope.

    Notes:
      - Exits 1 with a `relink-all: unknown scope '<id>'` message on stderr when a
        scope id is given and is not configured.
      - Dispatches one classify job per node without waiting for any job to complete.
      - Prints `{"scope": "<id>", "dispatched": N, "skipped": K}` as one JSON line per
        scope passed over, so a run with no scope configured prints nothing and exits 0.

    Args:
      args: Parsed argument namespace; must carry `.scope_id` (None for every scope) and `.repo`.

    Returns:
      Integer exit code (0 on success, 1 when a named scope is unknown).
    """
    repo_raw = args.repo or os.environ.get(_ENV_REPO_ROOT) or os.getcwd()
    repo = Path(repo_raw).resolve()
    resolver = _scope.ScopeResolver(repo = repo)
    scopes = resolver.load_scopes()

    # guard: a named scope that is not present in settings is an operator error
    if args.scope_id is not None and args.scope_id not in scopes:
      print(
        f"relink-all: unknown scope '{args.scope_id}' "
        f"(known: {', '.join(sorted(scopes)) or 'none'})",
        file = sys.stderr,
      )
      return 1

    targets = sorted(scopes) if args.scope_id is None else [ args.scope_id ]
    for scope_id in targets:
      dispatched, skipped = self._relink_scope(repo, resolver, scope_id, scopes[scope_id])
      print(json.dumps({
        "scope":      scope_id,
        "dispatched": dispatched,
        "skipped":    skipped,
      }))
    return 0

  def _relink_scope(
    self, repo: Path, resolver: _scope.ScopeResolver, scope_id: str, scope_cfg: dict,
  ) -> tuple[int, int]:
    """
    Dispatch a classify curation job for every node in one scope.

    The scope's existing per-axis tag values are collected once and shared across every
    dispatched payload as the classify anchor, so curators on a cold catalog still pull
    the consolidated vocabulary.

    Args:
      repo: Absolute path to the repository root.
      resolver: Scope resolver used to enumerate the scope's nodes.
      scope_id: Scope identifier as defined in `lazy.settings.json[wiki.scopes]`.
      scope_cfg: Configuration block for that scope.

    Returns:
      A `(dispatched, skipped)` pair; `skipped` counts only files the node factory does not recognise.
    """
    tag_axes: list[str] = scope_cfg.get(self._CFG_TAG_AXES) or []
    nodes = resolver.iter_nodes(scope_cfg)

    existing_tags = _tags.TagOps(
      repo = repo, scope_id = scope_id, cfg = scope_cfg,
    ).collect()

    dispatcher = _dispatch.CoreDispatch()
    dispatched = 0
    skipped = 0
    for abs_path in nodes:
      node_obj = _nodes.node_for(abs_path)
      # guard: unrecognised file type — scope glob caught it but node-factory rejected
      if node_obj is None:
        skipped += 1
        continue
      pins = {
        "pinned_topics":    node_obj.pinned_topics,
        "unrelated_topics": node_obj.unrelated_topics,
        "pinned_links":     node_obj.pinned_links,
        "unrelated_links":  node_obj.unrelated_links,
      }
      payload = {
        self._PAYLOAD_KIND:          _dispatch.CoreDispatch.KIND_CLASSIFY,
        self._PAYLOAD_NODE_PATH:     str(abs_path),
        self._CFG_TAG_AXES:          tag_axes,
        self._PAYLOAD_SCOPE_ID:      scope_id,
        self._PAYLOAD_PINS:          pins,
        self._PAYLOAD_EXISTING_TAGS: existing_tags,
      }
      dispatcher.dispatch_curator(
        repo = repo,
        node_path = abs_path,
        payload = payload,
      )
      dispatched += 1

    return dispatched, skipped

  def _cmd_find_candidates(self, args: argparse.Namespace) -> int:
    """
    Recall a ranked link-candidate shortlist for a node and print it as JSON.

    Resolves the scope config, then delegates to `CandidateFinder` (composed
    with the default two-layer source stack) to enumerate scope nodes, merge
    scored suggestions, apply the node's pins, and cap to `--top-n`.  The
    result — a JSON array of repo-relative POSIX candidate-path strings — is
    printed to stdout.  An empty array (`[]`) is valid and tells the link
    curator to fall back to topics.md judgment.

    Args:
      args: Parsed argument namespace; must carry `.node_path`, `.scope_id`,
        `.repo`, and `.top_n`.

    Returns:
      Integer exit code (0 on success, 1 when the scope is unknown).
    """
    repo_raw = args.repo or os.environ.get(_ENV_REPO_ROOT) or os.getcwd()
    repo = Path(repo_raw).resolve()
    resolver = _scope.ScopeResolver(repo = repo)
    scopes = resolver.load_scopes()

    # guard: requested scope id not present in settings
    if args.scope_id not in scopes:
      print(
        f"find-candidates: unknown scope '{args.scope_id}' "
        f"(known: {', '.join(sorted(scopes)) or 'none'})",
        file = sys.stderr,
      )
      return 1

    node_path = Path(args.node_path)
    abs_path = node_path if node_path.is_absolute() else repo / node_path

    finder = _candidates.CandidateFinder.with_default_sources(
      repo,
      scopes[args.scope_id],
      args.scope_id,
      top_n = args.top_n,
    )
    result = finder.find(abs_path)
    print(json.dumps(result))
    return 0

  def _cmd_find_back_candidates(self, args: argparse.Namespace) -> int:
    """
    Recall scope nodes that attract a node and print them as a JSON array.

    Resolves the scope config, then delegates to `BackCandidateFinder` to
    enumerate the scope's other nodes and keep every one whose top-N candidate
    list contains the target — i.e. the set of nodes that should consider
    linking TO the target. Used by `process-file` for incremental new-node
    dispatch: the daemon fires link jobs only for these attracted nodes
    instead of re-linking the entire scope.

    Args:
      args: Parsed argument namespace; must carry `.node_path`, `.scope_id`,
        `.repo`, and `.top_n`.

    Returns:
      Integer exit code (0 on success, 1 when the scope is unknown).
    """
    repo_raw = args.repo or os.environ.get(_ENV_REPO_ROOT) or os.getcwd()
    repo = Path(repo_raw).resolve()
    resolver = _scope.ScopeResolver(repo = repo)
    scopes = resolver.load_scopes()

    # guard: requested scope id not present in settings
    if args.scope_id not in scopes:
      print(
        f"find-back-candidates: unknown scope '{args.scope_id}' "
        f"(known: {', '.join(sorted(scopes)) or 'none'})",
        file = sys.stderr,
      )
      return 1

    node_path = Path(args.node_path)
    abs_path = node_path if node_path.is_absolute() else repo / node_path

    finder = _candidates.BackCandidateFinder(
      repo,
      scopes[args.scope_id],
      args.scope_id,
      top_n = args.top_n,
    )
    result = finder.find(abs_path)
    print(json.dumps(result))
    return 0

  def _cmd_collect_tags(self, args: argparse.Namespace) -> int:
    """
    Survey the distinct tag values per axis for a scope and print them as JSON.

    Resolves the scope config from `lazy.settings.json`, then delegates to
    `TagOps.collect` to enumerate scope nodes and aggregate the per-axis value
    set with counts and example summaries.  The result dict is printed to
    stdout as a single JSON object.

    Args:
      args: Parsed argument namespace; must carry `.scope_id` and `.repo`.

    Returns:
      Integer exit code (0 on success, 1 when the scope is unknown).
    """
    repo_raw = args.repo or os.environ.get(_ENV_REPO_ROOT) or os.getcwd()
    repo = Path(repo_raw).resolve()
    resolver = _scope.ScopeResolver(repo = repo)
    scopes = resolver.load_scopes()

    # guard: requested scope id not present in settings
    if args.scope_id not in scopes:
      print(
        f"collect-tags: unknown scope '{args.scope_id}' "
        f"(known: {', '.join(sorted(scopes)) or 'none'})",
        file = sys.stderr,
      )
      return 1

    ops = _tags.TagOps(repo = repo, scope_id = args.scope_id, cfg = scopes[args.scope_id])
    print(json.dumps(ops.collect()))
    return 0

  def _cmd_retag(self, args: argparse.Namespace) -> int:
    """
    Apply an axis-value alias map to a scope's node tags and print the outcome.

    Resolves the scope config, reads the alias map from the `--from` JSON file,
    then delegates to `TagOps.retag`, which rewrites each node's aliased tags
    via `apply-node` (managed region only).  The outcome dict (`nodes_changed`
    / `tags_remapped`) is printed to stdout as JSON.

    Args:
      args: Parsed argument namespace; must carry `.scope_id`, `.from_file`,
        and `.repo`.

    Returns:
      Integer exit code (0 on success, 1 when the scope is unknown or the
      alias-map file is missing or malformed).
    """
    repo_raw = args.repo or os.environ.get(_ENV_REPO_ROOT) or os.getcwd()
    repo = Path(repo_raw).resolve()
    resolver = _scope.ScopeResolver(repo = repo)
    scopes = resolver.load_scopes()

    # guard: requested scope id not present in settings
    if args.scope_id not in scopes:
      print(
        f"retag: unknown scope '{args.scope_id}' "
        f"(known: {', '.join(sorted(scopes)) or 'none'})",
        file = sys.stderr,
      )
      return 1

    alias_path = Path(args.from_file)
    # guard: alias-map file does not exist
    if not alias_path.is_file():
      print(f"retag: alias-map not found: {alias_path}", file = sys.stderr)
      return 1

    with alias_path.open(encoding = self._ENCODING) as fh:
      alias_map = json.load(fh)
    # guard: alias-map must be a JSON object
    if not isinstance(alias_map, dict):
      print(f"retag: alias-map must be a JSON object: {alias_path}", file = sys.stderr)
      return 1

    ops = _tags.TagOps(repo = repo, scope_id = args.scope_id, cfg = scopes[args.scope_id])
    print(json.dumps(ops.retag(alias_map)))
    return 0

  def _cmd_set_synced_sha(self, args: argparse.Namespace) -> int:
    """
    Write the `wiki_synced_sha` anchor into a scope's topics.md frontmatter.

    Resolves the scope config to find the topics-index path, then sets the
    `wiki_synced_sha` scalar frontmatter key to the given SHA, creating the
    file (with a minimal frontmatter block) when it does not yet exist.  The
    operation is idempotent — re-running with the same SHA leaves the file
    unchanged.  Prints a one-line confirmation.

    Args:
      args: Parsed argument namespace; must carry `.scope_id`, `.sha`, `.repo`.

    Returns:
      Integer exit code (0 on success, 1 when the scope is unknown or has no
      topics_index configured).
    """
    repo_raw = args.repo or os.environ.get(_ENV_REPO_ROOT) or os.getcwd()
    repo = Path(repo_raw).resolve()
    resolver = _scope.ScopeResolver(repo = repo)
    scopes = resolver.load_scopes()

    # guard: requested scope id not present in settings
    if args.scope_id not in scopes:
      print(
        f"set-synced-sha: unknown scope '{args.scope_id}' "
        f"(known: {', '.join(sorted(scopes)) or 'none'})",
        file = sys.stderr,
      )
      return 1

    cfg = scopes[args.scope_id]
    index_rel = cfg.get(self._CFG_TOPICS_INDEX, "")
    # guard: scope has no topics_index path configured
    if not index_rel:
      print(
        f"set-synced-sha: scope '{args.scope_id}' has no topics_index configured",
        file = sys.stderr,
      )
      return 1

    index_path = (repo / index_rel).resolve()
    existing = index_path.read_text(encoding = self._ENCODING) if index_path.is_file() else ""
    updated = _nodes.set_scalar_field(existing, self._KEY_WIKI_SYNCED_SHA, args.sha)
    index_path.parent.mkdir(parents = True, exist_ok = True)
    index_path.write_text(updated, encoding = self._ENCODING)
    rel = index_path.relative_to(repo).as_posix()
    print(f"set-synced-sha: ok {args.scope_id} {self._KEY_WIKI_SYNCED_SHA}={args.sha} → {rel}")
    return 0

  def _cmd_doctor(self, args: argparse.Namespace) -> int:
    """
    Audit one or all scopes for wiki integrity and print grouped findings.

    Resolves the scope set (a single `.scope_id`, or every configured scope
    when it is omitted), runs `Doctor.run_all` per scope, and prints findings
    grouped by scope and severity with a per-scope and grand-total count.
    When `--apply` is given, fixable findings are repaired in-place and the
    printed lines note which fixes were applied; `--commit` additionally
    commits the repaired files in one commit — the `lazy-wiki.doctor-apply`
    schedule routine's mode, so its worktree writes never trip the daemon's
    dirty-tree guard (a hand-run without the flag keeps leaving the repairs
    uncommitted for the operator to inspect).

    Guarantees:
      - Without `--apply` the audit is read-only: no audited file is rewritten.
      - Without `--commit` nothing is committed; applied repairs are left in the working
        tree for the operator to inspect.

    Args:
      args: Parsed argument namespace; carries `.scope_id` (or `None`),
        `.apply`, `.commit`, and `.repo`.

    Returns:
      Integer exit code: 0 when the audit ran (read-only or `--apply`),
      1 when a named scope id is unknown, no scopes are configured, or the
      requested commit step failed.
    """

    # Contract:
    # Without `--apply` the audit is read-only: no audited file is rewritten.

    # Contract:
    # Without `--commit` the command NEVER commits; applied repairs are left in the
    # working tree for the operator to inspect.

    repo_raw = args.repo or os.environ.get(_ENV_REPO_ROOT) or os.getcwd()
    repo = Path(repo_raw).resolve()
    resolver = _scope.ScopeResolver(repo = repo)
    scopes = resolver.load_scopes()

    # guard: no scopes configured at all
    if not scopes:
      print(self._MSG_NO_SCOPES, file = sys.stderr)
      return 1

    # Determine which scopes to audit.
    if args.scope_id is None:
      target_ids = sorted(scopes)
    else:
      # guard: named scope id is not configured
      if args.scope_id not in scopes:
        print(
          f"doctor: unknown scope '{args.scope_id}' "
          f"(known: {', '.join(sorted(scopes)) or 'none'})",
          file = sys.stderr,
        )
        return 1
      target_ids = [ args.scope_id ]

    grand_total = 0
    touched: set[str] = set()
    for scope_id in target_ids:
      doc = _doctor.Doctor(
        repo     = repo,
        scope_id = scope_id,
        cfg      = scopes[scope_id],
        apply    = bool(args.apply),
      )
      findings = doc.run_all()
      grand_total += len(findings)
      self._print_scope_findings(scope_id, findings, apply = bool(args.apply))
      touched |= self._applied_paths(findings, scopes[scope_id])

    # repo-level domain checks ride the same report; report-only, so never printed on a clean tree
    domain_findings = _doctor.DomainDoctor(repo = repo).run_all()
    if domain_findings:
      grand_total += len(domain_findings)
      self._print_scope_findings(self._DOMAIN_SECTION, domain_findings, apply = False)

    mode = "apply" if args.apply else "read-only"
    print(f"\ndoctor: {grand_total} finding(s) across {len(target_ids)} scope(s) [{mode}]")

    # guard: no commit requested (or nothing applied to commit) — the audit itself is done
    if not (args.apply and args.commit and touched):
      return 0
    # one commit for the whole run, under the invoking routine's exported git identity
    return self._commit_paths(
      repo = repo,
      paths = sorted(touched),
      message = f"lazy-wiki: doctor apply ({len(touched)} file(s))",
    )

  def _applied_paths(self, findings: list[dict], cfg: dict) -> set[str]:
    """
    Collect the repo-relative paths one scope's applied doctor fixes touched.

    Node-level repairs touch the finding's own node file; an applied
    orphan-topic / index-desync finding means the scope's topics index was
    rebuilt, so the index path joins the set once for any of them.

    Args:
      findings: The scope's finding dicts from `Doctor.run_all`.
      cfg: The scope-config dict, read for its `topics_index` path.

    Returns:
      Repo-relative POSIX paths of the files the applied fixes rewrote;
      empty when nothing was applied.
    """
    applied = [ f for f in findings if f.get(self._F_APPLIED) ]
    touched = { f[self._F_NODE] for f in applied if f.get(self._F_NODE) and f[self._F_NODE] != "-" }
    index_checks = (_doctor.Doctor.CHECK_ORPHAN_TOPIC, _doctor.Doctor.CHECK_INDEX_DESYNC)
    if any(f[self._F_CHECK] in index_checks for f in applied):
      touched.add(cfg.get(self._CFG_TOPICS_INDEX) or _doctor._DEFAULT_TOPICS_INDEX)
    return touched

  def _print_scope_findings(
    self,
    scope_id: str,
    findings: list[dict],
    *,
    apply: bool,
  ) -> None:
    """
    Print one scope's findings grouped by severity, with a per-scope count.

    Args:
      scope_id: The scope identifier being reported.
      findings: List of finding dicts from `Doctor.run_all`.
      apply: True when `--apply` was requested (annotates applied fixes).
    """
    print(f"\n=== scope '{scope_id}' — {len(findings)} finding(s) ===")
    # guard: a clean scope — nothing to enumerate
    if not findings:
      print(self._MSG_CLEAN)
      return

    by_sev: dict[str, list[dict]] = {}
    for f in findings:
      by_sev.setdefault(f[self._F_SEVERITY], []).append(f)

    for sev in self._SEVERITY_ORDER:
      bucket = by_sev.get(sev, [])
      # guard: no findings at this severity
      if not bucket:
        continue
      print(f"  [{sev}] {len(bucket)}")
      for f in bucket:
        suffix = ""
        if apply and f.get(self._F_APPLIED):
          suffix = "  (fixed)"
        elif f.get(self._F_FIXABLE):
          suffix = "  (fixable)"
        print(f"    {f[self._F_CHECK]}: {f[self._F_NODE]} — {f[self._F_MESSAGE]}{suffix}")

  def _cmd_process_file(self, args: argparse.Namespace) -> int:
    """
    Resolve a node to its scope and dispatch a classify curation job.

    Accepts `path` as either a git-item JSON string
    (`{"path": "...", ...}`) or a bare file path.  When the node
    belongs to no configured scope, prints a skip note and exits 0.
    Otherwise builds a classify payload — carrying `kind` inside the
    payload so it reaches the curator's `request.json` — and dispatches
    it via `CoreDispatch.dispatch_curator`.  Exits promptly without
    waiting for the curator.

    Args:
      args: Parsed argument namespace; must carry `.path` and `.repo`.

    Returns:
      Integer exit code (0 on success or skip, 1 on dispatch error).
    """
    repo_raw = args.repo or os.environ.get(_ENV_REPO_ROOT) or os.getcwd()
    repo = Path(repo_raw).resolve()

    raw_path = self._parse_path_arg(args.path)
    node_path = Path(raw_path)

    resolver = _scope.ScopeResolver(repo = repo)
    result = resolver.resolve_scope_by_path(node_path)

    # guard: node does not belong to any configured scope
    if result is None:
      print(f"process-file: skip (no scope) {raw_path}")
      return 0

    scope_id, cfg = result

    abs_path = node_path if node_path.is_absolute() else repo / node_path
    # guard: node file does not exist on disk
    if not abs_path.is_file():
      print(f"process-file: skip (file not found) {raw_path}")
      return 0

    tag_axes: list[str] = cfg.get(self._CFG_TAG_AXES) or []

    node_obj = _nodes.node_for(abs_path)
    # guard: unrecognised file type — skip (scope resolver let it through via glob)
    if node_obj is None:
      print(f"process-file: skip (unrecognised type) {raw_path}")
      return 0
    # guard: operator source unchanged since last curation — skip dispatch to
    # break the daemon re-dispatch loop. The curator's own commits touch only
    # managed regions, so wiki_src_hash stays equal to the node's current
    # source_hash; a virgin node (no stored hash) or an operator content edit
    # (differing hash) falls through and is dispatched.
    stored_hash = node_obj.stored_src_hash
    if stored_hash is not None and stored_hash == node_obj.source_hash:
      print(f"process-file: skip (source unchanged) {raw_path}")
      return 0
    pins = {
      "pinned_topics":    node_obj.pinned_topics,
      "unrelated_topics": node_obj.unrelated_topics,
      "pinned_links":     node_obj.pinned_links,
      "unrelated_links":  node_obj.unrelated_links,
    }

    # The existing per-axis tag values across the scope — the classify anchor, so
    # the curator reuses a value already in use instead of coining a synonym
    # (empty axes on cold-start). Same source /wiki.relink feeds inline.
    existing_tags = _tags.TagOps(repo = repo, scope_id = scope_id, cfg = cfg).collect()

    payload = {
      self._PAYLOAD_KIND:          _dispatch.CoreDispatch.KIND_CLASSIFY,
      self._PAYLOAD_NODE_PATH:     raw_path,
      self._CFG_TAG_AXES:          tag_axes,
      self._PAYLOAD_SCOPE_ID:      scope_id,
      self._PAYLOAD_PINS:          pins,
      self._PAYLOAD_EXISTING_TAGS: existing_tags,
    }

    dispatcher = _dispatch.CoreDispatch()
    dispatcher.dispatch_curator(
      repo = repo,
      node_path = node_path,
      payload = payload,
    )
    print(f"process-file: dispatched (classify) {raw_path}")
    return 0

  def _cmd_prune_node(self, args: argparse.Namespace) -> int:
    """
    Prune See-also links to a deleted node and persist the result.

    Reconciles one scope's See-also links and topic index after a wiki node is deleted, so a
    daemon-invoked run leaves a clean working tree.

    Notes:
      - Exits successfully without making changes when the target path still exists or falls
        outside any tracked scope.
      - Commits the touched nodes and the rebuilt topic index to git unless the caller opts out.

    Args:
      args: Parsed argument namespace. `.path` accepts a bare file path or a git-item JSON
        string (as produced by the `deleted_files` git watch); must also carry `.repo` and
        `.no_commit`.

    Returns:
      Integer exit code; 0 on success or skip, 1 when the commit step fails.
    """
    repo_raw = args.repo or os.environ.get(_ENV_REPO_ROOT) or os.getcwd()
    repo = Path(repo_raw).resolve()

    raw_path = self._parse_path_arg(args.path)
    node_path = Path(raw_path)
    abs_path = node_path if node_path.is_absolute() else repo / node_path

    # guard: the file still exists — not a deletion, nothing to prune
    if abs_path.is_file():
      print(f"prune-node: skip (file exists) {raw_path}")
      return 0

    resolver = _scope.ScopeResolver(repo = repo)
    result = resolver.resolve_scope_by_path(node_path)
    # guard: deleted path does not belong to any configured scope
    if result is None:
      print(f"prune-node: skip (no scope) {raw_path}")
      return 0

    scope_id, cfg = result
    pruner = _prune.NodePruner(repo = repo, scope_id = scope_id, cfg = cfg)
    outcome = pruner.prune(abs_path)

    if not args.no_commit:
      touched = [ *outcome[self._FIELD_PRUNED_NODES], outcome[self._FIELD_INDEX] ]
      exit_code = self._commit_paths(
        repo    = repo,
        paths   = touched,
        message = f"wiki(prune): drop links to {outcome[self._FIELD_DELETED]} ({scope_id})",
      )
      # guard: commit failed — surface the error so the daemon records it
      if exit_code != 0:
        return exit_code

    print(json.dumps(outcome))
    return 0

  def _commit_paths(self, *, repo: Path, paths: list[str], message: str) -> int:
    """
    Commit the given repo-relative paths when any of them carries changes.

    Guarantees:
      - Only the given paths are staged and committed; content the operator parked in the
        index never rides along.

    Notes:
      - Returns success without committing when there is nothing to commit — no paths given,
        or none of the given paths changed.

    Args:
      repo: Absolute repository root the git commands run in.
      paths: Repo-relative paths to stage and commit.
      message: Commit message.

    Returns:
      0 on success or clean no-op, 1 when a git command fails.
    """

    # Contract:
    # Only the given paths are ever staged and committed; content the operator parked in
    # the index MUST NOT ride along.

    # guard: nothing to commit
    if not paths:
      return 0
    try:
      status = subprocess.check_output(
        [ "git", "status", "--porcelain", "--", *paths ],
        cwd = str(repo), text = True,
      ).strip()
      # guard: no changes among the touched paths — clean no-op
      if not status:
        return 0
      subprocess.check_output([ "git", "add", "--", *paths ], cwd = str(repo), text = True)
      subprocess.check_output(
        [ "git", "commit", "-m", message, "--", *paths ],
        cwd = str(repo), text = True,
      )
    except subprocess.CalledProcessError as e:
      print(f"git commit failed: {e}", file = sys.stderr)
      return 1
    return 0

  def _cmd_dispatch_link(self, args: argparse.Namespace) -> int:
    """
    Resolve a node to its scope and dispatch a link curation job.

    Mirrors `process-file`'s dispatch path but builds a `link` payload:
    `kind=link`, plus the scope's current `topics.md` content as the
    candidate catalog.  Called by the classify curator (via Bash) to
    chain phase 2 after classify+build-index complete.

    When the node belongs to no scope → skip (exit 0).  When the scope's
    `topics.md` is missing or empty → prints a warning and dispatches
    anyway with an empty catalog string (link curator will return a
    `logical` error, which is correct).

    Args:
      args: Parsed argument namespace; must carry `.path` and `.repo`.

    Returns:
      Integer exit code (0 on success or skip, 1 on dispatch error).
    """
    repo_raw = args.repo or os.environ.get(_ENV_REPO_ROOT) or os.getcwd()
    repo = Path(repo_raw).resolve()

    node_path = Path(args.path)

    resolver = _scope.ScopeResolver(repo = repo)
    result = resolver.resolve_scope_by_path(node_path)

    # guard: node does not belong to any configured scope
    if result is None:
      print(f"dispatch-link: skip (no scope) {args.path}")
      return 0

    scope_id, cfg = result

    abs_path = node_path if node_path.is_absolute() else repo / node_path
    # guard: node file does not exist on disk
    if not abs_path.is_file():
      print(f"dispatch-link: skip (file not found) {args.path}")
      return 0

    node_obj = _nodes.node_for(abs_path)
    # guard: unrecognised file type — skip
    if node_obj is None:
      print(f"dispatch-link: skip (unrecognised type) {args.path}")
      return 0
    pins = {
      "pinned_topics":    node_obj.pinned_topics,
      "unrelated_topics": node_obj.unrelated_topics,
      "pinned_links":     node_obj.pinned_links,
      "unrelated_links":  node_obj.unrelated_links,
    }

    # Read the scope's topics.md as the link-phase candidate catalog.
    topics_index_path_rel = cfg.get(self._CFG_TOPICS_INDEX, "")
    topics_index_content = ""
    if topics_index_path_rel:
      topics_index_abs = repo / topics_index_path_rel
      if topics_index_abs.is_file():
        topics_index_content = topics_index_abs.read_text(encoding = self._ENCODING)
      else:
        print(
          f"dispatch-link: warning — topics.md not found at {topics_index_abs}; "
          "dispatching with empty catalog",
          file = sys.stderr,
        )

    payload = {
      self._PAYLOAD_KIND:              _dispatch.CoreDispatch.KIND_LINK,
      self._PAYLOAD_NODE_PATH:         str(abs_path),
      self._PAYLOAD_TOPICS_INDEX_CONT: topics_index_content,
      self._PAYLOAD_PINS:              pins,
      self._PAYLOAD_SCOPE_ID:          scope_id,
    }

    dispatcher = _dispatch.CoreDispatch()
    dispatcher.dispatch_curator(
      repo = repo,
      node_path = abs_path,
      payload = payload,
    )

    # Domain(wiki.graph):
    # # Order of the two curation phases
    # A node is curated in two phases that cannot be swapped: it is first classified — given its short
    # description and its topics — and only then linked to its neighbours. Neighbours are chosen from the
    # scope's catalog of classified nodes, so linking a node whose own classification has not yet reached
    # that catalog could only draw on stale material.
    # Reaching the catalog also changes what the surrounding nodes ought to link to, so the linking phase is
    # where the ripple starts: every node the newcomer attracts is sent back to be linked again against the
    # same freshly rebuilt catalog. A node that already names the newcomer among its neighbours is left
    # alone, because the link the ripple would draw is there already.
    # The ripple reaches exactly one step: linking a node never reclassifies it, and so never starts a ripple
    # of its own, which is what keeps a single appearance from cascading through the whole scope.

    # Back-link fan-out — dispatch link jobs for every scope node that lists this
    # node among its top-N candidates. Runs here (not in process-file) because
    # the classify tail has already executed apply-node + build-index, so the
    # topics.md content we just snapshot above is current — every attracted
    # node's link curator can pick this node from its catalog. Link jobs do not
    # themselves call dispatch-link, so the fan-out cannot recurse.
    back_finder = _candidates.BackCandidateFinder(repo, cfg, scope_id)
    attracted_rel = back_finder.find(abs_path)
    # The target's repo-relative POSIX path — matched against each attracted
    # node's existing forward see-also to skip re-link dispatches where the
    # link is already in place (no LLM work needed). None when the target
    # path is outside the repo root (a cross-repo dispatch — never skip).
    try:
      target_rel = abs_path.resolve().relative_to(repo.resolve()).as_posix()
    except ValueError:
      target_rel = None
    back_dispatched = 0
    back_skipped_existing = 0
    for rel in attracted_rel:
      y_abs = repo / rel
      # guard: attracted path does not resolve to an existing file — skip
      if not y_abs.is_file():
        continue
      y_node = _nodes.node_for(y_abs)
      # guard: unrecognised file type — skip
      if y_node is None:
        continue
      # guard: attractor already forward-links to the target — no LLM work needed
      if target_rel is not None and target_rel in y_node.see_also_targets:
        back_skipped_existing += 1
        continue
      y_pins = {
        "pinned_topics":    y_node.pinned_topics,
        "unrelated_topics": y_node.unrelated_topics,
        "pinned_links":     y_node.pinned_links,
        "unrelated_links":  y_node.unrelated_links,
      }
      y_payload = {
        self._PAYLOAD_KIND:              _dispatch.CoreDispatch.KIND_LINK,
        self._PAYLOAD_NODE_PATH:         str(y_abs),
        self._PAYLOAD_TOPICS_INDEX_CONT: topics_index_content,
        self._PAYLOAD_PINS:              y_pins,
        self._PAYLOAD_SCOPE_ID:          scope_id,
      }
      dispatcher.dispatch_curator(
        repo = repo,
        node_path = y_abs,
        payload = y_payload,
      )
      back_dispatched += 1

    print(
      f"dispatch-link: dispatched (link) {args.path}"
      f" + back-links={back_dispatched} (skipped-already-linked={back_skipped_existing})"
    )
    return 0

  def _cmd_domain_plan(self, args: argparse.Namespace) -> int:
    """
    Print the domain-spec plan to stdout as one JSON object.

    Runs full detection across the configured code, the dictionary, and the generated
    docs' hash anchors on every call. The plan consumer (the `/wiki.domain-sync` skill
    or `domain-tick`) owns writer dispatch and commits; this command never writes.

    Guarantees:
      - Planning is read-only: no domain doc, no index, and no commit is ever produced.

    Args:
      args: Parsed argument namespace; must carry `.repo`.

    Returns:
      Integer exit code (0 on success, 1 when `wiki.domains` is not configured).
    """

    # Contract:
    # Planning is read-only: the command NEVER writes a domain doc, rebuilds the index,
    # or produces a commit.

    repo_raw = args.repo or os.environ.get(_ENV_REPO_ROOT) or os.getcwd()
    planner = _domains.DomainPlanner(repo = Path(repo_raw).resolve())
    # guard: wiki.domains not configured — nothing to plan
    if not planner.configured:
      print(self._MSG_DOMAINS_UNCONFIGURED_PLAN, file = sys.stderr)
      return 1

    # the plan is the whole output — one JSON object on stdout
    print(json.dumps(planner.plan()))
    return 0

  def _cmd_domain_apply_index(self, args: argparse.Namespace) -> int:
    """
    Report as JSON whether the `domains.md` index was rebuilt.

    Writes the index file only when its rendered content differs from what is
    already on disk.

    Args:
      args: Parsed argument namespace; must carry `.repo`.

    Returns:
      Integer exit code (0 on success, 1 when `wiki.domains` is not configured).
    """
    repo_raw = args.repo or os.environ.get(_ENV_REPO_ROOT) or os.getcwd()
    planner = _domains.DomainPlanner(repo = Path(repo_raw).resolve())
    # guard: wiki.domains not configured — no index to build
    if not planner.configured:
      print(self._MSG_DOMAINS_UNCONFIGURED_INDEX, file = sys.stderr)
      return 1

    # rebuild only when the render differs; report which way it went
    index = _domains.DomainIndex(cfg = planner.cfg)
    updated = index.apply()
    print(json.dumps({ "index": index.index_rel(), "updated": updated }))
    return 0

  def _cmd_domain_tick(self, args: argparse.Namespace) -> int:
    """
    Reconcile the repo's domain-spec state for one triggered git change.

    Detection is always full; the trigger path only gates whether running a tick is
    worth it.

    Notes:
      - Deletes orphaned docs — a group with no blocks left in code, or a doc whose
        group the dictionary no longer lists — and rebuilds the index
        deterministically, committing that part itself.
      - Dispatches one `wiki.domain-writer` job per changed group; the writer owns the
        doc write, the index refresh, and its own commit.
      - Idempotent: matching hashes mean zero work, so repeated ticks from the same
        commit are safe.

    Args:
      args: Parsed argument namespace; carries `.path` (git-item JSON or bare
        path, `None` with `--full`), `.repo`, and `.full`.

    Returns:
      Integer exit code (0 on success or skip, 1 when a git commit fails).
    """
    repo_raw = args.repo or os.environ.get(_ENV_REPO_ROOT) or os.getcwd()
    repo = Path(repo_raw).resolve()
    planner = _domains.DomainPlanner(repo = repo)

    # guard: wiki.domains not configured — the routine fired in an unconfigured repo
    if not planner.configured:
      print(self._MSG_DOMAIN_TICK_SKIP)
      return 0

    # Domain(wiki.domains):
    # # What a change signal is worth
    # The published state of the domain tree is read in full from what lies on disk — the knowledge written
    # in the code, the groups the dictionary admits, and the generation mark each published document carries.
    # A single reported change therefore never says what has to be rebuilt, only whether reconciling is worth
    # running at all.
    # Two kinds of change can move the published set: an edit to code that may carry knowledge blocks, and an
    # edit to the dictionary, which admits or withdraws a group without any block moving. A change anywhere
    # else cannot alter the outcome and is dismissed without reading further.
    # Reconciling twice over the same state is free: the second pass finds every generation mark still
    # matching and every listed group still backed, so it writes nothing.

    # a per-file trigger is only worth a tick when it lands in the domain sources
    if not args.full and args.path is not None:
      rel = self._parse_path_arg(args.path)
      # guard: path outside the code globs and the dictionary — the tick is a no-op
      if not self._is_domain_trigger(planner.cfg, rel):
        print(f"domain-tick: skip (path outside domain sources) {rel}")
        return 0

    # full detect on every tick — the docs' domain_hash anchors are the whole state
    plan = planner.plan()
    changed = plan[_domains.PLAN_CHANGED]
    orphans = plan[_domains.PLAN_ORPHANED]

    # deterministic half: drop orphaned docs and refresh the index, committed here
    if orphans or plan[_domains.PLAN_INDEX_STALE]:
      # only git-tracked orphans join the commit pathspec — an untracked one has no deletion to record
      tracked = self._tracked_paths(repo, orphans)
      for rel in orphans:
        (repo / rel).unlink(missing_ok = True)
      index = _domains.DomainIndex(cfg = planner.cfg)
      index.apply()

      # name the dictionary-driven removals in the subject — a count alone hides why the doc went
      unlisted = plan[_domains.PLAN_UNLISTED]
      reason = f" ({len(unlisted)} for a group no longer in the dictionary)" if unlisted else ""

      # record the deletions and the refreshed index as one commit
      exit_code = self._commit_paths(
        repo    = repo,
        paths   = [ *tracked, index.index_rel() ],
        message = f"wiki(domains): drop {len(orphans)} orphaned doc(s){reason}, refresh index",
      )
      # guard: commit failed — surface the error so the daemon records it
      if exit_code != 0:
        return exit_code

    # LLM half: one writer job per changed group; the writer owns doc + commit
    if changed:
      dispatcher = _dispatch.CoreDispatch()
      for entry in changed:
        payload = {
          self._PAYLOAD_KIND:      _dispatch.CoreDispatch.KIND_DOMAIN_SPEC,
          self._PAYLOAD_GROUP:     entry[_domains.GROUP_KEY],
          self._PAYLOAD_GLOSS:     entry[_domains.GROUP_GLOSS],
          self._PAYLOAD_LANGUAGE:  plan[_domains.PLAN_LANGUAGE],
          self._PAYLOAD_DOC_PATH:  entry[_domains.GROUP_DOC],
          self._PAYLOAD_HASH:      entry[_domains.GROUP_HASH],
          self._PAYLOAD_BLOCKS:    entry[_domains.GROUP_BLOCKS],
          self._PAYLOAD_CONTRACTS: entry[_domains.GROUP_CONTRACTS],
        }
        dispatcher.dispatch_domain_writer(
          repo = repo,
          group = entry[_domains.GROUP_KEY],
          payload = payload,
        )

    # one-line JSON tick summary for the daemon log
    print(json.dumps({
      "dispatched":      len(changed),
      "orphans_removed": len(orphans),
      "index":           "updated" if (orphans or plan[_domains.PLAN_INDEX_STALE]) else "unchanged",
    }))
    return 0

  def _cmd_mirror_plan(self, args: argparse.Namespace) -> int:
    """
    Print the dry-run sync plan for one mirror scope.

    Fetches the runtime clone first (the clone is a cache, not the mirror),
    then prints the plan JSON and touches nothing else.

    Guarantees:
      - The dry run leaves the mirror tree untouched and never commits; only the runtime
        clone cache is refreshed.

    Args:
      args: Parsed argument namespace; must carry `.scope_id` and `.repo`.

    Returns:
      Integer exit code (0 on success, 1 on unknown scope, missing mirror
      block, or fetch failure).
    """

    # Contract:
    # The dry run leaves the mirror tree untouched and NEVER commits; the only thing it
    # writes is the runtime clone cache the plan is computed against.

    engine = self._fetch_mirror_engine(args, verb = self._CMD_MIRROR_PLAN)
    # guard: unknown scope, missing mirror block, or fetch failure — already reported
    if engine is None:
      return 1

    # the dry run stops at the plan — nothing is written or committed
    print(json.dumps(engine.plan()))
    return 0

  def _cmd_mirror_sync(self, args: argparse.Namespace) -> int:
    """
    Apply the sync plan for one mirror scope and commit the fallout.

    Fetches the runtime clone first (the clone is a cache, not the mirror),
    applies the plan, commits the touched mirror files (new and updated files
    plus tracked removals — same commit scheme as `prune-node` /
    `domain-tick`), and prints the applied report JSON.  Idempotent: a second
    run against an unchanged source commits nothing.

    Args:
      args: Parsed argument namespace; must carry `.scope_id` and `.repo`.

    Returns:
      Integer exit code (0 on success, 1 on unknown scope, missing mirror
      block, fetch failure, or commit failure).
    """
    engine = self._fetch_mirror_engine(args, verb = self._CMD_MIRROR_SYNC)
    # guard: unknown scope, missing mirror block, or fetch failure — already reported
    if engine is None:
      return 1

    # apply the plan; the report doubles as the tick summary printed below
    repo = Path(args.repo or os.environ.get(_ENV_REPO_ROOT) or os.getcwd()).resolve()
    report = engine.sync()

    # commit new + updated files and tracked removals under one deterministic message
    touched = [
      *report[_mirror.K_SYNCED],
      *report[_mirror.K_UPDATED],
      *self._tracked_paths(repo, report[_mirror.K_REMOVED]),
    ]
    exit_code = self._commit_paths(
      repo    = repo,
      paths   = touched,
      message = (
        f"wiki(mirror): sync {args.scope_id} "
        f"(+{len(report[_mirror.K_SYNCED])} ~{len(report[_mirror.K_UPDATED])} "
        f"-{len(report[_mirror.K_REMOVED])})"
      ),
    )
    # guard: commit failed — surface the error so the daemon records it
    if exit_code != 0:
      return exit_code

    # the applied report is the caller's one-line summary
    print(json.dumps(report))
    return 0

  def _fetch_mirror_engine(self, args: argparse.Namespace, *, verb: str) -> _mirror.MirrorSync | None:
    """
    Resolve, validate, and fetch the mirror engine for one scope.

    Args:
      args: Parsed argument namespace; must carry `.scope_id` and `.repo`.
      verb: CLI verb name prefixing every error message.

    Returns:
      The fetched engine, or `None` when the scope is unknown, carries no
      mirror block, or the fetch failed (the error is already printed).
    """
    repo_raw = args.repo or os.environ.get(_ENV_REPO_ROOT) or os.getcwd()
    repo = Path(repo_raw).resolve()
    scopes = _scope.ScopeResolver(repo = repo).load_scopes()

    # guard: requested scope id not present in settings
    if args.scope_id not in scopes:
      print(
        f"{verb}: unknown scope '{args.scope_id}' "
        f"(known: {', '.join(sorted(scopes)) or 'none'})",
        file = sys.stderr,
      )
      return None

    engine = _mirror.MirrorSync(repo = repo, scope_id = args.scope_id, cfg = scopes[args.scope_id])
    # guard: scope carries no usable mirror block
    if not engine.configured:
      print(
        f"{verb}: scope '{args.scope_id}' has no mirror block "
        "(run /wiki.configure mirror)",
        file = sys.stderr,
      )
      return None

    # a fetch failure leaves the mirror untouched and must surface to the daemon
    error = engine.fetch()
    # guard: fetch failed — report it and hand the caller nothing to act on
    if error is not None:
      print(f"{verb}: {error}", file = sys.stderr)
      return None

    # the engine is validated and freshly fetched — ready for plan or sync
    return engine

  def _tracked_paths(self, repo: Path, paths: list[str]) -> list[str]:
    """
    Filter a path list down to those git currently tracks.

    Args:
      repo: Absolute repository root the git command runs in.
      paths: Repo-relative candidate paths.

    Returns:
      The subset of `paths` present in the git index, in git's output order;
      empty when `paths` is empty or the lookup fails.
    """
    # guard: nothing to filter
    if not paths:
      return []
    proc = subprocess.run(
      [ "git", "ls-files", "--", *paths ],
      cwd = str(repo),
      capture_output = True,
      text = True,
      check = False,
    )
    # guard: lookup failed — treat every path as untracked
    if proc.returncode != 0:
      return []
    return [ ln for ln in proc.stdout.splitlines() if ln ]

  def _is_domain_trigger(self, cfg: _domains.DomainConfig, rel: str) -> bool:
    """
    Decide whether a trigger path warrants a domain tick.

    Args:
      cfg: The repo's domain configuration.
      rel: Repo-relative (or absolute) path of the changed file.

    Returns:
      True when the path matches a configured code glob or is the dictionary file.
    """
    path = Path(rel)
    # normalise an absolute trigger to the repo-relative POSIX form the globs expect
    if path.is_absolute():
      try:
        rel = path.resolve().relative_to(cfg.repo).as_posix()
      except ValueError:
        # guard: outside the repo — cannot match any source
        return False
    # guard: the dictionary itself is a domain source
    if rel == cfg.dictionary:
      return True
    matcher = _scope.GlobMatcher()
    return any(matcher.match(rel, pat) for pat in cfg.code)

  def _parse_path_arg(self, raw: str) -> str:
    """
    Parse the `path` argument, accepting either a git-item JSON or a bare path.

    A git-item JSON is a JSON object string with at least a `"path"` key,
    as produced by the git routine when it streams file-change events.
    A bare path is returned unchanged.

    Args:
      raw: The raw argument string.

    Returns:
      The file path string extracted from the argument.
    """
    stripped = raw.strip()
    # guard: does not look like a JSON object — treat as bare path
    if not stripped.startswith("{"):
      return raw
    try:
      parsed: dict = json.loads(stripped)
      return str(parsed[self._GIT_ITEM_PATH_KEY])
    except (json.JSONDecodeError, KeyError):
      # guard: JSON parse error or missing path key — fall back to raw string
      return raw

  def _not_implemented(self, name: str) -> int:
    """
    Report a not-yet-implemented subcommand on stderr.

    Args:
      name: The subcommand name that was invoked.

    Returns:
      A non-zero exit code.
    """
    print(f"{self._PROG} {name}: not implemented yet", file = sys.stderr)
    return 2


if __name__ == "__main__":
  sys.exit(Cli().run())
