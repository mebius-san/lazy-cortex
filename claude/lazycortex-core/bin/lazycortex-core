#!/usr/bin/env python3
"""lazycortex-core CLI dispatcher."""
import os, sys
from pathlib import Path
sys.path.insert(0, str(Path(__file__).parent))

USAGE = ("usage: lazycortex-core <subcommand> [args...]\n"
         "Subcommands: expert-pump-once, doctor-tick, runtime-tick, runtime, resume, memory-reflect-all, dispatch-job, collect-job, consume-job, cancel-job, lookup-expert, scaffold, file-sync, remote-mirror, error-record, error-list, settings-get, settings-set, permission-allow, add-protocols, detect-scope, daemon-list, metrics-alloc-port, metrics-scrape-file, sandbox-sync, sandbox-audit")


def _cmd_consume_job(argv: list[str]) -> int:
    """Inter-plugin job-consume entrypoint. Reads ``{expert, job_id}``
    JSON from stdin, marks the job as consumed via
    ``expert_runtime.consume_job``, prints ``{"status": "ok"}`` on
    success.

    Idempotent: re-consuming an already-consumed job is a no-op.
    Missing job dir is also a no-op (already cleaned up).

    This is the contract sibling plugins use to retire a job after
    they have applied or explicitly discarded its response.
    """
    import json
    from pathlib import Path as _Path
    from expert_runtime import consume_job as _consume
    repo = _Path(os.environ.get("LAZY_REPO_ROOT", os.getcwd()))
    try:
        req = json.load(sys.stdin)
    except json.JSONDecodeError as e:
        print(json.dumps({"error": f"request parse: {e}"})); return 1
    expert = req.get("expert")
    job_id = req.get("job_id")
    if not expert or not job_id:
        print(json.dumps({"error": "request missing 'expert' or 'job_id'"})); return 1
    try:
        _consume(repo, expert, job_id)
    except Exception as e:
        print(json.dumps({"error": f"consume failed: {e}"})); return 1
    print(json.dumps({"status": "ok"}))
    return 0


def _cmd_cancel_job(argv: list[str]) -> int:
    """Inter-plugin job-cancellation entrypoint. Reads ``{expert, job_id}``
    JSON from stdin, cancels the job via ``expert_runtime.cancel_job``,
    prints ``{"cancelled": true|false, "job_id": ...}`` to stdout.

    Sequentially idempotent: a job that is already terminal (done, failed,
    deferred, dead, cancelled) or whose bundle is absent reports
    ``cancelled: false`` without touching the bundle again — this is the
    CLI-side guard that keeps a second, later cancel call from clobbering
    a finished bundle's terminal marker, since ``cancel_job`` itself does
    not re-check status. A job that finishes between this guard's read and
    the ``cancel_job`` call below is a separate race window, not covered
    by this guard — see the ``# limit:`` comment at the check.

    This is the contract sibling plugins use to abort a running expert
    job headlessly, e.g. a pre-launch rollback across the plugin boundary.
    """
    import json
    from pathlib import Path as _Path
    from constants import JobStatus
    from expert_runtime import cancel_job as _cancel, _job_dir, _job_status
    repo = _Path(os.environ.get("LAZY_REPO_ROOT", os.getcwd()))
    try:
        req = json.load(sys.stdin)
    except json.JSONDecodeError as e:
        print(json.dumps({"error": f"request parse: {e}"})); return 1
    expert = req.get("expert")
    job_id = req.get("job_id")
    if not expert or not job_id:
        print(json.dumps({"error": "request missing 'expert' or 'job_id'"})); return 1
    # guard: a terminal or absent bundle is already done — don't re-mark it
    # limit: check-then-act — a job finishing between this status read and the
    # cancel_job call below still gets CANCELLED stamped over its marker; closing
    # it means moving the re-check inside cancel_job's contract
    terminal = {JobStatus.DONE, JobStatus.FAILED, JobStatus.DEFERRED, JobStatus.DEAD, JobStatus.CANCELLED}
    jdir = _job_dir(repo, expert, job_id)
    cancellable = jdir.exists() and _job_status(jdir) not in terminal
    if not cancellable:
        print(json.dumps({"cancelled": False, "job_id": job_id}))
        return 0
    try:
        _cancel(repo, expert, job_id)
    except Exception as e:
        print(json.dumps({"error": f"cancel failed: {e}"})); return 1
    print(json.dumps({"cancelled": True, "job_id": job_id}))
    return 0


def _cmd_collect_job(argv: list[str]) -> int:
    """Inter-plugin job-collection entrypoint. Reads ``{expert, job_id}``
    JSON from stdin, queries ``expert_runtime.collect_job``, prints the
    status dict to stdout.

    Output JSON:
      ``{"status": "pending|done|failed|missing", "response": {...}}``
      (``response`` is present only when ``status`` is ``done`` or ``failed``.)

    This is the read-side companion to ``dispatch-job`` — the contract
    sibling plugins use to inspect a job they earlier queued. Same
    rationale: no filesystem-walk imports across plugin boundaries.
    """
    import json
    from pathlib import Path as _Path
    from expert_runtime import collect_job as _collect
    repo = _Path(os.environ.get("LAZY_REPO_ROOT", os.getcwd()))
    try:
        req = json.load(sys.stdin)
    except json.JSONDecodeError as e:
        print(json.dumps({"error": f"request parse: {e}"})); return 1
    expert = req.get("expert")
    job_id = req.get("job_id")
    if not expert or not job_id:
        print(json.dumps({"error": "request missing 'expert' or 'job_id'"})); return 1
    try:
        out = _collect(repo, expert, job_id)
    except Exception as e:
        print(json.dumps({"error": f"collect failed: {e}"})); return 1
    print(json.dumps(out))
    return 0


def _cmd_dispatch_job(argv: list[str]) -> int:
    """Inter-plugin job-creation entrypoint. Reads a JSON job-bundle
    from stdin, atomically creates the job dir via
    ``expert_runtime.dispatch_job``, prints the result JSON to stdout.

    Input bundle (stdin, JSON):
      ``{ "expert": "<name>", "payload": {...}, "protocols": [...],
          "source": [repo-relative path, ...], "context": [repo-relative path, ...],
          "source_inline": {filename: text}, "context_inline": {filename: text},
          "result": [filename, ...], "job_id": "...", "dedup_key": "..." }``

    ``source`` / ``context`` name paths in the working tree that the pump copies
    into the job's buckets when it claims the job; ``source_inline`` /
    ``context_inline`` carry text that no file holds and are written at dispatch.

    Output (stdout, JSON):
      ``{"job_id": "...", "queue_path": "..."}`` on fresh dispatch,
      ``{"job_id": "...", "status": "already-queued"}`` on dedup hit.

    Exit codes: 0 on success, 1 on bundle parse / dispatch error
    (error JSON on stdout).

    This is the contract sibling plugins MUST use to queue jobs —
    never reach into ``expert_runtime`` directly via filesystem-walk
    imports.
    """
    import json
    from pathlib import Path as _Path
    from expert_runtime import dispatch_job as _dispatch
    repo = _Path(os.environ.get("LAZY_REPO_ROOT", os.getcwd()))
    try:
        bundle = json.load(sys.stdin)
    except json.JSONDecodeError as e:
        print(json.dumps({"error": f"bundle parse: {e}"})); return 1
    try:
        out = _dispatch(
            repo,
            bundle.get("expert") or "",
            bundle.get("payload") or {},
            protocols=bundle.get("protocols"),
            source=bundle.get("source"),
            context=bundle.get("context"),
            source_inline=bundle.get("source_inline"),
            context_inline=bundle.get("context_inline"),
            result=bundle.get("result"),
            job_id=bundle.get("job_id"),
            dedup_key=bundle.get("dedup_key"),
        )
    except KeyError as e:
        print(json.dumps({"error": f"missing required bundle field: {e}"})); return 1
    except Exception as e:
        print(json.dumps({"error": f"dispatch failed: {e}"})); return 1
    print(json.dumps(out))
    return 0


def _cmd_lookup_expert(argv: list[str]) -> int:
    """Read ``{"name": "..."}`` from stdin; print
    ``{"found": true, "entry": {...}}`` or ``{"found": false}`` to stdout.
    Exit 0 in both cases; non-zero only on settings I/O / parse error.
    """
    import json
    from pathlib import Path as _Path
    repo = os.environ.get("LAZY_REPO_ROOT")
    if not repo:
        print("LAZY_REPO_ROOT not set", file=sys.stderr)
        return 2
    try:
        body = json.loads(sys.stdin.read() or "{}")
    except json.JSONDecodeError as e:
        print(f"stdin not JSON: {e}", file=sys.stderr)
        return 2
    name = body.get("name")
    if not name:
        print('stdin missing "name"', file=sys.stderr)
        return 2
    from expert_runtime import _resolve_expert_entry
    entry = _resolve_expert_entry(_Path(repo), name)
    if entry:
        print(json.dumps({"found": True, "entry": entry}))
    else:
        print(json.dumps({"found": False}))
    return 0


def _cmd_memory_reflect_all(argv: list[str]) -> int:
    """Dispatch a kind=reflect job for every persona-marked expert.
    Flags: --dry-run (list targets but don't dispatch), --days N (log window)."""
    import argparse, json, time
    parser = argparse.ArgumentParser(prog="lazycortex-core memory-reflect-all")
    parser.add_argument("--dry-run", action="store_true")
    parser.add_argument("--days", type=int, default=30)
    args = parser.parse_args(argv)

    from lazy_settings import load_section
    from expert_runtime import dispatch_job

    repo = Path(os.environ.get("LAZY_REPO_ROOT", os.getcwd()))
    experts = load_section(repo / ".claude/lazy.settings.json", "experts")
    PERSONA = "lazycortex-core:lazy-memory.persona-aspect"

    summary = {"dispatched": 0, "skipped_not_persona": 0,
               "would_dispatch": 0, "errors": []}

    for name, entry in experts.items():
        if name == "_version" or not isinstance(entry, dict):
            continue
        aspects = entry.get("aspects") or []
        if PERSONA not in aspects:
            summary["skipped_not_persona"] += 1
            continue
        if args.dry_run:
            summary["would_dispatch"] += 1
            continue

        # Gather sources: recent logs + memory notes
        sources = []
        log_root = repo / ".logs/claude" / name
        cutoff = time.time() - args.days * 86400
        if log_root.is_dir():
            for p in sorted(log_root.iterdir()):
                if p.is_file() and p.suffix == ".md" and p.stat().st_mtime >= cutoff:
                    sources.append({"path": str(p), "description": "recent run log"})
        mem_root = repo / ".memory" / name
        if mem_root.is_dir():
            for p in sorted(mem_root.iterdir()):
                if p.is_file() and p.suffix == ".md":
                    sources.append({"path": str(p), "description": "current memory note"})

        payload = {
            "kind": "reflect",
            "role": "reflect",
            "request": (
                "Consolidate recent runs into memory per lazy-memory.persona-aspect "
                "§Obligations. Use /lazy-memory.write for any new or updated notes. "
                "Return outcome=empty if nothing is worth consolidating."
            ),
            "source": sources,
        }
        try:
            dispatch_job(repo, name, payload)
            summary["dispatched"] += 1
        except Exception as e:
            summary["errors"].append({"expert": name, "error": str(e)})

    print(json.dumps(summary))
    return 0


def _cmd_error_record(argv: list[str]) -> int:
    """Record one error event (or resolve an incident) from CLI flags.

    Other plugins call this over the published CLI to register an error the
    runtime did not capture as a job/routine failure. Best-effort: the underlying
    ``error_ledger.record`` never raises. On open, prints ``{"recorded": true, "id": "<ulid>"}``
    so the caller can correlate; ``--cause`` is required (closed-set) so a plugin can't drop a
    causeless event into the ledger.
    """
    import argparse, json
    import error_ledger
    p = argparse.ArgumentParser(prog="lazycortex-core error-record")
    p.add_argument("--incident", required=True)
    p.add_argument("--kind", default="plugin_error")
    p.add_argument("--cause")
    p.add_argument("--severity", default="error", choices=["error", "warn"])
    p.add_argument("--detail", default="")
    p.add_argument("--expert")
    p.add_argument("--job-id")
    p.add_argument("--routine")
    p.add_argument("--resolve", action="store_true")
    p.add_argument("--resolution", default="manual")
    a = p.parse_args(argv)
    repo = Path.cwd()
    # guard: --resolve closes an incident instead of opening one; cause is meaningless for the close path
    if a.resolve:
        event_id = error_ledger.new_id()
        error_ledger.resolve(repo, a.incident, resolution=a.resolution, id=event_id)
    else:
        # guard: opening an event without a cause violates the closed-set contract — refuse the call
        if not a.cause:
            print("error-record: --cause is required when opening an event", file=sys.stderr)
            return 2
        event_id = error_ledger.new_id()
        error_ledger.record(repo, {
            "id": event_id,
            "incident": a.incident, "phase": "opened", "kind": a.kind, "cause": a.cause,
            "severity": a.severity, "detail": a.detail, "actor": "plugin-cli",
            "expert": a.expert, "job_id": a.job_id, "routine": a.routine,
        })
    print(json.dumps({"recorded": True, "id": event_id}))
    return 0


def _daemon_alive(repo: Path) -> bool:
    """Return True when this checkout's supervisor unit is currently running a daemon process."""
    import shutil
    import subprocess
    if sys.platform == "darwin":
        # a host without launchctl has no supervisor that could be running the unit
        if shutil.which("launchctl") is None:
            return False
        probe = subprocess.run(["launchctl", "list", f"com.lazycortex.runtime.{repo.name}"],
                               capture_output=True, text=True, check=False)
        return probe.returncode == 0 and '"PID"' in probe.stdout
    # same reasoning for a non-systemd host
    if shutil.which("systemctl") is None:
        return False
    probe = subprocess.run(
        ["systemctl", "--user", "is-active", f"lazy-core-runtime-{repo.name}.service"],
        capture_output=True, text=True, check=False,
    )
    return probe.returncode == 0 and probe.stdout.strip() == "active"


def _cmd_runtime_tick(repo: Path, argv: list[str]) -> int:
    """Manual daemon iterations by hand — same primitives, full bookkeeping, push deferred."""
    import json
    import time
    from runtime_daemon import (
        _check_working_tree, _run_iteration, compute_sleep, due_routines, time_until_next_due,
    )
    from lazy_settings import load_section
    from constants import (
        DaemonKey, JobMarker, RepoDir, SettingsFile, SettingsKey, StateKey,
    )
    import rate_limit_flag
    import runtime_state

    drain = "--drain" in argv
    unknown_flags = [a for a in argv if a.startswith("--") and a != "--drain"]
    names = [a for a in argv if not a.startswith("--")]
    # the command's contract is refuse-rather-than-surprise: a typo'd flag or a second
    # positional must not be silently dropped
    if unknown_flags or len(names) > 1:
        print(f"refused: unrecognised arguments {unknown_flags + names[1:]!r}; "
              "usage: runtime-tick [<routine-name>] [--drain]", file=sys.stderr)
        return 2
    routine = names[0] if names else None

    # a live daemon and a manual tick would race over the tree, the index, and the job queue
    if _daemon_alive(repo):
        print("refused: the runtime daemon is running on this checkout — a concurrent manual "
              "tick would race it over the tree, index, and job queue. Stop the unit first.",
              file=sys.stderr)
        return 2

    registry = load_section(repo / SettingsFile.REL, SettingsKey.ROUTINES)
    registry.pop(SettingsKey.VERSION, None)
    if routine is not None and routine not in registry:
        print(f"refused: unknown routine {routine!r}; registered: {', '.join(sorted(registry)) or '(none)'}",
              file=sys.stderr)
        return 2

    def ready_jobs() -> int:
        jobs_root = repo / RepoDir.EXPERTS / RepoDir.JOBS
        if not jobs_root.is_dir():
            return 0
        n = 0
        for edir in jobs_root.iterdir():
            if not edir.is_dir():
                continue
            for jdir in edir.iterdir():
                if not jdir.is_dir():
                    continue
                if (jdir / JobMarker.READY).exists() and not any(
                    (jdir / m).exists() for m in (JobMarker.DONE, JobMarker.DEAD, JobMarker.CANCELLED)
                ):
                    n += 1
        return n

    def last_run_snapshot() -> dict:
        return dict(runtime_state.load(repo).get(StateKey.LAST_RUN, {}))

    polling = load_section(repo / SettingsFile.REL, SettingsKey.DAEMON).get(
        DaemonKey.POLLING_INTERVAL_SEC, 5)

    # Every pass is one REAL daemon iteration — dispatch, journal, ledger, commit all included;
    # the READY queue drains through the registered pump routine like it would under the daemon.
    # The loop stops on the same signals the daemon would stop dispatching on (halt, dirty tree,
    # rate-limit flag), on empty queues, or on a pass that made no progress — never on a count.
    ticks = 0
    stopped = None
    while True:
        before = (last_run_snapshot(), ready_jobs())
        _run_iteration(repo, push=False, only=routine, force_due=routine is not None)
        ticks += 1
        state = runtime_state.load(repo)
        if state.get(StateKey.DAEMON_HALTED):
            stopped = "halted"
            break
        if routine is not None or not drain:
            break
        if _check_working_tree(repo) is not None:
            # the iteration dispatched nothing on a dirty tree and wrote no halt — looping
            # would spin forever on the same state
            stopped = "dirty_tree"
            break
        if rate_limit_flag.is_raised():
            stopped = "rate_limited"
            break
        last_run = last_run_snapshot()
        due = due_routines(time.time(), registry, last_run, system_stuck=False)
        if not due and ready_jobs() == 0:
            break
        if (last_run, ready_jobs()) == before:
            # nothing advanced and nothing drained — whatever is left cannot be drained by
            # looping; stop instead of spinning
            stopped = "no_progress"
            break
        # wait for the next due routine exactly as the daemon would
        time.sleep(compute_sleep(time_until_next_due(time.time(), registry, last_run), polling))

    # named mode: the operator asked for one routine by name — a run where it never dispatched
    # (stuck-system filter, say) must not look like success
    dispatched = None
    if routine is not None:
        dispatched = last_run_snapshot().get(routine) != before[0].get(routine)
    print(json.dumps({"ticks": ticks, "routine": routine, "dispatched": dispatched,
                      "ready_left": ready_jobs(), "stopped": stopped,
                      "halted": bool(runtime_state.load(repo).get(StateKey.DAEMON_HALTED))}))
    if routine is not None and not dispatched:
        print(f"refused: routine {routine!r} did not dispatch — the runtime is stuck "
              "(dirty tree or halt); see /lazy-runtime.recover", file=sys.stderr)
        return 2
    return 0


def _cmd_resume(argv: list[str]) -> int:
    """Clear the daemon's halt block so the runtime resumes work.

    Reason-aware (see ``recover.resume``): ``uncommitted_changes`` requires a
    clean working tree; other reasons (``suspected_loop``, ``git_pull_diverged``,
    ``git_push_failed``, ``git_remote_unavailable``, future) clear unconditionally.
    If the underlying cause still holds, the daemon will re-halt on the next
    iteration — clearing is always safe, never destructive.

    Idempotent: if the daemon is not halted, exits 0 with ``resumed: false``.
    """
    import argparse, json
    import recover
    p = argparse.ArgumentParser(prog="lazycortex-core resume")
    p.add_argument("repo", nargs="?", default=None,
                   help="Repository root (default: $LAZY_REPO_ROOT or cwd)")
    a = p.parse_args(argv)
    repo_path = Path(a.repo) if a.repo else Path(os.environ.get("LAZY_REPO_ROOT", os.getcwd()))
    halt_before = recover.read_halt(repo_path)
    # guard: daemon is not halted — idempotent no-op
    if halt_before is None:
        print(json.dumps({"resumed": False, "halt": None, "note": "daemon not halted"}))
        return 0
    try:
        recover.resume(repo_path)
    except recover.RecoverError as e:
        print(json.dumps({"resumed": False, "halt": halt_before, "error": str(e)}), file=sys.stderr)
        return 1
    print(json.dumps({"resumed": True, "halt": halt_before}))
    return 0


def _cmd_error_list(argv: list[str]) -> int:
    """Print error-ledger incidents as JSON, optionally filtered by state / kind / since-cursor."""
    import argparse, json
    import error_ledger
    p = argparse.ArgumentParser(prog="lazycortex-core error-list")
    p.add_argument("--state", default="all", choices=["all", "open", "needs_operator", "closed"])
    p.add_argument("--kind", default=None)
    p.add_argument("--since", default=None,
                   help="ULID cursor; only incidents whose latest event id is strictly greater are returned")
    a = p.parse_args(argv)
    rows = error_ledger.incidents(Path.cwd(), state=a.state, since=a.since)
    # guard: optional kind filter
    if a.kind:
        rows = [r for r in rows if r.get("kind") == a.kind]
    print(json.dumps(rows, ensure_ascii=False))
    return 0


def _cmd_detect_scope(argv: list[str]) -> int:
    """Print the install scope (``project`` / ``user`` / ``not-installed``) for a plugin key.

    Resolves the scope from where the plugin is actually *enabled* (``enabledPlugins``
    in the project then the user ``settings.json`` / ``settings.local.json``), falling
    back to the install record's own ``scope`` in ``installed_plugins.json`` only when
    neither settings file enables it. ``project_root`` defaults to the git toplevel of
    the cwd, so a call from any subdirectory resolves the same scope.

    This is the boundary-legal path (dev.plugin-boundaries § 1c) for sibling install
    skills to detect their own scope without importing lazycortex-core Python.
    """
    import argparse, subprocess
    from lazy_install_phases import detect_install_scope
    p = argparse.ArgumentParser(prog="lazycortex-core detect-scope")
    p.add_argument("plugin_key", help="e.g. lazycortex-diagram@lazycortex")
    a = p.parse_args(argv)
    toplevel = subprocess.run(["git", "rev-parse", "--show-toplevel"],
                              capture_output=True, text=True).stdout.strip()
    print(detect_install_scope(a.plugin_key, project_root=toplevel or os.getcwd()))
    return 0


def _cmd_daemon_list(argv: list[str]) -> int:
    """Print every lazycortex runtime daemon installed on this host as JSON.

    Enumerates supervisor units (launchd plists / systemd user units), joins each
    with its repo's ``daemon.metrics`` settings, and prints
    ``{"daemons": [{"repo_id", "repo_root", "repo_label", "metrics_enabled",
    "bind", "port"}, ...]}``.

    This is the boundary-legal path (dev.plugin-boundaries § 1c) for sibling
    plugins (lazycortex-observe) to learn the host's scrape-target set without
    importing lazycortex-core Python.
    """
    import argparse, json
    from daemon_registry import enumerate_local_daemons
    p = argparse.ArgumentParser(prog="lazycortex-core daemon-list")
    p.add_argument("--json", action="store_true", default=True,
                   help="accepted for call-site clarity; output is always JSON")
    p.parse_args(argv)
    print(json.dumps({"daemons": enumerate_local_daemons()}, ensure_ascii=False))
    return 0


def _cmd_metrics_alloc_port(argv: list[str]) -> int:
    """Allocate a metrics port for a repo and print ``{"port": N, "reused": bool}``.

    Sequential allocation from 9464: the repo's already-recorded port is reused
    verbatim; otherwise the first port that is neither recorded by another local
    daemon nor currently bindable-blocked is returned. Exits 1 with an ``error``
    JSON when the whole range is exhausted.
    """
    import argparse, json
    from port_alloc import allocate_port
    p = argparse.ArgumentParser(prog="lazycortex-core metrics-alloc-port")
    p.add_argument("--repo-root", required=True, help="absolute path of the repo the port is for")
    a = p.parse_args(argv)
    try:
        print(json.dumps(allocate_port(Path(a.repo_root))))
    except RuntimeError as e:
        print(json.dumps({"error": str(e)})); return 1
    return 0


def _cmd_metrics_scrape_file(argv: list[str]) -> int:
    """Write the Prometheus file_sd scrape-targets file and print ``{"path", "count", "targets"}``.

    Covers every metrics-enabled daemon on this host, one file_sd entry per daemon
    (``{"targets": ["127.0.0.1:<port>"], "labels": {"repo": "<label>"}}``). The file
    is server-blind — no repo paths, hostnames, or credentials. Default location:
    ``${XDG_CONFIG_HOME:-~/.config}/lazycortex/scrape-targets.json``.
    """
    import argparse, json
    from daemon_registry import write_scrape_targets_file
    p = argparse.ArgumentParser(prog="lazycortex-core metrics-scrape-file")
    p.add_argument("--out", default=None, help="override the output path")
    a = p.parse_args(argv)
    out = Path(a.out) if a.out else None
    print(json.dumps(write_scrape_targets_file(out), ensure_ascii=False))
    return 0


def _cmd_sandbox_sync(argv: list[str]) -> int:
    """Record the expert-spawn sandbox scope for a repo and print the sync result.

    The repo root is always granted read+write. Every entry — recorded, passed,
    or the root itself — also contributes the location it resolves to through
    symlinks, plus the targets of the symlinks directly inside it: macOS checks
    the resolved path, so an unresolved entry grants nothing where the data lives.

    Output JSON: ``{"path", "present", "enabled", "added_read", "added_write", "changed"}``.
    A recorded ``enabled`` is never overwritten — a ``false`` comes back in the
    result for the caller to act on.
    """
    import argparse, json
    from sandbox_scope import sync
    p = argparse.ArgumentParser(prog="lazycortex-core sandbox-sync")
    p.add_argument("--repo-root", required=True, help="absolute path of the repo whose sandbox scope is recorded")
    p.add_argument("--allow-read", action="append", default=[], help="extra readable path (repeatable)")
    p.add_argument("--allow-write", action="append", default=[], help="extra writable path (repeatable)")
    a = p.parse_args(argv)
    print(json.dumps(sync(Path(a.repo_root), read=a.allow_read, write=a.allow_write), ensure_ascii=False))
    return 0


def _cmd_sandbox_audit(argv: list[str]) -> int:
    """Report which resolved locations the recorded sandbox scope fails to grant.

    Read-only companion to ``sandbox-sync``: prints
    ``{"path", "present", "enabled", "missing_read", "missing_write"}``. A
    non-empty ``missing_write`` means confined spawns will fail every write
    through that symlink with ``Operation not permitted``. Exits 0 either way —
    the verdict travels in the JSON.
    """
    import argparse, json
    from sandbox_scope import audit
    p = argparse.ArgumentParser(prog="lazycortex-core sandbox-audit")
    p.add_argument("--repo-root", required=True, help="absolute path of the repo whose sandbox scope is audited")
    a = p.parse_args(argv)
    print(json.dumps(audit(Path(a.repo_root)), ensure_ascii=False))
    return 0


def main() -> int:
    if len(sys.argv) < 2:
        print(USAGE, file=sys.stderr); return 2
    sub = sys.argv[1]
    repo = Path(os.environ.get("LAZY_REPO_ROOT", os.getcwd()))
    if sub == "expert-pump-once":
        import json
        from expert_pump import pump
        result = pump(repo)
        line = f"experts={result['experts']} processed={result['processed']} cleaned={result['cleaned']}"
        # A deferral is otherwise invisible: the tick looks idle, and on a checkout with no halt
        # of its own nothing else would ever say the queue is waiting on a rate-limit window.
        # Only the FIRST deferral of a window (and a window change) carries the marker — repeats
        # are elided by the daemon's quiet-tick filter, else a 5s-polling checkout would write
        # one journal line per tick for the whole window. The gitignored marker file remembers
        # which resets_at was last announced; a non-deferred tick clears it.
        marker = repo / ".runtime" / "rate-limit-deferred.json"
        if result.get("deferred"):
            resets = result.get("resets_at")
            announced = None
            try:
                announced = json.loads(marker.read_text()).get("resets_at")
            except (OSError, ValueError):
                pass
            if announced != resets:
                line += f" deferred=rate_limit resets_at={resets}"
                try:
                    marker.parent.mkdir(parents=True, exist_ok=True)
                    marker.write_text(json.dumps({"resets_at": resets}))
                except OSError:
                    pass
        else:
            try:
                marker.unlink()
            except OSError:
                pass
        print(line)
        return 0
    elif sub == "doctor-tick":
        import json
        from doctor_tick import doctor_tick
        result = doctor_tick(repo)
        print(json.dumps(result))
        return 0
    elif sub == "runtime-tick":
        return _cmd_runtime_tick(repo, sys.argv[2:])
    elif sub == "runtime":
        from runtime_daemon import run
        run(repo); return 0
    elif sub == "resume":
        return _cmd_resume(sys.argv[2:])
    elif sub == "memory-reflect-all":
        return _cmd_memory_reflect_all(sys.argv[2:])
    elif sub == "dispatch-job":
        return _cmd_dispatch_job(sys.argv[2:])
    elif sub == "collect-job":
        return _cmd_collect_job(sys.argv[2:])
    elif sub == "consume-job":
        return _cmd_consume_job(sys.argv[2:])
    elif sub == "cancel-job":
        return _cmd_cancel_job(sys.argv[2:])
    elif sub == "lookup-expert":
        return _cmd_lookup_expert(sys.argv[2:])
    elif sub == "scaffold":
        from scaffold_registry import main as _scaffold_main
        return _scaffold_main(sys.argv[2:])
    elif sub == "file-sync":
        from file_sync import main as _file_sync_main
        return _file_sync_main(sys.argv[2:])
    elif sub == "remote-mirror":
        from remote_mirror import main as _remote_mirror_main
        return _remote_mirror_main(sys.argv[2:])
    elif sub == "error-record":
        return _cmd_error_record(sys.argv[2:])
    elif sub == "error-list":
        return _cmd_error_list(sys.argv[2:])
    elif sub == "settings-get":
        from settings_cli import cmd_settings_get
        return cmd_settings_get(sys.argv[2:])
    elif sub == "settings-set":
        from settings_cli import cmd_settings_set
        return cmd_settings_set(sys.argv[2:])
    elif sub == "permission-allow":
        from permission_cli import cmd_permission_allow
        return cmd_permission_allow(sys.argv[2:])
    elif sub == "add-protocols":
        from protocol_attach import cmd_add_protocols
        return cmd_add_protocols(sys.argv[2:])
    elif sub == "detect-scope":
        return _cmd_detect_scope(sys.argv[2:])
    elif sub == "daemon-list":
        return _cmd_daemon_list(sys.argv[2:])
    elif sub == "metrics-alloc-port":
        return _cmd_metrics_alloc_port(sys.argv[2:])
    elif sub == "metrics-scrape-file":
        return _cmd_metrics_scrape_file(sys.argv[2:])
    elif sub == "sandbox-sync":
        return _cmd_sandbox_sync(sys.argv[2:])
    elif sub == "sandbox-audit":
        return _cmd_sandbox_audit(sys.argv[2:])
    else:
        print(f"unknown subcommand: {sub}\n{USAGE}", file=sys.stderr); return 2


if __name__ == "__main__":
    sys.exit(main())
